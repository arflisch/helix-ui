@using System.Net
@using System.Text.RegularExpressions
@inject IJSRuntime JS

<div class="@(new CssBuilder("code").Add("code--flush", Flush).Build())">
    <div class="code__bar">
        <span class="code__lang">@Language</span>
        <button class="code__copy" @onclick="Copy">
            <VeloIcon Name="@(_copied ? "check" : "copy")" Size="13" />
            @(_copied ? "Copié" : "Copier")
        </button>
    </div>
    <pre class="code__pre"><code>@Highlighted</code></pre>
</div>

@code {
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public string Language { get; set; } = "razor";
    [Parameter] public bool Flush { get; set; }

    private bool _copied;

    private MarkupString Highlighted => new(Highlight(Code.Trim('\n', '\r')));

    private async Task Copy()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", Code.Trim());
            _copied = true;
            StateHasChanged();
            await Task.Delay(1500);
            _copied = false;
        }
        catch (JSException)
        {
            // Clipboard not available (insecure context): ignore.
        }
    }

    private static string Highlight(string code)
    {
        // Single pass so that inserted <span> tags are never re-matched.
        var html = WebUtility.HtmlEncode(code).Replace("&#39;", "'");
        return Tokens.Replace(html, m =>
        {
            var kind = m.Groups["c"].Success ? "c"
                : m.Groups["s"].Success ? "s"
                : m.Groups["t"].Success ? "t"
                : m.Groups["a"].Success ? "a"
                : "k";
            return $"<span class=\"tk-{kind}\">{m.Value}</span>";
        });
    }

    private static readonly Regex Tokens = new(
        @"(?<c>//[^\n]*)|(?<s>&quot;.*?&quot;)|(?<t>(?<=&lt;/?)[A-Za-z][\w.]*)|(?<a>(?<=\s)@?[A-Za-z][\w:-]*(?==))|(?<k>\b(?:var|new|await|true|false|null|using)\b)",
        RegexOptions.Compiled);
}
