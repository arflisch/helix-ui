@page "/components/stepper"
@inject VeloToastService Toasts

<DemoPage Title="Stepper" Description="Les étapes d'un parcours (assistant, commande, onboarding) : faites, en cours, à venir, en erreur. Les étapes terminées sont cliquables pour revenir en arrière.">
    <Example WpfCode="@Wpf1" Title="Assistant" Code="@Code">
        <div class="stack" style="gap:24px">
            <VeloStepper Steps="Steps" @bind-ActiveIndex="_active" ErrorSteps="@(_error ? new[] { 1 } : null)" />
            <VeloCard>
                <p style="margin:0 0 14px"><strong>@Steps[_active].Title</strong> <span class="muted">— @Steps[_active].Description</span></p>
                <div class="row">
                    <VeloButton Variant="VeloVariant.Outline" Color="neutral" Disabled="@(_active == 0)" OnClick="() => _active--">Précédent</VeloButton>
                    <VeloButton IconEnd="arrow-right" OnClick="Next">@(_active == Steps.Length - 1 ? "Terminer" : "Suivant")</VeloButton>
                    <VeloSwitch Label="Étape 2 en erreur" @bind-Checked="_error" Size="VeloSize.Sm" />
                </div>
            </VeloCard>
        </div>
    </Example>

    <Example WpfCode="@Wpf2" Title="Vertical">
        <div style="max-width:360px">
            <VeloStepper Steps="Steps" ActiveIndex="2" Vertical="true" Clickable="false" />
        </div>
    </Example>

    <ApiTable Title="VeloStepper" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <velo:VeloStepper Steps="{Binding Steps}" ActiveIndex="{Binding Step}" IsClickable="True" ErrorSteps="{Binding InvalidSteps}" />

        // ViewModel
        Steps = [new VeloStep("Compte", "E-mail et mot de passe"), new VeloStep("Profil"), new VeloStep("Équipe"), new VeloStep("Terminé")];
        """;

    private const string Wpf2 = """
        <velo:VeloStepper Steps="{Binding Steps}" ActiveIndex="1" Orientation="Vertical" Width="320" />
        """;

    private static readonly VeloStep[] Steps =
    [
        new("Site", "Choisir le site concerné"),
        new("Puissance", "Indiquer la puissance et la période"),
        new("Prix", "Fixer le prix plafond"),
        new("Envoi", "Vérifier et envoyer"),
    ];

    private int _active = 1;
    private bool _error;

    private void Next()
    {
        if (_active < Steps.Length - 1)
        {
            _active++;
        }
        else
        {
            Toasts.Success("Demande envoyée");
            _active = 0;
        }
    }

    private const string Code = """
        <VeloStepper Steps="steps" @bind-ActiveIndex="active" ErrorSteps="errors" />

        // new VeloStep("Puissance", "Indiquer la puissance et la période")
        """;

    private static readonly ApiRow[] Api =
    [
        new("Steps", "IReadOnlyList<VeloStep>", null, "(Title, Description?)."),
        new("ActiveIndex", "int", null, "Étape courante (@bind-ActiveIndex) ; celles d'avant sont faites."),
        new("ErrorSteps", "IReadOnlyCollection<int>", null, "Étapes en erreur (icône + texte, pas seulement du rouge)."),
        new("Clickable / AllowSkip", "bool", null, "Revenir aux étapes faites (true) ; sauter vers l'avant."),
        new("Vertical / Color", "bool / string", "--velo-stepper-color", "Orientation ; couleur."),
    ];
}
