@page "/components/timeline"
@using System.Globalization
@using static Velo.Demo.Components.Shared.Snippet
@inject VeloToastService Toasts

<DemoPage Title="Timeline" Description="Planning sur une échelle de temps : créneaux, statuts avec légende (plein, contour, pointillés), ligne « maintenant » qui avance en temps réel, passé grisé, regroupement par ligne et repli.">
    <section class="demo-section">
        <h2 class="demo-section__title">Playground</h2>
        <div class="pg pg--wide">
            <div class="pg__stage pg__stage--block">
                <VeloTimeline Title="Programme horaire" Start="_start" End="_start.AddHours(_hours)" SlotDuration="TimeSpan.FromMinutes(_slot)"
                              Items="_demands" Statuses="EnergyData.Statuses" Layout="_layout" ShowNow="_showNow" ShadePast="_shadePast"
                              ShowLegend="_legend" Collapsible="true" NowColor="@_nowColor" SlotMinWidth="@($"{N(_slotWidth)}px")"
                              OnItemClick="Open" Culture="French" />
            </div>
            <aside class="pg__controls">
                <Choice TEnum="VeloTimelineLayout" Label="Layout" @bind-Value="_layout" />
                <Choice TEnum="SlotChoice" Label="SlotDuration" Value="_slotChoice" ValueChanged="SetSlot" />
                <VeloSlider Label="SlotMinWidth" @bind-Value="_slotWidth" Min="60" Max="220" Step="10" Format="@(v => $"{v} px")" />
                <ColorPicker Label="NowColor" @bind-Value="_nowColor" Colors="@(["#eb6834", "danger", "#18181b"])" />
                <VeloSwitch Label="ShowNow (temps réel)" @bind-Checked="_showNow" Size="VeloSize.Sm" />
                <VeloSwitch Label="ShadePast" @bind-Checked="_shadePast" Size="VeloSize.Sm" />
                <VeloSwitch Label="ShowLegend" @bind-Checked="_legend" Size="VeloSize.Sm" />
            </aside>
        </div>
        <CodeBlock Code="@Code" />
    </section>

    <Example WpfCode="@Wpf1" Title="Plusieurs lignes (Lane), éditable" Description="Donnez un Lane à chaque élément : une ligne par unité. Avec Editable, glissez un élément pour le déplacer (y compris vers une autre unité), tirez ses bords pour changer sa durée, ou utilisez les flèches (Maj + flèches pour la durée). Les éléments confirmés sont verrouillés (CanEdit)." Code="@LanesCode">
        <VeloTimeline Title="Plan de production" Start="EnergyData.Today" End="EnergyData.Today.AddDays(1)" SlotDuration="TimeSpan.FromHours(1)"
                      Items="_plan" Statuses="EnergyData.Statuses" ShowLegend="false" LaneHeader="Unité" SlotMinWidth="56px" Culture="French"
                      Editable="true" SnapTo="TimeSpan.FromMinutes(30)" CanEdit="@(i => !i.Status!.EndsWith("-ack"))" OnItemChanged="ChangePlan">
            <ItemTemplate>
                <span style="display:inline-flex;align-items:center;gap:6px">
                    @if (context.Status == "rejected") { <VeloIcon Name="danger" Size="12" /> }
                    @context.Label
                </span>
            </ItemTemplate>
        </VeloTimeline>
    </Example>

    <ApiTable Title="VeloTimeline" Rows="Api" />
    <ApiTable Title="VeloTimelineItem et VeloTimelineStatus" Rows="ItemApi" ShowIntro="false" />
</DemoPage>

<VeloDialog @bind-Open="_open" Title="@_opened?.Label" Description="@Period(_opened)" Width="400px">
    <ChildContent>
        @if (_opened is not null)
        {
            var status = EnergyData.Statuses.FirstOrDefault(s => s.Key == _opened.Status);
            <div class="row">
                <VeloBadge Dot="true" Color="@status?.Color">@(status?.Label ?? "Sans statut")</VeloBadge>
            </div>
        }
    </ChildContent>
    <Footer>
        <VeloButton Variant="VeloVariant.Outline" Color="neutral" OnClick="() => _open = false">Fermer</VeloButton>
        <VeloButton OnClick="Resend">Renvoyer</VeloButton>
    </Footer>
</VeloDialog>

@code {
    private const string Wpf1 = """
        <velo:VeloTimeline Title="Planning des équipes" Start="{Binding From}" End="{Binding To}" SlotDuration="1:00:00"
                           Items="{Binding Items}" Statuses="{Binding Statuses}" LaneHeader="ÉQUIPE"
                           IsEditable="True" AllowLaneChange="True" SnapTo="0:15:00"
                           ShowNow="True" NowBrush="#F15A24" IsCollapsible="True"
                           ItemChanged="OnItemChanged" />

        // Code-behind : la timeline propose, votre code applique
        Statuses = [new VeloTimelineStatus("done", "Terminé", "series-3"),
                    new VeloTimelineStatus("planned", "Planifié", "series-1", VeloTimelineAppearance.Outline)];
        Items = [new("1", day.AddHours(7), day.AddHours(10), "Inspection") { Lane = "Équipe A", Status = "done" }];

        private void OnItemChanged(object sender, RoutedEventArgs e)
        {
            var change = ((VeloEventArgs<VeloTimelineChange>)e).Value;
            Items = Items.Select(i => i.Id == change.Item.Id ? change.Applied : i).ToList();
        }
        """;

    private enum SlotChoice { Min15, Min30, Hour }

    private static readonly CultureInfo French = CultureInfo.GetCultureInfo("fr-FR");

    private readonly DateTime _start = DateTime.Now.Date.AddHours(DateTime.Now.Hour - 1);
    private readonly int _hours = 4;
    private IReadOnlyList<VeloTimelineItem> _demands = [];
    private IReadOnlyList<VeloTimelineItem> _plan = EnergyData.UnitPlan(EnergyData.Today);

    private void ChangePlan(VeloTimelineChange change)
    {
        _plan = _plan.Select(i => i.Id == change.Item.Id ? change.Applied : i).ToList();
        Toasts.Show($"{change.Item.Label} : {change.Start:HH:mm} – {change.End:HH:mm}{(change.Lane != change.Item.Lane ? $" · {change.Lane}" : "")}", VeloSeverity.Success, duration: TimeSpan.FromSeconds(2));
    }

    private VeloTimelineLayout _layout = VeloTimelineLayout.Staircase;
    private SlotChoice _slotChoice;
    private double _slot = 15, _slotWidth = 130;
    private string? _nowColor = "#eb6834";
    private bool _showNow = true, _shadePast = true, _legend = true, _open;
    private VeloTimelineItem? _opened;

    protected override void OnInitialized() => _demands = EnergyData.Demands(_start, _hours, DateTime.Now);

    private void SetSlot(SlotChoice choice)
    {
        _slotChoice = choice;
        (_slot, _slotWidth) = choice switch { SlotChoice.Min30 => (30d, 150d), SlotChoice.Hour => (60d, 170d), _ => (15d, 130d) };
    }

    private void Open(VeloTimelineItem item)
    {
        _opened = item;
        _open = true;
    }

    private void Resend()
    {
        _open = false;
        Toasts.Success($"{_opened?.Label} renvoyée", "Demande envoyée");
    }

    private static string? Period(VeloTimelineItem? item) => item is null ? null : $"{item.Start:HH:mm} – {item.End:HH:mm}";

    private string Code =>
        $"""
        <VeloTimeline Title="Programme horaire" Start="start" End="start.AddHours(4)"{(_slot == 15 ? "" : $" SlotDuration=\"TimeSpan.FromMinutes({_slot})\"")}
                      Items="demands" Statuses="statuses"{A("Layout", _layout, VeloTimelineLayout.Packed)}{A("NowColor", _nowColor)}{(_showNow ? "" : " ShowNow=\"false\"")}{(_shadePast ? "" : " ShadePast=\"false\"")}{(_legend ? "" : " ShowLegend=\"false\"")}
                      Collapsible OnItemClick="Open" />

        @code {"{"}
            private VeloTimelineStatus[] statuses =
            [
                new("saved", "Enregistrée", "var(--velo-series-1)", VeloTimelineAppearance.Dashed),
                new("sent", "Envoyée", "var(--velo-series-1)", VeloTimelineAppearance.Outline),
                new("ack", "Confirmée", "var(--velo-series-1)", VeloTimelineAppearance.Filled),
                new("rejected", "Rejetée", "danger"),
            ];

            private VeloTimelineItem[] demands =
            [
                new("1", at(11, 00), at(11, 15), "SA : 12,5 MW") {"{"} Status = "ack" {"}"},
                new("2", at(11, 15), at(11, 30), "SA : 8,0 MW") {"{"} Status = "sent" {"}"},
            ];
        {"}"}
        """;

    private const string LanesCode = """
        <VeloTimeline Title="Plan de production" Start="today" End="today.AddDays(1)" SlotDuration="TimeSpan.FromHours(1)"
                      Items="plan" Statuses="statuses" LaneHeader="Unité"
                      Editable SnapTo="TimeSpan.FromMinutes(30)" CanEdit="@(i => i.Status != "ack")" OnItemChanged="Change">
            <ItemTemplate>@context.Label</ItemTemplate>
        </VeloTimeline>

        // new VeloTimelineItem("u1", from, to, "Base 120 MW") { Lane = "Centrale A", Status = "ack" }

        private void Change(VeloTimelineChange change) =>
            plan = plan.Select(i => i.Id == change.Item.Id ? change.Applied : i).ToList();   // ou votre API
        """;

    private static readonly ApiRow[] Api =
    [
        new("Start / End / SlotDuration", "DateTime / DateTime / TimeSpan", null, "Fenêtre affichée et largeur d'un créneau (15 min)."),
        new("Items", "IEnumerable<VeloTimelineItem>", null, "Les éléments à placer."),
        new("Statuses", "IReadOnlyList<VeloTimelineStatus>", null, "Légende + rendu (Filled, Outline, Dashed) et couleur par statut."),
        new("Layout", "VeloTimelineLayout", null, "Packed (partage des lignes) ou Staircase (une ligne par élément)."),
        new("ItemTemplate / OnItemClick", "RenderFragment<VeloTimelineItem> / EventCallback", null, "Contenu libre d'un élément ; clic."),
        new("ShowNow / NowRefresh", "bool / TimeSpan", "--velo-timeline-now", "Ligne « maintenant » + badge, mise à jour en temps réel (30 s)."),
        new("NowColor", "string", "--velo-timeline-now", "Couleur de la ligne et du badge."),
        new("ShadePast", "bool", null, "Grise la partie déjà passée (true)."),
        new("Collapsible / Collapsed", "bool", null, "Bouton de repli ; @bind-Collapsed."),
        new("SlotMinWidth", "string", null, "Largeur minimale d'un créneau ; en dessous, défilement horizontal."),
        new("RowHeight / LaneWidth / LaneHeader", "int / string / string", "--velo-timeline-row-h, --velo-timeline-lane-w", "Hauteur des lignes, colonne des libellés."),
        new("SlotLabel", "Func<DateTime, DateTime, string>", null, "Libellé d'un créneau (« 11:00 – 11:15 » par défaut)."),
        new("HeaderContent", "RenderFragment", null, "Contenu à côté du titre (filtres, boutons)."),
        new("—", "", "--velo-timeline-bg", "Fond."),
    ];

    private static readonly ApiRow[] ItemApi =
    [
        new("VeloTimelineItem(Id, Start, End, Label)", "record", null, "Un élément ; Id sert de clé de rendu."),
        new("Status / Lane / Color / Data", "string / string / string / object", null, "Statut (clé), ligne, couleur forcée, votre objet."),
        new("VeloTimelineStatus(Key, Label, Color, Appearance)", "record", null, "Appearance : Filled (confirmé), Outline (envoyé), Dashed (brouillon)."),
    ];
}
