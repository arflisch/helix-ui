@page "/components/tabs"
@using static Velo.Demo.Components.Shared.Snippet

<DemoPage Title="Tabs" Description="Onglets en trois styles. Déclarez des VeloTab enfants : c'est tout.">
    <Playground Code="@Code" StageStyle="align-items:start">
        <Preview>
            <div style="width:100%;max-width:520px">
                <VeloTabs Variant="_variant" Color="@_color" @bind-ActiveIndex="_active">
                    <VeloTab Title="Compte" Icon="@(_icons ? "user" : null)">
                        <p class="muted" style="margin:0">Gérez votre nom, votre email et votre photo de profil.</p>
                    </VeloTab>
                    <VeloTab Title="Notifications" Icon="@(_icons ? "bell" : null)">
                        <div class="stack">
                            <VeloSwitch @bind-Checked="_n1" Label="Emails" />
                            <VeloSwitch @bind-Checked="_n2" Label="Push" />
                        </div>
                    </VeloTab>
                    <VeloTab Title="Sécurité" Icon="@(_icons ? "lock" : null)">
                        <p class="muted" style="margin:0">Mot de passe et authentification à deux facteurs.</p>
                    </VeloTab>
                    <VeloTab Title="Facturation" Disabled="true" />
                </VeloTabs>
            </div>
        </Preview>
        <Controls>
            <Choice TEnum="VeloTabsVariant" Label="Variant" @bind-Value="_variant" />
            <ColorPicker Label="Color" @bind-Value="_color" />
            <VeloSwitch Label="Icônes" @bind-Checked="_icons" Size="VeloSize.Sm" />
        </Controls>
    </Playground>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private VeloTabsVariant _variant;
    private string? _color;
    private bool _icons = true, _n1 = true, _n2;
    private int _active;

    private string Code
    {
        get
        {
            string Icon(string name) => _icons ? $" Icon=\"{name}\"" : "";
            return $"""
                <VeloTabs{A("Variant", _variant, VeloTabsVariant.Underline)}{A("Color", _color)} @bind-ActiveIndex="active">
                    <VeloTab Title="Compte"{Icon("user")}>…</VeloTab>
                    <VeloTab Title="Notifications"{Icon("bell")}>…</VeloTab>
                    <VeloTab Title="Sécurité"{Icon("lock")}>…</VeloTab>
                    <VeloTab Title="Facturation" Disabled />
                </VeloTabs>
                """;
        }
    }

    private static readonly ApiRow[] Api =
    [
        new("Variant", "VeloTabsVariant", null, "Underline, Pills ou Segmented."),
        new("ActiveIndex", "int", null, "Onglet actif (@bind-ActiveIndex)."),
        new("Color", "string", "--velo-tabs-color", "Couleur de l'indicateur / de l'onglet actif."),
        new("VeloTab.Title / Icon / Disabled", "string / string / bool", null, "Définition d'un onglet ; son contenu est le ChildContent."),
    ];
}
