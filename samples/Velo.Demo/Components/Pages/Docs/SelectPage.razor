@page "/components/select"
@using static Velo.Demo.Components.Shared.Snippet

<DemoPage Title="Select" Description="Liste déroulante typée : passez n'importe quelle collection d'objets et choisissez comment les afficher. Navigation au clavier (flèches, Entrée, Échap).">
    <Playground Code="@Code" StageStyle="align-items:start;padding-top:56px">
        <Preview>
            <div style="width:100%;max-width:320px">
                <VeloSelect TValue="Country" Items="Countries" @bind-Value="_country" ItemText="c => c.Name" Label="@_label" Placeholder="Choisir un pays"
                            Color="@_color" Disabled="_disabled" Hint="@(_country is null ? null : $"Code : {_country.Code}")" />
            </div>
        </Preview>
        <Controls>
            <VeloTextField Label="Label" @bind-Value="_label" />
            <ColorPicker Label="Color" @bind-Value="_color" />
            <VeloSwitch Label="Disabled" @bind-Checked="_disabled" Size="VeloSize.Sm" />
        </Controls>
    </Playground>

    <Example Title="Avec des chaînes ou des enums" Code="@SimpleCode">
        <div class="grid-2">
            <VeloSelect Items="_sizes" @bind-Value="_size" Label="Taille" />
            <VeloSelect Items="Enum.GetValues<VeloSeverity>()" @bind-Value="_severity" Label="Sévérité" />
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    public sealed record Country(string Code, string Name);

    private static readonly Country[] Countries =
    [
        new("FR", "France"), new("BE", "Belgique"), new("CH", "Suisse"), new("CA", "Canada"),
        new("LU", "Luxembourg"), new("DE", "Allemagne"), new("ES", "Espagne"), new("IT", "Italie"),
    ];

    private readonly string[] _sizes = ["Petit", "Moyen", "Grand"];
    private Country? _country = Countries[0];
    private string? _size = "Moyen";
    private VeloSeverity _severity = VeloSeverity.Success;
    private string? _label = "Pays";
    private string? _color;
    private bool _disabled;

    private string Code => $"""
        <VeloSelect Items="countries" @bind-Value="country" ItemText="c => c.Name"{A("Label", _label)}{A("Color", _color)}{B("Disabled", _disabled)} />

        @code {"{"}
            private Country? country;
            private Country[] countries = [new("FR", "France"), new("BE", "Belgique")];
        {"}"}
        """;

    private const string SimpleCode = """
        <VeloSelect Items="sizes" @bind-Value="size" Label="Taille" />
        <VeloSelect Items="Enum.GetValues<VeloSeverity>()" @bind-Value="severity" Label="Sévérité" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Items", "IEnumerable<T>", null, "Les options, de n'importe quel type."),
        new("Value", "T?", null, "Option sélectionnée (@bind-Value)."),
        new("ItemText", "Func<T, string>", null, "Texte affiché pour une option (ToString par défaut)."),
        new("Label / Placeholder / Hint", "string", null, "Textes."),
        new("Color", "string", "--velo-input-color", "Couleur du focus et de l'option sélectionnée."),
        new("Radius", "string", "--velo-input-radius", "Arrondi."),
        new("—", "", "--velo-select-menu-bg", "Fond du menu déroulant."),
    ];
}
