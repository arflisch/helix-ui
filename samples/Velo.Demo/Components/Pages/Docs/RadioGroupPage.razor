@page "/components/radiogroup"
@using static Velo.Demo.Components.Shared.Snippet

<DemoPage Title="RadioGroup" Description="Un choix parmi quelques options, toutes visibles. Trois apparences : classique, cartes (avec description) ou segmentée. Vraies cases radio natives : les flèches du clavier fonctionnent.">
    <Playground Code="@Code">
        <Preview>
            <div style="width:100%;max-width:560px">
                <VeloRadioGroup TValue="Plan" Items="Plans" @bind-Value="_plan" ItemText="p => p.Name" ItemDescription="@(_descriptions ? p => p.Description : null)"
                                Label="Formule" Appearance="_appearance" Horizontal="_horizontal" Color="@_color" />
            </div>
        </Preview>
        <Controls>
            <Choice TEnum="VeloRadioAppearance" Label="Appearance" @bind-Value="_appearance" />
            <ColorPicker Label="Color" @bind-Value="_color" />
            <VeloSwitch Label="Horizontal" @bind-Checked="_horizontal" Size="VeloSize.Sm" />
            <VeloSwitch Label="ItemDescription" @bind-Checked="_descriptions" Size="VeloSize.Sm" />
        </Controls>
    </Playground>

    <ApiTable Title="VeloRadioGroup" Rows="Api" />
</DemoPage>

@code {
    public sealed record Plan(string Name, string Description);

    private static readonly Plan[] Plans =
    [
        new("Essentiel", "Jusqu'à 3 sites, données sur 30 jours"),
        new("Pro", "Sites illimités, alertes, export"),
        new("Entreprise", "SSO, SLA 99,9 %, support dédié"),
    ];

    private Plan? _plan = Plans[1];
    private VeloRadioAppearance _appearance = VeloRadioAppearance.Cards;
    private string? _color;
    private bool _horizontal, _descriptions = true;

    private string Code =>
        $"<VeloRadioGroup Items=\"plans\" @bind-Value=\"plan\" ItemText=\"p => p.Name\"{(_descriptions ? " ItemDescription=\"p => p.Description\"" : "")} Label=\"Formule\"{A("Appearance", _appearance, VeloRadioAppearance.Default)}{B("Horizontal", _horizontal)}{A("Color", _color)} />";

    private static readonly ApiRow[] Api =
    [
        new("Items / Value", "IEnumerable<T> / T?", null, "Les options et le choix (@bind-Value)."),
        new("ItemText / ItemDescription / ItemDisabled", "Func<T, …>", null, "Libellé, description, option désactivée."),
        new("ItemTemplate", "RenderFragment<T>", null, "Contenu libre d'une option."),
        new("Appearance", "VeloRadioAppearance", null, "Default, Cards ou Segmented."),
        new("Horizontal / Label / Hint", "bool / string / string", null, "Disposition, titre (legend), aide."),
        new("Color", "string", "--velo-radio-color", "Couleur du choix."),
    ];
}
