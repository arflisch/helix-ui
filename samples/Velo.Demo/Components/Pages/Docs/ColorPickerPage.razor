@page "/components/colorpicker"

<DemoPage Title="ColorPicker" Description="Sélecteur de couleur complet : zone saturation / luminosité (souris, tactile, flèches), teinte, opacité, saisie hexadécimale, couleurs proposées et pipette pour prendre une couleur à l'écran (Chrome, Edge).">
    <Example WpfCode="@Wpf1" Title="Exemples" Code="@Code">
        <div class="grid-3">
            <VeloColorPicker Label="Couleur de marque" @bind-Value="_brand" Hint="Utilisée pour les boutons." />
            <VeloColorPicker Label="Fond avec transparence" @bind-Value="_overlay" ShowAlpha="true" />
            <VeloColorPicker Label="Palette imposée" @bind-Value="_series" Swatches="@(["#2a78d6", "#eb6834", "#1baf7a", "#eda100", "#e87ba4", "#6250d6"])" />
        </div>
        <div class="row" style="margin-top:20px">
            <VeloButton Color="@_brand">Bouton de marque</VeloButton>
            <span style="display:inline-block;width:120px;height:36px;border-radius:8px;background:@_overlay;box-shadow:inset 0 0 0 1px rgb(0 0 0 / .1)"></span>
            <VeloBadge Color="@_series" Variant="VeloBadgeVariant.Solid">Série</VeloBadge>
        </div>
    </Example>

    <ApiTable Title="VeloColorPicker" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <velo:VeloColorPicker Label="Couleur de marque" SelectedColor="{Binding BrandColor}" />
        <velo:VeloColorPicker Label="Avec opacité" ShowAlpha="True" Hint="Format #RRGGBBAA" />

        // SelectedColor est un Color? (deux sens). Swatches remplace les couleurs proposées :
        Picker.Swatches = [Colors.OrangeRed, Colors.SeaGreen, Colors.SteelBlue];
        """;

    private string? _brand = "#4f46e5";
    private string? _overlay = "#0ea5e980";
    private string? _series = "#1baf7a";

    private const string Code = """
        <VeloColorPicker Label="Couleur de marque" @bind-Value="brand" />
        <VeloColorPicker Label="Fond" @bind-Value="overlay" ShowAlpha />
        <VeloColorPicker Label="Palette imposée" @bind-Value="color" Swatches="brandColors" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Value", "string?", null, "« #rrggbb », ou « #rrggbbaa » avec ShowAlpha sous 100 %."),
        new("ShowAlpha", "bool", null, "Curseur d'opacité."),
        new("Swatches", "IReadOnlyList<string>", null, "Couleurs proposées (votre charte)."),
        new("Label / Hint / Placeholder / Disabled", "string / bool", null, "Textes, désactivé."),
        new("Clavier", "", null, "Zone : flèches (Maj = pas plus grand) ; curseurs natifs ; saisie hexadécimale."),
    ];
}
