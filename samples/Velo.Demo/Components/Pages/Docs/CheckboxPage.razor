@page "/components/checkbox"
@using static Velo.Demo.Components.Shared.Snippet

<DemoPage Title="Checkbox" Description="Case à cocher animée et accessible (vraie input native). La couleur de la case et celle de la coche sont des paramètres.">
    <Playground Code="@Code">
        <Preview>
            <VeloCheckbox @bind-Checked="_checked" Label="@_label" Color="@_color" CheckColor="@_checkColor" Radius="@Radius" Disabled="_disabled" />
        </Preview>
        <Controls>
            <VeloTextField Label="Label" @bind-Value="_label" />
            <ColorPicker Label="Color (case)" @bind-Value="_color" />
            <ColorPicker Label="CheckColor (coche)" @bind-Value="_checkColor" Colors="@(["#ffffff", "#18181b", "#fde047", "#a7f3d0"])" />
            <VeloSlider Label="Radius" @bind-Value="_radius" Min="0" Max="10" Format="@(v => $"{v} px")" />
            <VeloSwitch Label="Checked" @bind-Checked="_checked" Size="VeloSize.Sm" />
            <VeloSwitch Label="Disabled" @bind-Checked="_disabled" Size="VeloSize.Sm" />
        </Controls>
    </Playground>

    <Example Title="Liste d'options" Code="@ListCode">
        <div class="stack">
            @foreach (var option in _options)
            {
                <VeloCheckbox @bind-Checked="option.Selected" Label="@option.Name" />
            }
            <p class="muted" style="margin:0;font-size:13px">Sélection : @string.Join(", ", _options.Where(o => o.Selected).Select(o => o.Name))</p>
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private sealed class Option(string name, bool selected)
    {
        public string Name { get; } = name;
        public bool Selected { get; set; } = selected;
    }

    private readonly List<Option> _options = [new("Email", true), new("SMS", false), new("Push", true)];
    private bool _checked = true, _disabled;
    private string? _label = "Se souvenir de moi";
    private string? _color, _checkColor;
    private double _radius = 5;

    private string? Radius => _radius == 5 ? null : $"{N(_radius)}px";

    private string Code =>
        $"<VeloCheckbox @bind-Checked=\"remember\"{A("Label", _label)}{A("Color", _color)}{A("CheckColor", _checkColor)}{A("Radius", Radius)}{B("Disabled", _disabled)} />";

    private const string ListCode = """
        @foreach (var option in options)
        {
            <VeloCheckbox @bind-Checked="option.Selected" Label="@option.Name" />
        }
        """;

    private static readonly ApiRow[] Api =
    [
        new("Checked", "bool", null, "État (@bind-Checked)."),
        new("Label / ChildContent", "string / RenderFragment", null, "Libellé texte ou riche."),
        new("Color", "string", "--velo-check-color", "Couleur de la case cochée."),
        new("CheckColor", "string", "--velo-check-mark", "Couleur de la coche."),
        new("Radius", "string", "--velo-check-radius", "Arrondi de la case."),
        new("—", "", "--velo-check-border", "Bordure au repos."),
    ];
}
