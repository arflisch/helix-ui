@page "/components/datepicker"
@using System.Globalization

<DemoPage Title="DatePicker" Description="Sélecteur de date avec calendrier : semaine qui commence selon la culture (lundi en français), dates interdites, bornes. Au clavier : flèches pour les jours, Page ↑/↓ pour les mois (Maj : années), Début/Fin pour la semaine, Entrée pour choisir.">
    <Example WpfCode="@Wpf1" Title="Exemples" Code="@Code">
        <div class="grid-3">
            <VeloDatePicker Label="Date de livraison" @bind-Value="_delivery" Culture="French" Hint="@($"Choisie : {_delivery?.ToString("dddd d MMMM", French) ?? "aucune"}")" />
            <VeloDatePicker Label="Jour ouvré (14 jours)" @bind-Value="_workday" Culture="French"
                            Min="Today" Max="Today.AddDays(14)" IsDateDisabled="d => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday" />
            <VeloDatePicker Label="Format court" @bind-Value="_short" Format="dd/MM/yyyy" Culture="French" Clearable="false" />
        </div>
    </Example>

    <ApiTable Title="VeloDatePicker" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <velo:VeloDatePicker Label="Date de début" SelectedDate="{Binding Start}" Hint="Format jj/mm/aaaa"
                             DisplayDateStart="{Binding Today}" IsRequired="True" />
        <velo:VeloDatePicker Label="Échéance" Error="{Binding DueDateError}" Accent="#FF8A00" />
        """;

    private static readonly CultureInfo French = CultureInfo.GetCultureInfo("fr-FR");
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private DateOnly? _delivery = DateOnly.FromDateTime(DateTime.Today.AddDays(3));
    private DateOnly? _workday;
    private DateOnly? _short = DateOnly.FromDateTime(DateTime.Today);

    private const string Code = """
        <VeloDatePicker Label="Jour ouvré" @bind-Value="date" Min="today" Max="today.AddDays(14)"
                        IsDateDisabled="d => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Value", "DateOnly?", null, "Date choisie (@bind-Value)."),
        new("Min / Max / IsDateDisabled", "DateOnly? / DateOnly? / Func<DateOnly, bool>", null, "Dates autorisées (les autres sont barrées)."),
        new("Format", "string", null, "Affichage, « d MMMM yyyy » par défaut."),
        new("Culture", "CultureInfo", null, "Noms des mois et jours, premier jour de la semaine."),
        new("Clearable / Label / Hint / Error", "bool / string", null, "Bouton d'effacement, textes."),
        new("TimeProvider", "TimeProvider", null, "Horloge pour « Aujourd'hui » (tests)."),
        new("Prefix / Suffix", "RenderFragment", null, "Contenu au début / à la fin du champ (icône, signe, unité…). Même slots sur tous les champs."),
        new("Hint / Error", "string", null, "Aide sous le champ, ou erreur qui la remplace ; reliées au champ pour les lecteurs d'écran (aria-describedby)."),
        new("Required", "bool", null, "Astérisque après le libellé et attribut required."),
        new("Color / Radius / Background / BorderColor", "string", "--velo-input-*", "Même apparence sur tous les champs ; valeurs par défaut via Defaults.Field."),
    ];
}
