@page "/components/numberfield"

<DemoPage Title="NumberField" Description="Saisie d'un nombre avec boutons − / +, bornes, pas, arrondi et unité. Les valeurs hors bornes sont ramenées automatiquement ; les flèches du clavier incrémentent.">
    <Example Title="Exemples" Code="@Code">
        <div class="grid-3">
            <VeloNumberField Label="Puissance demandée" @bind-Value="_power" Min="0" Max="250" Step="5" Unit="MW" Hint="Entre 0 et 250 MW, par pas de 5" />
            <VeloNumberField Label="Prix plafond" @bind-Value="_price" Min="0" Step="0.5" Decimals="2" Unit="€/MWh" />
            <VeloNumberField Label="Quantité" @bind-Value="_qty" Min="1" Max="10" Decimals="0"
                             Error="@(_qty is null ? "Obligatoire" : null)" />
        </div>
        <p class="muted" style="margin:14px 0 0;font-size:13px">Valeurs : @_power MW · @_price €/MWh · @(_qty?.ToString() ?? "—")</p>
    </Example>

    <ApiTable Title="VeloNumberField" Rows="Api" />
</DemoPage>

@code {
    private double? _power = 120, _price = 92.5, _qty = 3;

    private const string Code = """
        <VeloNumberField Label="Puissance demandée" @bind-Value="power" Min="0" Max="250" Step="5" Unit="MW" />
        <VeloNumberField Label="Prix plafond" @bind-Value="price" Step="0.5" Decimals="2" Unit="€/MWh" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Value", "double?", null, "Valeur (@bind-Value) ; vide = null."),
        new("Min / Max / Step", "double? / double? / double", null, "Bornes (appliquées automatiquement) et pas des boutons."),
        new("Decimals", "int?", null, "Arrondi, ex. 0 pour des entiers."),
        new("Unit / Label / Hint / Error", "string", null, "Unité affichée, libellé, aide, erreur."),
        new("ShowSteppers", "bool", null, "Boutons − / + (true)."),
        new("Prefix / Suffix", "RenderFragment", null, "Contenu au début / à la fin du champ (icône, signe, unité…). Même slots sur tous les champs."),
        new("Hint / Error", "string", null, "Aide sous le champ, ou erreur qui la remplace ; reliées au champ pour les lecteurs d'écran (aria-describedby)."),
        new("Required", "bool", null, "Astérisque après le libellé et attribut required."),
        new("Color / Radius / Background / BorderColor", "string", "--velo-input-*", "Même apparence sur tous les champs ; valeurs par défaut via Defaults.Field."),
    ];
}
