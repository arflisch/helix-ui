@page "/components/textfield"
@using static Velo.Demo.Components.Shared.Snippet

<DemoPage Title="TextField" Description="Champ de saisie avec label, aide, message d'erreur, icône, préfixe/suffixe et bouton d'effacement.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <div style="width:100%;max-width:340px">
                <VeloTextField @bind-Value="_value" Label="@_label" Placeholder="@_placeholder" Hint="@_hint"
                               Error="@(_error ? "Ce champ est obligatoire" : null)" Icon="@(_icon ? "mail" : null)"
                               Clearable="_clearable" Disabled="_disabled" Required="_required" Color="@_color" Radius="@Radius" />
            </div>
        </Preview>
        <Controls>
            <VeloTextField Label="Label" @bind-Value="_label" />
            <VeloTextField Label="Placeholder" @bind-Value="_placeholder" />
            <VeloTextField Label="Hint" @bind-Value="_hint" />
            <ColorPicker Label="Color (focus)" @bind-Value="_color" />
            <VeloSlider Label="Radius" @bind-Value="_radius" Min="0" Max="20" Format="@(v => $"{v} px")" />
            <VeloSwitch Label="Icône" @bind-Checked="_icon" Size="VeloSize.Sm" />
            <VeloSwitch Label="Clearable" @bind-Checked="_clearable" Size="VeloSize.Sm" />
            <VeloSwitch Label="Required" @bind-Checked="_required" Size="VeloSize.Sm" />
            <VeloSwitch Label="Erreur" @bind-Checked="_error" Size="VeloSize.Sm" />
            <VeloSwitch Label="Disabled" @bind-Checked="_disabled" Size="VeloSize.Sm" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Préfixe, suffixe et types" Code="@AffixCode">
        <div class="grid-3">
            <VeloTextField Label="Recherche" Icon="search" Placeholder="Rechercher…" Clearable="true" @bind-Value="_search" />
            <VeloTextField Label="Mot de passe" Icon="lock" Type="password" Value="secret123" />
            <VeloTextField Label="Prix" Type="number" Value="49">
                <Suffix><span class="muted">EUR</span></Suffix>
            </VeloTextField>
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <velo:VeloTextField Label="E-mail" Icon="mail" Placeholder="prenom@exemple.fr"
                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                            Hint="Nous n'envoyons jamais de publicité." Error="{Binding EmailError}"
                            IsRequired="True" IsClearable="True" Accent="#0EA5E9" CornerRadius="10" />
        """;

    private const string Wpf2 = """
        <velo:VeloTextField Label="Montant">
            <velo:VeloTextField.Suffix>
                <TextBlock Text="EUR" FontWeight="SemiBold" />
            </velo:VeloTextField.Suffix>
        </velo:VeloTextField>
        <velo:VeloTextField Label="Site web">
            <velo:VeloTextField.Prefix>
                <TextBlock Text="https://" Foreground="{DynamicResource Velo.TextSubtle}" />
            </velo:VeloTextField.Prefix>
        </velo:VeloTextField>
        <!-- Mot de passe : PasswordBox dans un VeloField pour garder le même libellé et la même aide -->
        """;

    private string? _value;
    private string? _search;
    private string? _label = "Email";
    private string? _placeholder = "vous@exemple.fr";
    private string? _hint = "Nous ne partagerons jamais votre email.";
    private string? _color;
    private double _radius = 10;
    private bool _icon = true, _clearable = true, _required, _error, _disabled;

    private string? Radius => _radius == 10 ? null : $"{N(_radius)}px";

    private string Code =>
        $"<VeloTextField @bind-Value=\"email\"{A("Label", _label)}{A("Placeholder", _placeholder)}{A("Hint", _hint)}{A("Icon", _icon ? "mail" : null)}{A("Error", _error ? "Ce champ est obligatoire" : null)}{A("Color", _color)}{A("Radius", Radius)}{B("Clearable", _clearable)}{B("Required", _required)}{B("Disabled", _disabled)} />";

    private const string AffixCode = """
        <VeloTextField Label="Recherche" Icon="search" Placeholder="Rechercher…" Clearable @bind-Value="search" />
        <VeloTextField Label="Mot de passe" Icon="lock" Type="password" @bind-Value="password" />
        <VeloTextField Label="Prix" Type="number" @bind-Value="price">
            <Suffix><span>EUR</span></Suffix>
        </VeloTextField>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Value", "string?", null, "Valeur, à utiliser avec @bind-Value (mise à jour à chaque frappe)."),
        new("Label / Placeholder / Hint", "string", null, "Textes du champ."),
        new("Icon", "string", null, "Icône au début du champ."),
        new("Prefix / Suffix", "RenderFragment", null, "Contenu libre avant / après la saisie."),
        new("Clearable", "bool", null, "Bouton pour vider le champ."),
        new("Prefix / Suffix", "RenderFragment", null, "Contenu au début / à la fin du champ (icône, signe, unité…). Même slots sur tous les champs."),
        new("Hint / Error", "string", null, "Aide sous le champ, ou erreur qui la remplace ; reliées au champ pour les lecteurs d'écran (aria-describedby)."),
        new("Required", "bool", null, "Astérisque après le libellé et attribut required."),
        new("Color / Radius / Background / BorderColor", "string", "--velo-input-*", "Même apparence sur tous les champs ; valeurs par défaut via Defaults.Field."),
    ];
}
