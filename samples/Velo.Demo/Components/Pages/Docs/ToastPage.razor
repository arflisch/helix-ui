@page "/components/toast"
@inject VeloToastService Toasts

<DemoPage Title="Toast" Description="Notifications éphémères. Injectez VeloToastService n'importe où (composant ou service) et appelez une méthode. VeloProvider les affiche.">
    <Playground Code="@Code">
        <Preview>
            <div class="row">
                <VeloButton Color="@Color" OnClick="Show">Afficher le toast</VeloButton>
            </div>
        </Preview>
        <Controls>
            <Choice TEnum="VeloSeverity" Label="Severity" @bind-Value="_severity" />
            <VeloTextField Label="Title" @bind-Value="_title" />
            <VeloTextField Label="Message" @bind-Value="_message" />
            <VeloSlider Label="Durée" @bind-Value="_seconds" Min="0" Max="10" Format="@(v => v == 0 ? "permanent" : $"{v} s")" />
        </Controls>
    </Playground>

    <Example Title="Raccourcis" Code="@ShortcutsCode">
        <div class="row">
            <VeloButton Variant="VeloVariant.Soft" Color="info" OnClick="@(() => Toasts.Info("3 nouveaux messages"))">Info</VeloButton>
            <VeloButton Variant="VeloVariant.Soft" Color="success" OnClick="@(() => Toasts.Success("Modifications enregistrées", "Enregistré"))">Success</VeloButton>
            <VeloButton Variant="VeloVariant.Soft" Color="warning" OnClick="@(() => Toasts.Warning("Votre session expire dans 5 minutes"))">Warning</VeloButton>
            <VeloButton Variant="VeloVariant.Soft" Color="danger" OnClick="@(() => Toasts.Error("Impossible de joindre le serveur", "Erreur"))">Error</VeloButton>
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private VeloSeverity _severity = VeloSeverity.Success;
    private string? _title = "Projet publié";
    private string? _message = "Votre projet est en ligne.";
    private double _seconds = 4;

    private string Color => _severity switch
    {
        VeloSeverity.Success => "success",
        VeloSeverity.Warning => "warning",
        VeloSeverity.Danger => "danger",
        _ => "info",
    };

    private void Show() =>
        Toasts.Show(_message ?? "", _severity, _title, TimeSpan.FromSeconds(_seconds));

    private string Code
    {
        get
        {
            var title = string.IsNullOrEmpty(_title) ? "" : $", title: \"{_title}\"";
            var duration = _seconds == 4 ? "" : $", duration: TimeSpan.FromSeconds({_seconds})";
            return $"@inject VeloToastService Toasts\n\nToasts.Show(\"{_message}\", VeloSeverity.{_severity}{title}{duration});";
        }
    }

    private const string ShortcutsCode = """
        Toasts.Info("3 nouveaux messages");
        Toasts.Success("Modifications enregistrées", "Enregistré");
        Toasts.Warning("Votre session expire dans 5 minutes");
        Toasts.Error("Impossible de joindre le serveur", "Erreur");

        // Position : <VeloProvider ToastPosition="VeloToastPosition.TopCenter">
        """;

    private static readonly ApiRow[] Api =
    [
        new("Show(message, severity, title, duration)", "Guid", null, "Affiche un toast. TimeSpan.Zero = jusqu'à fermeture."),
        new("Info / Success / Warning / Error", "Guid", null, "Raccourcis."),
        new("Dismiss(id)", "void", null, "Ferme un toast."),
        new("DefaultDuration", "TimeSpan", null, "4 s par défaut, réglable via AddVelo(t => ...)."),
        new("VeloProvider.ToastPosition", "VeloToastPosition", null, "Coin de l'écran."),
        new("—", "", "--velo-toast-bg", "Fond du toast."),
    ];
}
