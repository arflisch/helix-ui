@page "/components/menu"
@inject VeloToastService Toasts

<DemoPage Title="Menu" Description="Menu déroulant d'actions : icônes, raccourcis, éléments cochables, séparateurs, actions dangereuses. Au clavier : flèches pour naviguer, Entrée pour choisir, Échap pour fermer (le focus revient sur le bouton).">
    <Example Title="Menu d'actions" Code="@ActionsCode">
        <div class="row" style="gap:16px">
            <VeloMenu>
                <Trigger><VeloButton Variant="VeloVariant.Outline" Color="neutral" IconEnd="chevron-down">Actions</VeloButton></Trigger>
                <ChildContent>
                    <VeloMenuItem Icon="copy" Shortcut="⌘D" OnClick="@(() => Say("Dupliqué"))">Dupliquer</VeloMenuItem>
                    <VeloMenuItem Icon="download" Shortcut="⌘E" OnClick="@(() => Say("Exporté"))">Exporter en CSV</VeloMenuItem>
                    <VeloMenuItem Icon="external" Description="Visible par toute l'équipe" OnClick="@(() => Say("Lien copié"))">Partager</VeloMenuItem>
                    <VeloMenuSeparator />
                    <VeloMenuItem Icon="lock" Disabled="true">Verrouiller (admin)</VeloMenuItem>
                    <VeloMenuItem Icon="trash" Danger="true" OnClick="@(() => Say("Supprimé"))">Supprimer</VeloMenuItem>
                </ChildContent>
            </VeloMenu>

            <VeloMenu Align="VeloAlign.End" MinWidth="200px">
                <Trigger><VeloButton Variant="VeloVariant.Ghost" Color="neutral" Icon="settings" aria-label="Affichage" /></Trigger>
                <ChildContent>
                    <VeloMenuLabel>Affichage</VeloMenuLabel>
                    <VeloMenuItem Checked="_compact" OnClick="() => _compact = !_compact">Mode compact</VeloMenuItem>
                    <VeloMenuItem Checked="_grid" OnClick="() => _grid = !_grid">Afficher la grille</VeloMenuItem>
                </ChildContent>
            </VeloMenu>
            <span class="muted" style="font-size:13px">Compact : @(_compact ? "oui" : "non") · Grille : @(_grid ? "oui" : "non")</span>
        </div>
    </Example>

    <ApiTable Title="VeloMenu et VeloMenuItem" Rows="Api" />
</DemoPage>

@code {
    private bool _compact, _grid = true;

    private void Say(string text) => Toasts.Show(text, VeloSeverity.Success, duration: TimeSpan.FromSeconds(2));

    private const string ActionsCode = """
        <VeloMenu>
            <Trigger><VeloButton Variant="VeloVariant.Outline" IconEnd="chevron-down">Actions</VeloButton></Trigger>
            <ChildContent>
                <VeloMenuItem Icon="copy" Shortcut="⌘D" OnClick="Duplicate">Dupliquer</VeloMenuItem>
                <VeloMenuItem Icon="external" Description="Visible par toute l'équipe">Partager</VeloMenuItem>
                <VeloMenuSeparator />
                <VeloMenuItem Icon="trash" Danger OnClick="Delete">Supprimer</VeloMenuItem>
            </ChildContent>
        </VeloMenu>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Trigger", "RenderFragment", null, "Ce qui ouvre le menu (souvent un VeloButton)."),
        new("Align / MinWidth", "VeloAlign / string", null, "Aligné sur le bord gauche (Start) ou droit (End) du bouton ; largeur minimale."),
        new("VeloMenuItem Icon / Shortcut / Description", "string", null, "Icône, raccourci affiché, seconde ligne."),
        new("VeloMenuItem Danger / Disabled / Checked", "bool", null, "Action dangereuse (rouge), désactivée, cochée."),
        new("VeloMenuItem OnClick / Href", "EventCallback / string", null, "Action ou lien ; le menu se ferme ensuite."),
        new("VeloMenuSeparator / VeloMenuLabel", "", null, "Séparateur ; titre de groupe."),
    ];
}
