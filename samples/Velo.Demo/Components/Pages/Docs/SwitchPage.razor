@page "/components/switch"
@using static Velo.Demo.Components.Shared.Snippet

<DemoPage Title="Switch" Description="L'interrupteur. Chaque partie a son paramètre : la piste allumée, la piste éteinte, la pastille, la pastille allumée et l'arrondi. Aucun template à copier.">
    <Playground Code="@Code">
        <Preview>
            <VeloSwitch @bind-Checked="_checked" Label="@_label" Size="_size" Color="@_color" TrackColor="@_track"
                        ThumbColor="@_thumb" ThumbOnColor="@_thumbOn" Radius="@Radius" Disabled="_disabled" />
        </Preview>
        <Controls>
            <VeloTextField Label="Label" @bind-Value="_label" />
            <Choice TEnum="VeloSize" Label="Size" @bind-Value="_size" />
            <ColorPicker Label="Color (piste allumée)" @bind-Value="_color" />
            <ColorPicker Label="TrackColor (piste éteinte)" @bind-Value="_track" Colors="@(["#d4d4d8", "#fecaca", "#bfdbfe", "#18181b"])" />
            <ColorPicker Label="ThumbColor (pastille)" @bind-Value="_thumb" Colors="@(["#ffffff", "#f59e0b", "#18181b", "#e11d48", "#a7f3d0"])" />
            <ColorPicker Label="ThumbOnColor (pastille allumée)" @bind-Value="_thumbOn" Colors="@(["#ffffff", "#fef3c7", "#18181b", "#dcfce7"])" />
            <VeloSlider Label="Radius" @bind-Value="_radius" Min="0" Max="12" Format="@(v => v >= 12 ? "rond" : $"{v} px")" />
            <VeloSwitch Label="Checked" @bind-Checked="_checked" Size="VeloSize.Sm" />
            <VeloSwitch Label="Disabled" @bind-Checked="_disabled" Size="VeloSize.Sm" />
        </Controls>
    </Playground>

    <Example Title="Changer la couleur de la pastille" Description="Le cas qui demande un template complet ailleurs : ici c'est un paramètre." Code="@ThumbCode">
        <div class="row" style="gap:28px">
            <VeloSwitch @bind-Checked="_demo" ThumbColor="#f59e0b" Label="Ambre" />
            <VeloSwitch @bind-Checked="_demo" ThumbColor="#18181b" TrackColor="#e4e4e7" Color="#a3e635" Label="Lime" />
            <VeloSwitch @bind-Checked="_demo" Color="danger" ThumbOnColor="#ffe4e6" Label="Danger" />
        </div>
    </Example>

    <Example Title="Tailles" Code="@SizesCode">
        <div class="row" style="gap:28px">
            <VeloSwitch @bind-Checked="_demo" Size="VeloSize.Sm" Label="Sm" />
            <VeloSwitch @bind-Checked="_demo" Label="Md" />
            <VeloSwitch @bind-Checked="_demo" Size="VeloSize.Lg" Label="Lg" />
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private bool _checked = true, _disabled, _demo = true;
    private string? _label = "Mode avion";
    private VeloSize _size = VeloSize.Md;
    private string? _color, _track, _thumb, _thumbOn;
    private double _radius = 12;

    private string? Radius => _radius >= 12 ? null : $"{N(_radius)}px";

    private string Code =>
        $"<VeloSwitch @bind-Checked=\"isOn\"{A("Label", _label)}{A("Size", _size, VeloSize.Md)}{A("Color", _color)}{A("TrackColor", _track)}{A("ThumbColor", _thumb)}{A("ThumbOnColor", _thumbOn)}{A("Radius", Radius)}{B("Disabled", _disabled)} />";

    private const string ThumbCode = """
        <VeloSwitch @bind-Checked="on" ThumbColor="#f59e0b" Label="Ambre" />
        <VeloSwitch @bind-Checked="on" ThumbColor="#18181b" TrackColor="#e4e4e7" Color="#a3e635" Label="Lime" />
        <VeloSwitch @bind-Checked="on" Color="danger" ThumbOnColor="#ffe4e6" Label="Danger" />
        """;

    private const string SizesCode = """
        <VeloSwitch @bind-Checked="on" Size="VeloSize.Sm" Label="Sm" />
        <VeloSwitch @bind-Checked="on" Label="Md" />
        <VeloSwitch @bind-Checked="on" Size="VeloSize.Lg" Label="Lg" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Checked", "bool", null, "État (@bind-Checked)."),
        new("Color", "string", "--velo-switch-color", "Piste quand allumé. Nom sémantique ou couleur CSS."),
        new("TrackColor", "string", "--velo-switch-track", "Piste quand éteint."),
        new("ThumbColor", "string", "--velo-switch-thumb", "Pastille."),
        new("ThumbOnColor", "string", "--velo-switch-thumb-on", "Pastille quand allumé (ThumbColor par défaut)."),
        new("Radius", "string", "--velo-switch-radius", "Arrondi de la piste et de la pastille."),
        new("Size", "VeloSize", null, "Sm, Md ou Lg."),
    ];
}
