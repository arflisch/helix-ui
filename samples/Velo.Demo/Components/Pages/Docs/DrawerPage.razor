@page "/components/drawer"
@inject VeloToastService Toasts

<DemoPage Title="Drawer" Description="Panneau latéral pour un détail ou un formulaire sans quitter la page. À droite, à gauche ou en bas ; Échap ou clic sur le fond pour fermer.">
    <Example WpfCode="@Wpf1" Title="Positions" Code="@Code">
        <div class="row">
            <VeloButton OnClick="() => Open(VeloDrawerPosition.Right)">Ouvrir à droite</VeloButton>
            <VeloButton Variant="VeloVariant.Outline" Color="neutral" OnClick="() => Open(VeloDrawerPosition.Left)">À gauche</VeloButton>
            <VeloButton Variant="VeloVariant.Outline" Color="neutral" OnClick="() => Open(VeloDrawerPosition.Bottom)">En bas</VeloButton>
        </div>
    </Example>

    <ApiTable Title="VeloDrawer" Rows="Api" />
</DemoPage>

<VeloDrawer @bind-Open="_open" Position="_position" Title="Nouvelle demande" Description="Elle sera envoyée au gestionnaire de réseau."
            Size="@(_position == VeloDrawerPosition.Bottom ? "auto" : "440px")">
    <ChildContent>
        <div class="stack">
            <VeloDatePicker Label="Date" @bind-Value="_date" />
            <VeloNumberField Label="Puissance" @bind-Value="_power" Min="0" Max="250" Step="5" Unit="MW" />
            <VeloRadioGroup TValue="string" Items="Kinds" @bind-Value="_kind" Label="Type" Appearance="VeloRadioAppearance.Segmented" />
        </div>
    </ChildContent>
    <Footer>
        <VeloButton Variant="VeloVariant.Ghost" Color="neutral" OnClick="() => _open = false">Annuler</VeloButton>
        <VeloButton OnClick="Send">Envoyer</VeloButton>
    </Footer>
</VeloDrawer>

@code {
    private const string Wpf1 = """
        <velo:VeloDrawer IsOpen="{Binding FiltersOpen}" Title="Filtres" Position="Right" DrawerSize="420">
            <StackPanel>
                <velo:VeloSelect Label="Région" ItemsSource="{Binding Regions}" />
                <velo:VeloSwitch Content="Seulement les actifs" Margin="0,16,0,0" />
            </StackPanel>
            <velo:VeloDrawer.Footer>
                <velo:VeloButton Content="Appliquer" Command="{Binding ApplyCommand}" />
            </velo:VeloDrawer.Footer>
        </velo:VeloDrawer>
        <!-- Position : Right, Left ou Bottom (DrawerSize = largeur ou hauteur). Nécessite un VeloHost. -->
        """;

    private static readonly string[] Kinds = ["Directe", "Planifiée"];
    private bool _open;
    private VeloDrawerPosition _position;
    private DateOnly? _date = DateOnly.FromDateTime(DateTime.Today);
    private double? _power = 40;
    private string? _kind = "Planifiée";

    private void Open(VeloDrawerPosition position) => (_position, _open) = (position, true);

    private void Send()
    {
        _open = false;
        Toasts.Success($"{_kind} · {_power} MW · {_date:d}", "Demande envoyée");
    }

    private const string Code = """
        <VeloButton OnClick="() => open = true">Ouvrir</VeloButton>

        <VeloDrawer @bind-Open="open" Title="Nouvelle demande" Size="440px">
            <ChildContent>…formulaire…</ChildContent>
            <Footer><VeloButton OnClick="Send">Envoyer</VeloButton></Footer>
        </VeloDrawer>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Open", "bool", null, "Visibilité (@bind-Open)."),
        new("Position", "VeloDrawerPosition", null, "Right, Left ou Bottom."),
        new("Title / Description / Footer", "string / string / RenderFragment", null, "En-tête et pied."),
        new("Size", "string", "--velo-drawer-size", "Largeur (ou hauteur en bas), 420px par défaut."),
        new("CloseOnBackdrop", "bool", null, "Fermer au clic sur le fond (true)."),
    ];
}
