@page "/components/slider"
@using static Velo.Demo.Components.Shared.Snippet

<DemoPage Title="Slider" Description="Curseur basé sur l'input range native : léger, accessible au clavier, avec remplissage coloré et format d'affichage libre.">
    <Playground Code="@Code">
        <Preview>
            <div style="width:100%;max-width:360px">
                <VeloSlider @bind-Value="_value" Label="@_label" Max="_max" Step="_step" Color="@_color" ThumbColor="@_thumb"
                            Format="@(v => $"{v} {_unit}".Trim())" Disabled="_disabled" />
            </div>
        </Preview>
        <Controls>
            <VeloTextField Label="Label" @bind-Value="_label" />
            <VeloTextField Label="Unité" @bind-Value="_unit" />
            <Choice TEnum="StepChoice" Label="Step" Value="_stepChoice" ValueChanged="SetStep" />
            <ColorPicker Label="Color (remplissage)" @bind-Value="_color" />
            <ColorPicker Label="ThumbColor" @bind-Value="_thumb" Colors="@(["#ffffff", "#18181b", "#f59e0b"])" />
            <VeloSwitch Label="Disabled" @bind-Checked="_disabled" Size="VeloSize.Sm" />
        </Controls>
    </Playground>

    <Example Title="Couleurs" Code="@ColorsCode">
        <div class="grid-3">
            <VeloSlider Label="Basses" @bind-Value="_a" Color="success" />
            <VeloSlider Label="Médiums" @bind-Value="_b" Color="warning" />
            <VeloSlider Label="Aigus" @bind-Value="_c" Color="#ec4899" />
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private enum StepChoice { One, Five, Ten }

    private double _value = 40, _max = 100, _step = 1, _a = 70, _b = 45, _c = 25;
    private StepChoice _stepChoice;
    private string? _label = "Luminosité";
    private string? _unit = "%";
    private string? _color, _thumb;
    private bool _disabled;

    private void SetStep(StepChoice choice)
    {
        _stepChoice = choice;
        _step = choice switch { StepChoice.Five => 5, StepChoice.Ten => 10, _ => 1 };
    }

    private string Code =>
        $"<VeloSlider @bind-Value=\"brightness\"{A("Label", _label)}{(_step == 1 ? "" : $" Step=\"{N(_step)}\"")}{A("Color", _color)}{A("ThumbColor", _thumb)}{B("Disabled", _disabled)} Format=\"@(v => $\"{{v}} {_unit}\")\" />";

    private const string ColorsCode = """
        <VeloSlider Label="Basses" @bind-Value="bass" Color="success" />
        <VeloSlider Label="Médiums" @bind-Value="mid" Color="warning" />
        <VeloSlider Label="Aigus" @bind-Value="treble" Color="#ec4899" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Value", "double", null, "Valeur (@bind-Value)."),
        new("Min / Max / Step", "double", null, "Bornes et pas (0, 100, 1 par défaut)."),
        new("Format", "Func<double, string>", null, "Affichage de la valeur, ex. v => $\"{v} %\"."),
        new("ShowValue", "bool", null, "Affiche la valeur à droite du label (true)."),
        new("Color", "string", "--velo-slider-color", "Couleur du remplissage."),
        new("TrackColor", "string", "--velo-slider-track", "Partie non remplie."),
        new("ThumbColor", "string", "--velo-slider-thumb", "Pastille."),
        new("—", "", "--velo-slider-height", "Épaisseur de la piste."),
    ];
}
