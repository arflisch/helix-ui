@page "/components/accordion"

<DemoPage Title="Accordion" Description="Sections repliables pour une FAQ, des réglages avancés ou un détail optionnel. Animation de hauteur fluide ; le contenu fermé n'est pas atteignable au clavier.">
    <Example WpfCode="@Wpf1" Title="FAQ" Code="@Code">
        <div class="grid-2">
            <VeloAccordion>
                <VeloAccordionItem Title="Comment est calculé le déséquilibre ?" Icon="info" Expanded="true">
                    C'est l'écart entre la production et la consommation sur chaque quart d'heure, mesuré par le gestionnaire de réseau.
                </VeloAccordionItem>
                <VeloAccordionItem Title="Quand une demande est-elle rejetée ?" Icon="warning">
                    Lorsqu'elle arrive après l'heure limite de dépôt, dépasse la capacité disponible ou sort des bornes de prix.
                </VeloAccordionItem>
                <VeloAccordionItem Title="Puis-je exporter les données ?" Icon="download">
                    Oui, depuis chaque tableau : menu Actions, puis « Exporter en CSV ».
                </VeloAccordionItem>
                <VeloAccordionItem Title="Fonction réservée aux administrateurs" Disabled="true" />
            </VeloAccordion>
            <VeloAccordion Multiple="true" Flush="true">
                <VeloAccordionItem Title="Notifications" Subtitle="E-mail, push, SMS">
                    <ChildContent>
                        <div class="stack">
                            <VeloSwitch Label="E-mail" Checked="true" />
                            <VeloSwitch Label="Push" />
                        </div>
                    </ChildContent>
                    <Extra><VeloBadge Color="success">2 actives</VeloBadge></Extra>
                </VeloAccordionItem>
                <VeloAccordionItem Title="Réglages avancés" Subtitle="Pour les utilisateurs expérimentés">
                    <VeloNumberField Label="Délai de relance" Value="15" Unit="min" Min="5" Max="60" Step="5" />
                </VeloAccordionItem>
            </VeloAccordion>
        </div>
    </Example>

    <ApiTable Title="VeloAccordion et VeloAccordionItem" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <velo:VeloAccordion>
            <velo:VeloAccordionItem Header="Livraison" Subtitle="Délais et zones" Icon="download" IsExpanded="True">
                <TextBlock Text="Livraison en 48 h partout en France." TextWrapping="Wrap" />
            </velo:VeloAccordionItem>
            <velo:VeloAccordionItem Header="Retours" Icon="refresh">
                <TextBlock Text="30 jours pour changer d'avis." />
            </velo:VeloAccordionItem>
            <velo:VeloAccordionItem Header="Paiement" Icon="lock">
                <velo:VeloAccordionItem.Extra>
                    <velo:VeloBadge Content="Sécurisé" Tone="Success" />
                </velo:VeloAccordionItem.Extra>
                <TextBlock Text="Carte, virement ou prélèvement." />
            </velo:VeloAccordionItem>
        </velo:VeloAccordion>

        <!-- Plusieurs sections ouvertes à la fois, sans cadre -->
        <velo:VeloAccordion AllowMultiple="True" IsFlush="True"> … </velo:VeloAccordion>
        """;

    private const string Code = """
        <VeloAccordion>
            <VeloAccordionItem Title="Comment est calculé le déséquilibre ?" Icon="info" Expanded>…</VeloAccordionItem>
            <VeloAccordionItem Title="Quand une demande est-elle rejetée ?">…</VeloAccordionItem>
        </VeloAccordion>

        <VeloAccordion Multiple Flush>…</VeloAccordion>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Multiple", "bool", null, "Plusieurs sections ouvertes à la fois (sinon une seule)."),
        new("Flush", "bool", null, "Sans cadre, seulement des séparateurs."),
        new("Item Title / Subtitle / Icon / Extra", "string / string / string / RenderFragment", null, "En-tête de la section, contenu à droite (badge…)."),
        new("Item Expanded / Disabled", "bool", null, "Ouverte au départ ; désactivée."),
    ];
}
