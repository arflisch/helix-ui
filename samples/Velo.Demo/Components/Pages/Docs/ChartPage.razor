@page "/components/chart"
@using System.Globalization
@using static Velo.Demo.Components.Shared.Snippet

<DemoPage Title="Chart" Description="Graphiques de séries temporelles ou numériques : lignes, aires, paliers, barres, lignes de référence, ligne « maintenant » en temps réel, zoom par navigateur et vue tableau. Rendu SVG côté serveur, survol sans JavaScript.">
    <section class="demo-section">
        <h2 class="demo-section__title">Playground</h2>
        <div class="pg pg--wide">
            <div class="pg__stage pg__stage--block">
                <VeloChart Title="Équilibrage" Subtitle="Déséquilibre du système, aujourd'hui, au quart d'heure" Unit="MW" YFormat="N0"
                           Height="@($"{N(_height)}px")" ShowNow="_showNow" ShowNavigator="_navigator" NowColor="@_nowColor" Culture="French">
                    <VeloChartSeries Name="Déséquilibre" Points="_imbalance" Type="_type" Markers="_markers" Color="@_color" />
                    @if (_forecast)
                    {
                        <VeloChartSeries Name="Prévision" Points="_forecastPoints" Dashed="true" />
                    }
                    @if (_activated)
                    {
                        <VeloChartSeries Name="Réserve activée" Points="_activatedPoints" Type="VeloSeriesType.Step" />
                    }
                    @if (_threshold)
                    {
                        <VeloChartLine Y="300" Label="Seuil d'alerte 300 MW" Color="danger" />
                        <VeloChartLine Y="-300" Label="-300 MW" Color="danger" />
                    }
                </VeloChart>
            </div>
            <aside class="pg__controls">
                <Choice TEnum="VeloSeriesType" Label="Type (Déséquilibre)" @bind-Value="_type" />
                <ColorPicker Label="Color" @bind-Value="_color" Colors="@(["#2a78d6", "success", "danger", "#8b5cf6"])" />
                <ColorPicker Label="NowColor" @bind-Value="_nowColor" Colors="@(["#eb6834", "danger", "#18181b"])" />
                <VeloSlider Label="Hauteur" @bind-Value="_height" Min="180" Max="440" Step="20" Format="@(v => $"{v} px")" />
                <VeloSwitch Label="Markers" @bind-Checked="_markers" Size="VeloSize.Sm" />
                <VeloSwitch Label="Série Prévision (pointillés)" @bind-Checked="_forecast" Size="VeloSize.Sm" />
                <VeloSwitch Label="Série Réserve (paliers)" @bind-Checked="_activated" Size="VeloSize.Sm" />
                <VeloSwitch Label="Seuils (VeloChartLine)" @bind-Checked="_threshold" Size="VeloSize.Sm" />
                <VeloSwitch Label="ShowNow (temps réel)" @bind-Checked="_showNow" Size="VeloSize.Sm" />
                <VeloSwitch Label="ShowNavigator (zoom)" @bind-Checked="_navigator" Size="VeloSize.Sm" />
            </aside>
        </div>
        <CodeBlock Code="@Code" />
    </section>

    <Example WpfCode="@Wpf1" Title="Deux mesures, deux graphiques"
             Description="Des MW et des €/MWh n'ont pas la même échelle : plutôt qu'un double axe Y (qui fait croire que les courbes se comparent), Velo aligne deux graphiques sur la même période. Les axes temporels tombent exactement l'un sous l'autre."
             Code="@StackedCode">
        <div class="stack" style="gap:28px">
            <VeloChart Title="Déséquilibre" Unit="MW" YFormat="N0" Height="200px" From="EnergyData.Today" To="EnergyData.Today.AddDays(1)" ShowNow="true" Culture="French">
                <VeloChartSeries Name="Déséquilibre" Points="_imbalance" Type="VeloSeriesType.Area" />
            </VeloChart>
            <VeloChart Title="Prix de déséquilibre" Unit="€/MWh" YFormat="N0" Height="160px" From="EnergyData.Today" To="EnergyData.Today.AddDays(1)" ShowNow="true" Culture="French">
                <VeloChartSeries Name="Prix" Points="_prices" Type="VeloSeriesType.Bar" Color="#eb6834" />
            </VeloChart>
        </div>
    </Example>

    <Example WpfCode="@Wpf2" Title="Axe numérique" Description="Sans dates : un X numérique et un format libre." Code="@NumericCode">
        <VeloChart Title="Profil de charge d'une batterie" Unit="%" Height="200px" XFormat="@(x => $"{x:0} min")" XLabel="Temps" Culture="French">
            <VeloChartSeries Name="Charge" Points="_battery" Type="VeloSeriesType.Area" Markers="true" Color="success" />
            <VeloChartLine Y="80" Label="Limite 80 %" />
        </VeloChart>
    </Example>

    <ApiTable Title="VeloChart" Rows="ChartApi" />
    <ApiTable Title="VeloChartSeries et VeloChartLine" Rows="SeriesApi" ShowIntro="false" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <!-- Deux mesures d'échelles différentes : deux graphiques, jamais deux axes Y -->
        <velo:VeloChart Title="Puissance" Unit="MW" ShowNow="True" From="{Binding DayStart}" To="{Binding DayEnd}">
            <velo:VeloChartSeries Name="Production" Type="Area" Points="{Binding Production}" />
            <velo:VeloChartSeries Name="Prévision" IsDashed="True" Points="{Binding Forecast}" />
            <velo:VeloChart.Lines>
                <velo:VeloChartLine Y="400" Label="Contrat" Color="danger" />
            </velo:VeloChart.Lines>
        </velo:VeloChart>
        <velo:VeloChart Title="Prix" Unit="€/MWh" PlotHeight="180">
            <velo:VeloChartSeries Name="Prix spot" Type="Step" Points="{Binding Prices}" />
        </velo:VeloChart>

        // ViewModel
        Production = readings.ToPoints(r => r.Time, r => r.Megawatts);   // VeloPoint.At(...)
        """;

    private const string Wpf2 = """
        <velo:VeloChart x:Name="Sales" Title="Ventes par mois" Unit="k€">
            <velo:VeloChartSeries Name="2025" Type="Bar" Points="{Binding Sales2025}" />
            <velo:VeloChartSeries Name="2026" Type="Bar" Points="{Binding Sales2026}" />
        </velo:VeloChart>

        // Code-behind : X = index du mois, libellé par XFormat
        Sales.XFormat = x => months[(int)x];
        Sales2025 = Enumerable.Range(0, 12).Select(m => new VeloPoint(m, totals[m])).ToList();
        """;

    private static readonly CultureInfo French = CultureInfo.GetCultureInfo("fr-FR");

    private readonly IReadOnlyList<VeloPoint> _imbalance = EnergyData.Imbalance(DateTime.Now);
    private readonly IReadOnlyList<VeloPoint> _forecastPoints = EnergyData.Forecast(DateTime.Now);
    private readonly IReadOnlyList<VeloPoint> _activatedPoints = EnergyData.Activated(DateTime.Now);
    private readonly IReadOnlyList<VeloPoint> _prices = EnergyData.Prices();
    private readonly IReadOnlyList<VeloPoint> _battery =
        Enumerable.Range(0, 13).Select(i => new VeloPoint(i * 10, Math.Round(20 + 62 * (1 - Math.Exp(-i / 4.0))))).ToList();

    private VeloSeriesType _type = VeloSeriesType.Line;
    private string? _color, _nowColor;
    private double _height = 300;
    private bool _markers, _forecast = true, _activated, _threshold = true, _showNow = true, _navigator = true;

    private string Code
    {
        get
        {
            var chart = $"<VeloChart Title=\"Équilibrage\" Unit=\"MW\"{A("Height", _height == 280 ? null : $"{N(_height)}px")}{B("ShowNow", _showNow)}{B("ShowNavigator", _navigator)}{A("NowColor", _nowColor)}>";
            var lines = new List<string>
            {
                $"    <VeloChartSeries Name=\"Déséquilibre\" Points=\"imbalance\"{A("Type", _type, VeloSeriesType.Line)}{B("Markers", _markers)}{A("Color", _color)} />",
            };
            if (_forecast) lines.Add("    <VeloChartSeries Name=\"Prévision\" Points=\"forecast\" Dashed />");
            if (_activated) lines.Add("    <VeloChartSeries Name=\"Réserve activée\" Points=\"reserve\" Type=\"VeloSeriesType.Step\" />");
            if (_threshold) lines.Add("    <VeloChartLine Y=\"300\" Label=\"Seuil d'alerte 300 MW\" Color=\"danger\" />");
            return $"{chart}\n{string.Join("\n", lines)}\n</VeloChart>\n\n@code {{\n    // VeloPoint.At(heure, valeur), ou data.ToPoints(d => d.Time, d => d.Mw)\n    private IReadOnlyList<VeloPoint> imbalance = measures.ToPoints(m => m.Time, m => m.Mw);\n}}";
        }
    }

    private const string StackedCode = """
        <VeloChart Title="Déséquilibre" Unit="MW" From="today" To="today.AddDays(1)" ShowNow>
            <VeloChartSeries Name="Déséquilibre" Points="imbalance" Type="VeloSeriesType.Area" />
        </VeloChart>
        <VeloChart Title="Prix de déséquilibre" Unit="€/MWh" From="today" To="today.AddDays(1)" ShowNow>
            <VeloChartSeries Name="Prix" Points="prices" Type="VeloSeriesType.Bar" />
        </VeloChart>
        """;

    private const string NumericCode = """
        <VeloChart Title="Profil de charge" Unit="%" XFormat="@(x => $"{x:0} min")">
            <VeloChartSeries Name="Charge" Points="points" Type="VeloSeriesType.Area" Markers Color="success" />
            <VeloChartLine Y="80" Label="Limite 80 %" />
        </VeloChart>
        """;

    private static readonly ApiRow[] ChartApi =
    [
        new("Title / Subtitle", "string", null, "En-tête. Avec une seule série, le titre la nomme (pas de légende)."),
        new("Unit / YFormat", "string", null, "Unité (au-dessus de l'axe et dans l'infobulle) et format .NET des valeurs."),
        new("Height", "string", null, "Hauteur de la zone de tracé (280px)."),
        new("From / To · XMin / XMax", "DateTime · double", null, "Période affichée (sinon l'étendue des données). Aligne plusieurs graphiques."),
        new("YMin / YMax", "double", null, "Bornes Y fixes (sinon calculées sur la partie visible)."),
        new("ShowNow / NowRefresh", "bool / TimeSpan", "--velo-chart-now", "Ligne « maintenant » qui avance toute seule (30 s)."),
        new("NowColor", "string", "--velo-chart-now", "Couleur de la ligne et du badge."),
        new("ShowNavigator", "bool", null, "Bandeau d'aperçu avec deux poignées pour zoomer."),
        new("ShowTableToggle", "bool", null, "Bouton « Tableau » : les mêmes données en tableau accessible (true)."),
        new("XFormat / XLabel", "Func<double,string> / string", null, "Libellés d'un axe numérique."),
        new("Culture / TimeProvider", "CultureInfo / TimeProvider", null, "Formats ; horloge injectable pour les tests."),
        new("—", "", "--velo-series-1 … --velo-series-8", "Palette des séries, ordre fixe, validée daltonisme (clair et sombre)."),
        new("—", "", "--velo-chart-grid, --velo-chart-bg, --velo-chart-axis-width", "Grille, fond (anneau des points), largeur de l'axe Y."),
    ];

    private static readonly ApiRow[] SeriesApi =
    [
        new("Name / Points", "string / IEnumerable<VeloPoint>", null, "VeloPoint.At(heure, valeur) ou new VeloPoint(x, y). Y = null coupe la ligne."),
        new("Type", "VeloSeriesType", null, "Line, Area, Step ou Bar."),
        new("Color", "string", null, "Par défaut la couleur suivante de la palette ; nom sémantique ou couleur CSS."),
        new("Markers / Dashed / Hidden", "bool", null, "Points visibles, pointillés (prévision), masquée au départ."),
        new("VeloChartLine Y / At / X", "double / DateTime / double", null, "Ligne de référence horizontale (seuil) ou verticale (événement)."),
        new("VeloChartLine Label / Color / Dashed", "string / string / bool", null, "Libellé, couleur, pointillés (true)."),
    ];
}
