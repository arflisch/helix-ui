@page "/components/emptystate"

<DemoPage Title="EmptyState" Description="Ce qu'on affiche quand il n'y a rien : expliquer pourquoi, et proposer l'action suivante.">
    <Example WpfCode="@Wpf1" Title="Variantes" Code="@Code">
        <div class="grid-3">
            <VeloEmptyState Framed="true" Icon="calendar" Title="Aucune demande planifiée" Description="Planifiez une demande pour la voir apparaître dans la timeline.">
                <Actions><VeloButton Icon="plus" Size="VeloSize.Sm">Planifier</VeloButton></Actions>
            </VeloEmptyState>
            <VeloEmptyState Framed="true" Icon="search" Title="Aucun résultat" Description="Essayez un autre mot-clé ou retirez des filtres.">
                <Actions><VeloButton Variant="VeloVariant.Outline" Color="neutral" Size="VeloSize.Sm">Effacer les filtres</VeloButton></Actions>
            </VeloEmptyState>
            <VeloEmptyState Framed="true" Icon="success" Color="success" Title="Tout est à jour" Description="Aucune alerte en cours." />
        </div>
    </Example>

    <ApiTable Title="VeloEmptyState" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <velo:VeloEmptyState Icon="search" Title="Aucun résultat"
                             Description="Aucun rapport ne correspond à ces filtres.">
            <velo:VeloEmptyState.Actions>
                <velo:VeloButton Content="Effacer les filtres" Variant="Soft" />
            </velo:VeloEmptyState.Actions>
        </velo:VeloEmptyState>
        <velo:VeloEmptyState Icon="bell" Title="Tout est lu" Tone="Success" Padding="12" />
        """;

    private const string Code = """
        <VeloEmptyState Icon="calendar" Title="Aucune demande planifiée" Description="Planifiez une demande…">
            <Actions><VeloButton Icon="plus">Planifier</VeloButton></Actions>
        </VeloEmptyState>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Icon / Title / Description", "string", null, "Illustration et textes."),
        new("Actions", "RenderFragment", null, "Boutons d'action."),
        new("Compact / Framed", "bool", null, "Version réduite ; cadre en pointillés."),
        new("Color", "string", "--velo-empty-color", "Couleur de l'illustration."),
    ];
}
