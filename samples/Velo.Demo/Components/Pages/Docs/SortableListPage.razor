@page "/components/sortable"

<DemoPage Title="SortableList" Description="Une liste que l'utilisateur réordonne en glissant les éléments, ou au clavier (Entrée, flèches, Entrée). Pratique pour des priorités, des étapes, l'ordre des colonnes d'un export…">
    <section class="demo-section">
        <h2 class="demo-section__title">Exemple</h2>
        <div class="grid-2">
            <VeloSortableList @bind-Items="_priorities" ItemKey="p => p.Id" ShowHandle="_handle">
                <ItemTemplate>
                    <div class="prio">
                        <span class="prio__rank">@(Rank(context))</span>
                        <span class="prio__title">@context.Title</span>
                        <span class="prio__owner">@context.Owner</span>
                    </div>
                </ItemTemplate>
            </VeloSortableList>
            <div class="stack">
                <VeloSwitch Label="ShowHandle" @bind-Checked="_handle" />
                <VeloCard Title="Ordre actuel">
                    <ol class="muted" style="margin:0;padding-left:18px;line-height:1.8">
                        @foreach (var p in _priorities)
                        {
                            <li>@p.Title</li>
                        }
                    </ol>
                </VeloCard>
            </div>
        </div>
        <CodeBlock Code="@Code" WpfCode="@WpfExample" />
    </section>

    <ApiTable Title="VeloSortableList" Rows="Api" />
</DemoPage>

@code {
    private const string WpfExample = """
        <velo:VeloSortableList ItemsSource="{Binding Priorities}" ShowHandle="True" Reordered="OnReordered">
            <velo:VeloSortableList.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </velo:VeloSortableList.ItemTemplate>
        </velo:VeloSortableList>

        // ItemsSource = ObservableCollection<T> : la liste est réordonnée directement (glisser ou Alt + ↑/↓).
        private void OnReordered(object sender, RoutedEventArgs e)
        {
            var (from, to) = ((VeloEventArgs<(int From, int To)>)e).Value;
            Save();
        }
        """;

    private IReadOnlyList<Priority> _priorities = DemoData.Priorities();
    private bool _handle = true;

    private int Rank(Priority p) => _priorities.ToList().IndexOf(p) + 1;

    private const string Code = """
        <VeloSortableList @bind-Items="priorities" ItemKey="p => p.Id">
            <ItemTemplate>@context.Title</ItemTemplate>
        </VeloSortableList>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Items", "IReadOnlyList<T>", null, "Les éléments, @bind-Items pour récupérer le nouvel ordre."),
        new("OnReorder", "EventCallback<(int From, int To)>", null, "Le déplacement effectué."),
        new("ItemTemplate / ItemKey", "RenderFragment<T> / Func<T, object>", null, "Contenu et identité d'un élément."),
        new("ShowHandle / Disabled", "bool", null, "Poignée visible (true) ; désactiver le réordonnancement."),
    ];
}
