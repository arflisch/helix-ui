@page "/getting-started"

<DemoPage Title="Installation" Eyebrow="Guide" Description="Quelques étapes, et tous les composants sont disponibles dans votre application Blazor ou WPF. Le sélecteur Blazor / WPF des blocs de code change d'exemple partout sur le site.">
    <div class="steps">
        <div class="step">
            <p class="step__title">Référencer la librairie</p>
            <p class="step__text">Ajoutez le projet (ou, plus tard, le package NuGet) à votre application.</p>
            <CodeBlock Language="bash" Code="dotnet add reference ../Velo.Blazor/Velo.Blazor.csproj" WpfCode="dotnet add reference ../Velo.Wpf/Velo.Wpf.csproj" />
        </div>
        <div class="step">
            <p class="step__title">Enregistrer les services</p>
            <p class="step__text">Une ligne dans <code>Program.cs</code> (nécessaire pour les toasts).</p>
            <CodeBlock Language="c#" Code="@ProgramCode" WpfCode="@WpfAppCode" />
        </div>
        <div class="step">
            <p class="step__title">Ajouter la feuille de style et le using</p>
            <p class="step__text">Dans <code>App.razor</code> et <code>_Imports.razor</code>.</p>
            <CodeBlock Language="razor" Code="@ImportsCode" WpfCode="@WpfNamespaceCode" />
        </div>
        <div class="step">
            <p class="step__title">Envelopper la mise en page</p>
            <p class="step__text"><code>VeloProvider</code> applique le thème, le mode sombre et affiche les toasts.</p>
            <CodeBlock Language="razor" Code="@LayoutCode" WpfCode="@WpfHostCode" />
        </div>
        <div class="step">
            <p class="step__title">Utiliser les composants</p>
            <p class="step__text">C'est prêt.</p>
            <CodeBlock Language="razor" Code="@UsageCode" WpfCode="@WpfUsageCode" />
        </div>
    </div>
</DemoPage>

@code {
    private const string WpfAppCode = """
        <!-- WPF · App.xaml : le thème (clair, sombre ou comme Windows) -->
        <Application.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <velo:VeloResources Mode="System" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Application.Resources>
        """;

    private const string WpfNamespaceCode = """
        <!-- WPF · un seul espace de noms XAML pour tous les contrôles -->
        <Window xmlns:velo="https://velo-ui.dev/wpf" … >

        // En C# : using Velo.Wpf;
        """;

    private const string WpfHostCode = """
        <!-- WPF · MainWindow.xaml : VeloHost affiche notifications, dialogues et confirmations -->
        <Window … Background="{DynamicResource Velo.Background}">
            <velo:VeloHost>
                <!-- votre mise en page -->
            </velo:VeloHost>
        </Window>
        """;

    private const string WpfUsageCode = """
        <velo:VeloButton Content="Enregistrer" Icon="check" Click="OnSave" />
        <velo:VeloSwitch Content="Pilote auto" ThumbBrush="#F59E0B" IsChecked="{Binding Auto}" />
        """;

    private const string ProgramCode = """
        builder.Services.AddVelo();
        """;

    private const string ImportsCode = """
        <!-- App.razor, dans <head> -->
        <link rel="stylesheet" href="_content/Velo.Blazor/velo.css" />

        @* _Imports.razor *@
        @using Velo.Blazor
        """;

    private const string LayoutCode = """
        @inherits LayoutComponentBase

        <VeloProvider Theme="_theme">
            @Body
        </VeloProvider>

        @code {
            private readonly VeloTheme _theme = new() { Primary = "#4f46e5" };
        }
        """;

    private const string UsageCode = """
        <VeloTextField Label="Email" @bind-Value="email" Icon="mail" Clearable />
        <VeloSwitch Label="Notifications" @bind-Checked="enabled" />
        <VeloButton OnClick="Save">Enregistrer</VeloButton>
        """;
}
