@inherits LayoutComponentBase
@implements IDisposable
@inject DemoThemeState ThemeState
@inject IJSRuntime JS

<VeloProvider Theme="ThemeState.Theme" Class="demo">
    <aside class="@(new CssBuilder("demo-sidebar").Add("is-open", _menuOpen).Build())">
        <a class="demo-logo" href="">
            <span class="demo-logo__mark"></span>
            Velo<span class="demo-logo__ui">UI</span>
        </a>

        <nav class="demo-nav" @onclick="() => _menuOpen = false">
            @foreach (var group in DemoNav.Groups)
            {
                <p class="demo-nav__group">@group.Title</p>
                @foreach (var item in group.Items)
                {
                    <NavLink class="demo-nav__link" href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        @item.Title
                    </NavLink>
                }
            }
        </nav>
    </aside>

    <div class="demo-main">
        <header class="demo-topbar">
            <button class="velo-close demo-menu-btn" aria-label="Menu" @onclick="() => _menuOpen = !_menuOpen">
                <VeloIcon Svg="<path d='M4 7h16M4 12h16M4 17h16'/>" Size="18" />
            </button>
            <div class="demo-topbar__spacer"></div>

            <VeloMenu Align="VeloAlign.End" MinWidth="230px">
                <Trigger>
                    <VeloButton Variant="VeloVariant.Ghost" Color="neutral" Size="VeloSize.Sm" IconEnd="chevron-down">
                        <span class="demo-theme-dot"></span>
                        @(ThemeState.Preset ?? "Personnalisé")
                    </VeloButton>
                </Trigger>
                <ChildContent>
                    <VeloMenuLabel>Thème</VeloMenuLabel>
                    @foreach (var (name, create) in VeloThemes.All)
                    {
                        <VeloMenuItem Checked="@(ThemeState.Preset == name)" OnClick="() => ThemeState.Apply(create(), name)">@name</VeloMenuItem>
                    }
                    <VeloMenuItem Icon="settings" Href="themes">Créer un thème…</VeloMenuItem>
                </ChildContent>
            </VeloMenu>

            <VeloMenu Align="VeloAlign.End" MinWidth="180px">
                <Trigger>
                    <VeloButton Variant="VeloVariant.Ghost" Color="neutral" Icon="@ModeIcon" aria-label="Mode clair, sombre ou système" />
                </Trigger>
                <ChildContent>
                    <VeloMenuLabel>Apparence</VeloMenuLabel>
                    <VeloMenuItem Icon="sun" Checked="@(Mode == VeloThemeMode.Light)" OnClick="() => SetMode(VeloThemeMode.Light)">Clair</VeloMenuItem>
                    <VeloMenuItem Icon="moon" Checked="@(Mode == VeloThemeMode.Dark)" OnClick="() => SetMode(VeloThemeMode.Dark)">Sombre</VeloMenuItem>
                    <VeloMenuItem Icon="settings" Checked="@(Mode == VeloThemeMode.System)" Description="Suit le réglage de l'ordinateur" OnClick="() => SetMode(VeloThemeMode.System)">Système</VeloMenuItem>
                </ChildContent>
            </VeloMenu>
        </header>

        <main class="demo-content">
            @Body
        </main>
    </div>
</VeloProvider>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur inattendue est survenue.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string StorageKey = "velo-demo-theme";

    private bool _menuOpen;
    private bool _restored;

    private VeloThemeMode Mode => ThemeState.Theme.Mode;

    private string ModeIcon => Mode switch
    {
        VeloThemeMode.Dark => "moon",
        VeloThemeMode.System => "settings",
        _ => "sun",
    };

    protected override void OnInitialized() => ThemeState.Changed += OnThemeChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ThemeState.Restore(await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey));
            _restored = true;
            StateHasChanged();
        }
    }

    private void OnThemeChanged() => _ = InvokeAsync(async () =>
    {
        StateHasChanged();
        if (_restored)
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, ThemeState.Serialize());
        }
    });

    private void SetMode(VeloThemeMode mode)
    {
        ThemeState.Theme.Mode = mode;
        ThemeState.Notify();
    }

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;
}
