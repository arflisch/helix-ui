<UserControl x:Class="Velo.Wpf.Demo.Pages.BoardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:velo="https://velo-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Organisation" />
        <TextBlock Style="{StaticResource PageLead}" Text="Kanban, liste à réordonner, tableau de bord personnalisable et arbres (liste ou organigramme)." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Kanban" />
        <TextBlock Style="{StaticResource SectionText}" Text="Glissez les cartes entre colonnes. La colonne « En revue » est limitée à 2 cartes (le compteur passe en rouge au-delà)." />
        <velo:VeloKanban x:Name="Board" ColumnPath="Column" ShowAddButton="True" Height="360" Margin="0,0,0,32">
            <velo:VeloKanban.CardTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <DockPanel Margin="0,8,0,0">
                            <velo:VeloAvatar DockPanel.Dock="Right" DisplayName="{Binding Owner}" Size="Sm" />
                            <velo:VeloBadge Content="{Binding Tag}" Tone="{Binding Tone}" />
                        </DockPanel>
                    </StackPanel>
                </DataTemplate>
            </velo:VeloKanban.CardTemplate>
        </velo:VeloKanban>

        <TextBlock Style="{StaticResource SectionTitle}" Text="SortableList" />
        <TextBlock Style="{StaticResource SectionText}" Text="Glissez une ligne, ou Alt + ↑ / ↓ sur la ligne sélectionnée." />
        <Border Style="{StaticResource Stage}">
            <velo:VeloSortableList x:Name="Priorities" MaxWidth="420" HorizontalAlignment="Left" />
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Dashboard" />
        <TextBlock Style="{StaticResource SectionText}" Text="« Modifier la disposition » : déplacer, élargir ou masquer les tuiles. Layout garde la disposition (à enregistrer)." />
        <velo:VeloDashboard x:Name="Dash" Title="Exploitation" ColumnCount="3" Margin="0,0,0,32">
            <velo:VeloDashboardTile TileId="kpi" IsPlain="True" DefaultSpan="3" CanHide="False">
                <UniformGrid Columns="3">
                    <Border Style="{StaticResource Stage}" Margin="0,0,8,0">
                        <velo:VeloStat Label="Production" Value="1 284" Unit="MWh" Delta="12.5" />
                    </Border>
                    <Border Style="{StaticResource Stage}" Margin="8,0">
                        <velo:VeloStat Label="Disponibilité" Value="96,4" Unit="%" Delta="0.8" />
                    </Border>
                    <Border Style="{StaticResource Stage}" Margin="8,0,0,0">
                        <velo:VeloStat Label="Incidents" Value="3" Delta="-40" HigherIsBetter="False" />
                    </Border>
                </UniformGrid>
            </velo:VeloDashboardTile>
            <velo:VeloDashboardTile TileId="chart" Title="Charge" DefaultSpan="2">
                <velo:VeloProgress Label="Réseau" ShowValue="True" Value="72" />
            </velo:VeloDashboardTile>
            <velo:VeloDashboardTile TileId="team" Title="Équipe">
                <velo:VeloAvatarGroup Max="4">
                    <velo:VeloAvatar DisplayName="Camille Martin" Status="Online" />
                    <velo:VeloAvatar DisplayName="Léo Bernard" />
                    <velo:VeloAvatar DisplayName="Inès Petit" Status="Away" />
                    <velo:VeloAvatar DisplayName="Hugo Robert" />
                    <velo:VeloAvatar DisplayName="Chloé Richard" />
                    <velo:VeloAvatar DisplayName="Nathan Durand" />
                </velo:VeloAvatarGroup>
            </velo:VeloDashboardTile>
            <velo:VeloDashboardTile TileId="alerts" Title="Alertes" DefaultSpan="3">
                <velo:VeloAlert Severity="Warning" Title="Maintenance" Content="Turbine 3 à l'arrêt de 14 h à 16 h." />
            </velo:VeloDashboardTile>
        </velo:VeloDashboard>

        <TextBlock Style="{StaticResource SectionTitle}" Text="TreeView" />
        <UniformGrid Columns="2" Margin="0,0,0,32">
            <Border Style="{StaticResource Stage}" Margin="0,0,12,0">
                <velo:VeloTreeView x:Name="Files" ChildrenPath="Children" TextPath="Name" IconPath="Icon" ExpandDepth="2" Height="300" />
            </Border>
            <Border Style="{StaticResource Stage}" Margin="12,0,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Velo.TextMuted}"
                           Text="Le même contrôle avec Layout=&quot;Diagram&quot; dessine un organigramme (ci-dessous). Les + / − déplient les branches." />
            </Border>
        </UniformGrid>
        <Border Style="{StaticResource Stage}">
            <velo:VeloTreeView x:Name="Org" Layout="Diagram" ChildrenPath="Children" TextPath="Name" DescriptionPath="Role" ExpandDepth="3" />
        </Border>
    </StackPanel>
</UserControl>
