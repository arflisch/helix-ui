<UserControl x:Class="Velo.Wpf.Demo.Pages.DataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:velo="https://velo-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="DataGrid" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Recherche, tri sur toutes les pages, pagination, choix des colonnes, densité et lignes alternées. En mémoire avec Source, ou côté serveur avec ItemsProvider." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="En mémoire" />
        <velo:VeloDataGrid x:Name="Grid" IsSearchable="True" ShowColumnChooser="True" IsStriped="True" PageSize="8" AutoGenerateColumns="False"
                           Height="460" Margin="0,0,0,32" IsReadOnly="True">
            <velo:VeloDataGrid.Toolbar>
                <velo:VeloButtonGroup x:Name="Density" SelectedIndex="1" SelectionChanged="OnDensity">
                    <ListBoxItem Content="Compact" />
                    <ListBoxItem Content="Normal" />
                    <ListBoxItem Content="Large" />
                </velo:VeloButtonGroup>
            </velo:VeloDataGrid.Toolbar>
            <velo:VeloDataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="120" />
                <DataGridTextColumn Header="Puissance (MW)" Binding="{Binding Power, StringFormat=N0}" Width="130" />
                <DataGridTemplateColumn Header="Statut" Width="130" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <velo:VeloBadge Content="{Binding Status}" Tone="{Binding Tone}" ShowDot="True" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Mise à jour" Binding="{Binding Updated, StringFormat=dd/MM HH:mm}" Width="120" />
            </velo:VeloDataGrid.Columns>
        </velo:VeloDataGrid>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Côté serveur" />
        <TextBlock Style="{StaticResource SectionText}" Text="ItemsProvider reçoit (recherche, tri, page) et un CancellationToken : la requête précédente est annulée quand on tape vite. Ici, un faux serveur avec 600 ms de latence et 10 000 lignes." />
        <velo:VeloDataGrid x:Name="ServerGrid" IsSearchable="True" PageSize="10" AutoGenerateColumns="False" Height="500" IsReadOnly="True">
            <velo:VeloDataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="80" />
                <DataGridTextColumn Header="Client" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Ville" Binding="{Binding Site}" Width="140" />
                <DataGridTextColumn Header="Montant (€)" Binding="{Binding Power, StringFormat=N0}" Width="130" />
            </velo:VeloDataGrid.Columns>
        </velo:VeloDataGrid>
    </StackPanel>
</UserControl>
