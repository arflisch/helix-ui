<UserControl x:Class="Velo.Wpf.Demo.Pages.ButtonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:velo="https://velo-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Boutons" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Quatre variantes, six tons du thème ou n'importe quelle couleur, trois tailles, des icônes et un état de chargement. Chaque partie est une propriété : aucun template à copier." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Variantes" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel>
                    <velo:VeloButton Content="Solid" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Soft" Variant="Soft" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Outline" Variant="Outline" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Ghost" Variant="Ghost" Margin="0,0,10,10" />
                </WrapPanel>
                <TextBox Style="{StaticResource Code}" Text="&lt;velo:VeloButton Content=&quot;Soft&quot; Variant=&quot;Soft&quot; /&gt;" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Tons et couleur libre" />
        <TextBlock Style="{StaticResource SectionText}" Text="Tone suit le thème (clair ou sombre). Accent accepte n'importe quelle couleur ; le texte devient noir ou blanc selon le contraste." />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel>
                    <velo:VeloButton Content="Primary" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Neutral" Tone="Neutral" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Success" Tone="Success" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Warning" Tone="Warning" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Danger" Tone="Danger" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Info" Tone="Info" Margin="0,0,10,10" />
                </WrapPanel>
                <WrapPanel>
                    <velo:VeloButton Content="#FF8A00" Accent="#FF8A00" Margin="0,0,10,10" />
                    <velo:VeloButton Content="#A3E635" Accent="#A3E635" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Soft #EC4899" Accent="#EC4899" Variant="Soft" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Outline danger" Tone="Danger" Variant="Outline" Margin="0,0,10,10" />
                </WrapPanel>
                <TextBox Style="{StaticResource Code}" Text="&lt;velo:VeloButton Content=&quot;Supprimer&quot; Tone=&quot;Danger&quot; /&gt;&#10;&lt;velo:VeloButton Content=&quot;Envoyer&quot; Accent=&quot;#FF8A00&quot; /&gt;" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Tailles, icônes, arrondi" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <velo:VeloButton Content="Sm" Size="Sm" Margin="0,0,10,10" VerticalAlignment="Center" />
                    <velo:VeloButton Content="Md" Margin="0,0,10,10" VerticalAlignment="Center" />
                    <velo:VeloButton Content="Lg" Size="Lg" Margin="0,0,10,10" VerticalAlignment="Center" />
                    <velo:VeloButton Content="Télécharger" Icon="download" Variant="Outline" Tone="Neutral" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Continuer" IconEnd="arrow-right" Margin="0,0,10,10" />
                    <velo:VeloButton Icon="settings" Variant="Ghost" Tone="Neutral" Padding="0" Width="38" ToolTip="Réglages" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Pilule" CornerRadius="999" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Carré" CornerRadius="0" Tone="Neutral" Margin="0,0,10,10" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Chargement" />
        <TextBlock Style="{StaticResource SectionText}" Text="IsLoading garde la largeur du bouton, affiche un spinner et ignore les clics." />
        <Border Style="{StaticResource Stage}">
            <WrapPanel>
                <velo:VeloButton x:Name="SaveButton" Content="Enregistrer" Icon="check" Click="OnSave" Margin="0,0,10,0" />
                <velo:VeloButton Content="Disabled" IsEnabled="False" Margin="0,0,10,0" />
            </WrapPanel>
        </Border>
    </StackPanel>
</UserControl>
