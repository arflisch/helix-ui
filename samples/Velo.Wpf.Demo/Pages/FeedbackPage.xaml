<UserControl x:Class="Velo.Wpf.Demo.Pages.FeedbackPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:velo="https://velo-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Retours" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Alertes, badges, progression, notifications, boîtes de dialogue et confirmations. Les notifications et dialogues s'affichent dans le VeloHost de la fenêtre." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Alert" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <velo:VeloAlert Severity="Info" Title="Nouvelle version" Content="Velo 1.2 apporte les champs unifiés." Margin="0,0,0,10" />
                <velo:VeloAlert Severity="Success" Title="Enregistré" Content="Vos réglages ont été appliqués." Margin="0,0,0,10" />
                <velo:VeloAlert Severity="Warning" Title="Quota presque atteint" Content="Il reste 8 % de l'espace disponible." IsClosable="True" Margin="0,0,0,10" />
                <velo:VeloAlert Severity="Danger" Content="La connexion au serveur a été perdue." />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Badge" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel Margin="0,0,0,10">
                    <velo:VeloBadge Content="Primary" Margin="0,0,8,0" />
                    <velo:VeloBadge Content="Neutral" Tone="Neutral" Margin="0,0,8,0" />
                    <velo:VeloBadge Content="En ligne" Tone="Success" ShowDot="True" Margin="0,0,8,0" />
                    <velo:VeloBadge Content="Attention" Tone="Warning" Icon="warning" Margin="0,0,8,0" />
                    <velo:VeloBadge Content="Erreur" Tone="Danger" Margin="0,0,8,0" />
                    <velo:VeloBadge Content="#FF8A00" Accent="#FF8A00" Margin="0,0,8,0" />
                </WrapPanel>
                <WrapPanel>
                    <velo:VeloBadge Content="Solid" Variant="Solid" Margin="0,0,8,0" />
                    <velo:VeloBadge Content="Solid danger" Variant="Solid" Tone="Danger" Margin="0,0,8,0" />
                    <velo:VeloBadge Content="Outline" Variant="Outline" Margin="0,0,8,0" />
                    <velo:VeloBadge Content="Carré" CornerRadius="4" Tone="Info" Margin="0,0,8,0" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Progress et Spinner" />
        <Border Style="{StaticResource Stage}">
            <StackPanel MaxWidth="520" HorizontalAlignment="Left">
                <velo:VeloProgress Label="Import des données" ShowValue="True" Value="{Binding Value, ElementName=ProgressValue}" Margin="0,0,0,12" />
                <velo:VeloSlider x:Name="ProgressValue" Minimum="0" Maximum="100" Value="64" Margin="0,0,0,20" />
                <velo:VeloProgress Label="Synchronisation" IsIndeterminate="True" Tone="Success" BarHeight="6" Margin="0,0,0,20" />
                <StackPanel Orientation="Horizontal">
                    <velo:VeloSpinner Margin="0,0,16,0" />
                    <velo:VeloSpinner Size="28" Tone="Success" Margin="0,0,16,0" />
                    <velo:VeloSpinner Size="36" Thickness="3" Accent="#FF8A00" />
                </StackPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Notifications, dialogue et confirmation" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel>
                    <velo:VeloButton Content="Succès" Tone="Success" Variant="Soft" Click="OnToastSuccess" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Avertissement" Tone="Warning" Variant="Soft" Click="OnToastWarning" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Erreur" Tone="Danger" Variant="Soft" Click="OnToastError" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Ouvrir un dialogue" Variant="Outline" Tone="Neutral" Click="OnOpenDialog" Margin="0,0,10,10" />
                    <velo:VeloButton Content="Supprimer…" Tone="Danger" Icon="trash" Click="OnDelete" Margin="0,0,10,10" />
                </WrapPanel>
                <TextBox Style="{StaticResource Code}" Text="VeloToasts.Success(&quot;Enregistré&quot;);&#10;if (await VeloConfirm.AskAsync(&quot;Supprimer ?&quot;, &quot;Action définitive.&quot;, danger: true)) { … }" />
            </StackPanel>
        </Border>

        <velo:VeloDialog x:Name="Dialog" Title="Inviter un membre" Description="Il recevra un e-mail pour rejoindre l'équipe.">
            <StackPanel>
                <velo:VeloTextField Label="E-mail" Icon="mail" Placeholder="prenom@exemple.fr" Margin="0,0,0,16" />
                <velo:VeloSelect Label="Rôle" SelectedIndex="0">
                    <ComboBoxItem Content="Lecteur" />
                    <ComboBoxItem Content="Éditeur" />
                    <ComboBoxItem Content="Administrateur" />
                </velo:VeloSelect>
            </StackPanel>
            <velo:VeloDialog.Footer>
                <StackPanel Orientation="Horizontal">
                    <velo:VeloButton Content="Annuler" Variant="Ghost" Tone="Neutral" Click="OnCloseDialog" />
                    <velo:VeloButton Content="Inviter" Icon="mail" Margin="8,0,0,0" Click="OnInvite" />
                </StackPanel>
            </velo:VeloDialog.Footer>
        </velo:VeloDialog>
    </StackPanel>
</UserControl>
