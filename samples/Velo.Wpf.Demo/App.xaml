<Application x:Class="Velo.Wpf.Demo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:velo="https://velo-ui.dev/wpf"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- One line: the Velo theme (light, dark or following Windows). -->
                <velo:VeloResources Mode="System" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Demo page helpers. -->
            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
            </Style>
            <Style x:Key="PageLead" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Margin" Value="0,6,0,28" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="MaxWidth" Value="720" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Foreground" Value="{DynamicResource Velo.TextMuted}" />
            </Style>
            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="17" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,4" />
                <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
            </Style>
            <Style x:Key="SectionText" TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,12" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="Foreground" Value="{DynamicResource Velo.TextMuted}" />
            </Style>
            <Style x:Key="Stage" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource Velo.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Velo.Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="24" />
                <Setter Property="Margin" Value="0,0,0,32" />
            </Style>
            <Style x:Key="Code" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Padding" Value="14,10" />
                <Setter Property="Margin" Value="0,16,0,0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="#FF0B0B0E" />
                <Setter Property="Foreground" Value="#FFE4E4E7" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
