<Window x:Class="Helix.Wpf.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="https://helix-ui.dev/wpf"
        Title="Helix UI · WPF" Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Helix.Background}"
        FontFamily="{DynamicResource Helix.FontFamily}" FontSize="{DynamicResource Helix.FontSize}">

    <Window.Resources>
        <!-- Side navigation: a ListBox with a light item style. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface3}" />
                                <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- HelixHost: shows toasts, dialogs and confirmations above the window. -->
    <helix:HelixHost>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16,20">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Helix.Primary}">
                            <helix:HelixIcon Icon="zap" Foreground="{DynamicResource Helix.OnPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Helix" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Helix.Text}" />
                        <TextBlock Text=" WPF" FontSize="17" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource Helix.TextSubtle}" />
                        <helix:HelixNotificationCenter PanelAlignment="Left" Margin="56,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="THÈME" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,8" Foreground="{DynamicResource Helix.TextSubtle}" />
                        <helix:HelixSelect x:Name="ThemePicker" SelectionChanged="OnThemeModeChanged">
                            <ComboBoxItem Content="Système" Tag="System" />
                            <ComboBoxItem Content="Clair" Tag="Light" />
                            <ComboBoxItem Content="Sombre" Tag="Dark" />
                        </helix:HelixSelect>
                    </StackPanel>

                    <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="OnNavigate" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem Content="Boutons" Tag="Buttons" />
                        <ListBoxItem Content="Champs" Tag="Fields" />
                        <ListBoxItem Content="Choix" Tag="Choices" />
                        <ListBoxItem Content="Retours" Tag="Feedback" />
                        <ListBoxItem Content="Mise en page" Tag="Layout" />
                        <ListBoxItem Content="Navigation" Tag="Navigation" />
                        <ListBoxItem Content="Données" Tag="Data" />
                        <ListBoxItem Content="Graphiques" Tag="Charts" />
                        <ListBoxItem Content="Planning" Tag="Planning" />
                        <ListBoxItem Content="Organisation" Tag="Board" />
                        <ListBoxItem Content="Personnalisation" Tag="Customization" />
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ContentControl x:Name="PageHost" Margin="48,40,48,48" MaxWidth="980" HorizontalAlignment="Left" Focusable="False" />
            </ScrollViewer>
        </Grid>
    </helix:HelixHost>
</Window>
