<Window x:Class="Helix.Wpf.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:helix="https://helix-ui.dev/wpf"
        Title="Helix UI · WPF" Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Helix.Background}"
        FontFamily="{DynamicResource Helix.FontFamily}" FontSize="{DynamicResource Helix.FontSize}">

    <Window.Resources>
        <!-- Side navigation: a ListBox with a light item style. -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface3}" />
                                <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- HelixHost: shows toasts, dialogs and confirmations above the window. -->
    <helix:HelixHost>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="16,20">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,24">
                        <Border Width="26" Height="26" CornerRadius="7" Background="{DynamicResource Helix.Primary}">
                            <helix:HelixIcon Icon="zap" Foreground="{DynamicResource Helix.OnPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Helix" FontSize="17" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Helix.Text}" />
                        <TextBlock Text=" WPF" FontSize="17" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource Helix.TextSubtle}" />
                        <helix:HelixNotificationCenter PanelAlignment="Left" Margin="56,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom">
                        <TextBlock Text="THEME" FontSize="11" FontWeight="SemiBold" Margin="8,0,0,8" Foreground="{DynamicResource Helix.TextSubtle}" />
                        <helix:HelixSelect x:Name="ThemePicker" SelectionChanged="OnThemeModeChanged">
                            <ComboBoxItem Content="System" Tag="System" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                        </helix:HelixSelect>
                    </StackPanel>

                    <ListBox x:Name="Nav" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NavItem}"
                             SelectionChanged="OnNavigate" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBoxItem Tag="Buttons" AutomationProperties.Name="Buttons">
                            <StackPanel>
                                <TextBlock Text="Buttons" />
                                <TextBlock Text="Button, async command" FontSize="11.5" FontWeight="Normal" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Helix.TextSubtle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Fields" AutomationProperties.Name="Fields">
                            <StackPanel>
                                <TextBlock Text="Fields" />
                                <TextBlock Text="Text, number, select, dates, auto form, color, files" FontSize="11.5" FontWeight="Normal" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Helix.TextSubtle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Choices" AutomationProperties.Name="Choices">
                            <StackPanel>
                                <TextBlock Text="Choices" />
                                <TextBlock Text="Switch, check box, radio group, slider, rating" FontSize="11.5" FontWeight="Normal" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Helix.TextSubtle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Feedback" AutomationProperties.Name="Feedback">
                            <StackPanel>
                                <TextBlock Text="Feedback" />
                                <TextBlock Text="Alerts, toasts, dialogs, time bar, log, busy" FontSize="11.5" FontWeight="Normal" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Helix.TextSubtle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Layout" AutomationProperties.Name="Layout">
                            <StackPanel>
                                <TextBlock Text="Layout" />
                                <TextBlock Text="Card, stat, empty state, avatar, carousel, drawer" FontSize="11.5" FontWeight="Normal" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Helix.TextSubtle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Navigation" AutomationProperties.Name="Navigation">
                            <StackPanel>
                                <TextBlock Text="Navigation" />
                                <TextBlock Text="Tabs, accordion, breadcrumb, pagination, stepper, menus" FontSize="11.5" FontWeight="Normal" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Helix.TextSubtle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Data" AutomationProperties.Name="Data">
                            <StackPanel>
                                <TextBlock Text="Data" />
                                <TextBlock Text="Data grid, filter bar, grouping, export" FontSize="11.5" FontWeight="Normal" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Helix.TextSubtle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Charts" AutomationProperties.Name="Charts">
                            <StackPanel>
                                <TextBlock Text="Charts" />
                                <TextBlock Text="Chart, donut, gauge, heatmap, bar list" FontSize="11.5" FontWeight="Normal" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Helix.TextSubtle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Planning" AutomationProperties.Name="Planning">
                            <StackPanel>
                                <TextBlock Text="Planning" />
                                <TextBlock Text="Timeline" FontSize="11.5" FontWeight="Normal" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Helix.TextSubtle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Board" AutomationProperties.Name="Dashboard &amp; boards">
                            <StackPanel>
                                <TextBlock Text="Dashboard &amp; boards" />
                                <TextBlock Text="Dashboard, kanban, sortable list, tree view" FontSize="11.5" FontWeight="Normal" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Helix.TextSubtle}" />
                            </StackPanel>
                        </ListBoxItem>
                        <ListBoxItem Tag="Customization" AutomationProperties.Name="Customization">
                            <StackPanel>
                                <TextBlock Text="Customization" />
                                <TextBlock Text="Theme, palette, defaults, texts" FontSize="11.5" FontWeight="Normal" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Helix.TextSubtle}" />
                            </StackPanel>
                        </ListBoxItem>
                    </ListBox>
                </DockPanel>
            </Border>

            <ScrollViewer x:Name="Scroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                <ContentControl x:Name="PageHost" Margin="48,40,48,48" MaxWidth="980" HorizontalAlignment="Left" Focusable="False" />
            </ScrollViewer>
        </Grid>
    </helix:HelixHost>
</Window>
