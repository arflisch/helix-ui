<UserControl x:Class="Helix.Wpf.Demo.Pages.ChartsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Charts" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="One Y axis, series colors in a fixed order, a legend that hides series, and a hover with the exact values. Colors follow the light or dark theme." />

        <Border Style="{StaticResource Stage}">
            <helix:HelixChart x:Name="Power" Title="Production and forecast" Subtitle="Today, by hour" Unit="MW" ShowNow="True" PlotHeight="280">
                <helix:HelixChartSeries x:Name="Actual" Name="Production" Type="Area" />
                <helix:HelixChartSeries x:Name="Forecast" Name="Forecast" IsDashed="True" />
                <helix:HelixChart.Lines>
                    <helix:HelixChartLine Y="400" Label="Contract" Color="danger" />
                </helix:HelixChart.Lines>
            </helix:HelixChart>
        </Border>

        <Border Style="{StaticResource Stage}">
            <helix:HelixChart x:Name="Monthly" Title="Sales by month" Subtitle="Grouped bars, one tone per year" Unit="k€" PlotHeight="240">
                <helix:HelixChartSeries x:Name="Y2025" Name="2025" Type="Bar" />
                <helix:HelixChartSeries x:Name="Y2026" Name="2026" Type="Bar" />
            </helix:HelixChart>
        </Border>

        <UniformGrid Columns="2" Margin="0,0,0,32">
            <Border Style="{StaticResource Stage}" Margin="0,0,12,0">
                <helix:HelixDonut x:Name="Mix" Title="Energy mix" Unit="GWh" />
            </Border>
            <Border Style="{StaticResource Stage}" Margin="12,0,0,0">
                <StackPanel>
                    <TextBlock Text="Grid load" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" Margin="0,0,0,12" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <helix:HelixGauge x:Name="Load" Value="72" Unit="%" Label="Load" Size="170" Margin="0,0,16,0" />
                        <helix:HelixGauge Value="38" Unit="°C" Label="Temperature" Maximum="60" Size="170" Accent="#0EA5E9" />
                    </StackPanel>
                    <helix:HelixSlider Minimum="0" Maximum="100" Value="{Binding Value, ElementName=Load, Mode=TwoWay}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Style="{StaticResource Stage}">
            <helix:HelixDonut x:Name="Share" Title="Share of sources" Shape="SegmentedBar" Unit="%" ValueFormat="0" Thickness="16" />
        </Border>

        <Border Style="{StaticResource Stage}">
            <helix:HelixHeatmap x:Name="Heat" Title="Consumption by hour" Unit="MW" ColumnLabelEvery="3" />
        </Border>

        <Border Style="{StaticResource Stage}">
            <helix:HelixHeatmap x:Name="Delta" Title="Gap to target (diverging)" Unit="%" IsDiverging="True" ShowValues="True" />
        </Border>

        <Border Style="{StaticResource Stage}">
            <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Text="Most viewed pages" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" Margin="0,0,0,12" />
                <helix:HelixBarList x:Name="Pages" Limit="5" LabelHeader="Page" ValueHeader="Vues" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
