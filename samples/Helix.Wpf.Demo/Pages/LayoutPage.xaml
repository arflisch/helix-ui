<UserControl x:Class="Helix.Wpf.Demo.Pages.LayoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Mise en page" />
        <TextBlock Style="{StaticResource PageLead}" Text="Cartes, chiffres clés et états vides pour composer des écrans propres sans effort." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Card" />
        <UniformGrid Columns="2" Margin="0,0,0,32">
            <helix:HelixCard Title="Production du jour" Subtitle="Mise à jour il y a 2 min" Margin="0,0,12,0">
                <helix:HelixCard.Actions>
                    <helix:HelixButton Icon="refresh" Variant="Ghost" Tone="Neutral" Padding="0" Width="32" Height="32" ToolTip="Actualiser" />
                </helix:HelixCard.Actions>
                <StackPanel>
                    <helix:HelixProgress Label="Objectif" ShowValue="True" Value="72" Margin="0,0,0,14" />
                    <helix:HelixProgress Label="Disponibilité" ShowValue="True" Value="96" Tone="Success" />
                </StackPanel>
                <helix:HelixCard.Footer>
                    <StackPanel Orientation="Horizontal">
                        <helix:HelixButton Content="Détails" Variant="Ghost" Tone="Neutral" Size="Sm" />
                        <helix:HelixButton Content="Exporter" Icon="download" Size="Sm" Margin="8,0,0,0" />
                    </StackPanel>
                </helix:HelixCard.Footer>
            </helix:HelixCard>
            <helix:HelixCard Title="Carte en relief" Subtitle="IsElevated : ombre douce, sans bordure." IsElevated="True" Margin="12,0,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}"
                           Text="Padding, CornerRadius, Background et BorderBrush se règlent directement sur la carte." />
            </helix:HelixCard>
        </UniformGrid>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Stat" />
        <TextBlock Style="{StaticResource SectionText}" Text="HigherIsBetter=False pour un coût ou un délai : une hausse s'affiche alors en rouge." />
        <Border Style="{StaticResource Stage}">
            <UniformGrid Columns="4">
                <helix:HelixStat Label="Production" Value="1 284" Unit="MWh" Delta="12.5" Icon="zap" Margin="0,0,16,0" />
                <helix:HelixStat Label="Disponibilité" Value="96,4" Unit="%" Delta="0" Margin="0,0,16,0" />
                <helix:HelixStat Label="Coût moyen" Value="82" Unit="€/MWh" Delta="4.2" HigherIsBetter="False" Margin="0,0,16,0" />
                <helix:HelixStat Label="Incidents" Value="3" Delta="-40" HigherIsBetter="False" />
            </UniformGrid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="EmptyState" />
        <Border Style="{StaticResource Stage}">
            <helix:HelixEmptyState Icon="search" Title="Aucun résultat" Description="Aucun rapport ne correspond à ces filtres. Essayez une autre période.">
                <helix:HelixEmptyState.Actions>
                    <helix:HelixButton Content="Effacer les filtres" Variant="Soft" />
                </helix:HelixEmptyState.Actions>
            </helix:HelixEmptyState>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Avatar et Skeleton" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel Margin="0,0,0,20">
                    <helix:HelixAvatar DisplayName="Camille Martin" Size="Sm" Margin="0,0,10,0" />
                    <helix:HelixAvatar DisplayName="Léo Bernard" Status="Online" Margin="0,0,10,0" />
                    <helix:HelixAvatar DisplayName="Inès Petit" Size="Lg" Status="Busy" Margin="0,0,10,0" />
                    <helix:HelixAvatar DisplayName="Hugo Robert" Size="Lg" CornerRadius="10" Accent="#18181B" Margin="0,0,24,0" />
                    <helix:HelixAvatarGroup Max="3">
                        <helix:HelixAvatar DisplayName="Chloé Richard" />
                        <helix:HelixAvatar DisplayName="Nathan Durand" />
                        <helix:HelixAvatar DisplayName="Emma Moreau" />
                        <helix:HelixAvatar DisplayName="Lucas Simon" />
                        <helix:HelixAvatar DisplayName="Jade Michel" />
                    </helix:HelixAvatarGroup>
                </WrapPanel>
                <DockPanel MaxWidth="420" HorizontalAlignment="Left">
                    <helix:HelixSkeleton DockPanel.Dock="Left" IsCircle="True" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top" />
                    <helix:HelixSkeleton Lines="3" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Splitter" />
        <Border Style="{StaticResource Stage}" Padding="0" Height="180">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Panneau gauche" Margin="20" Foreground="{DynamicResource Helix.TextMuted}" />
                <helix:HelixSplitter Grid.Column="1" />
                <TextBlock Grid.Column="2" Text="Panneau droit : glissez la poignée." Margin="20" Foreground="{DynamicResource Helix.TextMuted}" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Carousel" />
        <Border Style="{StaticResource Stage}">
            <helix:HelixCarousel SlidesPerView="2" Autoplay="True">
                <Border Height="140" CornerRadius="12" Background="{DynamicResource Helix.Series1}">
                    <TextBlock Text="Lyon" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Height="140" CornerRadius="12" Background="{DynamicResource Helix.Series2}">
                    <TextBlock Text="Grenoble" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Height="140" CornerRadius="12" Background="{DynamicResource Helix.Series3}">
                    <TextBlock Text="Marseille" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Height="140" CornerRadius="12" Background="{DynamicResource Helix.Series7}">
                    <TextBlock Text="Lille" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </helix:HelixCarousel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Drawer" />
        <Border Style="{StaticResource Stage}">
            <WrapPanel>
                <helix:HelixButton Content="Ouvrir à droite" Variant="Outline" Tone="Neutral" Click="OnOpenRight" Margin="0,0,10,0" />
                <helix:HelixButton Content="Ouvrir en bas" Variant="Outline" Tone="Neutral" Click="OnOpenBottom" />
            </WrapPanel>
        </Border>

        <helix:HelixDrawer x:Name="Filters" Title="Filtres" Description="Affinez la liste des sites.">
            <StackPanel>
                <helix:HelixSelect Label="Région" SelectedIndex="0" Margin="0,0,0,16">
                    <ComboBoxItem Content="Toutes" />
                    <ComboBoxItem Content="Auvergne-Rhône-Alpes" />
                    <ComboBoxItem Content="Occitanie" />
                </helix:HelixSelect>
                <helix:HelixSwitch Content="Seulement les sites actifs" IsChecked="True" Margin="0,0,0,16" />
                <helix:HelixSlider Minimum="0" Maximum="500" Value="120" />
            </StackPanel>
            <helix:HelixDrawer.Footer>
                <StackPanel Orientation="Horizontal">
                    <helix:HelixButton Content="Réinitialiser" Variant="Ghost" Tone="Neutral" />
                    <helix:HelixButton Content="Appliquer" Margin="8,0,0,0" Click="OnApply" />
                </StackPanel>
            </helix:HelixDrawer.Footer>
        </helix:HelixDrawer>
    </StackPanel>
</UserControl>
