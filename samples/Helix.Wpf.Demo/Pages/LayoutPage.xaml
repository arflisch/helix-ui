<UserControl x:Class="Helix.Wpf.Demo.Pages.LayoutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Layout" />
        <TextBlock Style="{StaticResource PageLead}" Text="Cards, key figures and empty states to build clean screens with no effort." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Card" />
        <UniformGrid Columns="2" Margin="0,0,0,32">
            <helix:HelixCard Title="Today's production" Subtitle="Updated 2 min ago" Margin="0,0,12,0">
                <helix:HelixCard.Actions>
                    <helix:HelixButton Icon="refresh" Variant="Ghost" Tone="Neutral" Padding="0" Width="32" Height="32" ToolTip="Refresh" />
                </helix:HelixCard.Actions>
                <StackPanel>
                    <helix:HelixProgress Label="Target" ShowValue="True" Value="72" Margin="0,0,0,14" />
                    <helix:HelixProgress Label="Availability" ShowValue="True" Value="96" Tone="Success" />
                </StackPanel>
                <helix:HelixCard.Footer>
                    <StackPanel Orientation="Horizontal">
                        <helix:HelixButton Content="Details" Variant="Ghost" Tone="Neutral" Size="Sm" />
                        <helix:HelixButton Content="Export" Icon="download" Size="Sm" Margin="8,0,0,0" />
                    </StackPanel>
                </helix:HelixCard.Footer>
            </helix:HelixCard>
            <helix:HelixCard Title="Elevated card" Subtitle="IsElevated: soft shadow, no border." IsElevated="True" Margin="12,0,0,0">
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}"
                           Text="Padding, CornerRadius, Background and BorderBrush are set directly on the card." />
            </helix:HelixCard>
        </UniformGrid>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Stat" />
        <TextBlock Style="{StaticResource SectionText}" Text="HigherIsBetter=False for a cost or a delay: an increase then shows in red." />
        <Border Style="{StaticResource Stage}">
            <UniformGrid Columns="4">
                <helix:HelixStat Label="Production" Value="1 284" Unit="MWh" Delta="12.5" Icon="zap" Margin="0,0,16,0" />
                <helix:HelixStat Label="Availability" Value="96,4" Unit="%" Delta="0" Margin="0,0,16,0" />
                <helix:HelixStat Label="Average cost" Value="82" Unit="€/MWh" Delta="4.2" HigherIsBetter="False" Margin="0,0,16,0" />
                <helix:HelixStat Label="Incidents" Value="3" Delta="-40" HigherIsBetter="False" />
            </UniformGrid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="EmptyState" />
        <Border Style="{StaticResource Stage}">
            <helix:HelixEmptyState Icon="search" Title="No results" Description="No report matches these filters. Try another period.">
                <helix:HelixEmptyState.Actions>
                    <helix:HelixButton Content="Clear filters" Variant="Soft" />
                </helix:HelixEmptyState.Actions>
            </helix:HelixEmptyState>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Avatar and Skeleton" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel Margin="0,0,0,20">
                    <helix:HelixAvatar DisplayName="Camille Martin" Size="Sm" Margin="0,0,10,0" />
                    <helix:HelixAvatar DisplayName="Léo Bernard" Status="Online" Margin="0,0,10,0" />
                    <helix:HelixAvatar DisplayName="Inès Petit" Size="Lg" Status="Busy" Margin="0,0,10,0" />
                    <helix:HelixAvatar DisplayName="Hugo Robert" Size="Lg" CornerRadius="10" Accent="#18181B" Margin="0,0,24,0" />
                    <helix:HelixAvatarGroup Max="3">
                        <helix:HelixAvatar DisplayName="Chloé Richard" />
                        <helix:HelixAvatar DisplayName="Nathan Durand" />
                        <helix:HelixAvatar DisplayName="Emma Moreau" />
                        <helix:HelixAvatar DisplayName="Lucas Simon" />
                        <helix:HelixAvatar DisplayName="Jade Michel" />
                    </helix:HelixAvatarGroup>
                </WrapPanel>
                <DockPanel MaxWidth="420" HorizontalAlignment="Left">
                    <helix:HelixSkeleton DockPanel.Dock="Left" IsCircle="True" Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Top" />
                    <helix:HelixSkeleton Lines="3" />
                </DockPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Splitter" />
        <Border Style="{StaticResource Stage}" Padding="0" Height="180">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Left panel" Margin="20" Foreground="{DynamicResource Helix.TextMuted}" />
                <helix:HelixSplitter Grid.Column="1" />
                <TextBlock Grid.Column="2" Text="Right panel: drag the handle." Margin="20" Foreground="{DynamicResource Helix.TextMuted}" />
            </Grid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Carousel" />
        <Border Style="{StaticResource Stage}">
            <helix:HelixCarousel SlidesPerView="2" Autoplay="True">
                <Border Height="140" CornerRadius="12" Background="{DynamicResource Helix.Series1}">
                    <TextBlock Text="Lyon" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Height="140" CornerRadius="12" Background="{DynamicResource Helix.Series2}">
                    <TextBlock Text="Grenoble" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Height="140" CornerRadius="12" Background="{DynamicResource Helix.Series3}">
                    <TextBlock Text="Marseille" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <Border Height="140" CornerRadius="12" Background="{DynamicResource Helix.Series7}">
                    <TextBlock Text="Lille" FontSize="22" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </helix:HelixCarousel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Drawer" />
        <Border Style="{StaticResource Stage}">
            <WrapPanel>
                <helix:HelixButton Content="Open on the right" Variant="Outline" Tone="Neutral" Click="OnOpenRight" Margin="0,0,10,0" />
                <helix:HelixButton Content="Open at the bottom" Variant="Outline" Tone="Neutral" Click="OnOpenBottom" />
            </WrapPanel>
        </Border>

        <helix:HelixDrawer x:Name="Filters" Title="Filters" Description="Narrow down the list of sites.">
            <StackPanel>
                <helix:HelixSelect Label="Region" SelectedIndex="0" Margin="0,0,0,16">
                    <ComboBoxItem Content="All" />
                    <ComboBoxItem Content="Auvergne-Rhône-Alpes" />
                    <ComboBoxItem Content="Occitanie" />
                </helix:HelixSelect>
                <helix:HelixSwitch Content="Only active sites" IsChecked="True" Margin="0,0,0,16" />
                <helix:HelixSlider Minimum="0" Maximum="500" Value="120" />
            </StackPanel>
            <helix:HelixDrawer.Footer>
                <StackPanel Orientation="Horizontal">
                    <helix:HelixButton Content="Reset" Variant="Ghost" Tone="Neutral" />
                    <helix:HelixButton Content="Apply" Margin="8,0,0,0" Click="OnApply" />
                </StackPanel>
            </helix:HelixDrawer.Footer>
        </helix:HelixDrawer>
    </StackPanel>
</UserControl>
