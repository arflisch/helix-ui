<UserControl x:Class="Helix.Wpf.Demo.Pages.DataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="DataGrid" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Recherche, tri sur toutes les pages, pagination, choix des colonnes, densité et lignes alternées. En mémoire avec Source, ou côté serveur avec ItemsProvider." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="En mémoire" />
        <helix:HelixFilterBar x:Name="Filters" Target="{Binding ElementName=Grid}" Margin="0,0,0,8">
            <helix:HelixTextFilter Key="q" Placeholder="Nom ou site" Paths="Name,Site" />
            <helix:HelixChoiceFilter Key="status" Label="Statut" Path="Status" />
            <helix:HelixChoiceFilter Key="site" Label="Site" Path="Site" IsSearchable="True" />
            <helix:HelixDateFilter Key="updated" Label="Mise à jour" Path="Updated" />
        </helix:HelixFilterBar>
        <helix:HelixDataGrid x:Name="Grid" IsSearchable="True" ShowColumnChooser="True" IsStriped="True" PageSize="8" AutoGenerateColumns="False"
                           Height="460" Margin="0,0,0,32" IsReadOnly="True">
            <helix:HelixDataGrid.Toolbar>
                <helix:HelixButtonGroup x:Name="Density" SelectedIndex="1" SelectionChanged="OnDensity">
                    <ListBoxItem Content="Compact" />
                    <ListBoxItem Content="Normal" />
                    <ListBoxItem Content="Large" />
                </helix:HelixButtonGroup>
            </helix:HelixDataGrid.Toolbar>
            <helix:HelixDataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="120" />
                <DataGridTextColumn Header="Puissance (MW)" Binding="{Binding Power, StringFormat=N0}" Width="130" />
                <DataGridTemplateColumn Header="Statut" Width="130" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <helix:HelixBadge Content="{Binding Status}" Tone="{Binding Tone}" ShowDot="True" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Mise à jour" Binding="{Binding Updated, StringFormat=dd/MM HH:mm}" Width="120" />
            </helix:HelixDataGrid.Columns>
        </helix:HelixDataGrid>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Groupes, totaux, détail et export" />
        <TextBlock Style="{StaticResource SectionText}"
                   Text="GroupBy regroupe les lignes (en-têtes repliables avec nombre et sous-totaux), helix:HelixDataGrid.Aggregate ajoute une ligne de total, HelixDetailsColumn ouvre le détail d'une ligne, HelixBadgeColumn et HelixSignedColumn affichent un statut et une variation. IsExportable ajoute l'export CSV." />
        <helix:HelixDataGrid x:Name="GroupedGrid" GroupBy="Site" PageSize="0" IsExportable="True" ExportFileName="unites" AutoGenerateColumns="False"
                           Height="480" Margin="0,0,0,32" IsReadOnly="True">
            <helix:HelixDataGrid.Columns>
                <helix:HelixDetailsColumn />
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" helix:HelixDataGrid.Aggregate="Count" />
                <helix:HelixBadgeColumn Header="Statut" Binding="{Binding Status}" ToneBinding="{Binding Tone}" Width="130" SortMemberPath="Status" />
                <DataGridTextColumn Header="Puissance" Binding="{Binding Power, StringFormat=N0}" Width="140"
                                    helix:HelixDataGrid.Aggregate="Sum" helix:HelixDataGrid.Unit="MW" />
                <helix:HelixSignedColumn Header="Variation" Binding="{Binding Change}" Format="0.0'%'" Width="120" />
            </helix:HelixDataGrid.Columns>
            <helix:HelixDataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Margin="52,0,16,12" Padding="14,12" CornerRadius="10" Background="{DynamicResource Helix.Surface2}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Id, StringFormat=Unité n° {0}}" Margin="0,0,28,0" />
                            <TextBlock Text="{Binding Updated, StringFormat=Mise à jour le {0:dd/MM à HH:mm}}" Foreground="{DynamicResource Helix.TextMuted}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </helix:HelixDataGrid.RowDetailsTemplate>
        </helix:HelixDataGrid>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Côté serveur" />
        <TextBlock Style="{StaticResource SectionText}" Text="ItemsProvider reçoit (recherche, tri, page) et un CancellationToken : la requête précédente est annulée quand on tape vite. Ici, un faux serveur avec 600 ms de latence et 10 000 lignes." />
        <helix:HelixDataGrid x:Name="ServerGrid" IsSearchable="True" PageSize="10" AutoGenerateColumns="False" Height="500" IsReadOnly="True">
            <helix:HelixDataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="80" />
                <DataGridTextColumn Header="Client" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Ville" Binding="{Binding Site}" Width="140" />
                <DataGridTextColumn Header="Montant (€)" Binding="{Binding Power, StringFormat=N0}" Width="130" />
            </helix:HelixDataGrid.Columns>
        </helix:HelixDataGrid>
    </StackPanel>
</UserControl>
