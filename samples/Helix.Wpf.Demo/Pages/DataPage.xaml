<UserControl x:Class="Helix.Wpf.Demo.Pages.DataPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="DataGrid" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Search, sorting across pages, paging, column chooser, density and striped rows. In memory with Source, or server side with ItemsProvider." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="In memory" />
        <helix:HelixFilterBar x:Name="Filters" Target="{Binding ElementName=Grid}" Margin="0,0,0,8">
            <helix:HelixTextFilter Key="q" Placeholder="Name or site" Paths="Name,Site" />
            <helix:HelixChoiceFilter Key="status" Label="Status" Path="Status" />
            <helix:HelixChoiceFilter Key="site" Label="Site" Path="Site" IsSearchable="True" />
            <helix:HelixDateFilter Key="updated" Label="Updated" Path="Updated" />
            <helix:HelixToggleFilter x:Name="HighPower" Key="high" Label="100 MW or more" />
        </helix:HelixFilterBar>
        <helix:HelixDataGrid x:Name="Grid" IsSearchable="True" ShowColumnChooser="True" IsStriped="True" PageSize="8" AutoGenerateColumns="False"
                           Height="460" Margin="0,0,0,32" IsReadOnly="True">
            <helix:HelixDataGrid.Toolbar>
                <helix:HelixButtonGroup x:Name="Density" SelectedIndex="1" SelectionChanged="OnDensity">
                    <ListBoxItem Content="Compact" />
                    <ListBoxItem Content="Normal" />
                    <ListBoxItem Content="Large" />
                </helix:HelixButtonGroup>
            </helix:HelixDataGrid.Toolbar>
            <helix:HelixDataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="120" />
                <DataGridTextColumn Header="Power (MW)" Binding="{Binding Power, StringFormat=N0}" Width="130" />
                <DataGridTemplateColumn Header="Status" Width="130" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <helix:HelixBadge Content="{Binding Status}" Tone="{Binding Tone}" ShowDot="True" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Updated" Binding="{Binding Updated, StringFormat=dd/MM HH:mm}" Width="120" />
            </helix:HelixDataGrid.Columns>
        </helix:HelixDataGrid>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Groups, totals, details and export" />
        <TextBlock Style="{StaticResource SectionText}"
                   Text="GroupBy groups the rows (collapsible headers with counts and subtotals), helix:HelixDataGrid.Aggregate adds a totals row, HelixDetailsColumn opens a row's details, HelixBadgeColumn and HelixSignedColumn show a status and a change. IsExportable adds the export." />
        <helix:HelixDataGrid x:Name="GroupedGrid" GroupBy="Site" PageSize="0" IsExportable="True" ExportFormats="All" ExportFileName="unites" AutoGenerateColumns="False"
                           Height="480" Margin="0,0,0,32" IsReadOnly="True">
            <helix:HelixDataGrid.Columns>
                <helix:HelixDetailsColumn />
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" helix:HelixDataGrid.Aggregate="Count" />
                <helix:HelixBadgeColumn Header="Status" Binding="{Binding Status}" ToneBinding="{Binding Tone}" Width="130" SortMemberPath="Status" />
                <DataGridTextColumn Header="Power" Binding="{Binding Power, StringFormat=N0}" Width="140"
                                    helix:HelixDataGrid.Aggregate="Sum" helix:HelixDataGrid.Unit="MW" />
                <helix:HelixSignedColumn Header="Variation" Binding="{Binding Change}" Format="0.0'%'" Width="120" />
            </helix:HelixDataGrid.Columns>
            <helix:HelixDataGrid.RowDetailsTemplate>
                <DataTemplate>
                    <Border Margin="52,0,16,12" Padding="14,12" CornerRadius="10" Background="{DynamicResource Helix.Surface2}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Id, StringFormat=Unit {0}}" Margin="0,0,28,0" />
                            <TextBlock Text="{Binding Updated, StringFormat=Updated {0:dd/MM HH:mm}}" Foreground="{DynamicResource Helix.TextMuted}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </helix:HelixDataGrid.RowDetailsTemplate>
        </helix:HelixDataGrid>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Server side" />
        <TextBlock Style="{StaticResource SectionText}" Text="ItemsProvider receives (search, sort, page) and a CancellationToken: the previous request is cancelled when you type fast. Here, a fake server with 600 ms latency and 10,000 rows." />
        <helix:HelixDataGrid x:Name="ServerGrid" IsSearchable="True" PageSize="10" AutoGenerateColumns="False" Height="500" IsReadOnly="True">
            <helix:HelixDataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Id}" Width="80" />
                <DataGridTextColumn Header="Customer" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="City" Binding="{Binding Site}" Width="140" />
                <DataGridTextColumn Header="Amount (€)" Binding="{Binding Power, StringFormat=N0}" Width="130" />
            </helix:HelixDataGrid.Columns>
        </helix:HelixDataGrid>
    </StackPanel>
</UserControl>
