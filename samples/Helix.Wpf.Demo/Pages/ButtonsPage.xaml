<UserControl x:Class="Helix.Wpf.Demo.Pages.ButtonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Buttons" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Four variants, six theme tones or any color, three sizes, icons and a loading state. Every part is a property: no template to copy." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Variants" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel>
                    <helix:HelixButton Content="Solid" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Soft" Variant="Soft" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Outline" Variant="Outline" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Ghost" Variant="Ghost" Margin="0,0,10,10" />
                </WrapPanel>
                <TextBox Style="{StaticResource Code}" Text="&lt;helix:HelixButton Content=&quot;Soft&quot; Variant=&quot;Soft&quot; /&gt;" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Tones and any color" />
        <TextBlock Style="{StaticResource SectionText}" Text="Tone follows the theme (light or dark). Accent takes any color; the text turns black or white for contrast." />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel>
                    <helix:HelixButton Content="Primary" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Neutral" Tone="Neutral" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Success" Tone="Success" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Warning" Tone="Warning" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Danger" Tone="Danger" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Info" Tone="Info" Margin="0,0,10,10" />
                </WrapPanel>
                <WrapPanel>
                    <helix:HelixButton Content="#FF8A00" Accent="#FF8A00" Margin="0,0,10,10" />
                    <helix:HelixButton Content="#A3E635" Accent="#A3E635" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Soft #EC4899" Accent="#EC4899" Variant="Soft" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Outline danger" Tone="Danger" Variant="Outline" Margin="0,0,10,10" />
                </WrapPanel>
                <TextBox Style="{StaticResource Code}" Text="&lt;helix:HelixButton Content=&quot;Delete&quot; Tone=&quot;Danger&quot; /&gt;&#10;&lt;helix:HelixButton Content=&quot;Send&quot; Accent=&quot;#FF8A00&quot; /&gt;" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Sizes, icons, rounding" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <helix:HelixButton Content="Sm" Size="Sm" Margin="0,0,10,10" VerticalAlignment="Center" />
                    <helix:HelixButton Content="Md" Margin="0,0,10,10" VerticalAlignment="Center" />
                    <helix:HelixButton Content="Lg" Size="Lg" Margin="0,0,10,10" VerticalAlignment="Center" />
                    <helix:HelixButton Content="Download" Icon="download" Variant="Outline" Tone="Neutral" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Continue" IconEnd="arrow-right" Margin="0,0,10,10" />
                    <helix:HelixButton Icon="settings" Variant="Ghost" Tone="Neutral" Padding="0" Width="38" ToolTip="Settings" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Pill" CornerRadius="999" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Square" CornerRadius="0" Tone="Neutral" Margin="0,0,10,10" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Loading" />
        <TextBlock Style="{StaticResource SectionText}" Text="IsLoading keeps the button's width, shows a spinner and ignores clicks." />
        <Border Style="{StaticResource Stage}">
            <WrapPanel>
                <helix:HelixButton x:Name="SaveButton" Content="Enregistrer" Icon="check" Click="OnSave" Margin="0,0,10,0" />
                <helix:HelixButton Content="Disabled" IsEnabled="False" Margin="0,0,10,0" />
            </WrapPanel>
        </Border>
    </StackPanel>
</UserControl>
