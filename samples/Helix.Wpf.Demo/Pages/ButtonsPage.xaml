<UserControl x:Class="Helix.Wpf.Demo.Pages.ButtonsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Boutons" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Quatre variantes, six tons du thème ou n'importe quelle couleur, trois tailles, des icônes et un état de chargement. Chaque partie est une propriété : aucun template à copier." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Variantes" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel>
                    <helix:HelixButton Content="Solid" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Soft" Variant="Soft" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Outline" Variant="Outline" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Ghost" Variant="Ghost" Margin="0,0,10,10" />
                </WrapPanel>
                <TextBox Style="{StaticResource Code}" Text="&lt;helix:HelixButton Content=&quot;Soft&quot; Variant=&quot;Soft&quot; /&gt;" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Tons et couleur libre" />
        <TextBlock Style="{StaticResource SectionText}" Text="Tone suit le thème (clair ou sombre). Accent accepte n'importe quelle couleur ; le texte devient noir ou blanc selon le contraste." />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel>
                    <helix:HelixButton Content="Primary" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Neutral" Tone="Neutral" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Success" Tone="Success" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Warning" Tone="Warning" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Danger" Tone="Danger" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Info" Tone="Info" Margin="0,0,10,10" />
                </WrapPanel>
                <WrapPanel>
                    <helix:HelixButton Content="#FF8A00" Accent="#FF8A00" Margin="0,0,10,10" />
                    <helix:HelixButton Content="#A3E635" Accent="#A3E635" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Soft #EC4899" Accent="#EC4899" Variant="Soft" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Outline danger" Tone="Danger" Variant="Outline" Margin="0,0,10,10" />
                </WrapPanel>
                <TextBox Style="{StaticResource Code}" Text="&lt;helix:HelixButton Content=&quot;Supprimer&quot; Tone=&quot;Danger&quot; /&gt;&#10;&lt;helix:HelixButton Content=&quot;Envoyer&quot; Accent=&quot;#FF8A00&quot; /&gt;" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Tailles, icônes, arrondi" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <helix:HelixButton Content="Sm" Size="Sm" Margin="0,0,10,10" VerticalAlignment="Center" />
                    <helix:HelixButton Content="Md" Margin="0,0,10,10" VerticalAlignment="Center" />
                    <helix:HelixButton Content="Lg" Size="Lg" Margin="0,0,10,10" VerticalAlignment="Center" />
                    <helix:HelixButton Content="Télécharger" Icon="download" Variant="Outline" Tone="Neutral" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Continuer" IconEnd="arrow-right" Margin="0,0,10,10" />
                    <helix:HelixButton Icon="settings" Variant="Ghost" Tone="Neutral" Padding="0" Width="38" ToolTip="Réglages" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Pilule" CornerRadius="999" Margin="0,0,10,10" />
                    <helix:HelixButton Content="Carré" CornerRadius="0" Tone="Neutral" Margin="0,0,10,10" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Chargement" />
        <TextBlock Style="{StaticResource SectionText}" Text="IsLoading garde la largeur du bouton, affiche un spinner et ignore les clics." />
        <Border Style="{StaticResource Stage}">
            <WrapPanel>
                <helix:HelixButton x:Name="SaveButton" Content="Enregistrer" Icon="check" Click="OnSave" Margin="0,0,10,0" />
                <helix:HelixButton Content="Disabled" IsEnabled="False" Margin="0,0,10,0" />
            </WrapPanel>
        </Border>
    </StackPanel>
</UserControl>
