<UserControl x:Class="Helix.Wpf.Demo.Pages.NavigationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Navigation" />
        <TextBlock Style="{StaticResource PageLead}" Text="Tabs, collapsible sections, breadcrumb, segmented buttons, pagination, steps and menus." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Tabs" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <helix:HelixTabs Margin="0,0,0,24">
                    <helix:HelixTab Header="Preview" Icon="layout">
                        <TextBlock Text="Underline: the default style." Foreground="{DynamicResource Helix.TextMuted}" />
                    </helix:HelixTab>
                    <helix:HelixTab Header="Activity" Icon="bell">
                        <TextBlock Text="Second tab." Foreground="{DynamicResource Helix.TextMuted}" />
                    </helix:HelixTab>
                    <helix:HelixTab Header="Settings" Icon="settings" />
                </helix:HelixTabs>
                <helix:HelixTabs Variant="Pills" Margin="0,0,0,24">
                    <helix:HelixTab Header="Day" />
                    <helix:HelixTab Header="Week" />
                    <helix:HelixTab Header="Month" />
                </helix:HelixTabs>
                <helix:HelixTabs Variant="Segmented">
                    <helix:HelixTab Header="List" Icon="menu" />
                    <helix:HelixTab Header="Table" Icon="columns" />
                    <helix:HelixTab Header="Calendar" Icon="calendar" />
                </helix:HelixTabs>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Accordion" />
        <Border Style="{StaticResource Stage}">
            <helix:HelixAccordion MaxWidth="560" HorizontalAlignment="Left">
                <helix:HelixAccordionItem Header="Delivery" Subtitle="Times and areas" Icon="download" IsExpanded="True">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}" Text="Delivery in 48 h everywhere in mainland France." />
                </helix:HelixAccordionItem>
                <helix:HelixAccordionItem Header="Feedback" Icon="refresh">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}" Text="30 days to change your mind." />
                </helix:HelixAccordionItem>
                <helix:HelixAccordionItem Header="Payment" Icon="lock">
                    <helix:HelixAccordionItem.Extra>
                        <helix:HelixBadge Content="Secure" Tone="Success" />
                    </helix:HelixAccordionItem.Extra>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}" Text="Card, transfer or direct debit." />
                </helix:HelixAccordionItem>
            </helix:HelixAccordion>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Breadcrumb, ButtonGroup, Pagination" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <helix:HelixBreadcrumb x:Name="Crumbs" MaxItems="4" Margin="0,0,0,20" />
                <helix:HelixButtonGroup SelectedIndex="1" Margin="0,0,0,20">
                    <ListBoxItem Content="Day" />
                    <ListBoxItem Content="Week" />
                    <ListBoxItem Content="Month" />
                    <ListBoxItem Content="Year" />
                </helix:HelixButtonGroup>
                <helix:HelixPagination TotalItems="87" PageSize="10" Page="2" ShowInfo="True" ShowLabels="True" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Stepper" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <helix:HelixStepper x:Name="Steps" ActiveIndex="2" IsClickable="True" Margin="0,0,0,24" />
                <helix:HelixStepper x:Name="StepsVertical" Orientation="Vertical" ActiveIndex="1" Width="320" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Menu" />
        <Border Style="{StaticResource Stage}">
            <WrapPanel>
                <helix:HelixMenuButton Content="Actions" IconEnd="chevron-down" Variant="Outline" Tone="Neutral" Margin="0,0,10,0">
                    <helix:HelixMenuButton.Menu>
                        <helix:HelixContextMenu>
                            <helix:HelixMenuLabel Text="DOCUMENT" />
                            <helix:HelixMenuItem Header="Edit" IconName="edit" Shortcut="Ctrl+E" />
                            <helix:HelixMenuItem Header="Duplicate" IconName="copy" Shortcut="Ctrl+D" />
                            <helix:HelixMenuItem Header="Export" IconName="download" Description="PDF or Excel" />
                            <helix:HelixMenuSeparator />
                            <helix:HelixMenuItem Header="Delete" IconName="trash" IsDanger="True" />
                        </helix:HelixContextMenu>
                    </helix:HelixMenuButton.Menu>
                </helix:HelixMenuButton>
                <Border Padding="16,10" CornerRadius="10" Background="{DynamicResource Helix.Surface2}">
                    <Border.ContextMenu>
                        <helix:HelixContextMenu>
                            <helix:HelixMenuItem Header="Copy" IconName="copy" />
                            <helix:HelixMenuItem Header="Pin" IconName="star" IsCheckable="True" IsChecked="True" />
                        </helix:HelixContextMenu>
                    </Border.ContextMenu>
                    <TextBlock Text="Right-click here" Foreground="{DynamicResource Helix.TextMuted}" />
                </Border>
            </WrapPanel>
        </Border>
    </StackPanel>
</UserControl>
