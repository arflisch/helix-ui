<UserControl x:Class="Helix.Wpf.Demo.Pages.NavigationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Navigation" />
        <TextBlock Style="{StaticResource PageLead}" Text="Onglets, sections dépliables, fil d'Ariane, boutons segmentés, pagination, étapes et menus." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Tabs" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <helix:HelixTabs Margin="0,0,0,24">
                    <helix:HelixTab Header="Aperçu" Icon="layout">
                        <TextBlock Text="Underline : le style par défaut." Foreground="{DynamicResource Helix.TextMuted}" />
                    </helix:HelixTab>
                    <helix:HelixTab Header="Activité" Icon="bell">
                        <TextBlock Text="Deuxième onglet." Foreground="{DynamicResource Helix.TextMuted}" />
                    </helix:HelixTab>
                    <helix:HelixTab Header="Réglages" Icon="settings" />
                </helix:HelixTabs>
                <helix:HelixTabs Variant="Pills" Margin="0,0,0,24">
                    <helix:HelixTab Header="Jour" />
                    <helix:HelixTab Header="Semaine" />
                    <helix:HelixTab Header="Mois" />
                </helix:HelixTabs>
                <helix:HelixTabs Variant="Segmented">
                    <helix:HelixTab Header="Liste" Icon="menu" />
                    <helix:HelixTab Header="Tableau" Icon="columns" />
                    <helix:HelixTab Header="Calendrier" Icon="calendar" />
                </helix:HelixTabs>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Accordion" />
        <Border Style="{StaticResource Stage}">
            <helix:HelixAccordion MaxWidth="560" HorizontalAlignment="Left">
                <helix:HelixAccordionItem Header="Livraison" Subtitle="Délais et zones" Icon="download" IsExpanded="True">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}" Text="Livraison en 48 h partout en France métropolitaine." />
                </helix:HelixAccordionItem>
                <helix:HelixAccordionItem Header="Retours" Icon="refresh">
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}" Text="30 jours pour changer d'avis." />
                </helix:HelixAccordionItem>
                <helix:HelixAccordionItem Header="Paiement" Icon="lock">
                    <helix:HelixAccordionItem.Extra>
                        <helix:HelixBadge Content="Sécurisé" Tone="Success" />
                    </helix:HelixAccordionItem.Extra>
                    <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}" Text="Carte, virement ou prélèvement." />
                </helix:HelixAccordionItem>
            </helix:HelixAccordion>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Breadcrumb, ButtonGroup, Pagination" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <helix:HelixBreadcrumb x:Name="Crumbs" MaxItems="4" Margin="0,0,0,20" />
                <helix:HelixButtonGroup SelectedIndex="1" Margin="0,0,0,20">
                    <ListBoxItem Content="Jour" />
                    <ListBoxItem Content="Semaine" />
                    <ListBoxItem Content="Mois" />
                    <ListBoxItem Content="Année" />
                </helix:HelixButtonGroup>
                <helix:HelixPagination TotalItems="87" PageSize="10" Page="2" ShowInfo="True" ShowLabels="True" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Stepper" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <helix:HelixStepper x:Name="Steps" ActiveIndex="2" IsClickable="True" Margin="0,0,0,24" />
                <helix:HelixStepper x:Name="StepsVertical" Orientation="Vertical" ActiveIndex="1" Width="320" HorizontalAlignment="Left" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Menu" />
        <Border Style="{StaticResource Stage}">
            <WrapPanel>
                <helix:HelixMenuButton Content="Actions" IconEnd="chevron-down" Variant="Outline" Tone="Neutral" Margin="0,0,10,0">
                    <helix:HelixMenuButton.Menu>
                        <helix:HelixContextMenu>
                            <helix:HelixMenuLabel Text="DOCUMENT" />
                            <helix:HelixMenuItem Header="Modifier" IconName="edit" Shortcut="Ctrl+E" />
                            <helix:HelixMenuItem Header="Dupliquer" IconName="copy" Shortcut="Ctrl+D" />
                            <helix:HelixMenuItem Header="Exporter" IconName="download" Description="PDF ou Excel" />
                            <helix:HelixMenuSeparator />
                            <helix:HelixMenuItem Header="Supprimer" IconName="trash" IsDanger="True" />
                        </helix:HelixContextMenu>
                    </helix:HelixMenuButton.Menu>
                </helix:HelixMenuButton>
                <Border Padding="16,10" CornerRadius="10" Background="{DynamicResource Helix.Surface2}">
                    <Border.ContextMenu>
                        <helix:HelixContextMenu>
                            <helix:HelixMenuItem Header="Copier" IconName="copy" />
                            <helix:HelixMenuItem Header="Épingler" IconName="star" IsCheckable="True" IsChecked="True" />
                        </helix:HelixContextMenu>
                    </Border.ContextMenu>
                    <TextBlock Text="Clic droit ici" Foreground="{DynamicResource Helix.TextMuted}" />
                </Border>
            </WrapPanel>
        </Border>
    </StackPanel>
</UserControl>
