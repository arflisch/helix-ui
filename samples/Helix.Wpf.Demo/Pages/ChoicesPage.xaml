<UserControl x:Class="Helix.Wpf.Demo.Pages.ChoicesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Choices" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Switches, check boxes, radio buttons and sliders. The color of a switch's thumb? A property, ThumbBrush." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="Switch: colors" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel>
                    <helix:HelixSwitch Content="Default" IsChecked="True" Margin="0,0,28,12" />
                    <helix:HelixSwitch Content="Amber thumb" IsChecked="True" ThumbBrush="#F59E0B" Margin="0,0,28,12" />
                    <helix:HelixSwitch Content="Lime" IsChecked="True" Accent="#A3E635" ThumbBrush="#18181B" TrackBrush="#E4E4E7" Margin="0,0,28,12" />
                    <helix:HelixSwitch Content="Danger" IsChecked="True" Tone="Danger" ThumbOnBrush="#FFE4E6" Margin="0,0,28,12" />
                    <helix:HelixSwitch Content="Square" IsChecked="True" CornerRadius="5" Tone="Neutral" Margin="0,0,28,12" />
                </WrapPanel>
                <TextBox Style="{StaticResource Code}" Text="&lt;helix:HelixSwitch Content=&quot;Amber thumb&quot; ThumbBrush=&quot;#F59E0B&quot; IsChecked=&quot;{Binding IsOn}&quot; /&gt;" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Switch: icon or text inside" />
        <TextBlock Style="{StaticResource SectionText}" Text="OnIcon / OffIcon in the thumb, OnText / OffText in the track, which widens for the longest text." />
        <Border Style="{StaticResource Stage}">
            <WrapPanel>
                <helix:HelixSwitch Content="Icons" OnIcon="check" OffIcon="x" IsChecked="True" Margin="0,0,28,12" />
                <helix:HelixSwitch Content="Theme" OnIcon="moon" OffIcon="sun" Accent="#312E81" Margin="0,0,28,12" />
                <helix:HelixSwitch Content="Text" OnText="ON" OffText="OFF" IsChecked="True" Margin="0,0,28,12" />
                <helix:HelixSwitch Content="Pilot" OnText="AUTO" OffText="MANUAL" Accent="#FF8A00" Size="Lg" IsChecked="True" Margin="0,0,28,12" />
            </WrapPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Switch: description and label side" />
        <Border Style="{StaticResource Stage}">
            <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                <helix:HelixSwitch Content="Notifications" Description="Get an email when a report is ready." IsChecked="True" Margin="0,0,0,16" />
                <helix:HelixSwitch Content="Sync" Description="Every night at 2 am." LabelPosition="Start" HorizontalAlignment="Stretch" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="CheckBox and RadioButton" />
        <Border Style="{StaticResource Stage}">
            <UniformGrid Columns="2">
                <StackPanel Margin="0,0,24,0">
                    <helix:HelixCheckBox Content="I accept the terms" IsChecked="True" Margin="0,0,0,12" />
                    <helix:HelixCheckBox Content="Select all" IsThreeState="True" IsChecked="{x:Null}" Margin="0,0,0,12" />
                    <helix:HelixCheckBox Content="Weekly report" Description="Sent on Monday morning." Accent="#10B981" IsChecked="True" Margin="0,0,0,12" />
                    <helix:HelixCheckBox Content="Square corners" CornerRadius="2" Tone="Neutral" IsChecked="True" />
                </StackPanel>
                <StackPanel>
                    <helix:HelixRadioButton Content="Standard" Description="Delivered in 3 to 5 days." GroupName="ship" IsChecked="True" Margin="0,0,0,12" />
                    <helix:HelixRadioButton Content="Express" Description="Delivered tomorrow." GroupName="ship" Margin="0,0,0,12" />
                    <helix:HelixRadioButton Content="Pick up in store" GroupName="ship" Accent="#EC4899" />
                </StackPanel>
            </UniformGrid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="RadioGroup" />
        <TextBlock Style="{StaticResource SectionText}" Text="One choice, as a list, cards or segmented buttons (Appearance). The arrow keys change the option." />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <helix:HelixRadioGroup x:Name="Plans" Label="Plan" Appearance="Cards" Columns="3" SelectedIndex="1"
                                     Hint="Can be changed at any time." Margin="0,0,0,24" />
                <UniformGrid Columns="2">
                    <helix:HelixRadioGroup Label="Delivery" SelectedIndex="0" Margin="0,0,24,0">
                        <helix:HelixRadioItem Content="Standard" Description="3 to 5 days" />
                        <helix:HelixRadioItem Content="Express" Description="Tomorrow" />
                        <helix:HelixRadioItem Content="Pickup" IsEnabled="False" Description="Soon" />
                    </helix:HelixRadioGroup>
                    <helix:HelixRadioGroup Label="Period" Appearance="Segmented" SelectedIndex="1" VerticalAlignment="Top">
                        <helix:HelixRadioItem Content="Day" />
                        <helix:HelixRadioItem Content="Week" />
                        <helix:HelixRadioItem Content="Month" />
                    </helix:HelixRadioGroup>
                </UniformGrid>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Slider" />
        <Border Style="{StaticResource Stage}">
            <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                <DockPanel Margin="0,0,0,6">
                    <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=Volume, StringFormat={}{0:0} %}" Foreground="{DynamicResource Helix.TextMuted}" />
                    <TextBlock Text="Volume" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" />
                </DockPanel>
                <helix:HelixSlider x:Name="Volume" Minimum="0" Maximum="100" Value="60" Margin="0,0,0,20" />
                <helix:HelixSlider Minimum="0" Maximum="100" Value="35" Accent="#FF8A00" TrackBrush="#FFEDD5" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
