<UserControl x:Class="Helix.Wpf.Demo.Pages.CustomizationPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Customization" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Changing the color of a switch's thumb should never require copying a template. Three levels, from the most local to the most global." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="1. A property on the control" />
        <TextBlock Style="{StaticResource SectionText}" Text="Every visual part has its property: Accent, TrackBrush, ThumbBrush, ThumbOnBrush, CornerRadius…" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel>
                    <helix:HelixSwitch Content="Default" IsChecked="True" Margin="0,0,28,0" />
                    <helix:HelixSwitch Content="Amber thumb" IsChecked="True" ThumbBrush="#F59E0B" Margin="0,0,28,0" />
                    <helix:HelixSwitch Content="Green + thumb" IsChecked="True" Tone="Success" ThumbOnBrush="#DCFCE7" Margin="0,0,28,0" />
                    <helix:HelixSwitch Content="Square" IsChecked="True" CornerRadius="5" Accent="#18181B" />
                </WrapPanel>
                <TextBox Style="{StaticResource Code}" Text="&lt;helix:HelixSwitch ThumbBrush=&quot;#F59E0B&quot; /&gt;" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="2. A default for the whole application" />
        <TextBlock Style="{StaticResource SectionText}"
                   Text="An implicit BasedOn style in App.xaml: only the properties that change, the template stays Helix's. Here, every switch in the box turns orange with its label on the left." />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <Border Padding="16" CornerRadius="10" Background="{DynamicResource Helix.Surface2}" HorizontalAlignment="Left" MinWidth="380">
                    <Border.Resources>
                        <Style TargetType="helix:HelixSwitch" BasedOn="{StaticResource {x:Type helix:HelixSwitch}}">
                            <Setter Property="Accent" Value="#FF8A00" />
                            <Setter Property="LabelPosition" Value="Start" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Margin" Value="0,0,0,12" />
                        </Style>
                        <Style TargetType="helix:HelixButton" BasedOn="{StaticResource {x:Type helix:HelixButton}}">
                            <Setter Property="CornerRadius" Value="999" />
                            <Setter Property="Variant" Value="Soft" />
                        </Style>
                    </Border.Resources>
                    <StackPanel>
                        <helix:HelixSwitch Content="Autopilot" Description="Controls the volumes." IsChecked="True" />
                        <helix:HelixSwitch Content="Alerts" />
                        <helix:HelixButton Content="Enregistrer" HorizontalAlignment="Left" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
                <TextBox Style="{StaticResource Code}">
                    <TextBox.Text>&lt;!-- App.xaml --&gt;
&lt;Style TargetType="helix:HelixSwitch" BasedOn="{StaticResource {x:Type helix:HelixSwitch}}"&gt;
    &lt;Setter Property="Accent" Value="#FF8A00" /&gt;
    &lt;Setter Property="LabelPosition" Value="Start" /&gt;
&lt;/Style&gt;</TextBox.Text>
                </TextBox>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="3. The theme: the whole application at once" />
        <TextBlock Style="{StaticResource SectionText}"
                   Text="HelixResources sets the colors (a light and a dark palette), the rounding, the control height and the font. Changes apply live to this whole gallery." />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="300" />
                    </Grid.ColumnDefinitions>
                    <helix:HelixCard Title="Preview" Subtitle="Every control follows." Margin="0,0,24,0" VerticalAlignment="Top">
                        <StackPanel>
                            <helix:HelixTextField Label="Project" Text="Helix UI" Margin="0,0,0,14" />
                            <helix:HelixSwitch Content="Publish" IsChecked="True" Margin="0,0,0,14" />
                            <WrapPanel>
                                <helix:HelixBadge Content="New" Margin="0,0,8,0" />
                                <helix:HelixBadge Content="Online" Tone="Success" ShowDot="True" />
                            </WrapPanel>
                        </StackPanel>
                        <helix:HelixCard.Footer>
                            <StackPanel Orientation="Horizontal">
                                <helix:HelixButton Content="Cancel" Variant="Outline" Tone="Neutral" />
                                <helix:HelixButton Content="Enregistrer" Margin="8,0,0,0" />
                            </StackPanel>
                        </helix:HelixCard.Footer>
                    </helix:HelixCard>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Primary color" FontWeight="SemiBold" Margin="0,0,0,8" Foreground="{DynamicResource Helix.Text}" />
                        <WrapPanel x:Name="Swatches" Margin="0,0,0,18" />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=RadiusSlider, StringFormat={}{0:0} px}" Foreground="{DynamicResource Helix.TextMuted}" />
                            <TextBlock Text="Rounding" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" />
                        </DockPanel>
                        <helix:HelixSlider x:Name="RadiusSlider" Minimum="0" Maximum="20" Value="10" IsSnapToTickEnabled="True" TickFrequency="1"
                                         ValueChanged="OnRadiusChanged" Margin="0,0,0,18" />
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Value, ElementName=HeightSlider, StringFormat={}{0:0} px}" Foreground="{DynamicResource Helix.TextMuted}" />
                            <TextBlock Text="Control height" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" />
                        </DockPanel>
                        <helix:HelixSlider x:Name="HeightSlider" Minimum="30" Maximum="46" Value="38" IsSnapToTickEnabled="True" TickFrequency="1"
                                         ValueChanged="OnHeightChanged" Margin="0,0,0,18" />
                        <helix:HelixButton Content="Reset" Variant="Soft" Tone="Neutral" Size="Sm" HorizontalAlignment="Left" Click="OnReset" />
                    </StackPanel>
                </Grid>
                <TextBox Style="{StaticResource Code}">
                    <TextBox.Text>&lt;!-- App.xaml --&gt;
&lt;helix:HelixResources Mode="System" Radius="12" ControlHeight="34"&gt;
    &lt;helix:HelixResources.Light&gt;&lt;helix:HelixPalette Primary="#C2410C" /&gt;&lt;/helix:HelixResources.Light&gt;
    &lt;helix:HelixResources.Dark&gt;&lt;helix:HelixPalette Primary="#F97316" /&gt;&lt;/helix:HelixResources.Dark&gt;
&lt;/helix:HelixResources&gt;

// In code, at any time:
HelixResources.Current!.Mode = HelixThemeMode.Dark;</TextBox.Text>
                </TextBox>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Built-in texts" />
        <TextBlock Style="{StaticResource SectionText}"
                   Text="The few texts written by the controls (Cancel, Confirm, Clear, Select…) follow the interface language, French or English. To change them: HelixTexts.Current = HelixTexts.English with { Cancel = &quot;Back&quot; };" />
    </StackPanel>
</UserControl>
