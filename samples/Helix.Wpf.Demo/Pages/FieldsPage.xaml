<UserControl x:Class="Helix.Wpf.Demo.Pages.FieldsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf"
             xmlns:local="clr-namespace:Helix.Wpf.Demo.Pages">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Champs" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Texte, nombre, liste et date partagent la même coque : Label, Hint, Error, IsRequired, Prefix, Suffix, Accent et CornerRadius. Ce que vous apprenez sur l'un vaut pour les autres." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="TextField" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <UniformGrid Columns="2">
                    <helix:HelixTextField Label="Nom du projet" Placeholder="Helix UI" Hint="Visible par toute l'équipe." Margin="0,0,16,20" />
                    <helix:HelixTextField Label="Recherche" Icon="search" Placeholder="Rechercher…" IsClearable="True" Text="Lyon" Margin="0,0,0,20" />
                    <helix:HelixTextField x:Name="Email" Label="E-mail" Icon="mail" IsRequired="True" Text="marie@" TextChanged="OnEmailChanged" Margin="0,0,16,0" />
                    <helix:HelixTextField Label="Montant" Placeholder="0,00" Margin="0">
                        <helix:HelixTextField.Suffix>
                            <TextBlock Text="EUR" FontWeight="SemiBold" />
                        </helix:HelixTextField.Suffix>
                    </helix:HelixTextField>
                </UniformGrid>
                <TextBox Style="{StaticResource Code}" Text="&lt;helix:HelixTextField Label=&quot;E-mail&quot; Icon=&quot;mail&quot; IsRequired=&quot;True&quot; Error=&quot;{Binding EmailError}&quot; /&gt;" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="NumberField" />
        <TextBlock Style="{StaticResource SectionText}" Text="Value est un double? lié en deux sens. Flèches haut/bas et boutons − / + avancent de Step ; Minimum, Maximum et Decimals sont appliqués à la saisie." />
        <Border Style="{StaticResource Stage}">
            <UniformGrid Columns="3">
                <helix:HelixNumberField Label="Puissance" Value="120" Unit="MW" Step="5" Minimum="0" Maximum="250" Hint="Entre 0 et 250 MW" Margin="0,0,16,0" />
                <helix:HelixNumberField Label="Prix plafond" Value="95.5" Unit="€/MWh" Decimals="1" Step="0.5" ShowSteppers="False" Margin="0,0,16,0" />
                <helix:HelixNumberField Label="Volume" Value="-30" Unit="MW" ShowSteppers="False" Accent="#FF8A00">
                    <helix:HelixNumberField.Prefix>
                        <helix:HelixIcon Icon="arrow-down" Foreground="{DynamicResource Helix.Danger}" />
                    </helix:HelixNumberField.Prefix>
                </helix:HelixNumberField>
            </UniformGrid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Select et DatePicker" />
        <Border Style="{StaticResource Stage}">
            <UniformGrid Columns="3">
                <helix:HelixSelect Label="Site" Margin="0,0,16,0">
                    <ComboBoxItem Content="Lyon" />
                    <ComboBoxItem Content="Grenoble" />
                    <ComboBoxItem Content="Marseille" />
                    <ComboBoxItem Content="Bordeaux" />
                </helix:HelixSelect>
                <helix:HelixSelect Label="Statut" Error="Choisissez un statut." Margin="0,0,16,0">
                    <ComboBoxItem Content="Brouillon" />
                    <ComboBoxItem Content="Publié" />
                </helix:HelixSelect>
                <helix:HelixDatePicker Label="Date de début" Hint="Format jj/mm/aaaa" />
            </UniformGrid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Recherche et choix multiple" />
        <TextBlock Style="{StaticResource SectionText}" Text="IsSearchable ajoute une recherche en haut de la liste. HelixMultiSelect : puces (× pour retirer), cases à cocher, « Tout sélectionner » et « Effacer »." />
        <Border Style="{StaticResource Stage}">
            <UniformGrid Columns="2">
                <helix:HelixSelect Label="Ville (recherche)" IsSearchable="True" Margin="0,0,16,0">
                    <ComboBoxItem Content="Lyon" />
                    <ComboBoxItem Content="Grenoble" />
                    <ComboBoxItem Content="Marseille" />
                    <ComboBoxItem Content="Bordeaux" />
                    <ComboBoxItem Content="Lille" />
                    <ComboBoxItem Content="Nantes" />
                    <ComboBoxItem Content="Toulouse" />
                    <ComboBoxItem Content="Strasbourg" />
                </helix:HelixSelect>
                <helix:HelixMultiSelect x:Name="Sites" Label="Sites" IsSearchable="True" MaxChips="2" Hint="Plusieurs choix possibles" />
            </UniformGrid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Date et heure, période" />
        <TextBlock Style="{StaticResource SectionText}" Text="HelixDateTimePicker : calendrier et liste des heures au pas choisi (15 min par défaut). HelixDateRangePicker : raccourcis et période en deux clics." />
        <Border Style="{StaticResource Stage}">
            <UniformGrid Columns="3">
                <helix:HelixDateTimePicker Label="Début de livraison" Hint="Au quart d'heure" Margin="0,0,16,0" />
                <helix:HelixDateTimePicker Label="Heure pleine" MinuteStep="60" Margin="0,0,16,0" />
                <helix:HelixDateRangePicker Label="Période du rapport" MaxDays="31" Hint="31 jours au plus" />
            </UniformGrid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="HelixField autour de vos contrôles" />
        <TextBlock Style="{StaticResource SectionText}" Text="La même coque (libellé, aide, erreur) autour de n'importe quel contenu." />
        <Border Style="{StaticResource Stage}">
            <helix:HelixField Label="Fréquence" Hint="Combien de fois par jour ?" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <helix:HelixRadioButton Content="1 fois" GroupName="freq" IsChecked="True" Margin="0,0,16,0" />
                    <helix:HelixRadioButton Content="4 fois" GroupName="freq" Margin="0,0,16,0" />
                    <helix:HelixRadioButton Content="Toutes les heures" GroupName="freq" />
                </StackPanel>
            </helix:HelixField>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Rating, ColorPicker, FileDrop" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel Margin="0,0,0,20">
                    <helix:HelixRating Value="4" Labels="{x:Static local:FieldsPage.RatingLabels}" Margin="0,0,32,0" />
                    <helix:HelixRating Value="3.6" IsReadOnly="True" ShowValue="True" Count="128" Size="Sm" Margin="0,0,32,0" />
                    <helix:HelixRating Value="2" Shape="heart" Accent="#E11D48" Size="Lg" />
                </WrapPanel>
                <UniformGrid Columns="2" Margin="0,0,0,20">
                    <helix:HelixColorPicker Label="Couleur de marque" SelectedColor="#C2410C" Margin="0,0,16,0" />
                    <helix:HelixColorPicker Label="Avec opacité" ShowAlpha="True" Hint="Format #RRGGBBAA" />
                </UniformGrid>
                <helix:HelixFileDrop Accept=".pdf,.xlsx,image/*" MaxFileSize="10485760" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
