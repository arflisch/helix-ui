<UserControl x:Class="Helix.Wpf.Demo.Pages.FieldsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf"
             xmlns:local="clr-namespace:Helix.Wpf.Demo.Pages">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Fields" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Text, number, list and date share the same shell: Label, Hint, Error, IsRequired, Prefix, Suffix, Accent and CornerRadius. What you learn on one applies to the others." />

        <TextBlock Style="{StaticResource SectionTitle}" Text="TextField" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <UniformGrid Columns="2">
                    <helix:HelixTextField Label="Project name" Placeholder="Helix UI" Hint="Visible to the whole team." Margin="0,0,16,20" />
                    <helix:HelixTextField Label="Search" Icon="search" Placeholder="Search…" IsClearable="True" Text="Lyon" Margin="0,0,0,20" />
                    <helix:HelixTextField x:Name="Email" Label="Email" Icon="mail" IsRequired="True" Text="marie@" TextChanged="OnEmailChanged" Margin="0,0,16,0" />
                    <helix:HelixTextField Label="Amount" Placeholder="0,00" Margin="0">
                        <helix:HelixTextField.Suffix>
                            <TextBlock Text="EUR" FontWeight="SemiBold" />
                        </helix:HelixTextField.Suffix>
                    </helix:HelixTextField>
                </UniformGrid>
                <TextBox Style="{StaticResource Code}" Text="&lt;helix:HelixTextField Label=&quot;E-mail&quot; Icon=&quot;mail&quot; IsRequired=&quot;True&quot; Error=&quot;{Binding EmailError}&quot; /&gt;" />
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="NumberField" />
        <TextBlock Style="{StaticResource SectionText}" Text="Value is a two-way double?. The up/down arrows and the − / + buttons move by Step; Minimum, Maximum and Decimals apply while typing." />
        <Border Style="{StaticResource Stage}">
            <UniformGrid Columns="3">
                <helix:HelixNumberField Label="Power" Value="120" Unit="MW" Step="5" Minimum="0" Maximum="250" Hint="Between 0 and 250 MW" Margin="0,0,16,0" />
                <helix:HelixNumberField Label="Price cap" Value="95.5" Unit="€/MWh" Decimals="1" Step="0.5" ShowSteppers="False" Margin="0,0,16,0" />
                <helix:HelixNumberField Label="Correction (signed)" Value="-15" Unit="MW" Step="5" IsSigned="True" Margin="0,0,16,0" />
                <helix:HelixNumberField Label="Volume (type 120*0.8)" Value="96" Unit="MWh" Decimals="1" AllowExpressions="True" Margin="0,0,16,0" />
                <helix:HelixNumberField Label="Volume" Value="-30" Unit="MW" ShowSteppers="False" Accent="#FF8A00">
                    <helix:HelixNumberField.Prefix>
                        <helix:HelixIcon Icon="arrow-down" Foreground="{DynamicResource Helix.Danger}" />
                    </helix:HelixNumberField.Prefix>
                </helix:HelixNumberField>
            </UniformGrid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Select and DatePicker" />
        <Border Style="{StaticResource Stage}">
            <UniformGrid Columns="3">
                <helix:HelixSelect Label="Site" Margin="0,0,16,0">
                    <ComboBoxItem Content="Lyon" />
                    <ComboBoxItem Content="Grenoble" />
                    <ComboBoxItem Content="Marseille" />
                    <ComboBoxItem Content="Bordeaux" />
                </helix:HelixSelect>
                <helix:HelixSelect Label="Status" Error="Pick a status." Margin="0,0,16,0">
                    <ComboBoxItem Content="Draft" />
                    <ComboBoxItem Content="Published" />
                </helix:HelixSelect>
                <helix:HelixDatePicker Label="Start date" Hint="Format dd/mm/yyyy" />
            </UniformGrid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Generated form (HelixAutoForm)" />
        <TextBlock Style="{StaticResource SectionText}" Text="A complete form from a class and its [Display], [Required], [Range], [HelixField] attributes: two-way bindings and validation." />
        <Border Style="{StaticResource Stage}">
            <helix:HelixAutoForm x:Name="RequestForm" Columns="2" SubmitText="Send the request" Submitted="OnFormSubmitted" />
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Search and multiple choice" />
        <TextBlock Style="{StaticResource SectionText}" Text="IsSearchable adds a search at the top of the list. HelixMultiSelect: chips (× to remove), check boxes, “Select all” and “Clear”." />
        <Border Style="{StaticResource Stage}">
            <UniformGrid Columns="2">
                <helix:HelixSelect Label="City (search)" IsSearchable="True" Margin="0,0,16,0">
                    <ComboBoxItem Content="Lyon" />
                    <ComboBoxItem Content="Grenoble" />
                    <ComboBoxItem Content="Marseille" />
                    <ComboBoxItem Content="Bordeaux" />
                    <ComboBoxItem Content="Lille" />
                    <ComboBoxItem Content="Nantes" />
                    <ComboBoxItem Content="Toulouse" />
                    <ComboBoxItem Content="Strasbourg" />
                </helix:HelixSelect>
                <helix:HelixMultiSelect x:Name="Sites" Label="Sites" IsSearchable="True" MaxChips="2" Hint="Several choices allowed" />
            </UniformGrid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Date and time, period" />
        <TextBlock Style="{StaticResource SectionText}" Text="HelixDateTimePicker: calendar and a list of times at the chosen step (15 min by default). HelixDateRangePicker: shortcuts and a period in two clicks." />
        <Border Style="{StaticResource Stage}">
            <UniformGrid Columns="3">
                <helix:HelixDateTimePicker Label="Delivery start" Hint="To the quarter hour" Margin="0,0,16,0" />
                <helix:HelixDateTimePicker Label="Full hour" MinuteStep="60" Margin="0,0,16,0" />
                <helix:HelixDateRangePicker Label="Report period" MaxDays="31" Hint="31 days at most" />
            </UniformGrid>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="HelixField around your controls" />
        <TextBlock Style="{StaticResource SectionText}" Text="The same shell (label, hint, error) around any content." />
        <Border Style="{StaticResource Stage}">
            <helix:HelixField Label="Frequency" Hint="How many times a day?" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <helix:HelixRadioButton Content="Once" GroupName="freq" IsChecked="True" Margin="0,0,16,0" />
                    <helix:HelixRadioButton Content="4 times" GroupName="freq" Margin="0,0,16,0" />
                    <helix:HelixRadioButton Content="Every hour" GroupName="freq" />
                </StackPanel>
            </helix:HelixField>
        </Border>

        <TextBlock Style="{StaticResource SectionTitle}" Text="Rating, ColorPicker, FileDrop" />
        <Border Style="{StaticResource Stage}">
            <StackPanel>
                <WrapPanel Margin="0,0,0,20">
                    <helix:HelixRating Value="4" Labels="{x:Static local:FieldsPage.RatingLabels}" Margin="0,0,32,0" />
                    <helix:HelixRating Value="3.6" IsReadOnly="True" ShowValue="True" Count="128" Size="Sm" Margin="0,0,32,0" />
                    <helix:HelixRating Value="2" Shape="heart" Accent="#E11D48" Size="Lg" />
                </WrapPanel>
                <UniformGrid Columns="2" Margin="0,0,0,20">
                    <helix:HelixColorPicker Label="Brand color" SelectedColor="#C2410C" Margin="0,0,16,0" />
                    <helix:HelixColorPicker Label="With opacity" ShowAlpha="True" Hint="Format #RRGGBBAA" />
                </UniformGrid>
                <helix:HelixFileDrop Accept=".pdf,.xlsx,image/*" MaxFileSize="10485760" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
