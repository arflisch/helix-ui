<UserControl x:Class="Helix.Wpf.Demo.Pages.PlanningPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="https://helix-ui.dev/wpf">
    <StackPanel>
        <TextBlock Style="{StaticResource PageTitle}" Text="Timeline" />
        <TextBlock Style="{StaticResource PageLead}"
                   Text="Items on a time axis, by lane, with a live “now” line. In edit mode: drag to move, pull an edge to resize, arrows to shift (Shift + arrows for the end)." />

        <helix:HelixTimeline x:Name="Schedule" Title="Team planning" SlotDuration="1:00:00" LaneHeader="TEAM" IsEditable="True" AllowLaneChange="True"
                           IsCollapsible="True" SnapTo="0:15:00" Margin="0,0,0,32" />

        <helix:HelixTimeline x:Name="Demand" Title="Time schedule" SlotDuration="0:15:00" Layout="Staircase" SlotMinWidth="150"
                           NowBrush="#F15A24" Margin="0,0,0,32" />
    </StackPanel>
</UserControl>
