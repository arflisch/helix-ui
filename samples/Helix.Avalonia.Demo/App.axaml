<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="using:Helix.Avalonia"
             x:Class="Helix.Avalonia.Demo.App"
             RequestedThemeVariant="Default">
    <Application.Styles>
        <FluentTheme />
        <helix:HelixTheme Mode="System" />
    </Application.Styles>
</Application>
