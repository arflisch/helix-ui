<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="using:Helix.Avalonia"
             x:Class="Helix.Avalonia.Demo.Pages.FormsPage">
    <UserControl.Styles>
        <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /></Style>
        <Style Selector="TextBlock.lead"><Setter Property="FontSize" Value="15" /><Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,22" /></Style>
        <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /><Setter Property="Margin" Value="0,18,0,10" /></Style>
        <Style Selector="Border.stage"><Setter Property="Background" Value="{DynamicResource Helix.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="24" /></Style>
    </UserControl.Styles>
    <StackPanel>
        <TextBlock Classes="h1">Forms</TextBlock>
        <TextBlock Classes="lead">Text fields with label, hint, error, icon, suffix and clear button; switches and checkboxes in any tone.</TextBlock>
        <TextBlock Classes="h2">Text fields</TextBlock>
        <Border Classes="stage">
            <Grid ColumnDefinitions="*,24,*" RowDefinitions="Auto,18,Auto,18,Auto">
                <helix:HelixTextField Label="Name" Placeholder="Ada Lovelace" IsRequired="True" />
                <helix:HelixTextField Grid.Column="2" Label="Email" Icon="mail" Text="ada@example.com" IsClearable="True" Hint="We never share it." />
                <helix:HelixTextField Grid.Row="2" Label="Password" Icon="lock" PasswordChar="•" Text="secret" />
                <helix:HelixTextField Grid.Row="2" Grid.Column="2" Label="Capacity" Text="120" Suffix="MW" />
                <helix:HelixTextField Grid.Row="4" Label="Site code" Text="X-12" Error="Use 4 characters or more." />
                <helix:HelixTextField Grid.Row="4" Grid.Column="2" Label="Read only" Text="Locked value" IsReadOnly="True" IsEnabled="False" />
            </Grid>
        </Border>
        <TextBlock Classes="h2">Switches and checkboxes</TextBlock>
        <Border Classes="stage">
            <Grid ColumnDefinitions="*,*">
                <StackPanel Spacing="14">
                    <helix:HelixSwitch Content="Notifications" IsChecked="True" />
                    <helix:HelixSwitch Content="Auto-refresh" />
                    <helix:HelixSwitch Content="Success tone" Tone="Success" IsChecked="True" />
                    <helix:HelixSwitch Content="Custom accent" Accent="#FF8A00" IsChecked="True" />
                    <helix:HelixSwitch Content="Label first" LabelPosition="Start" IsChecked="True" />
                    <helix:HelixSwitch Content="With texts" OnText="ON" OffText="OFF" IsChecked="True" />
                    <helix:HelixSwitch Content="Dark mode" OnIcon="moon" OffIcon="sun" ThumbOnBrush="#FDE68A" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="14">
                    <helix:HelixCheckBox Content="I accept the terms" IsChecked="True" />
                    <helix:HelixCheckBox Content="Send me the report" />
                    <helix:HelixCheckBox Content="Partly selected" IsThreeState="True" IsChecked="{x:Null}" />
                    <helix:HelixCheckBox Content="Danger tone" Tone="Danger" IsChecked="True" />
                    <helix:HelixCheckBox Content="Yellow accent" Accent="#FACC15" IsChecked="True" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
