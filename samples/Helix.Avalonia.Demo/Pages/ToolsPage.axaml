<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="using:Helix.Avalonia"
             x:Class="Helix.Avalonia.Demo.Pages.ToolsPage"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /></Style>
        <Style Selector="TextBlock.lead"><Setter Property="FontSize" Value="15" /><Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,22" /></Style>
        <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /><Setter Property="Margin" Value="0,18,0,10" /></Style>
        <Style Selector="Border.stage"><Setter Property="Background" Value="{DynamicResource Helix.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="24" /></Style>
    </UserControl.Styles>
    <StackPanel>
        <TextBlock Classes="h1">Filters and files</TextBlock>
        <TextBlock Classes="lead">A filter bar that filters a grid directly and saves sets of filters, a color picker and a file drop zone.</TextBlock>

        <TextBlock Classes="h2">Filter bar</TextBlock>
        <Border Classes="stage">
            <StackPanel Spacing="10">
                <helix:HelixFilterBar Name="Filters" Target="{Binding #Staff}">
                    <helix:HelixTextFilter Key="q" Paths="Name,Department" Placeholder="Name or department" />
                    <helix:HelixChoiceFilter Key="status" Path="Status" Label="Status" />
                    <helix:HelixDateFilter Key="start" Path="Start" Label="Started between" />
                    <helix:HelixToggleFilter Name="HighPay" Key="high" Label="Salary ≥ 60k" />
                </helix:HelixFilterBar>
                <helix:HelixDataGrid Name="Staff" PageSize="6" Height="360">
                    <helix:HelixDataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                        <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="150" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                        <DataGridTextColumn Header="Salary" Binding="{Binding Salary, StringFormat={}{0:N0}}" Width="110" />
                        <DataGridTextColumn Header="Start" Binding="{Binding Start, StringFormat={}{0:dd/MM/yyyy}}" Width="110" />
                    </helix:HelixDataGrid.Columns>
                </helix:HelixDataGrid>
                <TextBlock Name="StateText" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" FontFamily="Menlo, Consolas, monospace" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <TextBlock Classes="h2">Color picker</TextBlock>
        <Border Classes="stage">
            <WrapPanel ItemSpacing="20" LineSpacing="12">
                <helix:HelixColorPicker Name="Brand" Label="Brand color" SelectedColor="#4F46E5" Width="240" Hint="Used for buttons and links" />
                <helix:HelixColorPicker Label="Overlay" ShowAlpha="True" IsClearable="True" SelectedColor="#80E11D48" Width="240" />
                <helix:HelixColorPicker Label="Highlight" Width="240" />
            </WrapPanel>
        </Border>

        <TextBlock Classes="h2">File drop</TextBlock>
        <StackPanel Spacing="16">
            <helix:HelixFileDrop Name="Drop" Accept=".xlsx,.csv,.pdf" MaxFileSize="10485760" MaxFiles="5" />
            <helix:HelixFileDrop Accept="image/*" IsCompact="True" Multiple="False" Tone="Success" Title="Drop a logo" />
        </StackPanel>
    </StackPanel>
</UserControl>
