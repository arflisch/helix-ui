<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="using:Helix.Avalonia"
             x:Class="Helix.Avalonia.Demo.Pages.ButtonsPage">
    <UserControl.Styles>
        <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /></Style>
        <Style Selector="TextBlock.lead"><Setter Property="FontSize" Value="15" /><Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,22" /></Style>
        <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /><Setter Property="Margin" Value="0,18,0,10" /></Style>
        <Style Selector="Border.stage"><Setter Property="Background" Value="{DynamicResource Helix.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="24" /></Style>
    </UserControl.Styles>
    <StackPanel>
        <TextBlock Classes="h1">Buttons</TextBlock>
        <TextBlock Classes="lead">Four variants, every tone or any accent color, three sizes, icons and a loading state. Same properties as Helix for WPF.</TextBlock>
        <TextBlock Classes="h2">Variants</TextBlock>
        <Border Classes="stage">
            <WrapPanel ItemSpacing="10" LineSpacing="10">
                <helix:HelixButton Content="Solid" />
                <helix:HelixButton Content="Soft" Variant="Soft" />
                <helix:HelixButton Content="Outline" Variant="Outline" Tone="Neutral" />
                <helix:HelixButton Content="Ghost" Variant="Ghost" />
                <helix:HelixButton Content="Download" Icon="download" />
                <helix:HelixButton Content="Next" IconEnd="arrow-right" Variant="Soft" />
                <helix:HelixButton Icon="settings" Variant="Outline" Tone="Neutral" Width="38" Padding="0" />
            </WrapPanel>
        </Border>
        <TextBlock Classes="h2">Tones and custom accent</TextBlock>
        <Border Classes="stage">
            <StackPanel Spacing="10">
                <WrapPanel ItemSpacing="10" LineSpacing="10">
                    <helix:HelixButton Content="Primary" />
                    <helix:HelixButton Content="Neutral" Tone="Neutral" />
                    <helix:HelixButton Content="Success" Tone="Success" />
                    <helix:HelixButton Content="Warning" Tone="Warning" />
                    <helix:HelixButton Content="Danger" Tone="Danger" Icon="trash" />
                    <helix:HelixButton Content="Info" Tone="Info" />
                </WrapPanel>
                <WrapPanel ItemSpacing="10" LineSpacing="10">
                    <helix:HelixButton Content="Success" Tone="Success" Variant="Soft" />
                    <helix:HelixButton Content="Warning" Tone="Warning" Variant="Soft" />
                    <helix:HelixButton Content="Danger" Tone="Danger" Variant="Soft" />
                    <helix:HelixButton Content="Orange #FF8A00" Accent="#FF8A00" />
                    <helix:HelixButton Content="Yellow #FACC15" Accent="#FACC15" />
                    <helix:HelixButton Content="Teal outline" Accent="#0F766E" Variant="Outline" />
                </WrapPanel>
            </StackPanel>
        </Border>
        <TextBlock Classes="h2">Sizes and states</TextBlock>
        <Border Classes="stage">
            <WrapPanel ItemSpacing="10" LineSpacing="10">
                <helix:HelixButton Content="Small" Size="Sm" VerticalAlignment="Center" />
                <helix:HelixButton Content="Medium" VerticalAlignment="Center" />
                <helix:HelixButton Content="Large" Size="Lg" VerticalAlignment="Center" />
                <helix:HelixButton Name="SaveButton" Content="Save" Icon="check" IsLoading="True" VerticalAlignment="Center" />
                <helix:HelixButton Content="Disabled" IsEnabled="False" VerticalAlignment="Center" />
            </WrapPanel>
        </Border>
    </StackPanel>
</UserControl>
