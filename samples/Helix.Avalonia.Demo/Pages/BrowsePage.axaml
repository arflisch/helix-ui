<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="using:Helix.Avalonia"
             x:Class="Helix.Avalonia.Demo.Pages.BrowsePage"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /></Style>
        <Style Selector="TextBlock.lead"><Setter Property="FontSize" Value="15" /><Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,22" /></Style>
        <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /><Setter Property="Margin" Value="0,18,0,10" /></Style>
        <Style Selector="Border.stage"><Setter Property="Background" Value="{DynamicResource Helix.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="24" /></Style>
    </UserControl.Styles>
    <StackPanel>
        <TextBlock Classes="h1">Trees, slides and logs</TextBlock>
        <TextBlock Classes="lead">A tree as a list or an org chart, a carousel with any content, and a live log with level filters and search.</TextBlock>

        <TextBlock Classes="h2">Tree view</TextBlock>
        <StackPanel Spacing="16">
            <Border Classes="stage" Padding="10" Width="340" HorizontalAlignment="Left">
                <helix:HelixTreeView Name="Files" ChildrenPath="Children" TextPath="Name" IconPath="Icon" ExpandDepth="2" Height="250" />
            </Border>
            <Border Classes="stage" Padding="16">
                <helix:HelixTreeView Name="Org" Layout="Diagram" ChildrenPath="Children" TextPath="Name" DescriptionPath="Role" ExpandDepth="2" />
            </Border>
        </StackPanel>

        <TextBlock Classes="h2">Carousel</TextBlock>
        <helix:HelixCarousel Name="Slides" SlidesPerView="2" Gap="16">
            <Border Background="#4F46E5" CornerRadius="14" Height="150" Padding="22">
                <StackPanel><TextBlock Foreground="White" FontSize="20" FontWeight="Bold">One library</TextBlock><TextBlock Foreground="#DDFFFFFF" TextWrapping="Wrap">Blazor, WPF and Avalonia with the same names.</TextBlock></StackPanel>
            </Border>
            <Border Background="#0EA5E9" CornerRadius="14" Height="150" Padding="22">
                <StackPanel><TextBlock Foreground="White" FontSize="20" FontWeight="Bold">Dark mode</TextBlock><TextBlock Foreground="#DDFFFFFF" TextWrapping="Wrap">Every color is a theme brush.</TextBlock></StackPanel>
            </Border>
            <Border Background="#10B981" CornerRadius="14" Height="150" Padding="22">
                <StackPanel><TextBlock Foreground="White" FontSize="20" FontWeight="Bold">Export</TextBlock><TextBlock Foreground="#DDFFFFFF" TextWrapping="Wrap">Excel, Word and CSV, no dependency.</TextBlock></StackPanel>
            </Border>
            <Border Background="#F59E0B" CornerRadius="14" Height="150" Padding="22">
                <StackPanel><TextBlock Foreground="White" FontSize="20" FontWeight="Bold">Charts</TextBlock><TextBlock Foreground="#DDFFFFFF" TextWrapping="Wrap">Lines, bars, donuts, gauges, heatmaps.</TextBlock></StackPanel>
            </Border>
            <Border Background="#E11D48" CornerRadius="14" Height="150" Padding="22">
                <StackPanel><TextBlock Foreground="White" FontSize="20" FontWeight="Bold">Boards</TextBlock><TextBlock Foreground="#DDFFFFFF" TextWrapping="Wrap">Kanban, timeline and dashboards.</TextBlock></StackPanel>
            </Border>
        </helix:HelixCarousel>

        <TextBlock Classes="h2">Log viewer</TextBlock>
        <helix:HelixLogViewer Name="Log" Height="320" />
    </StackPanel>
</UserControl>
