<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="using:Helix.Avalonia"
             x:Class="Helix.Avalonia.Demo.Pages.DataPage"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /></Style>
        <Style Selector="TextBlock.lead"><Setter Property="FontSize" Value="15" /><Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,22" /></Style>
        <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /><Setter Property="Margin" Value="0,18,0,10" /></Style>
        <Style Selector="Border.stage"><Setter Property="Background" Value="{DynamicResource Helix.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="24" /></Style>
    </UserControl.Styles>
    <StackPanel>
        <TextBlock Classes="h1">Data grid</TextBlock>
        <TextBlock Classes="lead">Search, sort across pages, paging, column chooser, density, totals row, groups, and export to Excel, Word or CSV. Columns are ordinary DataGrid columns.</TextBlock>
        <TextBlock Classes="h2">Search, paging, totals and export</TextBlock>
        <helix:HelixDataGrid Name="Employees" IsSearchable="True" ShowColumnChooser="True" IsExportable="True" ExportFormats="All"
                             ExportFileName="employees" ExportTitle="Employees" PageSize="8" Height="470">
            <helix:HelixDataGrid.Toolbar>
                <TextBlock Text="Employees" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" />
            </helix:HelixDataGrid.Toolbar>
            <helix:HelixDataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" helix:HelixDataGrid.Aggregate="Count" />
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" Width="150" />
                <DataGridTemplateColumn Header="Status" SortMemberPath="Status" Width="130">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <helix:HelixBadge Content="{Binding Status}" Tone="{Binding Tone}" ShowDot="True" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Salary" Binding="{Binding Salary, StringFormat={}{0:N0}}" Width="120"
                                    helix:HelixDataGrid.Aggregate="Sum" helix:HelixDataGrid.Unit="€" />
                <DataGridTextColumn Header="Start" Binding="{Binding Start, StringFormat={}{0:dd/MM/yyyy}}" Width="120" />
            </helix:HelixDataGrid.Columns>
        </helix:HelixDataGrid>
        <TextBlock Classes="h2">Groups</TextBlock>
        <helix:HelixDataGrid Name="Orders" GroupBy="Region" PageSize="0" Density="Sm" Height="360">
            <helix:HelixDataGrid.Columns>
                <DataGridTextColumn Header="Product" Binding="{Binding Product}" Width="*" />
                <DataGridTextColumn Header="Region" Binding="{Binding Region}" Width="120" />
                <DataGridTextColumn Header="Volume" Binding="{Binding Volume, StringFormat={}{0:N0}}" Width="120"
                                    helix:HelixDataGrid.Aggregate="Sum" helix:HelixDataGrid.Unit="MWh" />
                <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat={}{0:N1}}" Width="110"
                                    helix:HelixDataGrid.Aggregate="Average" helix:HelixDataGrid.Unit="€" />
            </helix:HelixDataGrid.Columns>
        </helix:HelixDataGrid>
    </StackPanel>
</UserControl>
