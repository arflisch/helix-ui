<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helix="using:Helix.Avalonia"
             xmlns:pages="using:Helix.Avalonia.Demo.Pages"
             x:Class="Helix.Avalonia.Demo.Pages.PlanningPage">
    <UserControl.Styles>
        <Style Selector="TextBlock.h1"><Setter Property="FontSize" Value="28" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /></Style>
        <Style Selector="TextBlock.lead"><Setter Property="FontSize" Value="15" /><Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" /><Setter Property="TextWrapping" Value="Wrap" /><Setter Property="Margin" Value="0,6,0,22" /></Style>
        <Style Selector="TextBlock.h2"><Setter Property="FontSize" Value="17" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /><Setter Property="Margin" Value="0,18,0,10" /></Style>
        <Style Selector="Border.stage"><Setter Property="Background" Value="{DynamicResource Helix.Surface}" /><Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="14" /><Setter Property="Padding" Value="24" /></Style>
    </UserControl.Styles>
    <StackPanel>
        <TextBlock Classes="h1">Planning</TextBlock>
        <TextBlock Classes="lead">A timeline with lanes, statuses and a live now line (drag to move, stretch the edges, arrows on the keyboard); a kanban with cards dragged between columns; a list reordered by dragging.</TextBlock>
        <helix:HelixTimeline Name="Schedule" Title="Production schedule" LaneHeader="UNIT" SlotDuration="0:30:00" IsEditable="True" AllowLaneChange="True" IsCollapsible="True" />
        <TextBlock Classes="h2">Kanban</TextBlock>
        <helix:HelixKanban Name="Board" ColumnPath="Status" ShowAddButton="True" ColumnWidth="250" Height="330">
            <helix:HelixKanban.CardTemplate>
                <DataTemplate x:DataType="pages:TaskCard">
                    <StackPanel Spacing="6">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <helix:HelixBadge Content="{Binding Tag}" Tone="{Binding Tone}" />
                            <TextBlock Text="{Binding Owner}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </helix:HelixKanban.CardTemplate>
        </helix:HelixKanban>
        <TextBlock Classes="h2">Editable board</TextBlock>
        <TextBlock Classes="lead">HelixKanbanBoard edits its cards itself: + opens a new card, a click opens the editor (title, description, column, due date, assignee, tags, color), Delete asks first.</TextBlock>
        <helix:HelixKanbanBoard Name="EditableBoard" ColumnWidth="250" Height="330" />
        <TextBlock Classes="h2">Sortable list</TextBlock>
        <helix:HelixSortableList Name="Priorities" Width="420" HorizontalAlignment="Left" />
    </StackPanel>
</UserControl>
