<section class="demo-section">
    <h2 class="demo-section__title">Playground</h2>
    <div class="pg">
        <div class="pg__stage" style="@StageStyle">@Preview</div>
        <aside class="pg__controls">@Controls</aside>
    </div>
    <CodeBlock Code="@Code" WpfCode="@WpfCode" AvaloniaCode="@AvaloniaCode" />
</section>

@code {
    [Parameter] public RenderFragment? Preview { get; set; }
    [Parameter] public RenderFragment? Controls { get; set; }
    [Parameter] public string Code { get; set; } = "";
    [Parameter] public string? StageStyle { get; set; }

    /// <summary>The same example for WPF.</summary>
    [Parameter] public string? WpfCode { get; set; }

    /// <summary>The Avalonia version when it differs from the WPF one beyond names.</summary>
    [Parameter] public string? AvaloniaCode { get; set; }
}
