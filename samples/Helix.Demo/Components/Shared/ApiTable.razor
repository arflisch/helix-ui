<section class="demo-section">
    <h2 class="demo-section__title">@Title</h2>
    @if (ShowIntro)
    {
    <p class="demo-section__text">
        Every visual parameter maps to a CSS variable. Use the parameter for one specific component,
        or the variable (in your CSS or through <code>HelixTheme.Set(...)</code>) for every component at once.
    </p>
    }
    <div class="api">
        <table>
            <thead>
                <tr><th>Parameter</th><th>Type</th><th>CSS variable</th><th>Description</th></tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr>
                        <td><code class="api__param">@row.Param</code></td>
                        <td><code class="api__type">@row.Type</code></td>
                        <td>@if (!string.IsNullOrEmpty(row.CssVar)) { <code class="api__var">@row.CssVar</code> } else { <span class="api__none">—</span> }</td>
                        <td>@row.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@code {
    [Parameter] public string Title { get; set; } = "API";
    [Parameter] public bool ShowIntro { get; set; } = true;
    [Parameter] public IReadOnlyList<ApiRow> Rows { get; set; } = [];
}
