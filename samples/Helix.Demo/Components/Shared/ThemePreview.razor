@* A small, representative screen rendered with a theme forced to one mode. *@
<HelixProvider Theme="Theme.Clone(Mode)" ShowHosts="false" Class="theme-preview">
    <div class="theme-preview__head">
        <span class="theme-preview__mode"><HelixIcon Name="@(Mode == HelixThemeMode.Dark ? "moon" : "sun")" Size="14" /> @(Mode == HelixThemeMode.Dark ? "Dark" : "Light")</span>
        <HelixBadge Color="success" Dot="true">Online</HelixBadge>
    </div>
    <HelixCard Title="Reserve request" Subtitle="Send before 14:00">
        <ChildContent>
            <div class="stack">
                <HelixTextField Label="Site" Value="Lyon plant" Icon="search" />
                <div class="grid-2">
                    <HelixNumberField Label="Power" Value="120" Unit="MW" />
                    <HelixSelect TValue="string" Label="Type" Items="Types" Value="@("Scheduled")" />
                </div>
                <HelixSwitch Label="Confirm automatically" Checked="true" />
                <HelixProgress Label="Capacity used" Value="68" ShowValue="true" />
            </div>
        </ChildContent>
        <Footer>
            <HelixButton Variant="HelixVariant.Ghost" Color="neutral" Size="HelixSize.Sm">Cancel</HelixButton>
            <HelixButton Size="HelixSize.Sm" Icon="check">Send</HelixButton>
        </Footer>
    </HelixCard>
    <HelixAlert Severity="HelixSeverity.Warning" Title="Threshold near">The imbalance is nearing 300 MW.</HelixAlert>
</HelixProvider>

@code {
    private static readonly string[] Types = ["Direct", "Scheduled"];

    [Parameter, EditorRequired] public HelixTheme Theme { get; set; } = new();
    [Parameter] public HelixThemeMode Mode { get; set; } = HelixThemeMode.Light;
}
