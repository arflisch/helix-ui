<HelixBadge Color="@Color" Dot="true">@Label</HelixBadge>

@code {
    [Parameter] public EmployeeStatus Status { get; set; }

    private string Color => Status switch
    {
        EmployeeStatus.Active => "success",
        EmployeeStatus.Remote => "info",
        EmployeeStatus.Leave => "warning",
        _ => "danger",
    };

    private string Label => Status switch
    {
        EmployeeStatus.Active => "Actif",
        EmployeeStatus.Remote => "Télétravail",
        EmployeeStatus.Leave => "Congé",
        _ => "Départ",
    };
}
