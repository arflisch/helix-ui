@inherits LayoutComponentBase
@implements IDisposable
@inject DemoThemeState ThemeState
@inject IJSRuntime JS
@inject HelixNotificationService Notifications

<HelixProvider Theme="ThemeState.Theme" Class="demo">
    <aside class="@(new CssBuilder("demo-sidebar").Add("is-open", _menuOpen).Build())">
        <a class="demo-logo" href="">
            <span class="demo-logo__mark"></span>
            Helix<span class="demo-logo__ui">UI</span>
        </a>

        <nav class="demo-nav" @onclick="() => _menuOpen = false">
            @foreach (var group in DemoNav.Groups)
            {
                <p class="demo-nav__group">@group.Title</p>
                @foreach (var item in group.Items)
                {
                    <NavLink class="demo-nav__link" href="@item.Href" Match="@(item.Href == "" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                        @item.Title
                    </NavLink>
                }
            }
        </nav>
    </aside>

    <div class="demo-main">
        <header class="demo-topbar">
            <button class="helix-close demo-menu-btn" aria-label="Menu" @onclick="() => _menuOpen = !_menuOpen">
                <HelixIcon Svg="<path d='M4 7h16M4 12h16M4 17h16'/>" Size="18" />
            </button>
            <div class="demo-topbar__spacer"></div>

            <HelixNotificationCenter>
                <Footer><a class="helix-notif__link" href="components/notifications">About this panel</a></Footer>
            </HelixNotificationCenter>

            <HelixMenu Align="HelixAlign.End" MinWidth="230px">
                <Trigger>
                    <HelixButton Variant="HelixVariant.Ghost" Color="neutral" Size="HelixSize.Sm" IconEnd="chevron-down">
                        <span class="demo-theme-dot"></span>
                        @(ThemeState.Preset ?? "Custom")
                    </HelixButton>
                </Trigger>
                <ChildContent>
                    <HelixMenuLabel>Theme</HelixMenuLabel>
                    @foreach (var (name, create) in HelixThemes.All)
                    {
                        <HelixMenuItem Checked="@(ThemeState.Preset == name)" OnClick="() => ThemeState.Apply(create(), name)">@name</HelixMenuItem>
                    }
                    <HelixMenuItem Icon="settings" Href="themes">Create a theme…</HelixMenuItem>
                </ChildContent>
            </HelixMenu>

            <HelixMenu Align="HelixAlign.End" MinWidth="180px">
                <Trigger>
                    <HelixButton Variant="HelixVariant.Ghost" Color="neutral" Icon="@ModeIcon" aria-label="Light, dark or system mode" />
                </Trigger>
                <ChildContent>
                    <HelixMenuLabel>Appearance</HelixMenuLabel>
                    <HelixMenuItem Icon="sun" Checked="@(Mode == HelixThemeMode.Light)" OnClick="() => SetMode(HelixThemeMode.Light)">Light</HelixMenuItem>
                    <HelixMenuItem Icon="moon" Checked="@(Mode == HelixThemeMode.Dark)" OnClick="() => SetMode(HelixThemeMode.Dark)">Dark</HelixMenuItem>
                    <HelixMenuItem Icon="settings" Checked="@(Mode == HelixThemeMode.System)" Description="Follows the computer setting" OnClick="() => SetMode(HelixThemeMode.System)">System</HelixMenuItem>
                </ChildContent>
            </HelixMenu>
        </header>

        <main class="demo-content">
            @Body
        </main>
    </div>
</HelixProvider>

<div id="blazor-error-ui" data-nosnippet>
    An unexpected error occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string StorageKey = "helix-demo-theme";

    private bool _menuOpen;
    private bool _restored;

    private HelixThemeMode Mode => ThemeState.Theme.Mode;

    private string ModeIcon => Mode switch
    {
        HelixThemeMode.Dark => "moon",
        HelixThemeMode.System => "settings",
        _ => "sun",
    };

    protected override void OnInitialized()
    {
        ThemeState.Changed += OnThemeChanged;
        if (Notifications.Items.Count == 0)
        {
            var now = DateTime.Now;
            Notifications.Add("Welcome to Helix UI 0.3", HelixSeverity.Info, "TimeBar, Excel and Word export, notification center.", link: "export", actionText: "See the export", time: now.AddDays(-2), read: true);
            Notifications.Add("Report exported", HelixSeverity.Success, "team-report.docx", link: "export", actionText: "Open", time: now.AddMinutes(-12));
            Notifications.Add("Deadline in 5 minutes", HelixSeverity.Warning, "Submission for the next quarter hour", link: "components/timebar", actionText: "Open the TimeBar", time: now.AddMinutes(-5));
            Notifications.Add("Submission rejected", HelixSeverity.Danger, "Slot 14:15–14:30: the value is above the limit.", time: now.AddMinutes(-2));
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            ThemeState.Restore(await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey));
            _restored = true;
            StateHasChanged();
        }
    }

    private void OnThemeChanged() => _ = InvokeAsync(async () =>
    {
        StateHasChanged();
        if (_restored)
        {
            await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, ThemeState.Serialize());
        }
    });

    private void SetMode(HelixThemeMode mode)
    {
        ThemeState.Theme.Mode = mode;
        ThemeState.Notify();
    }

    public void Dispose() => ThemeState.Changed -= OnThemeChanged;
}
