@page "/getting-started"

<DemoPage Title="Installation" Eyebrow="Guide" Description="A few steps, and every component is available in your Blazor, WPF or Avalonia app. The Blazor / WPF / Avalonia switch on code blocks changes the examples across the whole site.">
    <section class="demo-section" style="margin-bottom:28px">
        <h2 class="demo-section__title">Start a new app</h2>
        <p class="demo-section__text">The templates create an app with the Helix theme (light, dark or system), a layout and a ready-made report page: filters, a grid with totals and CSV export, preferences remembered per user.</p>
        <CodeBlock Language="bash" Code="@TemplateCode" WpfCode="@WpfTemplateCode" AvaloniaCode="@AvaloniaTemplateCode" />
        <p class="demo-section__text" style="margin-top:14px">Or add Helix to an existing app, in a few steps:</p>
    </section>
    <div class="steps">
        <div class="step">
            <p class="step__title">Install the NuGet package</p>
            <p class="step__text">
                <code>Helix.Blazor</code> needs .NET 10. <code>Helix.Wpf</code> works with .NET 8 and later (Windows). <code>Helix.Avalonia</code> works with .NET 8 and later on Windows, macOS and Linux (Avalonia 12).
                From a terminal in your project folder:
            </p>
            <CodeBlock Language="bash" Code="dotnet add package Helix.Blazor" WpfCode="dotnet add package Helix.Wpf" />
            <p class="step__text" style="margin-top:14px">
                Or search for <code>Helix.Blazor</code> / <code>Helix.Wpf</code> / <code>Helix.Avalonia</code> in Visual Studio's NuGet package manager,
                or add the reference to your <code>.csproj</code> yourself.
                With central package management, the version goes in <code>Directory.Packages.props</code> instead.
            </p>
            <CodeBlock Language="xml" Code="@PackageReferenceCode" WpfCode="@WpfPackageReferenceCode" AvaloniaCode="@AvaloniaPackageReferenceCode" />
        </div>
        <div class="step">
            <p class="step__title">Register the services</p>
            <p class="step__text">One line in <code>Program.cs</code> (needed for toasts).</p>
            <CodeBlock Language="c#" Code="@ProgramCode" WpfCode="@WpfAppCode" AvaloniaCode="@AvaloniaAppCode" />
        </div>
        <div class="step">
            <p class="step__title">Add the stylesheet and the using</p>
            <p class="step__text">In <code>App.razor</code> and <code>_Imports.razor</code>.</p>
            <CodeBlock Language="razor" Code="@ImportsCode" WpfCode="@WpfNamespaceCode" AvaloniaCode="@AvaloniaNamespaceCode" />
        </div>
        <div class="step">
            <p class="step__title">Wrap the layout</p>
            <p class="step__text"><code>HelixProvider</code> applies the theme and dark mode, and shows toasts.</p>
            <CodeBlock Language="razor" Code="@LayoutCode" WpfCode="@WpfHostCode" AvaloniaCode="@AvaloniaHostCode" />
        </div>
        <div class="step">
            <p class="step__title">Use the components</p>
            <p class="step__text">You're ready.</p>
            <CodeBlock Language="razor" Code="@UsageCode" WpfCode="@WpfUsageCode" />
        </div>
    </div>
</DemoPage>

@code {
    private const string PackageReferenceCode = """
        <!-- YourApp.csproj -->
        <ItemGroup>
            <PackageReference Include="Helix.Blazor" Version="0.3.0" />
        </ItemGroup>

        <!-- Or, with central package management: Directory.Packages.props -->
        <PackageVersion Include="Helix.Blazor" Version="0.3.0" />
        <!-- and in YourApp.csproj -->
        <PackageReference Include="Helix.Blazor" />
        """;

    private const string WpfPackageReferenceCode = """
        <!-- YourApp.csproj (net8.0-windows or later, UseWPF) -->
        <ItemGroup>
            <PackageReference Include="Helix.Wpf" Version="0.3.0" />
        </ItemGroup>

        <!-- Or, with central package management: Directory.Packages.props -->
        <PackageVersion Include="Helix.Wpf" Version="0.3.0" />
        <!-- and in YourApp.csproj -->
        <PackageReference Include="Helix.Wpf" />
        """;

    private const string TemplateCode = """
        dotnet new install Helix.Templates
        dotnet new helix-blazor -n MyApp
        """;

    private const string WpfTemplateCode = """
        dotnet new install Helix.Templates
        dotnet new helix-wpf -n MyApp            # .NET 8 by default; --Framework net10.0-windows
        """;

    private const string WpfAppCode = """
        <!-- WPF · App.xaml: the theme (light, dark or like Windows) -->
        <Application.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <helix:HelixResources Mode="System" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Application.Resources>
        """;

    private const string WpfNamespaceCode = """
        <!-- WPF · a single XAML namespace for every control -->
        <Window xmlns:helix="https://helix-ui.dev/wpf" … >

        // In C#: using Helix.Wpf;
        """;

    private const string WpfHostCode = """
        <!-- WPF · MainWindow.xaml: HelixHost shows notifications, dialogs and confirmations -->
        <Window … Background="{DynamicResource Helix.Background}">
            <helix:HelixHost>
                <!-- your layout -->
            </helix:HelixHost>
        </Window>
        """;

    private const string AvaloniaPackageReferenceCode = """
        <!-- YourApp.csproj (net8.0 or later; Windows, macOS, Linux) -->
        <ItemGroup>
            <PackageReference Include="Helix.Avalonia" Version="0.3.0" />
        </ItemGroup>

        <!-- Or, with central package management: Directory.Packages.props -->
        <PackageVersion Include="Helix.Avalonia" Version="0.3.0" />
        <!-- and in YourApp.csproj -->
        <PackageReference Include="Helix.Avalonia" />
        """;

    private const string AvaloniaTemplateCode = """
        dotnet new install Avalonia.Templates
        dotnet new avalonia.app -n MyApp          # then add Helix.Avalonia (next step)
        """;

    private const string AvaloniaAppCode = """
        <!-- Avalonia · App.axaml: the Fluent theme, then Helix (light, dark or like the system) -->
        <Application xmlns:helix="using:Helix.Avalonia" …>
            <Application.Styles>
                <FluentTheme />
                <helix:HelixTheme Mode="System" />
            </Application.Styles>
        </Application>
        """;

    private const string AvaloniaNamespaceCode = """
        <!-- Avalonia · a single XAML namespace for every control -->
        <Window xmlns:helix="using:Helix.Avalonia" … >

        // In C#: using Helix.Avalonia;
        """;

    private const string AvaloniaHostCode = """
        <!-- Avalonia · MainWindow.axaml: HelixHost shows toasts, dialogs, drawers and confirmations -->
        <Window … Background="{DynamicResource Helix.Background}">
            <helix:HelixHost>
                <!-- your layout -->
            </helix:HelixHost>
        </Window>
        """;

    private const string WpfUsageCode = """
        <helix:HelixButton Content="Save" Icon="check" Click="OnSave" />
        <helix:HelixSwitch Content="Autopilot" ThumbBrush="#F59E0B" IsChecked="{Binding Auto}" />
        """;

    private const string ProgramCode = """
        builder.Services.AddHelix();
        """;

    private const string ImportsCode = """
        <!-- App.razor, in <head> -->
        <link rel="stylesheet" href="_content/Helix.Blazor/helix.css" />

        @* _Imports.razor *@
        @using Helix.Blazor
        """;

    private const string LayoutCode = """
        @inherits LayoutComponentBase

        <HelixProvider Theme="_theme">
            @Body
        </HelixProvider>

        @code {
            private readonly HelixTheme _theme = new() { Primary = "#4f46e5" };
        }
        """;

    private const string UsageCode = """
        <HelixTextField Label="Email" @bind-Value="email" Icon="mail" Clearable />
        <HelixSwitch Label="Notifications" @bind-Checked="enabled" />
        <HelixButton OnClick="Save">Save</HelixButton>
        """;
}
