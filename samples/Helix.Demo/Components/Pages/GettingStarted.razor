@page "/getting-started"

<DemoPage Title="Installation" Eyebrow="Guide" Description="A few steps, and every component is available in your Blazor or WPF app. The Blazor / WPF switch on code blocks changes the examples across the whole site.">
    <div class="steps">
        <div class="step">
            <p class="step__title">Install the NuGet package</p>
            <p class="step__text">
                <code>Helix.Blazor</code> needs .NET 10. <code>Helix.Wpf</code> works with .NET 8 and later (Windows).
                From a terminal in your project folder:
            </p>
            <CodeBlock Language="bash" Code="dotnet add package Helix.Blazor" WpfCode="dotnet add package Helix.Wpf" />
            <p class="step__text" style="margin-top:14px">
                Or search for <code>Helix.Blazor</code> / <code>Helix.Wpf</code> in Visual Studio's NuGet package manager,
                or add the reference to your <code>.csproj</code> yourself.
                With central package management, the version goes in <code>Directory.Packages.props</code> instead.
            </p>
            <CodeBlock Language="xml" Code="@PackageReferenceCode" WpfCode="@WpfPackageReferenceCode" />
        </div>
        <div class="step">
            <p class="step__title">Register the services</p>
            <p class="step__text">One line in <code>Program.cs</code> (needed for toasts).</p>
            <CodeBlock Language="c#" Code="@ProgramCode" WpfCode="@WpfAppCode" />
        </div>
        <div class="step">
            <p class="step__title">Add the stylesheet and the using</p>
            <p class="step__text">In <code>App.razor</code> and <code>_Imports.razor</code>.</p>
            <CodeBlock Language="razor" Code="@ImportsCode" WpfCode="@WpfNamespaceCode" />
        </div>
        <div class="step">
            <p class="step__title">Wrap the layout</p>
            <p class="step__text"><code>HelixProvider</code> applies the theme and dark mode, and shows toasts.</p>
            <CodeBlock Language="razor" Code="@LayoutCode" WpfCode="@WpfHostCode" />
        </div>
        <div class="step">
            <p class="step__title">Use the components</p>
            <p class="step__text">You're ready.</p>
            <CodeBlock Language="razor" Code="@UsageCode" WpfCode="@WpfUsageCode" />
        </div>
    </div>
</DemoPage>

@code {
    private const string PackageReferenceCode = """
        <!-- YourApp.csproj -->
        <ItemGroup>
            <PackageReference Include="Helix.Blazor" Version="0.1.0" />
        </ItemGroup>

        <!-- Or, with central package management: Directory.Packages.props -->
        <PackageVersion Include="Helix.Blazor" Version="0.1.0" />
        <!-- and in YourApp.csproj -->
        <PackageReference Include="Helix.Blazor" />
        """;

    private const string WpfPackageReferenceCode = """
        <!-- YourApp.csproj (net8.0-windows or later, UseWPF) -->
        <ItemGroup>
            <PackageReference Include="Helix.Wpf" Version="0.1.0" />
        </ItemGroup>

        <!-- Or, with central package management: Directory.Packages.props -->
        <PackageVersion Include="Helix.Wpf" Version="0.1.0" />
        <!-- and in YourApp.csproj -->
        <PackageReference Include="Helix.Wpf" />
        """;

    private const string WpfAppCode = """
        <!-- WPF · App.xaml: the theme (light, dark or like Windows) -->
        <Application.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <helix:HelixResources Mode="System" />
                </ResourceDictionary.MergedDictionaries>
            </ResourceDictionary>
        </Application.Resources>
        """;

    private const string WpfNamespaceCode = """
        <!-- WPF · a single XAML namespace for every control -->
        <Window xmlns:helix="https://helix-ui.dev/wpf" … >

        // In C#: using Helix.Wpf;
        """;

    private const string WpfHostCode = """
        <!-- WPF · MainWindow.xaml: HelixHost shows notifications, dialogs and confirmations -->
        <Window … Background="{DynamicResource Helix.Background}">
            <helix:HelixHost>
                <!-- your layout -->
            </helix:HelixHost>
        </Window>
        """;

    private const string WpfUsageCode = """
        <helix:HelixButton Content="Save" Icon="check" Click="OnSave" />
        <helix:HelixSwitch Content="Autopilot" ThumbBrush="#F59E0B" IsChecked="{Binding Auto}" />
        """;

    private const string ProgramCode = """
        builder.Services.AddHelix();
        """;

    private const string ImportsCode = """
        <!-- App.razor, in <head> -->
        <link rel="stylesheet" href="_content/Helix.Blazor/helix.css" />

        @* _Imports.razor *@
        @using Helix.Blazor
        """;

    private const string LayoutCode = """
        @inherits LayoutComponentBase

        <HelixProvider Theme="_theme">
            @Body
        </HelixProvider>

        @code {
            private readonly HelixTheme _theme = new() { Primary = "#4f46e5" };
        }
        """;

    private const string UsageCode = """
        <HelixTextField Label="Email" @bind-Value="email" Icon="mail" Clearable />
        <HelixSwitch Label="Notifications" @bind-Checked="enabled" />
        <HelixButton OnClick="Save">Save</HelixButton>
        """;
}
