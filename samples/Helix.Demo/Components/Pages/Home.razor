@page "/"
@inject HelixToastService Toasts

<PageTitle>Helix UI · Blazor and WPF components</PageTitle>

<div class="demo-page">
    <section class="hero">
        <HelixBadge Color="primary" Dot="true" Class="hero__badge">v0.2 · Blazor · WPF</HelixBadge>
        <h1 class="hero__title">Blazor and WPF components that <em>look good by default</em> and are simple to customize.</h1>
        <p class="hero__lead">
            Helix UI gives you clean, accessible components. Every visual detail is a parameter:
            no template to copy, no CSS to fight.
        </p>
        <div class="row">
            <HelixButton Size="HelixSize.Lg" IconEnd="arrow-right" OnClick="@(() => Nav.NavigateTo("getting-started"))">Get started</HelixButton>
            <HelixButton Size="HelixSize.Lg" Variant="HelixVariant.Outline" Color="neutral" Icon="settings" OnClick="@(() => Nav.NavigateTo("customization"))">Customization</HelixButton>
        </div>
    </section>

    <section class="showcase">
        <HelixCard Title="Create an account" Subtitle="It only takes a few seconds." Elevated="true">
            <ChildContent>
                <div class="stack">
                    <div class="grid-2">
                        <HelixTextField Label="First name" @bind-Value="_firstName" Placeholder="Ada" />
                        <HelixTextField Label="Last name" @bind-Value="_lastName" Placeholder="Lovelace" />
                    </div>
                    <HelixTextField Label="Email" Icon="mail" @bind-Value="_email" Placeholder="ada@example.com" Clearable="true"
                                   Error="@(_email is { Length: > 0 } && !_email.Contains('@') ? "Invalid address" : null)" />
                    <HelixSelect Label="Role" Items="_roles" @bind-Value="_role" />
                    <HelixCheckbox @bind-Checked="_terms" Label="I accept the terms of use" />
                </div>
            </ChildContent>
            <Footer>
                <HelixButton Variant="HelixVariant.Ghost" Color="neutral">Cancel</HelixButton>
                <HelixButton Disabled="!_terms" Loading="_saving" OnClick="Save">Create account</HelixButton>
            </Footer>
        </HelixCard>

        <div class="stack">
            <HelixCard Title="Notifications" Subtitle="Choose what you receive.">
                <Actions><HelixBadge Color="success" Dot="true">Active</HelixBadge></Actions>
                <ChildContent>
                    <div class="stack">
                        <HelixSwitch @bind-Checked="_n1" Label="New comments" />
                        <HelixSwitch @bind-Checked="_n2" Label="Mentions" Color="#10b981" />
                        <HelixSwitch @bind-Checked="_n3" Label="Weekly summary" Color="#f59e0b" ThumbOnColor="#fff7ed" />
                        <HelixSlider Label="Volume" @bind-Value="_volume" Format="@(v => $"{v:0} %")" />
                    </div>
                </ChildContent>
            </HelixCard>
            <HelixCard>
                <div class="row" style="justify-content:space-between">
                    <HelixAvatarGroup>
                        <HelixAvatar Name="Ada Lovelace" />
                        <HelixAvatar Name="Alan Turing" />
                        <HelixAvatar Name="Grace Hopper" />
                        <HelixAvatar Name="Linus Torvalds" />
                    </HelixAvatarGroup>
                    <HelixTooltip Text="Invite a member">
                        <HelixButton Variant="HelixVariant.Soft" Icon="plus" aria-label="Invite" />
                    </HelixTooltip>
                </div>
                <div style="margin-top:16px">
                    <HelixProgress Label="Storage" Value="68" ShowValue="true" />
                </div>
            </HelixCard>
        </div>
    </section>

    <section class="features">
        <HelixCard>
            <span class="feature__icon"><HelixIcon Name="sparkles" Size="18" /></span>
            <p class="feature__title">Beautiful without effort</p>
            <p class="feature__text">Careful typography, spacing, shadows and animations. Light and dark included.</p>
        </HelixCard>
        <HelixCard>
            <span class="feature__icon"><HelixIcon Name="settings" Size="18" /></span>
            <p class="feature__title">A parameter, not a template</p>
            <p class="feature__text"><code>&lt;HelixSwitch ThumbColor="#f59e0b" /&gt;</code>: the thumb changes, that's all.</p>
        </HelixCard>
        <HelixCard>
            <span class="feature__icon"><HelixIcon Name="lock" Size="18" /></span>
            <p class="feature__title">Your CSS always wins</p>
            <p class="feature__text">Zero-specificity styles: a plain class overrides Helix, without <code>!important</code>.</p>
        </HelixCard>
    </section>

    <section class="demo-section">
        <h2 class="demo-section__title">Components</h2>
        <p class="demo-section__text">Every page has a playground: set the parameters and copy the generated code.</p>
        <div class="comp-grid">
            @foreach (var item in DemoNav.Components)
            {
                <a class="comp-link" href="@item.Href">
                    <HelixCard Hoverable="true" Padding="18px">
                        <div class="comp-link__head">
                            <span class="comp-link__title">@item.Title</span>
                            <HelixIcon Name="arrow-right" Size="15" Class="comp-link__arrow" />
                        </div>
                        <p class="comp-link__text">@item.Description</p>
                    </HelixCard>
                </a>
            }
        </div>
    </section>
</div>

@code {
    [Inject] private NavigationManager Nav { get; set; } = default!;

    private readonly string[] _roles = ["Developer", "Designer", "Product manager", "Other"];
    private string? _firstName, _lastName, _email;
    private string? _role = "Developer";
    private bool _terms, _saving;
    private bool _n1 = true, _n2 = true, _n3;
    private double _volume = 60;

    private async Task Save()
    {
        _saving = true;
        await Task.Delay(900);
        _saving = false;
        Toasts.Success($"Welcome {(_firstName is { Length: > 0 } ? _firstName : "aboard")}!", "Account created");
    }
}
