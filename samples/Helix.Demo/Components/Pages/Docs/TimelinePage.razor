@page "/components/timeline"
@using System.Globalization
@using static Helix.Demo.Components.Shared.Snippet
@inject HelixToastService Toasts

<DemoPage Title="Timeline" Description="Schedule on a time scale: slots, statuses with a legend (filled, outline, dashed), a “now” line that moves in real time, shaded past, grouping by lane and collapsing.">
    <section class="demo-section">
        <h2 class="demo-section__title">Playground</h2>
        <div class="pg pg--wide">
            <div class="pg__stage pg__stage--block">
                <HelixTimeline Title="Hourly program" Start="_start" End="_start.AddHours(_hours)" SlotDuration="TimeSpan.FromMinutes(_slot)"
                              Items="_demands" Statuses="EnergyData.Statuses" Layout="_layout" ShowNow="_showNow" ShadePast="_shadePast"
                              ShowLegend="_legend" Collapsible="true" NowColor="@_nowColor" SlotMinWidth="@($"{N(_slotWidth)}px")"
                              OnItemClick="Open" Culture="English" />
            </div>
            <aside class="pg__controls">
                <Choice TEnum="HelixTimelineLayout" Label="Layout" @bind-Value="_layout" />
                <Choice TEnum="SlotChoice" Label="SlotDuration" Value="_slotChoice" ValueChanged="SetSlot" />
                <HelixSlider Label="SlotMinWidth" @bind-Value="_slotWidth" Min="60" Max="220" Step="10" Format="@(v => $"{v} px")" />
                <ColorPicker Label="NowColor" @bind-Value="_nowColor" Colors="@(["#eb6834", "danger", "#18181b"])" />
                <HelixSwitch Label="ShowNow (real time)" @bind-Checked="_showNow" Size="HelixSize.Sm" />
                <HelixSwitch Label="ShadePast" @bind-Checked="_shadePast" Size="HelixSize.Sm" />
                <HelixSwitch Label="ShowLegend" @bind-Checked="_legend" Size="HelixSize.Sm" />
            </aside>
        </div>
        <CodeBlock Code="@Code" />
    </section>

    <Example WpfCode="@Wpf1" Title="Several lanes (Lane), editable" Description="Give each item a Lane: one row per unit. With Editable, drag an item to move it (including to another unit), pull its edges to change its duration, or use the arrows (Shift + arrows for the duration). Confirmed items are locked (CanEdit)." Code="@LanesCode">
        <HelixTimeline Title="Production plan" Start="EnergyData.Today" End="EnergyData.Today.AddDays(1)" SlotDuration="TimeSpan.FromHours(1)"
                      Items="_plan" Statuses="EnergyData.Statuses" ShowLegend="false" LaneHeader="Unit" SlotMinWidth="56px" Culture="English"
                      Editable="true" SnapTo="TimeSpan.FromMinutes(30)" CanEdit="@(i => !i.Status!.EndsWith("-ack"))" OnItemChanged="ChangePlan">
            <ItemTemplate>
                <span style="display:inline-flex;align-items:center;gap:6px">
                    @if (context.Status == "rejected") { <HelixIcon Name="danger" Size="12" /> }
                    @context.Label
                </span>
            </ItemTemplate>
        </HelixTimeline>
    </Example>

    <ApiTable Title="HelixTimeline" Rows="Api" />
    <ApiTable Title="HelixTimelineItem and HelixTimelineStatus" Rows="ItemApi" ShowIntro="false" />
</DemoPage>

<HelixDialog @bind-Open="_open" Title="@_opened?.Label" Description="@Period(_opened)" Width="400px">
    <ChildContent>
        @if (_opened is not null)
        {
            var status = EnergyData.Statuses.FirstOrDefault(s => s.Key == _opened.Status);
            <div class="row">
                <HelixBadge Dot="true" Color="@status?.Color">@(status?.Label ?? "No status")</HelixBadge>
            </div>
        }
    </ChildContent>
    <Footer>
        <HelixButton Variant="HelixVariant.Outline" Color="neutral" OnClick="() => _open = false">Close</HelixButton>
        <HelixButton OnClick="Resend">Resend</HelixButton>
    </Footer>
</HelixDialog>

@code {
    private const string Wpf1 = """
        <helix:HelixTimeline Title="Team schedule" Start="{Binding From}" End="{Binding To}" SlotDuration="1:00:00"
                           Items="{Binding Items}" Statuses="{Binding Statuses}" LaneHeader="TEAM"
                           IsEditable="True" AllowLaneChange="True" SnapTo="0:15:00"
                           ShowNow="True" NowBrush="#F15A24" IsCollapsible="True"
                           ItemChanged="OnItemChanged" />

        // Code-behind: the timeline proposes, your code applies
        Statuses = [new HelixTimelineStatus("done", "Done", "series-3"),
                    new HelixTimelineStatus("planned", "Planned", "series-1", HelixTimelineAppearance.Outline)];
        Items = [new("1", day.AddHours(7), day.AddHours(10), "Inspection") { Lane = "Team A", Status = "done" }];

        private void OnItemChanged(object sender, RoutedEventArgs e)
        {
            var change = ((HelixEventArgs<HelixTimelineChange>)e).Value;
            Items = Items.Select(i => i.Id == change.Item.Id ? change.Applied : i).ToList();
        }
        """;

    private enum SlotChoice { Min15, Min30, Hour }

    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-GB");

    private readonly DateTime _start = DateTime.Now.Date.AddHours(DateTime.Now.Hour - 1);
    private readonly int _hours = 4;
    private IReadOnlyList<HelixTimelineItem> _demands = [];
    private IReadOnlyList<HelixTimelineItem> _plan = EnergyData.UnitPlan(EnergyData.Today);

    private void ChangePlan(HelixTimelineChange change)
    {
        _plan = _plan.Select(i => i.Id == change.Item.Id ? change.Applied : i).ToList();
        Toasts.Show($"{change.Item.Label}: {change.Start:HH:mm} – {change.End:HH:mm}{(change.Lane != change.Item.Lane ? $" · {change.Lane}" : "")}", HelixSeverity.Success, duration: TimeSpan.FromSeconds(2));
    }

    private HelixTimelineLayout _layout = HelixTimelineLayout.Staircase;
    private SlotChoice _slotChoice;
    private double _slot = 15, _slotWidth = 130;
    private string? _nowColor = "#eb6834";
    private bool _showNow = true, _shadePast = true, _legend = true, _open;
    private HelixTimelineItem? _opened;

    protected override void OnInitialized() => _demands = EnergyData.Demands(_start, _hours, DateTime.Now);

    private void SetSlot(SlotChoice choice)
    {
        _slotChoice = choice;
        (_slot, _slotWidth) = choice switch { SlotChoice.Min30 => (30d, 150d), SlotChoice.Hour => (60d, 170d), _ => (15d, 130d) };
    }

    private void Open(HelixTimelineItem item)
    {
        _opened = item;
        _open = true;
    }

    private void Resend()
    {
        _open = false;
        Toasts.Success($"{_opened?.Label} resent", "Request sent");
    }

    private static string? Period(HelixTimelineItem? item) => item is null ? null : $"{item.Start:HH:mm} – {item.End:HH:mm}";

    private string Code =>
        $"""
        <HelixTimeline Title="Hourly program" Start="start" End="start.AddHours(4)"{(_slot == 15 ? "" : $" SlotDuration=\"TimeSpan.FromMinutes({_slot})\"")}
                      Items="demands" Statuses="statuses"{A("Layout", _layout, HelixTimelineLayout.Packed)}{A("NowColor", _nowColor)}{(_showNow ? "" : " ShowNow=\"false\"")}{(_shadePast ? "" : " ShadePast=\"false\"")}{(_legend ? "" : " ShowLegend=\"false\"")}
                      Collapsible OnItemClick="Open" />

        @code {"{"}
            private HelixTimelineStatus[] statuses =
            [
                new("saved", "Saved", "var(--helix-series-1)", HelixTimelineAppearance.Dashed),
                new("sent", "Sent", "var(--helix-series-1)", HelixTimelineAppearance.Outline),
                new("ack", "Confirmed", "var(--helix-series-1)", HelixTimelineAppearance.Filled),
                new("rejected", "Rejected", "danger"),
            ];

            private HelixTimelineItem[] demands =
            [
                new("1", at(11, 00), at(11, 15), "SA: 12.5 MW") {"{"} Status = "ack" {"}"},
                new("2", at(11, 15), at(11, 30), "SA: 8.0 MW") {"{"} Status = "sent" {"}"},
            ];
        {"}"}
        """;

    private const string LanesCode = """
        <HelixTimeline Title="Production plan" Start="today" End="today.AddDays(1)" SlotDuration="TimeSpan.FromHours(1)"
                      Items="plan" Statuses="statuses" LaneHeader="Unit"
                      Editable SnapTo="TimeSpan.FromMinutes(30)" CanEdit="@(i => i.Status != "ack")" OnItemChanged="Change">
            <ItemTemplate>@context.Label</ItemTemplate>
        </HelixTimeline>

        // new HelixTimelineItem("u1", from, to, "Base 120 MW") { Lane = "Plant A", Status = "ack" }

        private void Change(HelixTimelineChange change) =>
            plan = plan.Select(i => i.Id == change.Item.Id ? change.Applied : i).ToList();   // or your API
        """;

    private static readonly ApiRow[] Api =
    [
        new("Start / End / SlotDuration", "DateTime / DateTime / TimeSpan", null, "Displayed window and width of a slot (15 min)."),
        new("Items", "IEnumerable<HelixTimelineItem>", null, "The items to place."),
        new("Statuses", "IReadOnlyList<HelixTimelineStatus>", null, "Legend + rendering (Filled, Outline, Dashed) and color per status."),
        new("Layout", "HelixTimelineLayout", null, "Packed (rows are shared) or Staircase (one row per item)."),
        new("ItemTemplate / OnItemClick", "RenderFragment<HelixTimelineItem> / EventCallback", null, "Free content of an item; click."),
        new("ShowNow / NowRefresh", "bool / TimeSpan", "--helix-timeline-now", "“Now” line + badge, updated in real time (30 s)."),
        new("NowColor", "string", "--helix-timeline-now", "Color of the line and badge."),
        new("ShadePast", "bool", null, "Shades the part already past (true)."),
        new("Collapsible / Collapsed", "bool", null, "Collapse button; @bind-Collapsed."),
        new("SlotMinWidth", "string", null, "Minimum slot width; below it, horizontal scrolling."),
        new("RowHeight / LaneWidth / LaneHeader", "int / string / string", "--helix-timeline-row-h, --helix-timeline-lane-w", "Row height, label column."),
        new("SlotLabel", "Func<DateTime, DateTime, string>", null, "Slot label (“11:00 – 11:15” by default)."),
        new("HeaderContent", "RenderFragment", null, "Content next to the title (filters, buttons)."),
        new("—", "", "--helix-timeline-bg", "Background."),
    ];

    private static readonly ApiRow[] ItemApi =
    [
        new("HelixTimelineItem(Id, Start, End, Label)", "record", null, "An item; Id is the render key."),
        new("Status / Lane / Color / Data", "string / string / string / object", null, "Status (key), lane, forced color, your object."),
        new("HelixTimelineStatus(Key, Label, Color, Appearance)", "record", null, "Appearance: Filled (confirmed), Outline (sent), Dashed (draft)."),
    ];
}
