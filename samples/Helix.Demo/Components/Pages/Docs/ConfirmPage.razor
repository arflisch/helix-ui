@page "/components/confirm"
@inject HelixConfirmService Confirm
@inject HelixToastService Toasts

<DemoPage Title="Confirm" Description="Ask for confirmation from any code, in one line that awaits the answer: if (await Confirm.AskAsync(…)). No dialog to declare in the page: HelixProvider shows it.">
    <Example WpfCode="@Wpf1" Title="Examples" Code="@Code">
        <div class="row">
            <HelixButton Color="danger" Variant="HelixVariant.Soft" Icon="trash" OnClick="Delete">Delete the schedule</HelixButton>
            <HelixButton Variant="HelixVariant.Outline" Color="neutral" OnClick="Publish">Publish</HelixButton>
            <span class="muted" style="font-size:13px">Last answer: @_last</span>
        </div>
    </Example>

    <ApiTable Title="HelixConfirmService" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <!-- MainWindow.xaml: once, around the content -->
        <helix:HelixHost> … </helix:HelixHost>

        // Code-behind or ViewModel
        if (await HelixConfirm.AskAsync("Delete the report?", "This action is permanent.",
                                       danger: true, confirmText: "Delete"))
        {
            await reports.DeleteAsync(id);
            HelixToasts.Success("Report deleted.");
        }
        """;

    private string _last = "—";

    private async Task Delete()
    {
        var ok = await Confirm.AskAsync(new HelixConfirmOptions("Delete the schedule?")
        {
            Message = "The 12 scheduled requests will be cancelled. This action is permanent.",
            ConfirmText = "Delete",
            Danger = true,
        });
        _last = ok ? "confirmed" : "cancelled";
        if (ok)
        {
            Toasts.Error("Schedule deleted");
        }
    }

    private async Task Publish()
    {
        _last = await Confirm.AskAsync("Publish the schedule?", "It will be visible to the whole team.") ? "confirmed" : "cancelled";
    }

    private const string Code = """
        @inject HelixConfirmService Confirm

        if (await Confirm.AskAsync(new HelixConfirmOptions("Delete the schedule?")
            {
                Message = "This action is permanent.",
                ConfirmText = "Delete",
                Danger = true,
            }))
        {
            await planning.DeleteAsync();
        }

        // Short version
        if (await Confirm.AskAsync("Publish the schedule?")) { … }
        """;

    private static readonly ApiRow[] Api =
    [
        new("AskAsync(title, message, danger, confirmText)", "Task<bool>", null, "Short version."),
        new("AskAsync(HelixConfirmOptions, CancellationToken)", "Task<bool>", null, "true = confirmed; false = cancelled, closed or token cancelled."),
        new("HelixConfirmOptions", "record", null, "Title, Message, ConfirmText, CancelText, Danger."),
        new("Registration", "AddHelix()", null, "Service registered by AddHelix; shown by HelixProvider."),
    ];
}
