@page "/components/switch"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="Switch" Description="L'interrupteur. Chaque partie a son paramètre : la piste, la pastille, une icône ou un texte dedans, une description, le côté du libellé. Aucun template à copier.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <HelixSwitch @bind-Checked="_checked" Label="@_label" Description="@_description" LabelPosition="_position" Size="_size"
                        Color="@_color" TrackColor="@_track" ThumbColor="@_thumb" ThumbOnColor="@_thumbOn" Radius="@Radius"
                        OnIcon="@OnIcon" OffIcon="@OffIcon" OnText="@OnText" OffText="@OffText" Disabled="_disabled" />
        </Preview>
        <Controls>
            <HelixTextField Label="Label" @bind-Value="_label" />
            <HelixTextField Label="Description" @bind-Value="_description" />
            <Choice TEnum="HelixLabelPosition" Label="LabelPosition" @bind-Value="_position" />
            <Choice TEnum="Inside" Label="Dans l'interrupteur" @bind-Value="_inside" />
            <Choice TEnum="HelixSize" Label="Size" @bind-Value="_size" />
            <ColorPicker Label="Color (piste allumée)" @bind-Value="_color" />
            <ColorPicker Label="TrackColor (piste éteinte)" @bind-Value="_track" Colors="@(["#d4d4d8", "#fecaca", "#bfdbfe", "#18181b"])" />
            <ColorPicker Label="ThumbColor (pastille)" @bind-Value="_thumb" Colors="@(["#ffffff", "#f59e0b", "#18181b", "#e11d48", "#a7f3d0"])" />
            <ColorPicker Label="ThumbOnColor (pastille allumée)" @bind-Value="_thumbOn" Colors="@(["#ffffff", "#fef3c7", "#18181b", "#dcfce7"])" />
            <HelixSlider Label="Radius" @bind-Value="_radius" Min="0" Max="12" Format="@(v => v >= 12 ? "rond" : $"{v} px")" />
            <HelixSwitch Label="Checked" @bind-Checked="_checked" Size="HelixSize.Sm" />
            <HelixSwitch Label="Disabled" @bind-Checked="_disabled" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Changer la couleur de la pastille" Description="Le cas qui demande un template complet ailleurs : ici c'est un paramètre." Code="@ThumbCode">
        <div class="row" style="gap:28px">
            <HelixSwitch @bind-Checked="_demo" ThumbColor="#f59e0b" Label="Ambre" />
            <HelixSwitch @bind-Checked="_demo" ThumbColor="#18181b" TrackColor="#e4e4e7" Color="#a3e635" Label="Lime" />
            <HelixSwitch @bind-Checked="_demo" Color="danger" ThumbOnColor="#ffe4e6" Label="Danger" />
        </div>
    </Example>

    <Example WpfCode="@Wpf3" Title="Icône ou texte dans l'interrupteur" Description="OnIcon / OffIcon dans la pastille, OnText / OffText dans la piste (elle s'élargit). Ils changent à l'instant du clic." Code="@InsideCode">
        <div class="row" style="gap:28px">
            <HelixSwitch @bind-Checked="_demo" OnIcon="check" OffIcon="x" Label="Icônes" />
            <HelixSwitch @bind-Checked="_demo" OnIcon="moon" OffIcon="sun" Color="#312e81" Label="Thème" />
            <HelixSwitch @bind-Checked="_demo" OnText="On" OffText="Off" Label="Texte" />
            <HelixSwitch @bind-Checked="_demo" OnText="Auto" OffText="Manuel" Color="#ff8a00" Size="HelixSize.Lg" Label="Pilote" />
        </div>
    </Example>

    <Example WpfCode="@Wpf4" Title="Description et côté du libellé" Description="Une deuxième ligne sous le libellé, lue avec l'interrupteur. LabelPosition=Start pour les listes de réglages." Code="@DescriptionCode">
        <div class="stack" style="max-width:420px">
            <HelixSwitch @bind-Checked="_demo" Label="Notifications" Description="Recevoir un e-mail quand un rapport est prêt." />
            <HelixSwitch @bind-Checked="_demo2" LabelPosition="HelixLabelPosition.Start" Label="Synchronisation" Description="Chaque nuit à 2 h." Style="width:100%;justify-content:space-between" />
        </div>
    </Example>

    <Example WpfCode="@Wpf5" Title="Tailles" Code="@SizesCode">
        <div class="row" style="gap:28px">
            <HelixSwitch @bind-Checked="_demo" Size="HelixSize.Sm" Label="Sm" />
            <HelixSwitch @bind-Checked="_demo" Label="Md" />
            <HelixSwitch @bind-Checked="_demo" Size="HelixSize.Lg" Label="Lg" />
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixSwitch Content="Mode avion" Description="Coupe toutes les connexions."
                         IsChecked="{Binding IsOn}" LabelPosition="End" Size="Md"
                         Accent="#10B981" TrackBrush="#E4E4E7" ThumbBrush="White" ThumbOnBrush="#DCFCE7"
                         OnIcon="check" OffIcon="x" CornerRadius="999" />
        """;

    private const string Wpf2 = """
        <helix:HelixSwitch Content="Ambre" IsChecked="True" ThumbBrush="#F59E0B" />
        <helix:HelixSwitch Content="Lime" IsChecked="True" ThumbBrush="#18181B" TrackBrush="#E4E4E7" Accent="#A3E635" />
        <helix:HelixSwitch Content="Danger" IsChecked="True" Tone="Danger" ThumbOnBrush="#FFE4E6" />
        """;

    private const string Wpf3 = """
        <helix:HelixSwitch Content="Icônes" OnIcon="check" OffIcon="x" />
        <helix:HelixSwitch Content="Thème" OnIcon="moon" OffIcon="sun" Accent="#312E81" />
        <helix:HelixSwitch Content="Texte" OnText="ON" OffText="OFF" />
        <helix:HelixSwitch Content="Pilote" OnText="AUTO" OffText="MANUEL" Accent="#FF8A00" Size="Lg" />
        """;

    private const string Wpf4 = """
        <helix:HelixSwitch Content="Notifications" Description="Recevoir un e-mail quand un rapport est prêt." />
        <helix:HelixSwitch Content="Synchronisation" Description="Chaque nuit à 2 h."
                         LabelPosition="Start" HorizontalAlignment="Stretch" />
        """;

    private const string Wpf5 = """
        <helix:HelixSwitch Content="Sm" Size="Sm" />
        <helix:HelixSwitch Content="Md" />
        <helix:HelixSwitch Content="Lg" Size="Lg" />
        """;

    private enum Inside { Rien, Icônes, Texte }

    private bool _checked = true, _disabled, _demo = true, _demo2;
    private string? _description;
    private HelixLabelPosition _position = HelixLabelPosition.End;
    private Inside _inside = Inside.Rien;

    private string? OnIcon => _inside == Inside.Icônes ? "check" : null;
    private string? OffIcon => _inside == Inside.Icônes ? "x" : null;
    private string? OnText => _inside == Inside.Texte ? "On" : null;
    private string? OffText => _inside == Inside.Texte ? "Off" : null;
    private string? _label = "Mode avion";
    private HelixSize _size = HelixSize.Md;
    private string? _color, _track, _thumb, _thumbOn;
    private double _radius = 12;

    private string? Radius => _radius >= 12 ? null : $"{N(_radius)}px";

    private string Code =>
        $"<HelixSwitch @bind-Checked=\"isOn\"{A("Label", _label)}{A("Description", _description)}{A("LabelPosition", _position, HelixLabelPosition.End)}{A("OnIcon", OnIcon)}{A("OffIcon", OffIcon)}{A("OnText", OnText)}{A("OffText", OffText)}{A("Size", _size, HelixSize.Md)}{A("Color", _color)}{A("TrackColor", _track)}{A("ThumbColor", _thumb)}{A("ThumbOnColor", _thumbOn)}{A("Radius", Radius)}{B("Disabled", _disabled)} />";

    private const string ThumbCode = """
        <HelixSwitch @bind-Checked="on" ThumbColor="#f59e0b" Label="Ambre" />
        <HelixSwitch @bind-Checked="on" ThumbColor="#18181b" TrackColor="#e4e4e7" Color="#a3e635" Label="Lime" />
        <HelixSwitch @bind-Checked="on" Color="danger" ThumbOnColor="#ffe4e6" Label="Danger" />
        """;

    private const string InsideCode = """
        <HelixSwitch @bind-Checked="on" OnIcon="check" OffIcon="x" Label="Icônes" />
        <HelixSwitch @bind-Checked="on" OnIcon="moon" OffIcon="sun" Color="#312e81" Label="Thème" />
        <HelixSwitch @bind-Checked="on" OnText="On" OffText="Off" Label="Texte" />
        <HelixSwitch @bind-Checked="on" OnText="Auto" OffText="Manuel" Color="#ff8a00" Size="HelixSize.Lg" Label="Pilote" />
        """;

    private const string DescriptionCode = """
        <HelixSwitch @bind-Checked="on" Label="Notifications" Description="Recevoir un e-mail quand un rapport est prêt." />
        <HelixSwitch @bind-Checked="sync" LabelPosition="HelixLabelPosition.Start" Label="Synchronisation" Description="Chaque nuit à 2 h." />
        """;

    private const string SizesCode = """
        <HelixSwitch @bind-Checked="on" Size="HelixSize.Sm" Label="Sm" />
        <HelixSwitch @bind-Checked="on" Label="Md" />
        <HelixSwitch @bind-Checked="on" Size="HelixSize.Lg" Label="Lg" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Checked", "bool", null, "État (@bind-Checked)."),
        new("Color", "string", "--helix-switch-color", "Piste quand allumé. Nom sémantique ou couleur CSS."),
        new("TrackColor", "string", "--helix-switch-track", "Piste quand éteint."),
        new("ThumbColor", "string", "--helix-switch-thumb", "Pastille."),
        new("ThumbOnColor", "string", "--helix-switch-thumb-on", "Pastille quand allumé (ThumbColor par défaut)."),
        new("Radius", "string", "--helix-switch-radius", "Arrondi de la piste et de la pastille."),
        new("Size", "HelixSize?", null, "Sm, Md ou Lg. Par défaut : Defaults.Switch.Size, puis Defaults.Size, puis Md."),
        new("Label / ChildContent", "string / RenderFragment", null, "Libellé cliquable."),
        new("Description", "string", null, "Deuxième ligne sous le libellé, lue par les lecteurs d'écran."),
        new("LabelPosition", "HelixLabelPosition?", null, "End (après, par défaut) ou Start (avant)."),
        new("OnIcon / OffIcon", "string", null, "Icône intégrée dans la pastille selon l'état (check, x, sun, moon…)."),
        new("OnText / OffText", "string", null, "Texte court dans la piste selon l'état ; la piste s'élargit."),
        new("Width", "string", "--helix-switch-width", "Largeur minimale de la piste avec un texte (elle s'adapte sinon au texte le plus long)."),
    ];
}
