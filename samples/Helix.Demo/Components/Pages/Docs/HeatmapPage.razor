@page "/components/heatmap"
@using System.Globalization
@inject HelixToastService Toasts

<DemoPage Title="Heatmap" Description="A grid of colored values: spot at a glance the hours and days that matter. Single scale (one hue, light to dark) for a quantity, or diverging (two hues around a neutral point) for a gap.">
    <Example WpfCode="@Wpf1" Title="Diverging scale: deficit or surplus" Description="Blue = deficit, red = surplus, gray = balance (Midpoint = 0). The scale is symmetric: the same distance gives the same intensity on both sides. Hatched cells have no data." Code="@DivergingCode">
        <HelixHeatmap Title="Average imbalance (MW)" Cells="_weekly" Diverging="true" Unit="MW" Format="N0" ColumnLabelEvery="2" Culture="English" OnCellClick="Show" />
    </Example>

    <Example WpfCode="@Wpf2" Title="Single scale: a quantity" Description="Number of reserve activations. ShowValues shows the numbers in the cells; the text turns white on dark cells." Code="@SequentialCode">
        <HelixHeatmap Title="Activations per hour" Cells="_activations" ShowValues="true" Format="0" CellHeight="30px" CellMinWidth="30px" Culture="English" />
    </Example>

    <ApiTable Title="HelixHeatmap" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixHeatmap Title="Gap to target" Unit="MW" IsDiverging="True" Midpoint="0"
                          ShowValues="True" Rows="{Binding Units}" Columns="{Binding Hours}" Cells="{Binding Gaps}"
                          CellClick="OnCellClick" />

        // ViewModel: one cell per (row, column), null = no data
        Gaps = units.SelectMany(u => hours.Select(h => new HelixHeatCell(u, h, Gap(u, h)))).ToList();
        """;

    private const string Wpf2 = """
        <helix:HelixHeatmap Title="Consumption per hour" Unit="MW" ColumnLabelEvery="3" CellHeight="24"
                          Rows="{Binding Days}" Columns="{Binding Hours}" Cells="{Binding Load}" />
        """;

    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-GB");

    private readonly IReadOnlyList<HelixHeatCell> _weekly = DemoData.WeeklyImbalance();
    private readonly IReadOnlyList<HelixHeatCell> _activations = DemoData.Activations();

    private void Show(HelixHeatCell cell) =>
        Toasts.Info(cell.Value is null ? "No data" : $"{cell.Value:N0} MW", $"{cell.Row} · {cell.Column}");

    private const string DivergingCode = """
        <HelixHeatmap Title="Average imbalance (MW)" Cells="cells" Diverging Unit="MW" ColumnLabelEvery="2" OnCellClick="Show" />

        // cells = readings.Select(m => new HelixHeatCell(m.Day, $"{m.Hour:00}h", m.Mw))
        """;

    private const string SequentialCode = """
        <HelixHeatmap Title="Activations per hour" Cells="cells" ShowValues Format="0" CellHeight="30px" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Cells", "IEnumerable<HelixHeatCell>", null, "HelixHeatCell(Row, Column, Value); Value = null for “no data”."),
        new("Rows / Columns", "IReadOnlyList<string>", null, "Order of rows and columns (otherwise the order they appear)."),
        new("Diverging / Midpoint", "bool / double", "--helix-heat-neg, --helix-heat-mid, --helix-heat-pos", "Two hues around a neutral point (0)."),
        new("—", "", "--helix-heat-lo, --helix-heat-hi", "Single scale: light to dark (one hue)."),
        new("Min / Max", "double?", null, "Fixed bounds (otherwise the data's)."),
        new("ShowValues / Format / Unit", "bool / string / string", null, "Numbers in the cells, format, unit."),
        new("ColumnLabelEvery", "int", null, "Show only one column label in N."),
        new("CellHeight / CellMinWidth", "string", "--helix-heatmap-cell-h", "Cell size."),
        new("OnCellClick", "EventCallback<HelixHeatCell>", null, "Click (or Enter) on a cell."),
    ];
}
