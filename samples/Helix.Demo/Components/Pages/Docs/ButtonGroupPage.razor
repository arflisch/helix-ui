@page "/components/buttongroup"
@inject HelixToastService Toasts

<DemoPage Title="ButtonGroup" Description="Joined buttons for related actions: toolbar, main button + menu (split button), view choice.">
    <Example WpfCode="@Wpf1" Title="Toolbar and split button" Code="@Code">
        <div class="row" style="gap:20px">
            <HelixButtonGroup Label="Alignment">
                <HelixButton Variant="HelixVariant.Outline" Color="neutral" Icon="chevron-left" aria-label="Previous" />
                <HelixButton Variant="HelixVariant.Outline" Color="neutral">Today</HelixButton>
                <HelixButton Variant="HelixVariant.Outline" Color="neutral" Icon="chevron-right" aria-label="Next" />
            </HelixButtonGroup>

            <HelixButtonGroup Label="Save">
                <HelixButton Icon="check" OnClick="@(() => Toasts.Success("Saved"))">Save</HelixButton>
                <HelixMenu Align="HelixAlign.End">
                    <Trigger><HelixButton Icon="chevron-down" aria-label="More save options" /></Trigger>
                    <ChildContent>
                        <HelixMenuItem Icon="copy">Save a copy</HelixMenuItem>
                        <HelixMenuItem Icon="download">Save and export</HelixMenuItem>
                    </ChildContent>
                </HelixMenu>
            </HelixButtonGroup>

            <HelixButtonGroup Label="Period">
                @foreach (var p in Periods)
                {
                    <HelixButton Variant="@(p == _period ? HelixVariant.Soft : HelixVariant.Outline)" Color="@(p == _period ? "primary" : "neutral")"
                                aria-pressed="@(p == _period ? "true" : "false")" OnClick="() => _period = p">@p</HelixButton>
                }
            </HelixButtonGroup>
        </div>
    </Example>

    <ApiTable Title="HelixButtonGroup" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <!-- Segmented choice (SelectedIndex / SelectedItem like a ListBox) -->
        <helix:HelixButtonGroup SelectedIndex="1">
            <ListBoxItem Content="Day" />
            <ListBoxItem Content="Week" />
            <ListBoxItem Content="Month" />
        </helix:HelixButtonGroup>

        <!-- Split button: a button + a menu button -->
        <StackPanel Orientation="Horizontal">
            <helix:HelixButton Content="Save" CornerRadius="10,0,0,10" />
            <helix:HelixMenuButton Icon="chevron-down" Padding="0" Width="34" CornerRadius="0,10,10,0" Margin="1,0,0,0" MenuAlignment="Right">
                <helix:HelixMenuButton.Menu>
                    <helix:HelixContextMenu>
                        <helix:HelixMenuItem Header="Save as…" />
                        <helix:HelixMenuItem Header="Save as template" />
                    </helix:HelixContextMenu>
                </helix:HelixMenuButton.Menu>
            </helix:HelixMenuButton>
        </StackPanel>
        """;

    private static readonly string[] Periods = ["Day", "Week", "Month"];
    private string _period = "Week";

    private const string Code = """
        <HelixButtonGroup Label="Save">
            <HelixButton Icon="check" OnClick="Save">Save</HelixButton>
            <HelixMenu Align="HelixAlign.End">
                <Trigger><HelixButton Icon="chevron-down" aria-label="More options" /></Trigger>
                <ChildContent>
                    <HelixMenuItem Icon="copy">Save a copy</HelixMenuItem>
                </ChildContent>
            </HelixMenu>
        </HelixButtonGroup>
        """;

    private static readonly ApiRow[] Api =
    [
        new("ChildContent", "RenderFragment", null, "HelixButtons (or a HelixMenu): their edges join."),
        new("Label", "string", null, "Accessible name of the group (role=group)."),
        new("Vertical", "bool", null, "Stacked buttons."),
    ];
}
