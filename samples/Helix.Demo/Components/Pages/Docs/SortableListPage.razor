@page "/components/sortable"

<DemoPage Title="SortableList" Description="A list the user reorders by dragging items, or from the keyboard (Enter, arrows, Enter). Handy for priorities, steps, the column order of an export…">
    <section class="demo-section">
        <h2 class="demo-section__title">Example</h2>
        <div class="grid-2">
            <HelixSortableList @bind-Items="_priorities" ItemKey="p => p.Id" ShowHandle="_handle">
                <ItemTemplate>
                    <div class="prio">
                        <span class="prio__rank">@(Rank(context))</span>
                        <span class="prio__title">@context.Title</span>
                        <span class="prio__owner">@context.Owner</span>
                    </div>
                </ItemTemplate>
            </HelixSortableList>
            <div class="stack">
                <HelixSwitch Label="ShowHandle" @bind-Checked="_handle" />
                <HelixCard Title="Current order">
                    <ol class="muted" style="margin:0;padding-left:18px;line-height:1.8">
                        @foreach (var p in _priorities)
                        {
                            <li>@p.Title</li>
                        }
                    </ol>
                </HelixCard>
            </div>
        </div>
        <CodeBlock Code="@Code" WpfCode="@WpfExample" />
    </section>

    <ApiTable Title="HelixSortableList" Rows="Api" />
</DemoPage>

@code {
    private const string WpfExample = """
        <helix:HelixSortableList ItemsSource="{Binding Priorities}" ShowHandle="True" Reordered="OnReordered">
            <helix:HelixSortableList.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Title}" />
                </DataTemplate>
            </helix:HelixSortableList.ItemTemplate>
        </helix:HelixSortableList>

        // ItemsSource = ObservableCollection<T>: the list is reordered in place (drag or Alt + ↑/↓).
        private void OnReordered(object sender, RoutedEventArgs e)
        {
            var (from, to) = ((HelixEventArgs<(int From, int To)>)e).Value;
            Save();
        }
        """;

    private IReadOnlyList<Priority> _priorities = DemoData.Priorities();
    private bool _handle = true;

    private int Rank(Priority p) => _priorities.ToList().IndexOf(p) + 1;

    private const string Code = """
        <HelixSortableList @bind-Items="priorities" ItemKey="p => p.Id">
            <ItemTemplate>@context.Title</ItemTemplate>
        </HelixSortableList>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Items", "IReadOnlyList<T>", null, "The items, @bind-Items to get the new order back."),
        new("OnReorder", "EventCallback<(int From, int To)>", null, "The move that was made."),
        new("ItemTemplate / ItemKey", "RenderFragment<T> / Func<T, object>", null, "Content and identity of an item."),
        new("ShowHandle / Disabled", "bool", null, "Visible handle (true); turn off reordering."),
    ];
}
