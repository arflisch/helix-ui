@page "/components/datagrid"
@using System.Globalization
@using static Helix.Demo.Components.Shared.Snippet
@inject HelixToastService Toasts
@inject EmployeeApi Server
@implements IDisposable

<DemoPage Title="DataGrid" Description="Data table: columns declared in one line, sorting, search, paging, selection, loading and a sticky header. Cells can hold any component.">
    <section class="demo-section">
        <h2 class="demo-section__title">Playground</h2>
        <div class="pg pg--wide">
            <div class="pg__stage pg__stage--block">
                <HelixDataGrid Items="_employees" Culture="English" Searchable="_searchable" Selectable="_selectable" @bind-SelectedItems="_selection"
                              PageSize="_pageSize" PageSizes="@([5, 10, 25])" Striped="_striped" Density="_density" Loading="_loading"
                              MaxHeight="@(_sticky ? "360px" : null)" Color="@_color" HeaderBackground="@_header" SelectedColor="@_selectedColor"
                              OnRowClick="RowClick" SearchPlaceholder="Search employees…"
                              ReorderableColumns="_reorder" ColumnChooser="_chooser" @bind-ColumnLayout="_columnLayout">
                    <Toolbar>
                        @if (_selection.Count > 0)
                        {
                            <HelixButton Variant="HelixVariant.Soft" Color="danger" Size="HelixSize.Sm" Icon="trash" OnClick="DeleteSelection">
                                Delete (@_selection.Count)
                            </HelixButton>
                        }
                        <HelixButton Size="HelixSize.Sm" Icon="plus">Add</HelixButton>
                    </Toolbar>
                    <ChildContent>
                        <HelixColumn Field="e => e.Name" Title="Employee" Width="30%">
                            <Template>
                                <div class="person">
                                    <HelixAvatar Name="@context.Name" Size="HelixSize.Sm" />
                                    <div>
                                        <div class="person__name">@context.Name</div>
                                        <div class="person__email">@context.Email</div>
                                    </div>
                                </div>
                            </Template>
                        </HelixColumn>
                        <HelixColumn Field="e => e.Department" Title="Department" />
                        <HelixColumn Field="e => e.Role" Title="Role" />
                        <HelixColumn Field="e => e.Status" Title="Status" SortBy="e => (int)e.Status">
                            <Template><StatusBadge Status="context.Status" /></Template>
                        </HelixColumn>
                        <HelixColumn Field="e => e.StartDate" Title="Start date" Format="d MMM yyyy" />
                        <HelixColumn Field="e => e.Salary" Title="Salary" Format="C0" Align="HelixAlign.End" />
                    </ChildContent>
                </HelixDataGrid>
            </div>
            <aside class="pg__controls">
                <Choice TEnum="HelixSize" Label="Density" @bind-Value="_density" />
                <Choice TEnum="PageChoice" Label="PageSize" Value="_pageChoice" ValueChanged="SetPage" />
                <ColorPicker Label="Color (sort, selection, page)" @bind-Value="_color" />
                <ColorPicker Label="HeaderBackground" @bind-Value="_header" Colors="@(["#eef2ff", "#f0fdf4", "#18181b", "#fafaf9"])" />
                <ColorPicker Label="SelectedColor" @bind-Value="_selectedColor" Colors="@(["#fef9c3", "#dcfce7", "#fce7f3"])" />
                <HelixSwitch Label="Searchable" @bind-Checked="_searchable" Size="HelixSize.Sm" />
                <HelixSwitch Label="Selectable" @bind-Checked="_selectable" Size="HelixSize.Sm" />
                <HelixSwitch Label="Striped" @bind-Checked="_striped" Size="HelixSize.Sm" />
                <HelixSwitch Label="Sticky header (MaxHeight)" @bind-Checked="_sticky" Size="HelixSize.Sm" />
                <HelixSwitch Label="OnRowClick" @bind-Checked="_rowClick" Size="HelixSize.Sm" />
                <HelixSwitch Label="Loading" @bind-Checked="_loading" Size="HelixSize.Sm" />
                <HelixSwitch Label="ReorderableColumns (drag the headers)" @bind-Checked="_reorder" Size="HelixSize.Sm" />
                <HelixSwitch Label="ColumnChooser (Columns menu)" @bind-Checked="_chooser" Size="HelixSize.Sm" />
            </aside>
        </div>
        <CodeBlock Code="@Code" />
    </section>

    <section class="demo-section">
        <h2 class="demo-section__title">Server-side loading</h2>
        <p class="demo-section__text">
            Replace <code>Items</code> with <code>ItemsProvider</code>: the grid asks for one page at a time (sort, search, paging)
            and your code queries the database or the API. Search waits for typing to stop, and each new request cancels the previous one.
            The API below is simulated: set its latency or make it fail.
        </p>
        <div class="pg pg--wide">
            <div class="pg__stage pg__stage--block">
                <HelixDataGrid @ref="_serverGrid" TItem="Employee" ItemsProvider="LoadEmployees" ItemKey="e => e.Id" Culture="English"
                              Searchable="true" Selectable="true" @bind-SelectedItems="_serverSelection" PageSize="8" PageSizes="@([8, 16, 32])"
                              SearchPlaceholder="Search (server side)…" OnLoadError="OnServerError">
                    <Toolbar>
                        @if (_serverSelection.Count > 0)
                        {
                            <HelixButton Variant="HelixVariant.Soft" Color="danger" Size="HelixSize.Sm" Icon="trash" Loading="_deleting" OnClick="DeleteOnServer">
                                Delete (@_serverSelection.Count)
                            </HelixButton>
                        }
                        <HelixTooltip Text="Reload">
                            <HelixButton Variant="HelixVariant.Outline" Color="neutral" Size="HelixSize.Sm" Icon="download" aria-label="Reload" OnClick="() => _serverGrid!.RefreshAsync()" />
                        </HelixTooltip>
                    </Toolbar>
                    <ChildContent>
                        <HelixColumn Field="e => e.Name" Title="Employee" Width="30%">
                            <Template>
                                <div class="person">
                                    <HelixAvatar Name="@context.Name" Size="HelixSize.Sm" />
                                    <div>
                                        <div class="person__name">@context.Name</div>
                                        <div class="person__email">@context.Email</div>
                                    </div>
                                </div>
                            </Template>
                        </HelixColumn>
                        <HelixColumn Field="e => e.Department" Title="Department" />
                        <HelixColumn Field="e => e.Status" Title="Status">
                            <Template><StatusBadge Status="context.Status" /></Template>
                        </HelixColumn>
                        <HelixColumn Field="e => e.StartDate" Title="Start date" Format="d MMM yyyy" />
                        <HelixColumn Field="e => e.Salary" Title="Salary" Format="C0" Align="HelixAlign.End" />
                    </ChildContent>
                </HelixDataGrid>
                <p class="request-log">
                    <span class="request-log__label">Last request</span>
                    <code>@(_lastRequest is null ? "—" : Describe(_lastRequest))</code>
                    <span class="muted">@_requestCount sent · @_cancelledCount cancelled</span>
                </p>
            </div>
            <aside class="pg__controls">
                <HelixSlider Label="API latency" Value="Server.Latency.TotalMilliseconds" ValueChanged="v => Server.Latency = TimeSpan.FromMilliseconds(v)"
                            Min="0" Max="2000" Step="100" Format="@(v => $"{v:0} ms")" />
                <HelixSwitch Label="Simulate a server error" Checked="Server.SimulateFailure" CheckedChanged="v => Server.SimulateFailure = v" Color="danger" />
            </aside>
        </div>
        <CodeBlock Code="@ServerRazorCode" />
        <CodeBlock Language="c#" Code="@ServerCSharpCode" />
    </section>

    <Example WpfCode="@Wpf1" Title="The minimum" Description="A collection and columns. The title comes from the property name; sorting and search follow automatically." Code="@MinimalCode">
        <HelixDataGrid Items="_employees.Take(4)" PageSize="0" Culture="English">
            <HelixColumn Field="e => e.Name" />
            <HelixColumn Field="e => e.Department" />
            <HelixColumn Field="e => e.StartDate" Format="d" />
            <HelixColumn Field="e => e.Salary" Format="C0" Align="HelixAlign.End" />
        </HelixDataGrid>
    </Example>

    <Example WpfCode="@Wpf2" Title="Customize rows" Description="RowClass adds a class per row; a plain CSS rule does the rest." Code="@RowClassCode">
        <style>
            .row-leaving td { color: var(--helix-text-subtle); text-decoration: line-through; text-decoration-color: color-mix(in oklab, var(--helix-danger) 50%, transparent); }
        </style>
        <HelixDataGrid Items="_employees.Take(6)" PageSize="0" Density="HelixSize.Sm" Culture="English"
                      RowClass="@(e => e.Status == EmployeeStatus.Offboarding ? "row-leaving" : null)">
            <HelixColumn Field="e => e.Name" Title="Employee" />
            <HelixColumn Field="e => e.Status" Title="Status">
                <Template><StatusBadge Status="context.Status" /></Template>
            </HelixColumn>
            <HelixColumn Field="e => e.Salary" Title="Salary" Format="C0" Align="HelixAlign.End" />
        </HelixDataGrid>
    </Example>

    <ApiTable Rows="Api" />
    <ApiTable Title="HelixColumn" Rows="ColumnApi" ShowIntro="false" />
</DemoPage>

<HelixDialog @bind-Open="_dialogOpen" Title="@_opened?.Name" Description="@_opened?.Email" Width="420px">
    @if (_opened is not null)
    {
        <div class="stack">
            <div class="row"><StatusBadge Status="_opened.Status" /><HelixBadge>@_opened.Department</HelixBadge></div>
            <p style="margin:0">@_opened.Role since @_opened.StartDate.ToString("MMMM d, yyyy", English).</p>
        </div>
    }
</HelixDialog>

@code {
    private const string Wpf1 = """
        <!-- In memory: Source (not ItemsSource) for search, global sorting and paging -->
        <helix:HelixDataGrid Source="{Binding Employees}" IsSearchable="True" PageSize="10"
                           AutoGenerateColumns="False" IsReadOnly="True" ShowColumnChooser="True">
            <helix:HelixDataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Department" Binding="{Binding Team}" />
                <DataGridTextColumn Header="Salary" Binding="{Binding Salary, StringFormat=N0}" />
            </helix:HelixDataGrid.Columns>
        </helix:HelixDataGrid>

        // Server side: one page at a time, the previous request is cancelled
        Grid.ItemsProvider = async (request, ct) =>
        {
            var page = await api.SearchAsync(request.Search, request.SortBy, request.Descending, request.Page, request.PageSize, ct);
            return new HelixGridPage(page.Items, page.Total);
        };
        """;

    private const string Wpf2 = """
        <helix:HelixDataGrid Source="{Binding Plants}" IsStriped="True" Density="Sm" AutoGenerateColumns="False">
            <helix:HelixDataGrid.Columns>
                <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="*" />
                <DataGridTemplateColumn Header="Status" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <helix:HelixBadge Content="{Binding Status}" Tone="{Binding Tone}" ShowDot="True" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </helix:HelixDataGrid.Columns>
            <helix:HelixDataGrid.Toolbar>
                <TextBlock Text="Sites" FontWeight="SemiBold" />
            </helix:HelixDataGrid.Toolbar>
        </helix:HelixDataGrid>
        """;

    private enum PageChoice { Five, Ten, TwentyFive, All }

    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-US");

    private List<Employee> _employees = SampleData.Employees.ToList();
    private IReadOnlyCollection<Employee> _selection = [];
    private HelixSize _density = HelixSize.Md;
    private PageChoice _pageChoice = PageChoice.Ten;
    private int _pageSize = 10;
    private string? _color, _header, _selectedColor;
    private bool _reorder = true, _chooser = true;
    private IReadOnlyList<HelixColumnState>? _columnLayout;
    private bool _searchable = true, _selectable = true, _striped, _sticky, _rowClick, _loading;
    private bool _dialogOpen;
    private Employee? _opened;

    private readonly CancellationTokenSource _pageCts = new();
    private HelixDataGrid<Employee>? _serverGrid;
    private IReadOnlyCollection<Employee> _serverSelection = [];
    private HelixGridRequest? _lastRequest;
    private int _requestCount, _cancelledCount;
    private bool _deleting;

    private async Task<HelixGridResult<Employee>> LoadEmployees(HelixGridRequest request, CancellationToken cancellationToken)
    {
        _lastRequest = request;
        _requestCount++;
        StateHasChanged();
        try
        {
            return await Server.QueryAsync(request, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            _cancelledCount++;
            StateHasChanged();
            throw;
        }
    }

    private void OnServerError(Exception ex) => Toasts.Error(ex.Message, "Could not load");

    private async Task DeleteOnServer()
    {
        _deleting = true;
        var ids = _serverSelection.Select(e => e.Id).ToArray();
        try
        {
            await Server.DeleteAsync(ids, _pageCts.Token);
            _serverSelection = [];
            Toasts.Success($"{ids.Length} employee{(ids.Length > 1 ? "s" : "")} deleted on the server");
            await _serverGrid!.RefreshAsync();
        }
        finally
        {
            _deleting = false;
        }
    }

    private static string Describe(HelixGridRequest r) =>
        $"Skip={r.Skip} Take={r.Take}" +
        (r.SortBy is null ? "" : $" SortBy={r.SortBy}{(r.SortDescending ? " desc" : "")}") +
        (r.Search is null ? "" : $" Search=\"{r.Search}\"");

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
    }

    private const string ServerRazorCode = """
        <HelixDataGrid @ref="grid" TItem="Employee" ItemsProvider="LoadEmployees" ItemKey="e => e.Id"
                      Searchable Selectable @bind-SelectedItems="selection">
            <HelixColumn Field="e => e.Name" Title="Employee" />
            <HelixColumn Field="e => e.Department" Title="Department" />
            <HelixColumn Field="e => e.Salary" Title="Salary" Format="C0" Align="HelixAlign.End" />
        </HelixDataGrid>

        @code {
            private HelixDataGrid<Employee>? grid;

            // After an add / a delete:  await grid!.RefreshAsync();
        }
        """;

    private const string ServerCSharpCode = """
        // A single method: the grid passes the requested page and a cancellation token.
        private async Task<HelixGridResult<Employee>> LoadEmployees(HelixGridRequest request, CancellationToken ct)
        {
            var query = db.Employees.AsNoTracking();

            if (request.Search is { } search)
                query = query.Where(e => e.Name.Contains(search) || e.Department.Contains(search));

            var total = await query.CountAsync(ct);
            var items = await query
                .ApplySort(request)   // ORDER BY <clicked column>, provided by Helix
                .ApplyPage(request)   // OFFSET / FETCH, provided by Helix
                .ToListAsync(ct);

            return new HelixGridResult<Employee>(items, total);
        }
        """;

    private void SetPage(PageChoice choice)
    {
        _pageChoice = choice;
        _pageSize = choice switch { PageChoice.Five => 5, PageChoice.TwentyFive => 25, PageChoice.All => 0, _ => 10 };
    }

    private EventCallback<Employee> RowClick =>
        _rowClick ? EventCallback.Factory.Create<Employee>(this, OpenEmployee) : default;

    private void OpenEmployee(Employee employee)
    {
        _opened = employee;
        _dialogOpen = true;
    }

    private void DeleteSelection()
    {
        var count = _selection.Count;
        _employees = _employees.Except(_selection).ToList();
        _selection = [];
        Toasts.Success($"{count} employee{(count > 1 ? "s" : "")} deleted");
    }

    private string Code
    {
        get
        {
            var attrs = string.Concat(
                B("Searchable", _searchable),
                _selectable ? " Selectable @bind-SelectedItems=\"selection\"" : "",
                _pageSize == 10 ? "" : $" PageSize=\"{_pageSize}\"",
                A("Density", _density, HelixSize.Md),
                B("Striped", _striped),
                A("MaxHeight", _sticky ? "360px" : null),
                A("Color", _color),
                A("HeaderBackground", _header),
                A("SelectedColor", _selectedColor),
                _rowClick ? " OnRowClick=\"Open\"" : "",
                B("Loading", _loading),
                B("ReorderableColumns", _reorder),
                _chooser ? " ColumnChooser @bind-ColumnLayout=\"columnLayout\"" : "");
            return $"""
                <HelixDataGrid Items="employees"{attrs}>
                    <HelixColumn Field="e => e.Name" Title="Employee">
                        <Template>
                            <HelixAvatar Name="@context.Name" Size="HelixSize.Sm" /> @context.Name
                        </Template>
                    </HelixColumn>
                    <HelixColumn Field="e => e.Department" Title="Department" />
                    <HelixColumn Field="e => e.Role" Title="Role" />
                    <HelixColumn Field="e => e.Status" Title="Status" SortBy="e => (int)e.Status">
                        <Template><StatusBadge Status="context.Status" /></Template>
                    </HelixColumn>
                    <HelixColumn Field="e => e.StartDate" Title="Start date" Format="d MMM yyyy" />
                    <HelixColumn Field="e => e.Salary" Title="Salary" Format="C0" Align="HelixAlign.End" />
                </HelixDataGrid>
                """;
        }
    }

    private const string MinimalCode = """
        <HelixDataGrid Items="employees">
            <HelixColumn Field="e => e.Name" />
            <HelixColumn Field="e => e.Department" />
            <HelixColumn Field="e => e.StartDate" Format="d" />
            <HelixColumn Field="e => e.Salary" Format="C0" Align="HelixAlign.End" />
        </HelixDataGrid>
        """;

    private const string RowClassCode = """
        <HelixDataGrid Items="employees" RowClass="@(e => e.Status == EmployeeStatus.Offboarding ? "row-leaving" : null)">
            …
        </HelixDataGrid>

        /* app.css */
        .row-leaving td { color: var(--helix-text-subtle); text-decoration: line-through; }
        """;

    private static readonly ApiRow[] Api =
    [
        new("Items", "IEnumerable<T>", null, "The rows."),
        new("Searchable / SearchPlaceholder", "bool / string", null, "Search across every column."),
        new("Toolbar", "RenderFragment", null, "Content on the right of the toolbar."),
        new("PageSize / PageSizes", "int / int[]", null, "Rows per page (0 = all) and the offered choices."),
        new("Selectable / SelectedItems", "bool / IReadOnlyCollection<T>", null, "Checkbox column, @bind-SelectedItems."),
        new("OnRowClick", "EventCallback<T>", null, "Click on a row (otherwise a click selects)."),
        new("RowClass", "Func<T, string?>", null, "CSS class per row."),
        new("Density", "HelixSize", null, "Sm (compact), Md, Lg (roomy)."),
        new("Striped / Loading", "bool", null, "Alternating rows / loading skeletons."),
        new("EmptyContent / EmptyText", "RenderFragment / string", null, "Display when there is no data."),
        new("Culture", "CultureInfo", null, "Culture for formats (dates, amounts)."),
        new("ReorderableColumns", "bool", null, "Drag the headers to reorder the columns."),
        new("ColumnChooser", "bool", null, "“Columns” button: show / hide columns."),
        new("ColumnLayout", "IReadOnlyList<HelixColumnState>", null, "Chosen order and visibility (Key, Visible), to save and restore (@bind-ColumnLayout)."),
        new("Color", "string", "--helix-grid-color", "Sort, selection and active page."),
        new("HeaderBackground", "string", "--helix-grid-header-bg", "Header background."),
        new("HoverColor", "string", "--helix-grid-hover", "Background of a hovered row."),
        new("StripeColor", "string", "--helix-grid-stripe", "Background of even rows (Striped)."),
        new("SelectedColor", "string", "--helix-grid-selected", "Background of a selected row."),
        new("Radius", "string", "--helix-grid-radius", "Corner radius."),
        new("MaxHeight", "string", "--helix-grid-max-height", "Maximum height with a sticky header."),
        new("—", "", "--helix-grid-header-text, --helix-grid-border, --helix-grid-row-border, --helix-grid-bg", "Header text, borders, background."),
    ];

    private static readonly ApiRow[] ColumnApi =
    [
        new("Field", "Expression<Func<T, object?>>", null, "Property displayed, sorted and searched."),
        new("Title", "string", null, "Header (the property name by default)."),
        new("Format", "string", null, "A .NET format: \"C0\", \"d\", \"N2\", \"P1\"…"),
        new("Template", "RenderFragment<T>", null, "Free cell content (context = the row)."),
        new("SortBy", "Func<T, object?>", null, "Custom sort key."),
        new("Sortable / Searchable", "bool", null, "Turn off sorting / search on the column."),
        new("Align / Width / CellClass", "HelixAlign / string / string", null, "Alignment, width, cell class."),
    ];
}
