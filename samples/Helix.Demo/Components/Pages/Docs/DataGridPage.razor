@page "/components/datagrid"
@using System.Globalization
@using static Helix.Demo.Components.Shared.Snippet
@inject HelixToastService Toasts
@inject EmployeeApi Server
@implements IDisposable

<DemoPage Title="DataGrid" Description="Tableau de données : colonnes déclarées en une ligne, tri, recherche, pagination, sélection, chargement et en-tête fixe. Les cellules peuvent contenir n'importe quel composant.">
    <section class="demo-section">
        <h2 class="demo-section__title">Playground</h2>
        <div class="pg pg--wide">
            <div class="pg__stage pg__stage--block">
                <HelixDataGrid Items="_employees" Culture="French" Searchable="_searchable" Selectable="_selectable" @bind-SelectedItems="_selection"
                              PageSize="_pageSize" PageSizes="@([5, 10, 25])" Striped="_striped" Density="_density" Loading="_loading"
                              MaxHeight="@(_sticky ? "360px" : null)" Color="@_color" HeaderBackground="@_header" SelectedColor="@_selectedColor"
                              OnRowClick="RowClick" SearchPlaceholder="Rechercher un employé…"
                              ReorderableColumns="_reorder" ColumnChooser="_chooser" @bind-ColumnLayout="_columnLayout">
                    <Toolbar>
                        @if (_selection.Count > 0)
                        {
                            <HelixButton Variant="HelixVariant.Soft" Color="danger" Size="HelixSize.Sm" Icon="trash" OnClick="DeleteSelection">
                                Supprimer (@_selection.Count)
                            </HelixButton>
                        }
                        <HelixButton Size="HelixSize.Sm" Icon="plus">Ajouter</HelixButton>
                    </Toolbar>
                    <ChildContent>
                        <HelixColumn Field="e => e.Name" Title="Employé" Width="30%">
                            <Template>
                                <div class="person">
                                    <HelixAvatar Name="@context.Name" Size="HelixSize.Sm" />
                                    <div>
                                        <div class="person__name">@context.Name</div>
                                        <div class="person__email">@context.Email</div>
                                    </div>
                                </div>
                            </Template>
                        </HelixColumn>
                        <HelixColumn Field="e => e.Department" Title="Service" />
                        <HelixColumn Field="e => e.Role" Title="Poste" />
                        <HelixColumn Field="e => e.Status" Title="Statut" SortBy="e => (int)e.Status">
                            <Template><StatusBadge Status="context.Status" /></Template>
                        </HelixColumn>
                        <HelixColumn Field="e => e.StartDate" Title="Arrivée" Format="d MMM yyyy" />
                        <HelixColumn Field="e => e.Salary" Title="Salaire" Format="C0" Align="HelixAlign.End" />
                    </ChildContent>
                </HelixDataGrid>
            </div>
            <aside class="pg__controls">
                <Choice TEnum="HelixSize" Label="Density" @bind-Value="_density" />
                <Choice TEnum="PageChoice" Label="PageSize" Value="_pageChoice" ValueChanged="SetPage" />
                <ColorPicker Label="Color (tri, sélection, page)" @bind-Value="_color" />
                <ColorPicker Label="HeaderBackground" @bind-Value="_header" Colors="@(["#eef2ff", "#f0fdf4", "#18181b", "#fafaf9"])" />
                <ColorPicker Label="SelectedColor" @bind-Value="_selectedColor" Colors="@(["#fef9c3", "#dcfce7", "#fce7f3"])" />
                <HelixSwitch Label="Searchable" @bind-Checked="_searchable" Size="HelixSize.Sm" />
                <HelixSwitch Label="Selectable" @bind-Checked="_selectable" Size="HelixSize.Sm" />
                <HelixSwitch Label="Striped" @bind-Checked="_striped" Size="HelixSize.Sm" />
                <HelixSwitch Label="En-tête fixe (MaxHeight)" @bind-Checked="_sticky" Size="HelixSize.Sm" />
                <HelixSwitch Label="OnRowClick" @bind-Checked="_rowClick" Size="HelixSize.Sm" />
                <HelixSwitch Label="Loading" @bind-Checked="_loading" Size="HelixSize.Sm" />
                <HelixSwitch Label="ReorderableColumns (glisser les en-têtes)" @bind-Checked="_reorder" Size="HelixSize.Sm" />
                <HelixSwitch Label="ColumnChooser (menu Colonnes)" @bind-Checked="_chooser" Size="HelixSize.Sm" />
            </aside>
        </div>
        <CodeBlock Code="@Code" />
    </section>

    <section class="demo-section">
        <h2 class="demo-section__title">Chargement côté serveur</h2>
        <p class="demo-section__text">
            Remplacez <code>Items</code> par <code>ItemsProvider</code> : la grille demande une seule page à la fois (tri, recherche, pagination)
            et votre code interroge la base ou l'API. La recherche attend la fin de la frappe, et chaque nouvelle requête annule la précédente.
            L'API ci-dessous est simulée : réglez sa latence ou faites-la échouer.
        </p>
        <div class="pg pg--wide">
            <div class="pg__stage pg__stage--block">
                <HelixDataGrid @ref="_serverGrid" TItem="Employee" ItemsProvider="LoadEmployees" ItemKey="e => e.Id" Culture="French"
                              Searchable="true" Selectable="true" @bind-SelectedItems="_serverSelection" PageSize="8" PageSizes="@([8, 16, 32])"
                              SearchPlaceholder="Rechercher (côté serveur)…" OnLoadError="OnServerError">
                    <Toolbar>
                        @if (_serverSelection.Count > 0)
                        {
                            <HelixButton Variant="HelixVariant.Soft" Color="danger" Size="HelixSize.Sm" Icon="trash" Loading="_deleting" OnClick="DeleteOnServer">
                                Supprimer (@_serverSelection.Count)
                            </HelixButton>
                        }
                        <HelixTooltip Text="Recharger">
                            <HelixButton Variant="HelixVariant.Outline" Color="neutral" Size="HelixSize.Sm" Icon="download" aria-label="Recharger" OnClick="() => _serverGrid!.RefreshAsync()" />
                        </HelixTooltip>
                    </Toolbar>
                    <ChildContent>
                        <HelixColumn Field="e => e.Name" Title="Employé" Width="30%">
                            <Template>
                                <div class="person">
                                    <HelixAvatar Name="@context.Name" Size="HelixSize.Sm" />
                                    <div>
                                        <div class="person__name">@context.Name</div>
                                        <div class="person__email">@context.Email</div>
                                    </div>
                                </div>
                            </Template>
                        </HelixColumn>
                        <HelixColumn Field="e => e.Department" Title="Service" />
                        <HelixColumn Field="e => e.Status" Title="Statut">
                            <Template><StatusBadge Status="context.Status" /></Template>
                        </HelixColumn>
                        <HelixColumn Field="e => e.StartDate" Title="Arrivée" Format="d MMM yyyy" />
                        <HelixColumn Field="e => e.Salary" Title="Salaire" Format="C0" Align="HelixAlign.End" />
                    </ChildContent>
                </HelixDataGrid>
                <p class="request-log">
                    <span class="request-log__label">Dernière requête</span>
                    <code>@(_lastRequest is null ? "—" : Describe(_lastRequest))</code>
                    <span class="muted">@_requestCount envoyée@(_requestCount > 1 ? "s" : "") · @_cancelledCount annulée@(_cancelledCount > 1 ? "s" : "")</span>
                </p>
            </div>
            <aside class="pg__controls">
                <HelixSlider Label="Latence de l'API" Value="Server.Latency.TotalMilliseconds" ValueChanged="v => Server.Latency = TimeSpan.FromMilliseconds(v)"
                            Min="0" Max="2000" Step="100" Format="@(v => $"{v:0} ms")" />
                <HelixSwitch Label="Simuler une erreur serveur" Checked="Server.SimulateFailure" CheckedChanged="v => Server.SimulateFailure = v" Color="danger" />
            </aside>
        </div>
        <CodeBlock Code="@ServerRazorCode" />
        <CodeBlock Language="c#" Code="@ServerCSharpCode" />
    </section>

    <Example WpfCode="@Wpf1" Title="Le minimum" Description="Une collection et des colonnes. Le titre est déduit du nom de la propriété, le tri et la recherche suivent automatiquement." Code="@MinimalCode">
        <HelixDataGrid Items="_employees.Take(4)" PageSize="0" Culture="French">
            <HelixColumn Field="e => e.Name" />
            <HelixColumn Field="e => e.Department" />
            <HelixColumn Field="e => e.StartDate" Format="d" />
            <HelixColumn Field="e => e.Salary" Format="C0" Align="HelixAlign.End" />
        </HelixDataGrid>
    </Example>

    <Example WpfCode="@Wpf2" Title="Personnaliser des lignes" Description="RowClass ajoute une classe par ligne ; une simple règle CSS fait le reste." Code="@RowClassCode">
        <style>
            .row-leaving td { color: var(--helix-text-subtle); text-decoration: line-through; text-decoration-color: color-mix(in oklab, var(--helix-danger) 50%, transparent); }
        </style>
        <HelixDataGrid Items="_employees.Take(6)" PageSize="0" Density="HelixSize.Sm" Culture="French"
                      RowClass="@(e => e.Status == EmployeeStatus.Offboarding ? "row-leaving" : null)">
            <HelixColumn Field="e => e.Name" Title="Employé" />
            <HelixColumn Field="e => e.Status" Title="Statut">
                <Template><StatusBadge Status="context.Status" /></Template>
            </HelixColumn>
            <HelixColumn Field="e => e.Salary" Title="Salaire" Format="C0" Align="HelixAlign.End" />
        </HelixDataGrid>
    </Example>

    <ApiTable Rows="Api" />
    <ApiTable Title="HelixColumn" Rows="ColumnApi" ShowIntro="false" />
</DemoPage>

<HelixDialog @bind-Open="_dialogOpen" Title="@_opened?.Name" Description="@_opened?.Email" Width="420px">
    @if (_opened is not null)
    {
        <div class="stack">
            <div class="row"><StatusBadge Status="_opened.Status" /><HelixBadge>@_opened.Department</HelixBadge></div>
            <p style="margin:0">@_opened.Role depuis le @_opened.StartDate.ToString("d MMMM yyyy", French).</p>
        </div>
    }
</HelixDialog>

@code {
    private const string Wpf1 = """
        <!-- En mémoire : Source (pas ItemsSource) pour la recherche, le tri global et la pagination -->
        <helix:HelixDataGrid Source="{Binding Employees}" IsSearchable="True" PageSize="10"
                           AutoGenerateColumns="False" IsReadOnly="True" ShowColumnChooser="True">
            <helix:HelixDataGrid.Columns>
                <DataGridTextColumn Header="Nom" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Service" Binding="{Binding Team}" />
                <DataGridTextColumn Header="Salaire" Binding="{Binding Salary, StringFormat=N0}" />
            </helix:HelixDataGrid.Columns>
        </helix:HelixDataGrid>

        // Côté serveur : une page à la fois, la requête précédente est annulée
        Grid.ItemsProvider = async (request, ct) =>
        {
            var page = await api.SearchAsync(request.Search, request.SortBy, request.Descending, request.Page, request.PageSize, ct);
            return new HelixGridPage(page.Items, page.Total);
        };
        """;

    private const string Wpf2 = """
        <helix:HelixDataGrid Source="{Binding Plants}" IsStriped="True" Density="Sm" AutoGenerateColumns="False">
            <helix:HelixDataGrid.Columns>
                <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="*" />
                <DataGridTemplateColumn Header="Statut" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <helix:HelixBadge Content="{Binding Status}" Tone="{Binding Tone}" ShowDot="True" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </helix:HelixDataGrid.Columns>
            <helix:HelixDataGrid.Toolbar>
                <TextBlock Text="Sites" FontWeight="SemiBold" />
            </helix:HelixDataGrid.Toolbar>
        </helix:HelixDataGrid>
        """;

    private enum PageChoice { Five, Ten, TwentyFive, All }

    private static readonly CultureInfo French = CultureInfo.GetCultureInfo("fr-FR");

    private List<Employee> _employees = SampleData.Employees.ToList();
    private IReadOnlyCollection<Employee> _selection = [];
    private HelixSize _density = HelixSize.Md;
    private PageChoice _pageChoice = PageChoice.Ten;
    private int _pageSize = 10;
    private string? _color, _header, _selectedColor;
    private bool _reorder = true, _chooser = true;
    private IReadOnlyList<HelixColumnState>? _columnLayout;
    private bool _searchable = true, _selectable = true, _striped, _sticky, _rowClick, _loading;
    private bool _dialogOpen;
    private Employee? _opened;

    private readonly CancellationTokenSource _pageCts = new();
    private HelixDataGrid<Employee>? _serverGrid;
    private IReadOnlyCollection<Employee> _serverSelection = [];
    private HelixGridRequest? _lastRequest;
    private int _requestCount, _cancelledCount;
    private bool _deleting;

    private async Task<HelixGridResult<Employee>> LoadEmployees(HelixGridRequest request, CancellationToken cancellationToken)
    {
        _lastRequest = request;
        _requestCount++;
        StateHasChanged();
        try
        {
            return await Server.QueryAsync(request, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            _cancelledCount++;
            StateHasChanged();
            throw;
        }
    }

    private void OnServerError(Exception ex) => Toasts.Error(ex.Message, "Chargement impossible");

    private async Task DeleteOnServer()
    {
        _deleting = true;
        var ids = _serverSelection.Select(e => e.Id).ToArray();
        try
        {
            await Server.DeleteAsync(ids, _pageCts.Token);
            _serverSelection = [];
            Toasts.Success($"{ids.Length} employé{(ids.Length > 1 ? "s" : "")} supprimé{(ids.Length > 1 ? "s" : "")} sur le serveur");
            await _serverGrid!.RefreshAsync();
        }
        finally
        {
            _deleting = false;
        }
    }

    private static string Describe(HelixGridRequest r) =>
        $"Skip={r.Skip} Take={r.Take}" +
        (r.SortBy is null ? "" : $" SortBy={r.SortBy}{(r.SortDescending ? " desc" : "")}") +
        (r.Search is null ? "" : $" Search=\"{r.Search}\"");

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
    }

    private const string ServerRazorCode = """
        <HelixDataGrid @ref="grid" TItem="Employee" ItemsProvider="LoadEmployees" ItemKey="e => e.Id"
                      Searchable Selectable @bind-SelectedItems="selection">
            <HelixColumn Field="e => e.Name" Title="Employé" />
            <HelixColumn Field="e => e.Department" Title="Service" />
            <HelixColumn Field="e => e.Salary" Title="Salaire" Format="C0" Align="HelixAlign.End" />
        </HelixDataGrid>

        @code {
            private HelixDataGrid<Employee>? grid;

            // Après un ajout / une suppression :  await grid!.RefreshAsync();
        }
        """;

    private const string ServerCSharpCode = """
        // Une seule méthode : la grille passe la page demandée et un jeton d'annulation.
        private async Task<HelixGridResult<Employee>> LoadEmployees(HelixGridRequest request, CancellationToken ct)
        {
            var query = db.Employees.AsNoTracking();

            if (request.Search is { } search)
                query = query.Where(e => e.Name.Contains(search) || e.Department.Contains(search));

            var total = await query.CountAsync(ct);
            var items = await query
                .ApplySort(request)   // ORDER BY <colonne cliquée>, fourni par Helix
                .ApplyPage(request)   // OFFSET / FETCH, fourni par Helix
                .ToListAsync(ct);

            return new HelixGridResult<Employee>(items, total);
        }
        """;

    private void SetPage(PageChoice choice)
    {
        _pageChoice = choice;
        _pageSize = choice switch { PageChoice.Five => 5, PageChoice.TwentyFive => 25, PageChoice.All => 0, _ => 10 };
    }

    private EventCallback<Employee> RowClick =>
        _rowClick ? EventCallback.Factory.Create<Employee>(this, OpenEmployee) : default;

    private void OpenEmployee(Employee employee)
    {
        _opened = employee;
        _dialogOpen = true;
    }

    private void DeleteSelection()
    {
        var count = _selection.Count;
        _employees = _employees.Except(_selection).ToList();
        _selection = [];
        Toasts.Success($"{count} employé{(count > 1 ? "s" : "")} supprimé{(count > 1 ? "s" : "")}");
    }

    private string Code
    {
        get
        {
            var attrs = string.Concat(
                B("Searchable", _searchable),
                _selectable ? " Selectable @bind-SelectedItems=\"selection\"" : "",
                _pageSize == 10 ? "" : $" PageSize=\"{_pageSize}\"",
                A("Density", _density, HelixSize.Md),
                B("Striped", _striped),
                A("MaxHeight", _sticky ? "360px" : null),
                A("Color", _color),
                A("HeaderBackground", _header),
                A("SelectedColor", _selectedColor),
                _rowClick ? " OnRowClick=\"Open\"" : "",
                B("Loading", _loading),
                B("ReorderableColumns", _reorder),
                _chooser ? " ColumnChooser @bind-ColumnLayout=\"columnLayout\"" : "");
            return $"""
                <HelixDataGrid Items="employees"{attrs}>
                    <HelixColumn Field="e => e.Name" Title="Employé">
                        <Template>
                            <HelixAvatar Name="@context.Name" Size="HelixSize.Sm" /> @context.Name
                        </Template>
                    </HelixColumn>
                    <HelixColumn Field="e => e.Department" Title="Service" />
                    <HelixColumn Field="e => e.Role" Title="Poste" />
                    <HelixColumn Field="e => e.Status" Title="Statut" SortBy="e => (int)e.Status">
                        <Template><StatusBadge Status="context.Status" /></Template>
                    </HelixColumn>
                    <HelixColumn Field="e => e.StartDate" Title="Arrivée" Format="d MMM yyyy" />
                    <HelixColumn Field="e => e.Salary" Title="Salaire" Format="C0" Align="HelixAlign.End" />
                </HelixDataGrid>
                """;
        }
    }

    private const string MinimalCode = """
        <HelixDataGrid Items="employees">
            <HelixColumn Field="e => e.Name" />
            <HelixColumn Field="e => e.Department" />
            <HelixColumn Field="e => e.StartDate" Format="d" />
            <HelixColumn Field="e => e.Salary" Format="C0" Align="HelixAlign.End" />
        </HelixDataGrid>
        """;

    private const string RowClassCode = """
        <HelixDataGrid Items="employees" RowClass="@(e => e.Status == EmployeeStatus.Offboarding ? "row-leaving" : null)">
            …
        </HelixDataGrid>

        /* app.css */
        .row-leaving td { color: var(--helix-text-subtle); text-decoration: line-through; }
        """;

    private static readonly ApiRow[] Api =
    [
        new("Items", "IEnumerable<T>", null, "Les lignes."),
        new("Searchable / SearchPlaceholder", "bool / string", null, "Recherche sur toutes les colonnes."),
        new("Toolbar", "RenderFragment", null, "Contenu à droite de la barre d'outils."),
        new("PageSize / PageSizes", "int / int[]", null, "Lignes par page (0 = tout) et choix proposés."),
        new("Selectable / SelectedItems", "bool / IReadOnlyCollection<T>", null, "Colonne de cases à cocher, @bind-SelectedItems."),
        new("OnRowClick", "EventCallback<T>", null, "Clic sur une ligne (sinon le clic sélectionne)."),
        new("RowClass", "Func<T, string?>", null, "Classe CSS par ligne."),
        new("Density", "HelixSize", null, "Sm (compact), Md, Lg (aéré)."),
        new("Striped / Loading", "bool", null, "Lignes alternées / squelettes de chargement."),
        new("EmptyContent / EmptyText", "RenderFragment / string", null, "Affichage sans données."),
        new("Culture", "CultureInfo", null, "Culture des formats (dates, montants)."),
        new("ReorderableColumns", "bool", null, "Glisser les en-têtes pour réordonner les colonnes."),
        new("ColumnChooser", "bool", null, "Bouton « Colonnes » : afficher / masquer des colonnes."),
        new("ColumnLayout", "IReadOnlyList<HelixColumnState>", null, "Ordre et visibilité choisis (Key, Visible), à sauvegarder et restaurer (@bind-ColumnLayout)."),
        new("Color", "string", "--helix-grid-color", "Tri, sélection et page active."),
        new("HeaderBackground", "string", "--helix-grid-header-bg", "Fond de l'en-tête."),
        new("HoverColor", "string", "--helix-grid-hover", "Fond d'une ligne survolée."),
        new("StripeColor", "string", "--helix-grid-stripe", "Fond des lignes paires (Striped)."),
        new("SelectedColor", "string", "--helix-grid-selected", "Fond d'une ligne sélectionnée."),
        new("Radius", "string", "--helix-grid-radius", "Arrondi."),
        new("MaxHeight", "string", "--helix-grid-max-height", "Hauteur maximale avec en-tête fixe."),
        new("—", "", "--helix-grid-header-text, --helix-grid-border, --helix-grid-row-border, --helix-grid-bg", "Texte d'en-tête, bordures, fond."),
    ];

    private static readonly ApiRow[] ColumnApi =
    [
        new("Field", "Expression<Func<T, object?>>", null, "Propriété affichée, triée et recherchée."),
        new("Title", "string", null, "En-tête (nom de la propriété par défaut)."),
        new("Format", "string", null, "Format .NET : \"C0\", \"d\", \"N2\", \"P1\"…"),
        new("Template", "RenderFragment<T>", null, "Contenu libre de la cellule (context = la ligne)."),
        new("SortBy", "Func<T, object?>", null, "Clé de tri personnalisée."),
        new("Sortable / Searchable", "bool", null, "Désactiver le tri / la recherche sur la colonne."),
        new("Align / Width / CellClass", "HelixAlign / string / string", null, "Alignement, largeur, classe des cellules."),
    ];
}
