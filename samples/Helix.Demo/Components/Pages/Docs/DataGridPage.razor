    private const string Wpf2 = """
        <helix:HelixDataGrid Source="{Binding Plants}" IsStriped="True" Density="Sm" AutoGenerateColumns="False">
            <helix:HelixDataGrid.Columns>
                <DataGridTextColumn Header="Site" Binding="{Binding Site}" Width="*" />
                <DataGridTemplateColumn Header="Status" SortMemberPath="Status">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <helix:HelixBadge Content="{Binding Status}" Tone="{Binding Tone}" ShowDot="True" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </helix:HelixDataGrid.Columns>
            <helix:HelixDataGrid.Toolbar>
                <TextBlock Text="Sites" FontWeight="SemiBold" />
            </helix:HelixDataGrid.Toolbar>
        </helix:HelixDataGrid>
        """;

    private enum PageChoice { Five, Ten, TwentyFive, All }

    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-US");

    private List<Employee> _employees = SampleData.Employees.ToList();
    private IReadOnlyCollection<Employee> _selection = [];
    private HelixSize _density = HelixSize.Md;
    private PageChoice _pageChoice = PageChoice.Ten;
    private int _pageSize = 10;
    private string? _color, _header, _selectedColor;
    private bool _reorder = true, _chooser = true;
    private IReadOnlyList<HelixColumnState>? _columnLayout;
    private bool _searchable = true, _selectable = true, _striped, _sticky, _rowClick, _loading;
    private bool _dialogOpen;
    private Employee? _opened;

    private readonly CancellationTokenSource _pageCts = new();
    private HelixDataGrid<Employee>? _serverGrid;
    private IReadOnlyCollection<Employee> _serverSelection = [];
    private HelixGridRequest? _lastRequest;
    private int _requestCount, _cancelledCount;
    private bool _deleting;

    private async Task<HelixGridResult<Employee>> LoadEmployees(HelixGridRequest request, CancellationToken cancellationToken)
    {
        _lastRequest = request;
        _requestCount++;
        StateHasChanged();
        try
        {
            return await Server.QueryAsync(request, cancellationToken);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            _cancelledCount++;
            StateHasChanged();
            throw;
        }
    }

    private void OnServerError(Exception ex) => Toasts.Error(ex.Message, "Could not load");

    private async Task DeleteOnServer()
    {
        _deleting = true;
        var ids = _serverSelection.Select(e => e.Id).ToArray();
        try
        {
            await Server.DeleteAsync(ids, _pageCts.Token);
            _serverSelection = [];
            Toasts.Success($"{ids.Length} employee{(ids.Length > 1 ? "s" : "")} deleted on the server");
            await _serverGrid!.RefreshAsync();
        }
        finally
        {
            _deleting = false;
        }
    }

    private static string Describe(HelixGridRequest r) =>
        $"Skip={r.Skip} Take={r.Take}" +
        (r.SortBy is null ? "" : $" SortBy={r.SortBy}{(r.SortDescending ? " desc" : "")}") +
        (r.Search is null ? "" : $" Search=\"{r.Search}\"");

    public void Dispose()
    {
        _pageCts.Cancel();
        _pageCts.Dispose();
    }

    private const string ServerRazorCode = """
        <HelixDataGrid @ref="grid" TItem="Employee" ItemsProvider="LoadEmployees" ItemKey="e => e.Id"
                      Searchable Selectable @bind-SelectedItems="selection">
            <HelixColumn Field="e => e.Name" Title="Employee" />
            <HelixColumn Field="e => e.Department" Title="Department" />
            <HelixColumn Field="e => e.Salary" Title="Salary" Format="C0" Align="HelixAlign.End" />
        </HelixDataGrid>

        @code {
            private HelixDataGrid<Employee>? grid;

            // After an add / a delete:  await grid!.RefreshAsync();
        }
        """;

    private const string ServerCSharpCode = """
        // A single method: the grid passes the requested page and a cancellation token.
        private async Task<HelixGridResult<Employee>> LoadEmployees(HelixGridRequest request, CancellationToken ct)
        {
            var query = db.Employees.AsNoTracking();

            if (request.Search is { } search)
                query = query.Where(e => e.Name.Contains(search) || e.Department.Contains(search));

            var total = await query.CountAsync(ct);
            var items = await query
                .ApplySort(request)   // ORDER BY <clicked column>, provided by Helix
                .ApplyPage(request)   // OFFSET / FETCH, provided by Helix
                .ToListAsync(ct);

            return new HelixGridResult<Employee>(items, total);
        }
        """;

    private void SetPage(PageChoice choice)
    {
        _pageChoice = choice;
        _pageSize = choice switch { PageChoice.Five => 5, PageChoice.TwentyFive => 25, PageChoice.All => 0, _ => 10 };
    }

    private EventCallback<Employee> RowClick =>
        _rowClick ? EventCallback.Factory.Create<Employee>(this, OpenEmployee) : default;

    private void OpenEmployee(Employee employee)
    {
        _opened = employee;
        _dialogOpen = true;
    }

    private void DeleteSelection()
    {
        var count = _selection.Count;
        _employees = _employees.Except(_selection).ToList();
        _selection = [];
        Toasts.Success($"{count} employee{(count > 1 ? "s" : "")} deleted");
    }

    private string Code
    {
        get
        {
            var attrs = string.Concat(
                B("Searchable", _searchable),
                _selectable ? " Selectable @bind-SelectedItems=\"selection\"" : "",
                _pageSize == 10 ? "" : $" PageSize=\"{_pageSize}\"",
                A("Density", _density, HelixSize.Md),
                B("Striped", _striped),
                A("MaxHeight", _sticky ? "360px" : null),
                A("Color", _color),
                A("HeaderBackground", _header),
                A("SelectedColor", _selectedColor),
                _rowClick ? " OnRowClick=\"Open\"" : "",
                B("Loading", _loading),
                B("ReorderableColumns", _reorder),
                _chooser ? " ColumnChooser @bind-ColumnLayout=\"columnLayout\"" : "");
            return $"""
                <HelixDataGrid Items="employees"{attrs}>
                    <HelixColumn Field="e => e.Name" Title="Employee">
                        <Template>
                            <HelixAvatar Name="@context.Name" Size="HelixSize.Sm" /> @context.Name
                        </Template>
                    </HelixColumn>
                    <HelixColumn Field="e => e.Department" Title="Department" />
                    <HelixColumn Field="e => e.Role" Title="Role" />
                    <HelixColumn Field="e => e.Status" Title="Status" SortBy="e => (int)e.Status">
                        <Template><StatusBadge Status="context.Status" /></Template>
                    </HelixColumn>
                    <HelixColumn Field="e => e.StartDate" Title="Start date" Format="d MMM yyyy" />
                    <HelixColumn Field="e => e.Salary" Title="Salary" Format="C0" Align="HelixAlign.End" />
                </HelixDataGrid>
                """;
        }
    }

    private const string MinimalCode = """
        <HelixDataGrid Items="employees">
            <HelixColumn Field="e => e.Name" />
            <HelixColumn Field="e => e.Department" />
            <HelixColumn Field="e => e.StartDate" Format="d" />
            <HelixColumn Field="e => e.Salary" Format="C0" Align="HelixAlign.End" />
        </HelixDataGrid>
        """;

    private const string RowClassCode = """
        <HelixDataGrid Items="employees" RowClass="@(e => e.Status == EmployeeStatus.Offboarding ? "row-leaving" : null)">
            …
        </HelixDataGrid>

        /* app.css */
        .row-leaving td { color: var(--helix-text-subtle); text-decoration: line-through; }
        """;

    private static readonly ApiRow[] Api =
    [
        new("Items", "IEnumerable<T>", null, "The rows."),
        new("Searchable / SearchPlaceholder", "bool / string", null, "Search across every column."),
        new("Toolbar", "RenderFragment", null, "Content on the right of the toolbar."),
        new("PageSize / PageSizes", "int / int[]", null, "Rows per page (0 = all) and the offered choices."),
        new("Selectable / SelectedItems", "bool / IReadOnlyCollection<T>", null, "Checkbox column, @bind-SelectedItems."),
        new("OnRowClick", "EventCallback<T>", null, "Click on a row (otherwise a click selects)."),
        new("RowClass", "Func<T, string?>", null, "CSS class per row."),
        new("Density", "HelixSize", null, "Sm (compact), Md, Lg (roomy)."),
        new("Striped / Loading", "bool", null, "Alternating rows / loading skeletons."),
        new("EmptyContent / EmptyText", "RenderFragment / string", null, "Display when there is no data."),
        new("Culture", "CultureInfo", null, "Culture for formats (dates, amounts)."),
        new("ReorderableColumns", "bool", null, "Drag the headers to reorder the columns."),
        new("ColumnChooser", "bool", null, "“Columns” button: show / hide columns."),
        new("ColumnLayout", "IReadOnlyList<HelixColumnState>", null, "Chosen order and visibility (Key, Visible), to save and restore (@bind-ColumnLayout)."),
        new("RowDetails / HasDetails", "RenderFragment<T> / Func<T, bool>", null, "Content under an expanded row (chevron column); which rows can expand."),
        new("GroupBy / GroupText / GroupsCollapsed", "Func<T, object?> / Func<object?, string> / bool", null, "Collapsible groups with count and subtotals; header text; start collapsed."),
        new("Exportable / ExportFileName", "bool / string", null, "“Export” button: CSV of the filtered rows (Excel-friendly). Also ExportAsync() and ToCsv()."),
