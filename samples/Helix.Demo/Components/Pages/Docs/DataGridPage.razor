        """;

    private const string Wpf4 = """
        <helix:HelixDataGrid Source="{Binding Employees}" AutoGenerateColumns="False" IsReadOnly="True">
            <helix:HelixDataGrid.Columns>
                <helix:HelixDetailsColumn />   <!-- the chevron that opens the row details -->
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Department" Binding="{Binding Department}" />
            </helix:HelixDataGrid.Columns>
            <helix:HelixDataGrid.RowDetailsTemplate>
