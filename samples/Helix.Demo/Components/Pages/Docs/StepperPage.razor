@page "/components/stepper"
@inject HelixToastService Toasts

<DemoPage Title="Stepper" Description="The steps of a flow (wizard, checkout, onboarding): done, current, upcoming, in error. Finished steps can be clicked to go back.">
    <Example WpfCode="@Wpf1" Title="Wizard" Code="@Code">
        <div class="stack" style="gap:24px">
            <HelixStepper Steps="Steps" @bind-ActiveIndex="_active" ErrorSteps="@(_error ? new[] { 1 } : null)" />
            <HelixCard>
                <p style="margin:0 0 14px"><strong>@Steps[_active].Title</strong> <span class="muted">— @Steps[_active].Description</span></p>
                <div class="row">
                    <HelixButton Variant="HelixVariant.Outline" Color="neutral" Disabled="@(_active == 0)" OnClick="() => _active--">Previous</HelixButton>
                    <HelixButton IconEnd="arrow-right" OnClick="Next">@(_active == Steps.Length - 1 ? "Finish" : "Next")</HelixButton>
                    <HelixSwitch Label="Step 2 in error" @bind-Checked="_error" Size="HelixSize.Sm" />
                </div>
            </HelixCard>
        </div>
    </Example>

    <Example WpfCode="@Wpf2" Title="Vertical">
        <div style="max-width:360px">
            <HelixStepper Steps="Steps" ActiveIndex="2" Vertical="true" Clickable="false" />
        </div>
    </Example>

    <ApiTable Title="HelixStepper" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixStepper Steps="{Binding Steps}" ActiveIndex="{Binding Step}" IsClickable="True" ErrorSteps="{Binding InvalidSteps}" />

        // ViewModel
        Steps = [new HelixStep("Account", "Email and password"), new HelixStep("Profile"), new HelixStep("Team"), new HelixStep("Done")];
        """;

    private const string Wpf2 = """
        <helix:HelixStepper Steps="{Binding Steps}" ActiveIndex="1" Orientation="Vertical" Width="320" />
        """;

    private static readonly HelixStep[] Steps =
    [
        new("Site", "Choose the site"),
        new("Power", "Enter the power and the period"),
        new("Price", "Set the price cap"),
        new("Send", "Check and send"),
    ];

    private int _active = 1;
    private bool _error;

    private void Next()
    {
        if (_active < Steps.Length - 1)
        {
            _active++;
        }
        else
        {
            Toasts.Success("Request sent");
            _active = 0;
        }
    }

    private const string Code = """
        <HelixStepper Steps="steps" @bind-ActiveIndex="active" ErrorSteps="errors" />

        // new HelixStep("Power", "Enter the power and the period")
        """;

    private static readonly ApiRow[] Api =
    [
        new("Steps", "IReadOnlyList<HelixStep>", null, "(Title, Description?)."),
        new("ActiveIndex", "int", null, "Current step (@bind-ActiveIndex); the ones before are done."),
        new("ErrorSteps", "IReadOnlyCollection<int>", null, "Steps in error (icon + text, not only red)."),
        new("Clickable / AllowSkip", "bool", null, "Go back to finished steps (true); skip ahead."),
        new("Vertical / Color", "bool / string", "--helix-stepper-color", "Orientation; color."),
    ];
}
