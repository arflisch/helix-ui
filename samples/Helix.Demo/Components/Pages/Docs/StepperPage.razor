@page "/components/stepper"
@inject HelixToastService Toasts

<DemoPage Title="Stepper" Description="Les étapes d'un parcours (assistant, commande, onboarding) : faites, en cours, à venir, en erreur. Les étapes terminées sont cliquables pour revenir en arrière.">
    <Example WpfCode="@Wpf1" Title="Assistant" Code="@Code">
        <div class="stack" style="gap:24px">
            <HelixStepper Steps="Steps" @bind-ActiveIndex="_active" ErrorSteps="@(_error ? new[] { 1 } : null)" />
            <HelixCard>
                <p style="margin:0 0 14px"><strong>@Steps[_active].Title</strong> <span class="muted">— @Steps[_active].Description</span></p>
                <div class="row">
                    <HelixButton Variant="HelixVariant.Outline" Color="neutral" Disabled="@(_active == 0)" OnClick="() => _active--">Précédent</HelixButton>
                    <HelixButton IconEnd="arrow-right" OnClick="Next">@(_active == Steps.Length - 1 ? "Terminer" : "Suivant")</HelixButton>
                    <HelixSwitch Label="Étape 2 en erreur" @bind-Checked="_error" Size="HelixSize.Sm" />
                </div>
            </HelixCard>
        </div>
    </Example>

    <Example WpfCode="@Wpf2" Title="Vertical">
        <div style="max-width:360px">
            <HelixStepper Steps="Steps" ActiveIndex="2" Vertical="true" Clickable="false" />
        </div>
    </Example>

    <ApiTable Title="HelixStepper" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixStepper Steps="{Binding Steps}" ActiveIndex="{Binding Step}" IsClickable="True" ErrorSteps="{Binding InvalidSteps}" />

        // ViewModel
        Steps = [new HelixStep("Compte", "E-mail et mot de passe"), new HelixStep("Profil"), new HelixStep("Équipe"), new HelixStep("Terminé")];
        """;

    private const string Wpf2 = """
        <helix:HelixStepper Steps="{Binding Steps}" ActiveIndex="1" Orientation="Vertical" Width="320" />
        """;

    private static readonly HelixStep[] Steps =
    [
        new("Site", "Choisir le site concerné"),
        new("Puissance", "Indiquer la puissance et la période"),
        new("Prix", "Fixer le prix plafond"),
        new("Envoi", "Vérifier et envoyer"),
    ];

    private int _active = 1;
    private bool _error;

    private void Next()
    {
        if (_active < Steps.Length - 1)
        {
            _active++;
        }
        else
        {
            Toasts.Success("Demande envoyée");
            _active = 0;
        }
    }

    private const string Code = """
        <HelixStepper Steps="steps" @bind-ActiveIndex="active" ErrorSteps="errors" />

        // new HelixStep("Puissance", "Indiquer la puissance et la période")
        """;

    private static readonly ApiRow[] Api =
    [
        new("Steps", "IReadOnlyList<HelixStep>", null, "(Title, Description?)."),
        new("ActiveIndex", "int", null, "Étape courante (@bind-ActiveIndex) ; celles d'avant sont faites."),
        new("ErrorSteps", "IReadOnlyCollection<int>", null, "Étapes en erreur (icône + texte, pas seulement du rouge)."),
        new("Clickable / AllowSkip", "bool", null, "Revenir aux étapes faites (true) ; sauter vers l'avant."),
        new("Vertical / Color", "bool / string", "--helix-stepper-color", "Orientation ; couleur."),
    ];
}
