@page "/components/button"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="Button" Description="The button: four variants, every color (semantic or custom), three sizes, icons and a loading state.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <HelixButton Variant="_variant" Color="@_color" Size="_size" Radius="@Radius" Loading="_loading" Disabled="_disabled"
                        Icon="@(_icon ? "sparkles" : null)">@_label</HelixButton>
        </Preview>
        <Controls>
            <HelixTextField Label="Text" @bind-Value="_label" />
            <Choice TEnum="HelixVariant" Label="Variant" @bind-Value="_variant" />
            <Choice TEnum="HelixSize" Label="Size" @bind-Value="_size" />
            <ColorPicker Label="Color" @bind-Value="_color" />
            <HelixSlider Label="Radius" @bind-Value="_radius" Min="0" Max="24" Format="@(v => $"{v} px")" />
            <HelixSwitch Label="Icon" @bind-Checked="_icon" Size="HelixSize.Sm" />
            <HelixSwitch Label="Loading" @bind-Checked="_loading" Size="HelixSize.Sm" />
            <HelixSwitch Label="Disabled" @bind-Checked="_disabled" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Variants" Code="@VariantsCode">
        <div class="row">
            <HelixButton>Solid</HelixButton>
            <HelixButton Variant="HelixVariant.Soft">Soft</HelixButton>
            <HelixButton Variant="HelixVariant.Outline">Outline</HelixButton>
            <HelixButton Variant="HelixVariant.Ghost">Ghost</HelixButton>
        </div>
    </Example>

    <Example WpfCode="@Wpf3" Title="Colors" Description="A semantic name or any CSS color. Hover and focus states and the text color are computed automatically.">
        <div class="stack">
            @foreach (var variant in Enum.GetValues<HelixVariant>())
            {
                <div class="row">
                    @foreach (var color in Colors)
                    {
                        <HelixButton Variant="variant" Color="@color">@color</HelixButton>
                    }
                </div>
            }
        </div>
    </Example>

    <Example WpfCode="@Wpf4" Title="Icons, sizes and loading" Code="@IconsCode">
        <div class="row">
            <HelixButton Icon="download" Size="HelixSize.Sm">Download</HelixButton>
            <HelixButton Variant="HelixVariant.Outline" Color="neutral" IconEnd="arrow-right">Continue</HelixButton>
            <HelixButton Size="HelixSize.Lg" Color="danger" Icon="trash">Delete</HelixButton>
            <HelixButton Variant="HelixVariant.Soft" Icon="heart" aria-label="Like" />
            <HelixButton Loading="true">Saving</HelixButton>
            <HelixButton Radius="999px" Color="#18181b">Pill</HelixButton>
        </div>
    </Example>

    <Example WpfCode="@WpfAsync" Title="Async work" Description="AutoLoading shows the spinner and blocks the button for the whole OnClick task: no double submit, no Loading flag to manage. Turn it on everywhere with Defaults.Button.AutoLoading." Code="@AsyncCode">
        <div class="row">
            <HelixButton Icon="check" AutoLoading="true" OnClick="SaveAsync">Save (1.5 s)</HelixButton>
            <span class="muted" style="font-size:13px">Saved @_saves time(s)</span>
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private int _saves;

    private async Task SaveAsync()
    {
        await Task.Delay(1500);
        _saves++;
    }

    private const string AsyncCode = """
        <HelixButton AutoLoading OnClick="SaveAsync">Save</HelixButton>

        // Or for every button: builder.Services.AddHelix(o => o.Defaults.Button.AutoLoading = true);
        """;

    private const string WpfAsync = """
        <helix:HelixButton Content="Save" Command="{Binding SaveCommand}" />

        // ViewModel: disabled while it runs, spinner on the button, errors shown as a toast, cancellable
        SaveCommand = new HelixAsyncCommand(async ct => await api.SaveAsync(model, ct));
        """;

    private const string Wpf1 = """
        <helix:HelixButton Content="Save" Variant="Solid" Tone="Primary" Size="Md"
                         Icon="check" CornerRadius="10" Click="OnSave" />

        <!-- Any color: the text turns black or white for contrast -->
        <helix:HelixButton Content="Send" Accent="#FF8A00" />
        """;

    private const string Wpf2 = """
        <helix:HelixButton Content="Solid" />
        <helix:HelixButton Content="Soft" Variant="Soft" />
        <helix:HelixButton Content="Outline" Variant="Outline" />
        <helix:HelixButton Content="Ghost" Variant="Ghost" />
        """;

    private const string Wpf3 = """
        <helix:HelixButton Content="Primary" />
        <helix:HelixButton Content="Neutral" Tone="Neutral" />
        <helix:HelixButton Content="Success" Tone="Success" />
        <helix:HelixButton Content="Danger" Tone="Danger" />
        <helix:HelixButton Content="Violet" Accent="#8B5CF6" />
        """;

    private const string Wpf4 = """
        <helix:HelixButton Content="Download" Icon="download" Size="Sm" />
        <helix:HelixButton Content="Continue" IconEnd="arrow-right" Size="Lg" />
        <helix:HelixButton Icon="settings" Variant="Ghost" Tone="Neutral" Padding="0" Width="38" ToolTip="Settings" />
        <helix:HelixButton x:Name="Save" Content="Save" IsLoading="{Binding IsSaving}" />
        """;

    private static readonly string[] Colors = ["primary", "neutral", "success", "warning", "danger", "#8b5cf6"];

    private string? _label = "Save";
    private HelixVariant _variant;
    private HelixSize _size = HelixSize.Md;
    private string? _color;
    private double _radius = 10;
    private bool _icon, _loading, _disabled;

    private string? Radius => _radius == 10 ? null : $"{N(_radius)}px";

    private string Code =>
        $"<HelixButton{A("Variant", _variant, HelixVariant.Solid)}{A("Color", _color)}{A("Size", _size, HelixSize.Md)}{A("Radius", Radius)}{A("Icon", _icon ? "sparkles" : null)}{B("Loading", _loading)}{B("Disabled", _disabled)} OnClick=\"Save\">{_label}</HelixButton>";

    private const string VariantsCode = """
        <HelixButton>Solid</HelixButton>
        <HelixButton Variant="HelixVariant.Soft">Soft</HelixButton>
        <HelixButton Variant="HelixVariant.Outline">Outline</HelixButton>
        <HelixButton Variant="HelixVariant.Ghost">Ghost</HelixButton>
        """;

    private const string IconsCode = """
        <HelixButton Icon="download" Size="HelixSize.Sm">Download</HelixButton>
        <HelixButton Variant="HelixVariant.Outline" Color="neutral" IconEnd="arrow-right">Continue</HelixButton>
        <HelixButton Size="HelixSize.Lg" Color="danger" Icon="trash">Delete</HelixButton>
        <HelixButton Variant="HelixVariant.Soft" Icon="heart" aria-label="Like" />
        <HelixButton Loading="true">Saving</HelixButton>
        <HelixButton Radius="999px" Color="#18181b">Pill</HelixButton>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Variant", "HelixVariant", null, "Solid, Soft, Outline or Ghost."),
        new("Color", "string", "--helix-btn-color", "Semantic name (primary, danger…) or CSS color."),
        new("TextColor", "string", "--helix-btn-text", "Forces the text color."),
        new("Radius", "string", "--helix-btn-radius", "Corner radius, e.g. \"999px\" for a pill."),
        new("Size", "HelixSize", "--helix-btn-height", "Sm, Md or Lg."),
        new("Icon / IconEnd", "string", null, "Icon name before / after the text. Without text, the button becomes square."),
        new("Loading", "bool", null, "Shows a spinner and disables the button."),
        new("Block", "bool", null, "Takes the full width."),
        new("OnClick", "EventCallback", null, "Click."),
        new("AutoLoading", "bool?", null, "Spinner and blocked button while the OnClick task runs. Null: Defaults.Button.AutoLoading."),
    ];
}
