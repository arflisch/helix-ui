@page "/components/button"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="Button" Description="Le bouton : quatre variantes, toutes les couleurs (sémantiques ou libres), trois tailles, icônes et état de chargement.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <HelixButton Variant="_variant" Color="@_color" Size="_size" Radius="@Radius" Loading="_loading" Disabled="_disabled"
                        Icon="@(_icon ? "sparkles" : null)">@_label</HelixButton>
        </Preview>
        <Controls>
            <HelixTextField Label="Texte" @bind-Value="_label" />
            <Choice TEnum="HelixVariant" Label="Variant" @bind-Value="_variant" />
            <Choice TEnum="HelixSize" Label="Size" @bind-Value="_size" />
            <ColorPicker Label="Color" @bind-Value="_color" />
            <HelixSlider Label="Radius" @bind-Value="_radius" Min="0" Max="24" Format="@(v => $"{v} px")" />
            <HelixSwitch Label="Icône" @bind-Checked="_icon" Size="HelixSize.Sm" />
            <HelixSwitch Label="Loading" @bind-Checked="_loading" Size="HelixSize.Sm" />
            <HelixSwitch Label="Disabled" @bind-Checked="_disabled" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Variantes" Code="@VariantsCode">
        <div class="row">
            <HelixButton>Solid</HelixButton>
            <HelixButton Variant="HelixVariant.Soft">Soft</HelixButton>
            <HelixButton Variant="HelixVariant.Outline">Outline</HelixButton>
            <HelixButton Variant="HelixVariant.Ghost">Ghost</HelixButton>
        </div>
    </Example>

    <Example WpfCode="@Wpf3" Title="Couleurs" Description="Un nom sémantique ou n'importe quelle couleur CSS. Les états hover, focus et le texte sont calculés automatiquement.">
        <div class="stack">
            @foreach (var variant in Enum.GetValues<HelixVariant>())
            {
                <div class="row">
                    @foreach (var color in Colors)
                    {
                        <HelixButton Variant="variant" Color="@color">@color</HelixButton>
                    }
                </div>
            }
        </div>
    </Example>

    <Example WpfCode="@Wpf4" Title="Icônes, tailles et chargement" Code="@IconsCode">
        <div class="row">
            <HelixButton Icon="download" Size="HelixSize.Sm">Télécharger</HelixButton>
            <HelixButton Variant="HelixVariant.Outline" Color="neutral" IconEnd="arrow-right">Continuer</HelixButton>
            <HelixButton Size="HelixSize.Lg" Color="danger" Icon="trash">Supprimer</HelixButton>
            <HelixButton Variant="HelixVariant.Soft" Icon="heart" aria-label="J'aime" />
            <HelixButton Loading="true">Enregistrement</HelixButton>
            <HelixButton Radius="999px" Color="#18181b">Pilule</HelixButton>
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixButton Content="Enregistrer" Variant="Solid" Tone="Primary" Size="Md"
                         Icon="check" CornerRadius="10" Click="OnSave" />

        <!-- N'importe quelle couleur : le texte devient noir ou blanc selon le contraste -->
        <helix:HelixButton Content="Envoyer" Accent="#FF8A00" />
        """;

    private const string Wpf2 = """
        <helix:HelixButton Content="Solid" />
        <helix:HelixButton Content="Soft" Variant="Soft" />
        <helix:HelixButton Content="Outline" Variant="Outline" />
        <helix:HelixButton Content="Ghost" Variant="Ghost" />
        """;

    private const string Wpf3 = """
        <helix:HelixButton Content="Primary" />
        <helix:HelixButton Content="Neutral" Tone="Neutral" />
        <helix:HelixButton Content="Success" Tone="Success" />
        <helix:HelixButton Content="Danger" Tone="Danger" />
        <helix:HelixButton Content="Violet" Accent="#8B5CF6" />
        """;

    private const string Wpf4 = """
        <helix:HelixButton Content="Télécharger" Icon="download" Size="Sm" />
        <helix:HelixButton Content="Continuer" IconEnd="arrow-right" Size="Lg" />
        <helix:HelixButton Icon="settings" Variant="Ghost" Tone="Neutral" Padding="0" Width="38" ToolTip="Réglages" />
        <helix:HelixButton x:Name="Save" Content="Enregistrer" IsLoading="{Binding IsSaving}" />
        """;

    private static readonly string[] Colors = ["primary", "neutral", "success", "warning", "danger", "#8b5cf6"];

    private string? _label = "Enregistrer";
    private HelixVariant _variant;
    private HelixSize _size = HelixSize.Md;
    private string? _color;
    private double _radius = 10;
    private bool _icon, _loading, _disabled;

    private string? Radius => _radius == 10 ? null : $"{N(_radius)}px";

    private string Code =>
        $"<HelixButton{A("Variant", _variant, HelixVariant.Solid)}{A("Color", _color)}{A("Size", _size, HelixSize.Md)}{A("Radius", Radius)}{A("Icon", _icon ? "sparkles" : null)}{B("Loading", _loading)}{B("Disabled", _disabled)} OnClick=\"Save\">{_label}</HelixButton>";

    private const string VariantsCode = """
        <HelixButton>Solid</HelixButton>
        <HelixButton Variant="HelixVariant.Soft">Soft</HelixButton>
        <HelixButton Variant="HelixVariant.Outline">Outline</HelixButton>
        <HelixButton Variant="HelixVariant.Ghost">Ghost</HelixButton>
        """;

    private const string IconsCode = """
        <HelixButton Icon="download" Size="HelixSize.Sm">Télécharger</HelixButton>
        <HelixButton Variant="HelixVariant.Outline" Color="neutral" IconEnd="arrow-right">Continuer</HelixButton>
        <HelixButton Size="HelixSize.Lg" Color="danger" Icon="trash">Supprimer</HelixButton>
        <HelixButton Variant="HelixVariant.Soft" Icon="heart" aria-label="J'aime" />
        <HelixButton Loading="true">Enregistrement</HelixButton>
        <HelixButton Radius="999px" Color="#18181b">Pilule</HelixButton>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Variant", "HelixVariant", null, "Solid, Soft, Outline ou Ghost."),
        new("Color", "string", "--helix-btn-color", "Nom sémantique (primary, danger…) ou couleur CSS."),
        new("TextColor", "string", "--helix-btn-text", "Force la couleur du texte."),
        new("Radius", "string", "--helix-btn-radius", "Arrondi, ex. \"999px\" pour une pilule."),
        new("Size", "HelixSize", "--helix-btn-height", "Sm, Md ou Lg."),
        new("Icon / IconEnd", "string", null, "Nom d'icône avant / après le texte. Sans texte, le bouton devient carré."),
        new("Loading", "bool", null, "Affiche un spinner et désactive le bouton."),
        new("Block", "bool", null, "Prend toute la largeur."),
        new("OnClick", "EventCallback", null, "Clic."),
    ];
}
