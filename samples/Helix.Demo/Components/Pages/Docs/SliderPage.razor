@page "/components/slider"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="Slider" Description="Slider built on the native range input: lightweight, keyboard accessible, with a colored fill and any display format.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <div style="width:100%;max-width:360px">
                <HelixSlider @bind-Value="_value" Label="@_label" Max="_max" Step="_step" Color="@_color" ThumbColor="@_thumb"
                            Format="@(v => $"{v} {_unit}".Trim())" Disabled="_disabled" />
            </div>
        </Preview>
        <Controls>
            <HelixTextField Label="Label" @bind-Value="_label" />
            <HelixTextField Label="Unit" @bind-Value="_unit" />
            <Choice TEnum="StepChoice" Label="Step" Value="_stepChoice" ValueChanged="SetStep" />
            <ColorPicker Label="Color (fill)" @bind-Value="_color" />
            <ColorPicker Label="ThumbColor" @bind-Value="_thumb" Colors="@(["#ffffff", "#18181b", "#f59e0b"])" />
            <HelixSwitch Label="Disabled" @bind-Checked="_disabled" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Colors" Code="@ColorsCode">
        <div class="grid-3">
            <HelixSlider Label="Bass" @bind-Value="_a" Color="success" />
            <HelixSlider Label="Mids" @bind-Value="_b" Color="warning" />
            <HelixSlider Label="Treble" @bind-Value="_c" Color="#ec4899" />
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixSlider Minimum="0" Maximum="100" Value="{Binding Volume}" TickFrequency="5" IsSnapToTickEnabled="True" />
        """;

    private const string Wpf2 = """
        <helix:HelixSlider Value="40" Tone="Success" />
        <helix:HelixSlider Value="60" Accent="#FF8A00" TrackBrush="#FFEDD5" />
        """;

    private enum StepChoice { One, Five, Ten }

    private double _value = 40, _max = 100, _step = 1, _a = 70, _b = 45, _c = 25;
    private StepChoice _stepChoice;
    private string? _label = "Brightness";
    private string? _unit = "%";
    private string? _color, _thumb;
    private bool _disabled;

    private void SetStep(StepChoice choice)
    {
        _stepChoice = choice;
        _step = choice switch { StepChoice.Five => 5, StepChoice.Ten => 10, _ => 1 };
    }

    private string Code =>
        $"<HelixSlider @bind-Value=\"brightness\"{A("Label", _label)}{(_step == 1 ? "" : $" Step=\"{N(_step)}\"")}{A("Color", _color)}{A("ThumbColor", _thumb)}{B("Disabled", _disabled)} Format=\"@(v => $\"{{v}} {_unit}\")\" />";

    private const string ColorsCode = """
        <HelixSlider Label="Bass" @bind-Value="bass" Color="success" />
        <HelixSlider Label="Mids" @bind-Value="mid" Color="warning" />
        <HelixSlider Label="Treble" @bind-Value="treble" Color="#ec4899" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Value", "double", null, "Value (@bind-Value)."),
        new("Min / Max / Step", "double", null, "Bounds and step (0, 100, 1 by default)."),
        new("Format", "Func<double, string>", null, "Value display, e.g. v => $\"{v} %\"."),
        new("ShowValue", "bool", null, "Shows the value to the right of the label (true)."),
        new("Color", "string", "--helix-slider-color", "Fill color."),
        new("TrackColor", "string", "--helix-slider-track", "Unfilled part."),
        new("ThumbColor", "string", "--helix-slider-thumb", "Thumb."),
        new("—", "", "--helix-slider-height", "Track thickness."),
    ];
}
