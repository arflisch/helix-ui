@page "/components/toast"
@inject HelixToastService Toasts

<DemoPage Title="Toast" Description="Notifications éphémères. Injectez HelixToastService n'importe où (composant ou service) et appelez une méthode. HelixProvider les affiche.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <div class="row">
                <HelixButton Color="@Color" OnClick="Show">Afficher le toast</HelixButton>
            </div>
        </Preview>
        <Controls>
            <Choice TEnum="HelixSeverity" Label="Severity" @bind-Value="_severity" />
            <HelixTextField Label="Title" @bind-Value="_title" />
            <HelixTextField Label="Message" @bind-Value="_message" />
            <HelixSlider Label="Durée" @bind-Value="_seconds" Min="0" Max="10" Format="@(v => v == 0 ? "permanent" : $"{v} s")" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Raccourcis" Code="@ShortcutsCode">
        <div class="row">
            <HelixButton Variant="HelixVariant.Soft" Color="info" OnClick="@(() => Toasts.Info("3 nouveaux messages"))">Info</HelixButton>
            <HelixButton Variant="HelixVariant.Soft" Color="success" OnClick="@(() => Toasts.Success("Modifications enregistrées", "Enregistré"))">Success</HelixButton>
            <HelixButton Variant="HelixVariant.Soft" Color="warning" OnClick="@(() => Toasts.Warning("Votre session expire dans 5 minutes"))">Warning</HelixButton>
            <HelixButton Variant="HelixVariant.Soft" Color="danger" OnClick="@(() => Toasts.Error("Impossible de joindre le serveur", "Erreur"))">Error</HelixButton>
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <!-- MainWindow.xaml : le HelixHost affiche les notifications -->
        <helix:HelixHost ToastHorizontalAlignment="Right" ToastVerticalAlignment="Bottom"> … </helix:HelixHost>

        // Partout dans l'application
        HelixToasts.Show("Synchronisation terminée.", HelixSeverity.Success, title: "Terminé", duration: TimeSpan.FromSeconds(6));
        HelixToasts.DefaultDuration = TimeSpan.FromSeconds(5);   // pour toute l'application
        """;

    private const string Wpf2 = """
        HelixToasts.Info("Nouvelle version disponible.");
        HelixToasts.Success("Enregistré.");
        HelixToasts.Warning("Il reste 8 % d'espace.");
        HelixToasts.Error("Le serveur ne répond pas.", "Erreur réseau");
        """;

    private HelixSeverity _severity = HelixSeverity.Success;
    private string? _title = "Projet publié";
    private string? _message = "Votre projet est en ligne.";
    private double _seconds = 4;

    private string Color => _severity switch
    {
        HelixSeverity.Success => "success",
        HelixSeverity.Warning => "warning",
        HelixSeverity.Danger => "danger",
        _ => "info",
    };

    private void Show() =>
        Toasts.Show(_message ?? "", _severity, _title, TimeSpan.FromSeconds(_seconds));

    private string Code
    {
        get
        {
            var title = string.IsNullOrEmpty(_title) ? "" : $", title: \"{_title}\"";
            var duration = _seconds == 4 ? "" : $", duration: TimeSpan.FromSeconds({_seconds})";
            return $"@inject HelixToastService Toasts\n\nToasts.Show(\"{_message}\", HelixSeverity.{_severity}{title}{duration});";
        }
    }

    private const string ShortcutsCode = """
        Toasts.Info("3 nouveaux messages");
        Toasts.Success("Modifications enregistrées", "Enregistré");
        Toasts.Warning("Votre session expire dans 5 minutes");
        Toasts.Error("Impossible de joindre le serveur", "Erreur");

        // Position : <HelixProvider ToastPosition="HelixToastPosition.TopCenter">
        """;

    private static readonly ApiRow[] Api =
    [
        new("Show(message, severity, title, duration)", "Guid", null, "Affiche un toast. TimeSpan.Zero = jusqu'à fermeture."),
        new("Info / Success / Warning / Error", "Guid", null, "Raccourcis."),
        new("Dismiss(id)", "void", null, "Ferme un toast."),
        new("DefaultDuration", "TimeSpan", null, "4 s par défaut, réglable via AddVelo(t => ...)."),
        new("HelixProvider.ToastPosition", "HelixToastPosition", null, "Coin de l'écran."),
        new("—", "", "--helix-toast-bg", "Fond du toast."),
    ];
}
