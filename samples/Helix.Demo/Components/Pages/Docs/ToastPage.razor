@page "/components/toast"
@inject HelixToastService Toasts

<DemoPage Title="Toast" Description="Short-lived notifications. Inject HelixToastService anywhere (component or service) and call a method. HelixProvider shows them.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <div class="row">
                <HelixButton Color="@Color" OnClick="Show">Show the toast</HelixButton>
            </div>
        </Preview>
        <Controls>
            <Choice TEnum="HelixSeverity" Label="Severity" @bind-Value="_severity" />
            <HelixTextField Label="Title" @bind-Value="_title" />
            <HelixTextField Label="Message" @bind-Value="_message" />
            <HelixSlider Label="Duration" @bind-Value="_seconds" Min="0" Max="10" Format="@(v => v == 0 ? "permanent" : $"{v} s")" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Shortcuts" Code="@ShortcutsCode">
        <div class="row">
            <HelixButton Variant="HelixVariant.Soft" Color="info" OnClick="@(() => Toasts.Info("3 new messages"))">Info</HelixButton>
            <HelixButton Variant="HelixVariant.Soft" Color="success" OnClick="@(() => Toasts.Success("Changes saved", "Saved"))">Success</HelixButton>
            <HelixButton Variant="HelixVariant.Soft" Color="warning" OnClick="@(() => Toasts.Warning("Your session expires in 5 minutes"))">Warning</HelixButton>
            <HelixButton Variant="HelixVariant.Soft" Color="danger" OnClick="@(() => Toasts.Error("Can't reach the server", "Error"))">Error</HelixButton>
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <!-- MainWindow.xaml: the HelixHost shows the notifications -->
        <helix:HelixHost ToastHorizontalAlignment="Right" ToastVerticalAlignment="Bottom"> … </helix:HelixHost>

        // Anywhere in the app
        HelixToasts.Show("Sync finished.", HelixSeverity.Success, title: "Done", duration: TimeSpan.FromSeconds(6));
        HelixToasts.DefaultDuration = TimeSpan.FromSeconds(5);   // for the whole app
        """;

    private const string Wpf2 = """
        HelixToasts.Info("New version available.");
        HelixToasts.Success("Saved.");
        HelixToasts.Warning("8% of space left.");
        HelixToasts.Error("The server is not responding.", "Network error");
        """;

    private HelixSeverity _severity = HelixSeverity.Success;
    private string? _title = "Project published";
    private string? _message = "Your project is live.";
    private double _seconds = 4;

    private string Color => _severity switch
    {
        HelixSeverity.Success => "success",
        HelixSeverity.Warning => "warning",
        HelixSeverity.Danger => "danger",
        _ => "info",
    };

    private void Show() =>
        Toasts.Show(_message ?? "", _severity, _title, TimeSpan.FromSeconds(_seconds));

    private string Code
    {
        get
        {
            var title = string.IsNullOrEmpty(_title) ? "" : $", title: \"{_title}\"";
            var duration = _seconds == 4 ? "" : $", duration: TimeSpan.FromSeconds({_seconds})";
            return $"@inject HelixToastService Toasts\n\nToasts.Show(\"{_message}\", HelixSeverity.{_severity}{title}{duration});";
        }
    }

    private const string ShortcutsCode = """
        Toasts.Info("3 new messages");
        Toasts.Success("Changes saved", "Saved");
        Toasts.Warning("Your session expires in 5 minutes");
        Toasts.Error("Can't reach the server", "Error");

        // Position: <HelixProvider ToastPosition="HelixToastPosition.TopCenter">
        """;

    private static readonly ApiRow[] Api =
    [
        new("Show(message, severity, title, duration)", "Guid", null, "Shows a toast. TimeSpan.Zero = until closed."),
        new("Info / Success / Warning / Error", "Guid", null, "Shortcuts."),
        new("Dismiss(id)", "void", null, "Closes a toast."),
        new("DefaultDuration", "TimeSpan", null, "4 s by default, set through AddHelix(t => ...)."),
        new("HelixProvider.ToastPosition", "HelixToastPosition", null, "Screen corner."),
        new("—", "", "--helix-toast-bg", "Toast background."),
    ];
}
