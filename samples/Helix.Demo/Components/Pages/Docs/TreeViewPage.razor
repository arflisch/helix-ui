@page "/components/treeview"
@inject HelixToastService Toasts

<DemoPage Title="TreeView" Description="A hierarchy, as a list (explorer) or a diagram (org chart). Same data, same options: expanding, selection, node template. From the keyboard: ↑ ↓ to move, → to expand or enter, ← to collapse or go up, Enter to select.">
    <Example WpfCode="@Wpf1" Title="List (explorer)" Code="@ListCode">
        <div class="grid-2">
            <HelixCard Padding="8px">
                <HelixTreeView TItem="Node" Items="Sites" ChildrenOf="n => n.Children" ItemText="n => n.Name" ItemIcon="n => n.Icon"
                              ItemKey="n => n.Name" @bind-SelectedItem="_selected" ExpandDepth="2" />
            </HelixCard>
            <HelixCard Title="@(_selected?.Name ?? "Nothing selected")" Subtitle="@_selected?.Role">
                <p class="muted" style="margin:0">@(_selected is null ? "Choose an item in the tree." : $"{_selected.Children?.Count ?? 0} item(s) below.")</p>
            </HelixCard>
        </div>
    </Example>

    <Example WpfCode="@Wpf2" Title="Diagram (org chart)" Description="Click the badge under a node to expand or collapse it." Code="@DiagramCode">
        <HelixTreeView TItem="Node" Items="Org" ChildrenOf="n => n.Children" ItemText="n => n.Name" ItemDescription="n => n.Role"
                      ItemKey="n => n.Name" Layout="HelixTreeLayout.Diagram" ExpandDepth="2"
                      SelectedItemChanged="n => Toasts.Info(n?.Role ?? string.Empty, n?.Name)" AriaLabel="Org chart">
        </HelixTreeView>
    </Example>

    <ApiTable Title="HelixTreeView" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <!-- No template: ChildrenPath + TextPath (and IconPath, DescriptionPath) are enough -->
        <helix:HelixTreeView ItemsSource="{Binding Folders}" ChildrenPath="Children" TextPath="Name"
                           IconPath="Icon" ExpandDepth="2" SelectedItemChanged="OnSelected" />

        <!-- Or your usual HierarchicalDataTemplate -->
        <helix:HelixTreeView ItemsSource="{Binding Folders}">
            <helix:HelixTreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" />
                </HierarchicalDataTemplate>
            </helix:HelixTreeView.ItemTemplate>
        </helix:HelixTreeView>
        """;

    private const string Wpf2 = """
        <helix:HelixTreeView Layout="Diagram" ItemsSource="{Binding Organization}"
                           ChildrenPath="Reports" TextPath="Name" DescriptionPath="Role" ExpandDepth="3" />
        """;

    public sealed record Node(string Name, string? Role = null, string? Icon = null, List<Node>? Children = null);

    private static readonly Node[] Sites =
    [
        new("France", "Country", "layout", [
            new("Auvergne-Rhône-Alpes", "Region", "columns", [
                new("Lyon plant", "Industrial site", "zap", [new("Meter 41", "Meter", "settings"), new("Meter 42", "Meter", "settings")]),
                new("Grenoble warehouse", "Logistics", "download"),
            ]),
            new("Île-de-France", "Region", "columns", [
                new("Paris head office", "Offices", "user"),
                new("Saclay data center", "IT", "lock", [new("Room A", "Room"), new("Room B", "Room")]),
            ]),
        ]),
        new("Belgium", "Country", "layout", [new("Brussels office", "Offices", "user")]),
    ];

    private static readonly Node[] Org =
    [
        new("Ada Lovelace", "Chief executive", Children: [
            new("Alan Turing", "Operations", Children: [new("Grace Hopper", "Dispatching"), new("Ken Thompson", "On call")]),
            new("Margaret Hamilton", "Data", Children: [new("Barbara Liskov", "Forecasting"), new("Dennis Ritchie", "Platform"), new("Linus Torvalds", "Tooling")]),
            new("Katherine Johnson", "Finance"),
        ]),
    ];

    private Node? _selected;

    private const string ListCode = """
        <HelixTreeView Items="sites" ChildrenOf="n => n.Children" ItemText="n => n.Name" ItemIcon="n => n.Icon"
                      @bind-SelectedItem="selected" ExpandDepth="2" />
        """;

    private const string DiagramCode = """
        <HelixTreeView Items="org" ChildrenOf="n => n.Children" ItemText="n => n.Name" ItemDescription="n => n.Role"
                      Layout="HelixTreeLayout.Diagram" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Items / ChildrenOf", "IEnumerable<T> / Func<T, IEnumerable<T>?>", null, "The roots and an item's children."),
        new("Layout", "HelixTreeLayout", null, "List (explorer) or Diagram (org chart)."),
        new("ItemText / ItemIcon / ItemDescription", "Func<T, string?>", null, "Label, icon, second line (diagram)."),
        new("ItemTemplate", "RenderFragment<T>", null, "Free content of a node."),
        new("SelectedItem / ItemKey", "T? / Func<T, object>", null, "Selection (@bind-SelectedItem); identity of an item."),
        new("ExpandDepth / ShowLines", "int / bool", "--helix-tree-line", "Levels expanded at first; guide lines."),
    ];
}
