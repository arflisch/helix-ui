@page "/components/treeview"
@inject HelixToastService Toasts

<DemoPage Title="TreeView" Description="Une hiérarchie, en liste (explorateur) ou en diagramme (organigramme). Mêmes données, mêmes options : dépliage, sélection, modèle de nœud. Au clavier : ↑ ↓ pour se déplacer, → pour déplier ou entrer, ← pour replier ou remonter, Entrée pour sélectionner.">
    <Example WpfCode="@Wpf1" Title="Liste (explorateur)" Code="@ListCode">
        <div class="grid-2">
            <HelixCard Padding="8px">
                <HelixTreeView TItem="Node" Items="Sites" ChildrenOf="n => n.Children" ItemText="n => n.Name" ItemIcon="n => n.Icon"
                              ItemKey="n => n.Name" @bind-SelectedItem="_selected" ExpandDepth="2" />
            </HelixCard>
            <HelixCard Title="@(_selected?.Name ?? "Aucune sélection")" Subtitle="@_selected?.Role">
                <p class="muted" style="margin:0">@(_selected is null ? "Choisissez un élément dans l'arborescence." : $"{_selected.Children?.Count ?? 0} élément(s) en dessous.")</p>
            </HelixCard>
        </div>
    </Example>

    <Example WpfCode="@Wpf2" Title="Diagramme (organigramme)" Description="Cliquez sur le badge sous un nœud pour le déplier ou le replier." Code="@DiagramCode">
        <HelixTreeView TItem="Node" Items="Org" ChildrenOf="n => n.Children" ItemText="n => n.Name" ItemDescription="n => n.Role"
                      ItemKey="n => n.Name" Layout="HelixTreeLayout.Diagram" ExpandDepth="2"
                      SelectedItemChanged="n => Toasts.Info(n?.Role ?? string.Empty, n?.Name)" AriaLabel="Organigramme">
        </HelixTreeView>
    </Example>

    <ApiTable Title="HelixTreeView" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <!-- Sans template : ChildrenPath + TextPath (et IconPath, DescriptionPath) suffisent -->
        <helix:HelixTreeView ItemsSource="{Binding Folders}" ChildrenPath="Children" TextPath="Name"
                           IconPath="Icon" ExpandDepth="2" SelectedItemChanged="OnSelected" />

        <!-- Ou votre HierarchicalDataTemplate habituel -->
        <helix:HelixTreeView ItemsSource="{Binding Folders}">
            <helix:HelixTreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                    <TextBlock Text="{Binding Name}" />
                </HierarchicalDataTemplate>
            </helix:HelixTreeView.ItemTemplate>
        </helix:HelixTreeView>
        """;

    private const string Wpf2 = """
        <helix:HelixTreeView Layout="Diagram" ItemsSource="{Binding Organization}"
                           ChildrenPath="Reports" TextPath="Name" DescriptionPath="Role" ExpandDepth="3" />
        """;

    public sealed record Node(string Name, string? Role = null, string? Icon = null, List<Node>? Children = null);

    private static readonly Node[] Sites =
    [
        new("France", "Pays", "layout", [
            new("Auvergne-Rhône-Alpes", "Région", "columns", [
                new("Usine de Lyon", "Site industriel", "zap", [new("Compteur 41", "Compteur", "settings"), new("Compteur 42", "Compteur", "settings")]),
                new("Entrepôt de Grenoble", "Logistique", "download"),
            ]),
            new("Île-de-France", "Région", "columns", [
                new("Siège Paris", "Bureaux", "user"),
                new("Data center Saclay", "Informatique", "lock", [new("Salle A", "Salle"), new("Salle B", "Salle")]),
            ]),
        ]),
        new("Belgique", "Pays", "layout", [new("Agence Bruxelles", "Bureaux", "user")]),
    ];

    private static readonly Node[] Org =
    [
        new("Ada Lovelace", "Directrice générale", Children: [
            new("Alan Turing", "Exploitation", Children: [new("Grace Hopper", "Dispatching"), new("Ken Thompson", "Astreinte")]),
            new("Margaret Hamilton", "Data", Children: [new("Barbara Liskov", "Prévisions"), new("Dennis Ritchie", "Plateforme"), new("Linus Torvalds", "Outillage")]),
            new("Katherine Johnson", "Finance"),
        ]),
    ];

    private Node? _selected;

    private const string ListCode = """
        <HelixTreeView Items="sites" ChildrenOf="n => n.Children" ItemText="n => n.Name" ItemIcon="n => n.Icon"
                      @bind-SelectedItem="selected" ExpandDepth="2" />
        """;

    private const string DiagramCode = """
        <HelixTreeView Items="org" ChildrenOf="n => n.Children" ItemText="n => n.Name" ItemDescription="n => n.Role"
                      Layout="HelixTreeLayout.Diagram" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Items / ChildrenOf", "IEnumerable<T> / Func<T, IEnumerable<T>?>", null, "Les racines et les enfants d'un élément."),
        new("Layout", "HelixTreeLayout", null, "List (explorateur) ou Diagram (organigramme)."),
        new("ItemText / ItemIcon / ItemDescription", "Func<T, string?>", null, "Libellé, icône, seconde ligne (diagramme)."),
        new("ItemTemplate", "RenderFragment<T>", null, "Contenu libre d'un nœud."),
        new("SelectedItem / ItemKey", "T? / Func<T, object>", null, "Sélection (@bind-SelectedItem) ; identité d'un élément."),
        new("ExpandDepth / ShowLines", "int / bool", "--helix-tree-line", "Niveaux dépliés au départ ; lignes de guidage."),
    ];
}
