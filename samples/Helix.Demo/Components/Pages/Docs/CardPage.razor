@page "/components/card"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="Card" Description="Container with title, subtitle, actions area and footer. Border or shadow, hover effect.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <HelixCard Title="@_title" Subtitle="@_subtitle" Elevated="_elevated" Hoverable="_hoverable" Padding="@Padding"
                      Background="@_bg" Style="width:100%;max-width:380px">
                <Actions>
                    @if (_actions)
                    {
                        <HelixBadge Color="success" Dot="true">Active</HelixBadge>
                    }
                </Actions>
                <ChildContent>The card content. Anything you want: text, forms, lists…</ChildContent>
                <Footer>
                    @if (_footer)
                    {
                        <HelixButton Variant="HelixVariant.Ghost" Color="neutral" Size="HelixSize.Sm">Cancel</HelixButton>
                        <HelixButton Size="HelixSize.Sm">Confirm</HelixButton>
                    }
                </Footer>
            </HelixCard>
        </Preview>
        <Controls>
            <HelixTextField Label="Title" @bind-Value="_title" />
            <HelixTextField Label="Subtitle" @bind-Value="_subtitle" />
            <HelixSlider Label="Padding" @bind-Value="_padding" Min="8" Max="36" Format="@(v => $"{v} px")" />
            <ColorPicker Label="Background" @bind-Value="_bg" Colors="@(["#fafaf9", "#eef2ff", "#ecfdf5", "#18181b"])" />
            <HelixSwitch Label="Elevated" @bind-Checked="_elevated" Size="HelixSize.Sm" />
            <HelixSwitch Label="Hoverable" @bind-Checked="_hoverable" Size="HelixSize.Sm" />
            <HelixSwitch Label="Actions" @bind-Checked="_actions" Size="HelixSize.Sm" />
            <HelixSwitch Label="Footer" @bind-Checked="_footer" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Statistics" Code="@StatsCode">
        <div class="grid-3">
            @foreach (var (label, value, delta, up) in Stats)
            {
                <HelixCard Hoverable="true">
                    <p class="muted" style="margin:0 0 8px;font-size:13px">@label</p>
                    <div class="row" style="justify-content:space-between">
                        <span style="font-size:26px;font-weight:700;letter-spacing:-.02em;color:var(--helix-text)">@value</span>
                        <HelixBadge Color="@(up ? "success" : "danger")">@delta</HelixBadge>
                    </div>
                </HelixCard>
            }
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixCard Title="Today's production" Subtitle="Updated 2 min ago" IsElevated="True"
                       Padding="20" CornerRadius="16">
            <helix:HelixCard.Actions>
                <helix:HelixButton Icon="refresh" Variant="Ghost" Tone="Neutral" Padding="0" Width="32" />
            </helix:HelixCard.Actions>
            <TextBlock Text="Card content" />
            <helix:HelixCard.Footer>
                <helix:HelixButton Content="Export" Size="Sm" />
            </helix:HelixCard.Footer>
        </helix:HelixCard>
        """;

    private const string Wpf2 = """
        <UniformGrid Columns="3">
            <helix:HelixCard><helix:HelixStat Label="Production" Value="1,284" Unit="MWh" Delta="12.5" /></helix:HelixCard>
            <helix:HelixCard><helix:HelixStat Label="Availability" Value="96.4" Unit="%" Delta="0.8" /></helix:HelixCard>
            <helix:HelixCard><helix:HelixStat Label="Incidents" Value="3" Delta="-40" HigherIsBetter="False" /></helix:HelixCard>
        </UniformGrid>
        """;

    private static readonly (string, string, string, bool)[] Stats =
        [("Revenue", "€48,290", "+12.4%", true), ("Customers", "1,284", "+3.1%", true), ("Churn", "2.4%", "+0.3%", false)];

    private string? _title = "Pro subscription";
    private string? _subtitle = "Renewed on the 1st of every month";
    private string? _bg;
    private double _padding = 20;
    private bool _elevated, _hoverable, _actions = true, _footer = true;

    private string? Padding => _padding == 20 ? null : $"{N(_padding)}px";

    private string Code
    {
        get
        {
            var actions = _actions ? "\n    <Actions><HelixBadge Color=\"success\" Dot>Active</HelixBadge></Actions>" : "";
            var footer = _footer ? "\n    <Footer>\n        <HelixButton Variant=\"HelixVariant.Ghost\">Cancel</HelixButton>\n        <HelixButton>Confirm</HelixButton>\n    </Footer>" : "";
            var content = actions.Length + footer.Length > 0 ? "\n    <ChildContent>The content…</ChildContent>" : "The content…";
            var close = actions.Length + footer.Length > 0 ? "\n" : "";
            return $"<HelixCard{A("Title", _title)}{A("Subtitle", _subtitle)}{A("Padding", Padding)}{A("Background", _bg)}{B("Elevated", _elevated)}{B("Hoverable", _hoverable)}>{actions}{content}{footer}{close}</HelixCard>";
        }
    }

    private const string StatsCode = """
        <HelixCard Hoverable>
            <p>Revenue</p>
            <strong>€48,290</strong>
            <HelixBadge Color="success">+12.4%</HelixBadge>
        </HelixCard>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Title / Subtitle", "string", null, "Simple header."),
        new("Actions", "RenderFragment", null, "Content on the right of the title."),
        new("Header", "RenderFragment", null, "Replaces the whole header."),
        new("Footer", "RenderFragment", null, "Footer with a lightly tinted background."),
        new("Elevated", "bool", null, "Shadow instead of the border."),
        new("Hoverable", "bool", null, "Lifts on hover."),
        new("Padding", "string", "--helix-card-padding", "Inner spacing."),
        new("Radius", "string", "--helix-card-radius", "Corner radius."),
        new("Background", "string", "--helix-card-bg", "Background."),
        new("BorderColor", "string", "--helix-card-border", "Border."),
    ];
}
