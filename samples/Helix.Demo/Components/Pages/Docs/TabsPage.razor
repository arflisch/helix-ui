@page "/components/tabs"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="Tabs" Description="Tabs in three styles. Declare child HelixTabs: that's all.">
    <Playground WpfCode="@Wpf1" Code="@Code" StageStyle="align-items:start">
        <Preview>
            <div style="width:100%;max-width:520px">
                <HelixTabs Variant="_variant" Color="@_color" @bind-ActiveIndex="_active">
                    <HelixTab Title="Account" Icon="@(_icons ? "user" : null)">
                        <p class="muted" style="margin:0">Manage your name, your email and your profile photo.</p>
                    </HelixTab>
                    <HelixTab Title="Notifications" Icon="@(_icons ? "bell" : null)">
                        <div class="stack">
                            <HelixSwitch @bind-Checked="_n1" Label="Emails" />
                            <HelixSwitch @bind-Checked="_n2" Label="Push" />
                        </div>
                    </HelixTab>
                    <HelixTab Title="Security" Icon="@(_icons ? "lock" : null)">
                        <p class="muted" style="margin:0">Password and two-factor authentication.</p>
                    </HelixTab>
                    <HelixTab Title="Billing" Disabled="true" />
                </HelixTabs>
            </div>
        </Preview>
        <Controls>
            <Choice TEnum="HelixTabsVariant" Label="Variant" @bind-Value="_variant" />
            <ColorPicker Label="Color" @bind-Value="_color" />
            <HelixSwitch Label="Icons" @bind-Checked="_icons" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixTabs Variant="Underline" SelectedIndex="{Binding Tab}" Accent="#8B5CF6">
            <helix:HelixTab Header="Overview" Icon="layout">
                <TextBlock Text="Overview content" />
            </helix:HelixTab>
            <helix:HelixTab Header="Activity" Icon="bell" />
            <helix:HelixTab Header="Settings" Icon="settings" IsEnabled="False" />
        </helix:HelixTabs>
        <!-- Variant: Underline, Pills or Segmented -->
        """;

    private HelixTabsVariant _variant;
    private string? _color;
    private bool _icons = true, _n1 = true, _n2;
    private int _active;

    private string Code
    {
        get
        {
            string Icon(string name) => _icons ? $" Icon=\"{name}\"" : "";
            return $"""
                <HelixTabs{A("Variant", _variant, HelixTabsVariant.Underline)}{A("Color", _color)} @bind-ActiveIndex="active">
                    <HelixTab Title="Account"{Icon("user")}>…</HelixTab>
                    <HelixTab Title="Notifications"{Icon("bell")}>…</HelixTab>
                    <HelixTab Title="Security"{Icon("lock")}>…</HelixTab>
                    <HelixTab Title="Billing" Disabled />
                </HelixTabs>
                """;
        }
    }

    private static readonly ApiRow[] Api =
    [
        new("Variant", "HelixTabsVariant", null, "Underline, Pills or Segmented."),
        new("ActiveIndex", "int", null, "Active tab (@bind-ActiveIndex)."),
        new("Color", "string", "--helix-tabs-color", "Color of the indicator / active tab."),
        new("HelixTab.Title / Icon / Disabled", "string / string / bool", null, "Defines a tab; its content is the ChildContent."),
    ];
}
