@page "/components/barlist"
@using System.Globalization
@inject HelixToastService Toasts

<DemoPage Title="BarList" Description="Ranking as horizontal bars: the label in the bar, the value on the right. Ideal for “top N” (sites, customers, causes). A single color: the bars compare one measure.">
    <Example WpfCode="@Wpf1" Title="Top sites" Code="@Code">
        <div class="grid-2">
            <HelixCard Title="Consumption per site" Subtitle="This week">
                <HelixBarList Items="Sites" Unit="MWh" ValueFormat="N0" LabelHeader="Site" ValueHeader="MWh" Culture="English"
                             OnItemClick="@(i => Toasts.Info($"{i.Value:N0} MWh", i.Label))" />
            </HelixCard>
            <HelixCard Title="Rejection causes" Subtitle="Last 30 days">
                <HelixBarList Items="Causes" Limit="null" Color="#eb6834" ValueFormat="0" Culture="English" />
            </HelixCard>
        </div>
    </Example>

    <ApiTable Title="HelixBarList" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixBarList x:Name="Sites" Limit="5" LabelHeader="Site" ValueHeader="Visits" Unit="k" ItemClick="OnSiteClick" />

        // Code-behind
        Sites.Items =
        [
            new HelixBarItem("helix-ui.dev", 128.4) { Icon = "external" },
            new HelixBarItem("github.com", 82.1),
            new HelixBarItem("google.com", 64.5),
        ];

        private void OnSiteClick(object sender, RoutedEventArgs e) =>
            Open(((HelixEventArgs<HelixBarItem>)e).Value.Label);
        """;

    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-GB");

    private static readonly HelixBarItem[] Sites =
    [
        new("Lyon plant", 1840) { Icon = "zap" }, new("Lille warehouse", 920), new("Paris head office", 610),
        new("Marseille data center", 2410) { Icon = "settings" }, new("Nantes workshop", 455), new("Bordeaux office", 180),
        new("Rennes office", 140), new("Strasbourg office", 120),
    ];

    private static readonly HelixBarItem[] Causes =
    [
        new("Submitted too late", 14), new("Insufficient capacity", 9), new("Price out of bounds", 6), new("Duplicate", 3),
    ];

    private const string Code = """
        <HelixBarList Items="sites" Unit="MWh" ValueFormat="N0" Limit="5" OnItemClick="Open" />

        // new HelixBarItem("Lyon plant", 1840) { Icon = "zap", Href = "/sites/lyon" }
        """;

    private static readonly ApiRow[] Api =
    [
        new("Items", "IEnumerable<HelixBarItem>", null, "HelixBarItem(Label, Value) { Icon, Href }."),
        new("Sort / Limit", "bool / int?", null, "Descending sort (true); rows shown before “Show all” (5, null = all)."),
        new("MaxValue", "double?", null, "Value of a full bar (otherwise the largest)."),
        new("ValueFormat / Unit", "string", null, "Format and unit of the values."),
        new("LabelHeader / ValueHeader", "string", null, "Column headers."),
        new("Color / OnItemClick", "string / EventCallback<HelixBarItem>", "--helix-barlist-color", "Bar color; click on a row."),
    ];
}
