@page "/components/pagination"

<DemoPage Title="Pagination" Description="Self-contained page navigation: for a list of cards, search results or a gallery. Long ranges collapse around the current page.">
    <Example WpfCode="@Wpf1" Title="Variants" Code="@Code">
        <div class="stack" style="gap:22px">
            <HelixPagination @bind-Page="_page" TotalItems="243" PageSize="10" ShowInfo="true" />
            <HelixPagination @bind-Page="_page" Count="25" ShowLabels="true" />
            <HelixPagination @bind-Page="_page" Count="25" Compact="true" />
        </div>
    </Example>

    <ApiTable Title="HelixPagination" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixPagination Page="{Binding Page}" TotalItems="87" PageSize="10" ShowInfo="True" />
        <helix:HelixPagination Page="{Binding Page}" Count="20" ShowLabels="True" />
        <helix:HelixPagination Page="{Binding Page}" Count="20" IsCompact="True" />
        """;

    private int _page = 4;

    private const string Code = """
        <HelixPagination @bind-Page="page" TotalItems="243" PageSize="10" ShowInfo />
        <HelixPagination @bind-Page="page" Count="25" ShowLabels />
        <HelixPagination @bind-Page="page" Count="25" Compact />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Page", "int", null, "Current page, starting at 1 (@bind-Page)."),
        new("Count · TotalItems + PageSize", "int", null, "Number of pages, or computed from the total."),
        new("ShowInfo / ShowLabels / Compact", "bool", null, "“31–40 of 243”; Previous/Next texts; smaller version."),
        new("Color", "string", "--helix-pagination-color", "Color of the current page."),
    ];
}
