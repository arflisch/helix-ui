@page "/components/accordion"

<DemoPage Title="Accordion" Description="Collapsible sections for an FAQ, advanced settings or optional detail. Smooth height animation; closed content can't be reached from the keyboard.">
    <Example WpfCode="@Wpf1" Title="FAQ" Code="@Code">
        <div class="grid-2">
            <HelixAccordion>
                <HelixAccordionItem Title="How is the imbalance computed?" Icon="info" Expanded="true">
                    It is the gap between production and consumption over each quarter hour, measured by the grid operator.
                </HelixAccordionItem>
                <HelixAccordionItem Title="When is a request rejected?" Icon="warning">
                    When it arrives after the submission deadline, exceeds the available capacity or falls outside the price bounds.
                </HelixAccordionItem>
                <HelixAccordionItem Title="Can I export the data?" Icon="download">
                    Yes, from every table: Actions menu, then “Export to CSV”.
                </HelixAccordionItem>
                <HelixAccordionItem Title="Administrators only" Disabled="true" />
            </HelixAccordion>
            <HelixAccordion Multiple="true" Flush="true">
                <HelixAccordionItem Title="Notifications" Subtitle="Email, push, SMS">
                    <ChildContent>
                        <div class="stack">
                            <HelixSwitch Label="Email" Checked="true" />
                            <HelixSwitch Label="Push" />
                        </div>
                    </ChildContent>
                    <Extra><HelixBadge Color="success">2 active</HelixBadge></Extra>
                </HelixAccordionItem>
                <HelixAccordionItem Title="Advanced settings" Subtitle="For experienced users">
                    <HelixNumberField Label="Retry delay" Value="15" Unit="min" Min="5" Max="60" Step="5" />
                </HelixAccordionItem>
            </HelixAccordion>
        </div>
    </Example>

    <ApiTable Title="HelixAccordion and HelixAccordionItem" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixAccordion>
            <helix:HelixAccordionItem Header="Delivery" Subtitle="Times and areas" Icon="download" IsExpanded="True">
                <TextBlock Text="Delivery in 48 h anywhere in France." TextWrapping="Wrap" />
            </helix:HelixAccordionItem>
            <helix:HelixAccordionItem Header="Returns" Icon="refresh">
                <TextBlock Text="30 days to change your mind." />
            </helix:HelixAccordionItem>
            <helix:HelixAccordionItem Header="Payment" Icon="lock">
                <helix:HelixAccordionItem.Extra>
                    <helix:HelixBadge Content="Secure" Tone="Success" />
                </helix:HelixAccordionItem.Extra>
                <TextBlock Text="Card, transfer or direct debit." />
            </helix:HelixAccordionItem>
        </helix:HelixAccordion>

        <!-- Several sections open at once, no frame -->
        <helix:HelixAccordion AllowMultiple="True" IsFlush="True"> … </helix:HelixAccordion>
        """;

    private const string Code = """
        <HelixAccordion>
            <HelixAccordionItem Title="How is the imbalance computed?" Icon="info" Expanded>…</HelixAccordionItem>
            <HelixAccordionItem Title="When is a request rejected?">…</HelixAccordionItem>
        </HelixAccordion>

        <HelixAccordion Multiple Flush>…</HelixAccordion>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Multiple", "bool", null, "Several sections open at once (otherwise only one)."),
        new("Flush", "bool", null, "No frame, only separators."),
        new("Item Title / Subtitle / Icon / Extra", "string / string / string / RenderFragment", null, "Section header, content on the right (badge…)."),
        new("Item Expanded / Disabled", "bool", null, "Open at first; disabled."),
    ];
}
