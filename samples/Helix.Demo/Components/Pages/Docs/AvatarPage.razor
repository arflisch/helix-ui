@page "/components/avatar"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="Avatar" Description="Initials computed from the name, with a stable color per person. Image, status and shape as you like.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <HelixAvatar Name="@_name" Size="_size" Status="_status" Color="@_color" Radius="@(_square ? "10px" : null)" />
        </Preview>
        <Controls>
            <HelixTextField Label="Name" @bind-Value="_name" />
            <Choice TEnum="HelixSize" Label="Size" @bind-Value="_size" />
            <Choice TEnum="HelixAvatarStatus" Label="Status" @bind-Value="_status" />
            <ColorPicker Label="Color (auto by default)" @bind-Value="_color" />
            <HelixSwitch Label="Rounded square" @bind-Checked="_square" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Automatic color" Description="Each name always gives the same color, with nothing to configure." Code="@AutoCode">
        <div class="row">
            @foreach (var name in Names)
            {
                <HelixTooltip Text="@name"><HelixAvatar Name="@name" /></HelixTooltip>
            }
        </div>
    </Example>

    <Example WpfCode="@Wpf3" Title="Group" Code="@GroupCode">
        <HelixAvatarGroup>
            @foreach (var name in Names.Take(5))
            {
                <HelixAvatar Name="@name" Size="HelixSize.Lg" />
            }
        </HelixAvatarGroup>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixAvatar DisplayName="Camille Martin" Size="Lg" Status="Online" />
        <helix:HelixAvatar DisplayName="Léo Bernard" Source="/Images/leo.jpg" />
        <helix:HelixAvatar DisplayName="Inès Petit" CornerRadius="10" Accent="#18181B" />
        """;

    private const string Wpf2 = """
        <!-- Without Accent, the color comes from the name: the same person always has the same color. -->
        <helix:HelixAvatar DisplayName="Camille Martin" />
        <helix:HelixAvatar DisplayName="Léo Bernard" />
        <helix:HelixAvatar DisplayName="Inès Petit" />
        """;

    private const string Wpf3 = """
        <helix:HelixAvatarGroup Max="3">
            <helix:HelixAvatar DisplayName="Camille Martin" />
            <helix:HelixAvatar DisplayName="Léo Bernard" />
            <helix:HelixAvatar DisplayName="Inès Petit" />
            <helix:HelixAvatar DisplayName="Hugo Robert" />
            <helix:HelixAvatar DisplayName="Chloé Richard" />
        </helix:HelixAvatarGroup>   <!-- shows 3 avatars + “+2” -->
        """;

    private static readonly string[] Names = ["Ada Lovelace", "Alan Turing", "Grace Hopper", "Linus Torvalds", "Margaret Hamilton", "Dennis Ritchie", "Barbara Liskov", "Ken Thompson"];

    private string? _name = "Grace Hopper";
    private HelixSize _size = HelixSize.Lg;
    private HelixAvatarStatus _status = HelixAvatarStatus.Online;
    private string? _color;
    private bool _square;

    private string Code =>
        $"<HelixAvatar{A("Name", _name)}{A("Size", _size, HelixSize.Md)}{A("Status", _status, HelixAvatarStatus.None)}{A("Color", _color)}{A("Radius", _square ? "10px" : null)} />";

    private const string AutoCode = """<HelixAvatar Name="Ada Lovelace" />""";

    private const string GroupCode = """
        <HelixAvatarGroup>
            <HelixAvatar Name="Ada Lovelace" Size="HelixSize.Lg" />
            <HelixAvatar Name="Alan Turing" Size="HelixSize.Lg" />
            <HelixAvatar Src="/img/grace.jpg" Name="Grace Hopper" Size="HelixSize.Lg" />
        </HelixAvatarGroup>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Name", "string", null, "Full name: initials, tooltip and automatic color."),
        new("Src", "string", null, "Image (replaces the initials)."),
        new("Size", "HelixSize", null, "Sm, Md or Lg."),
        new("Status", "HelixAvatarStatus", null, "Online, Away, Busy, Offline."),
        new("Color", "string", "--helix-avatar-color", "Replaces the automatic color."),
        new("Radius", "string", "--helix-avatar-radius", "Corner radius (round by default)."),
    ];
}
