@page "/components/donut"
@using System.Globalization
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="Donut" Description="A whole split into a few parts (6 at most; beyond that, the smallest are grouped into “Other”). Hover a part or the legend: the center shows its detail. To compare close values, prefer a BarList, which is more precise.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <div style="width:100%;max-width:560px">
                <HelixDonut Title="Production mix" Subtitle="Today" Items="Mix" Unit="MWh" ValueFormat="N0" Shape="_shape"
                           MaxParts="(int)_max" Thickness="_thickness" Culture="English" />
            </div>
        </Preview>
        <Controls>
            <Choice TEnum="HelixPartShape" Label="Shape" @bind-Value="_shape" />
            <HelixSlider Label="MaxParts" @bind-Value="_max" Min="3" Max="7" />
            <HelixSlider Label="Thickness" @bind-Value="_thickness" Min="6" Max="20" />
        </Controls>
    </Playground>

    <ApiTable Title="HelixDonut" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixDonut Title="Energy mix" Unit="GWh" MaxParts="6" CenterLabel="Total"
                        Items="{Binding Mix}" ItemClick="OnPartClick" />
        <helix:HelixDonut Shape="SegmentedBar" Items="{Binding Shares}" Unit="%" ValueFormat="0" />

        // ViewModel
        Mix = [new HelixPart("Nuclear", 312), new HelixPart("Hydro", 64), new HelixPart("Wind", 48, "series-3")];
        """;

    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-GB");

    private static readonly HelixPart[] Mix =
    [
        new("Nuclear", 980), new("Wind", 310), new("Hydro", 240), new("Solar", 160),
        new("Gas", 120), new("Bioenergy", 45), new("Coal", 12),
    ];

    private HelixPartShape _shape;
    private double _max = 6, _thickness = 12;

    private string Code =>
        $"<HelixDonut Title=\"Production mix\" Items=\"mix\" Unit=\"MWh\"{A("Shape", _shape, HelixPartShape.Donut)}{(_max == 6 ? "" : $" MaxParts=\"{N(_max)}\"")}{(_thickness == 12 ? "" : $" Thickness=\"{N(_thickness)}\"")} />\n\n// new HelixPart(\"Wind\", 310), new HelixPart(\"Solar\", 160, Color: \"warning\")…";

    private static readonly ApiRow[] Api =
    [
        new("Items", "IEnumerable<HelixPart>", null, "HelixPart(Label, Value, Color?); series palette colors by default."),
        new("Shape", "HelixPartShape", null, "Donut or SegmentedBar (segmented bar, easier to read at a glance)."),
        new("MaxParts / OtherLabel / Sort", "int / string / bool", null, "6 parts max, the rest in “Other”; descending sort."),
        new("CenterLabel / Unit / ValueFormat", "string", null, "Text under the total, unit, format."),
        new("Thickness / Size", "double / string", "--helix-donut-size", "Ring thickness; diameter."),
        new("ShowTableToggle / OnItemClick", "bool / EventCallback<HelixPart>", null, "Table view; click on a part."),
    ];
}
