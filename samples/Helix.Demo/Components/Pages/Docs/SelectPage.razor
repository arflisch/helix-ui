@page "/components/select"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="Select" Description="Typed dropdown list: pass any collection of objects and choose how to display them. Keyboard navigation (arrows, Enter, Escape).">
    <Playground WpfCode="@Wpf1" Code="@Code" StageStyle="align-items:start;padding-top:56px">
        <Preview>
            <div style="width:100%;max-width:320px">
                <HelixSelect TValue="Country" Items="Countries" @bind-Value="_country" ItemText="c => c.Name" Label="@_label" Placeholder="Choose a country"
                            Color="@_color" Disabled="_disabled" Hint="@(_country is null ? null : $"Code: {_country.Code}")" />
            </div>
        </Preview>
        <Controls>
            <HelixTextField Label="Label" @bind-Value="_label" />
            <ColorPicker Label="Color" @bind-Value="_color" />
            <HelixSwitch Label="Disabled" @bind-Checked="_disabled" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="With strings or enums" Code="@SimpleCode">
        <div class="grid-2">
            <HelixSelect Items="_sizes" @bind-Value="_size" Label="Size" />
            <HelixSelect Items="Enum.GetValues<HelixSeverity>()" @bind-Value="_severity" Label="Severity" />
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixSelect Label="Country" ItemsSource="{Binding Countries}" DisplayMemberPath="Name"
                         SelectedItem="{Binding Country}" Placeholder="Choose a country"
                         Hint="For billing" IsRequired="True" />
        """;

    private const string Wpf2 = """
        <helix:HelixSelect Label="Site">
            <ComboBoxItem Content="Lyon" />
            <ComboBoxItem Content="Grenoble" />
        </helix:HelixSelect>
        <helix:HelixSelect Label="Priority" ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" />

        // Priorities = Enum.GetValues<Priority>();
        """;

    public sealed record Country(string Code, string Name);

    private static readonly Country[] Countries =
    [
        new("FR", "France"), new("BE", "Belgium"), new("CH", "Switzerland"), new("CA", "Canada"),
        new("LU", "Luxembourg"), new("DE", "Germany"), new("ES", "Spain"), new("IT", "Italy"),
    ];

    private readonly string[] _sizes = ["Small", "Medium", "Large"];
    private Country? _country = Countries[0];
    private string? _size = "Medium";
    private HelixSeverity _severity = HelixSeverity.Success;
    private string? _label = "Country";
    private string? _color;
    private bool _disabled;

    private string Code => $"""
        <HelixSelect Items="countries" @bind-Value="country" ItemText="c => c.Name"{A("Label", _label)}{A("Color", _color)}{B("Disabled", _disabled)} />

        @code {"{"}
            private Country? country;
            private Country[] countries = [new("FR", "France"), new("BE", "Belgium")];
        {"}"}
        """;

    private const string SimpleCode = """
        <HelixSelect Items="sizes" @bind-Value="size" Label="Size" />
        <HelixSelect Items="Enum.GetValues<HelixSeverity>()" @bind-Value="severity" Label="Severity" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Items", "IEnumerable<T>", null, "The options, of any type."),
        new("Value", "T?", null, "Selected option (@bind-Value)."),
        new("ItemText", "Func<T, string>", null, "Text shown for an option (ToString by default)."),
        new("Label / Placeholder / Hint", "string", null, "Texts."),
        new("—", "", "--helix-select-menu-bg", "Background of the dropdown menu."),
        new("Prefix / Suffix", "RenderFragment", null, "Content at the start / end of the field (icon, sign, unit…). Same slots on every field."),
        new("Hint / Error", "string", null, "Hint under the field, or an error that replaces it; linked to the field for screen readers (aria-describedby)."),
        new("Required", "bool", null, "Asterisk after the label and required attribute."),
        new("Color / Radius / Background / BorderColor", "string", "--helix-input-*", "Same look on every field; defaults through Defaults.Field."),
    ];
}
