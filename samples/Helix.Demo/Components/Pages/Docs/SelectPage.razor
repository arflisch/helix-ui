@page "/components/select"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="Select" Description="Liste déroulante typée : passez n'importe quelle collection d'objets et choisissez comment les afficher. Navigation au clavier (flèches, Entrée, Échap).">
    <Playground WpfCode="@Wpf1" Code="@Code" StageStyle="align-items:start;padding-top:56px">
        <Preview>
            <div style="width:100%;max-width:320px">
                <HelixSelect TValue="Country" Items="Countries" @bind-Value="_country" ItemText="c => c.Name" Label="@_label" Placeholder="Choisir un pays"
                            Color="@_color" Disabled="_disabled" Hint="@(_country is null ? null : $"Code : {_country.Code}")" />
            </div>
        </Preview>
        <Controls>
            <HelixTextField Label="Label" @bind-Value="_label" />
            <ColorPicker Label="Color" @bind-Value="_color" />
            <HelixSwitch Label="Disabled" @bind-Checked="_disabled" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Avec des chaînes ou des enums" Code="@SimpleCode">
        <div class="grid-2">
            <HelixSelect Items="_sizes" @bind-Value="_size" Label="Taille" />
            <HelixSelect Items="Enum.GetValues<HelixSeverity>()" @bind-Value="_severity" Label="Sévérité" />
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixSelect Label="Pays" ItemsSource="{Binding Countries}" DisplayMemberPath="Name"
                         SelectedItem="{Binding Country}" Placeholder="Choisir un pays"
                         Hint="Pour la facturation" IsRequired="True" />
        """;

    private const string Wpf2 = """
        <helix:HelixSelect Label="Site">
            <ComboBoxItem Content="Lyon" />
            <ComboBoxItem Content="Grenoble" />
        </helix:HelixSelect>
        <helix:HelixSelect Label="Priorité" ItemsSource="{Binding Priorities}" SelectedItem="{Binding Priority}" />

        // Priorities = Enum.GetValues<Priority>();
        """;

    public sealed record Country(string Code, string Name);

    private static readonly Country[] Countries =
    [
        new("FR", "France"), new("BE", "Belgique"), new("CH", "Suisse"), new("CA", "Canada"),
        new("LU", "Luxembourg"), new("DE", "Allemagne"), new("ES", "Espagne"), new("IT", "Italie"),
    ];

    private readonly string[] _sizes = ["Petit", "Moyen", "Grand"];
    private Country? _country = Countries[0];
    private string? _size = "Moyen";
    private HelixSeverity _severity = HelixSeverity.Success;
    private string? _label = "Pays";
    private string? _color;
    private bool _disabled;

    private string Code => $"""
        <HelixSelect Items="countries" @bind-Value="country" ItemText="c => c.Name"{A("Label", _label)}{A("Color", _color)}{B("Disabled", _disabled)} />

        @code {"{"}
            private Country? country;
            private Country[] countries = [new("FR", "France"), new("BE", "Belgique")];
        {"}"}
        """;

    private const string SimpleCode = """
        <HelixSelect Items="sizes" @bind-Value="size" Label="Taille" />
        <HelixSelect Items="Enum.GetValues<HelixSeverity>()" @bind-Value="severity" Label="Sévérité" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Items", "IEnumerable<T>", null, "Les options, de n'importe quel type."),
        new("Value", "T?", null, "Option sélectionnée (@bind-Value)."),
        new("ItemText", "Func<T, string>", null, "Texte affiché pour une option (ToString par défaut)."),
        new("Label / Placeholder / Hint", "string", null, "Textes."),
        new("—", "", "--helix-select-menu-bg", "Fond du menu déroulant."),
        new("Prefix / Suffix", "RenderFragment", null, "Contenu au début / à la fin du champ (icône, signe, unité…). Même slots sur tous les champs."),
        new("Hint / Error", "string", null, "Aide sous le champ, ou erreur qui la remplace ; reliées au champ pour les lecteurs d'écran (aria-describedby)."),
        new("Required", "bool", null, "Astérisque après le libellé et attribut required."),
        new("Color / Radius / Background / BorderColor", "string", "--helix-input-*", "Même apparence sur tous les champs ; valeurs par défaut via Defaults.Field."),
    ];
}
