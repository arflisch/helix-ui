@page "/components/dashboard"
@using System.Globalization
@using System.Text.Json
@inject IJSRuntime JS
@inject HelixToastService Toasts

<DemoPage Title="Dashboard" Description="A dashboard each user arranges: drag the tiles, change their width, hide them and bring them back. The layout is a plain object you save wherever you want; here in the browser (localStorage), it survives a reload.">
    <section class="demo-section">
        <HelixDashboard Title="Today's operations" Columns="4" Layout="_layout" LayoutChanged="SaveLayout" @bind-Editing="_editing">
            <Toolbar>
                <HelixBadge Color="success" Dot="true">Live data</HelixBadge>
            </Toolbar>
            <ChildContent>
                <HelixDashboardTile Id="imbalance" Plain="true">
                    <HelixStat Label="Current imbalance" Value="182" Unit="MW" Delta="-24" DeltaLabel="vs 1 h ago" HigherIsBetter="false"
                              Trend="DemoData.Trend(1, 14, 260, -6)" Icon="zap" Culture="English" />
                </HelixDashboardTile>
                <HelixDashboardTile Id="reserve" Plain="true">
                    <HelixStat Label="Activated reserve" Value="350" Unit="MW" Delta="50" DeltaLabel="vs yesterday" Trend="DemoData.Trend(2, 14, 280, 5)" TrendColor="#1baf7a" Icon="trending-up" Culture="English" />
                </HelixDashboardTile>
                <HelixDashboardTile Id="price" Plain="true">
                    <HelixStat Label="Average price" Value="91.4" Format="0.0" Unit="€/MWh" Delta="3.2" DeltaFormat="+0.0 '%';-0.0 '%'" DeltaLabel="vs yesterday" HigherIsBetter="false"
                              Trend="DemoData.Trend(3, 14, 84, 0.6)" TrendColor="#eb6834" Icon="star" Culture="English" />
                </HelixDashboardTile>
                <HelixDashboardTile Id="rejected" Plain="true">
                    <HelixStat Label="Rejected requests" Value="3" Delta="0" DeltaLabel="stable" HigherIsBetter="false" Trend="DemoData.Trend(4, 14, 4, -0.05)" TrendColor="var(--helix-text-subtle)" Icon="danger" Culture="English" />
                </HelixDashboardTile>

                <HelixDashboardTile Id="chart" Title="Balancing" DefaultSpan="3" MinSpan="2">
                    <Actions><HelixBadge>MW</HelixBadge></Actions>
                    <ChildContent>
                        <HelixChart Height="240px" Unit="MW" YFormat="N0" ShowNow="true" ShowTableToggle="false" Culture="English">
                            <HelixChartSeries Name="Imbalance" Points="_imbalance" Type="HelixSeriesType.Area" />
                            <HelixChartSeries Name="Forecast" Points="_forecast" Dashed="true" />
                        </HelixChart>
                    </ChildContent>
                </HelixDashboardTile>

                <HelixDashboardTile Id="priorities" Title="Team priorities">
                    <HelixSortableList TItem="Priority" Items="_priorities" ItemsChanged="p => _priorities = p.ToList()" ItemKey="p => p.Id">
                        <ItemTemplate>
                            <div class="prio">
                                <span class="prio__title">@context.Title</span>
                                <span class="prio__owner">@context.Owner</span>
                            </div>
                        </ItemTemplate>
                    </HelixSortableList>
                </HelixDashboardTile>

                <HelixDashboardTile Id="heatmap" Title="Average imbalance per hour" DefaultSpan="4" MinSpan="2">
                    <HelixHeatmap Cells="_weekly" Diverging="true" Unit="MW" Format="N0" ColumnLabelEvery="3" CellHeight="24px" CellMinWidth="18px" Culture="English" />
                </HelixDashboardTile>
            </ChildContent>
        </HelixDashboard>
    </section>

    <section class="demo-section">
        <h2 class="demo-section__title">Saved layout</h2>
        <p class="demo-section__text">What <code>LayoutChanged</code> receives: the order, width and visibility of each tile. Reload the page: it is kept.</p>
        <CodeBlock Language="json" Code="@LayoutJson" />
        <CodeBlock Code="@Code" WpfCode="@WpfExample" />
    </section>

    <ApiTable Title="HelixDashboard and HelixDashboardTile" Rows="Api" />
</DemoPage>

@code {
    private const string WpfExample = """
        <helix:HelixDashboard Title="Operations" ColumnCount="3" IsEditing="{Binding Editing}" Layout="{Binding SavedLayout}">
            <helix:HelixDashboardTile TileId="kpi" IsPlain="True" DefaultSpan="3" CanHide="False">
                <UniformGrid Columns="3"> … </UniformGrid>
            </helix:HelixDashboardTile>
            <helix:HelixDashboardTile TileId="load" Title="Load" DefaultSpan="2" MinSpan="1" MaxSpan="3">
                <helix:HelixChart … />
            </helix:HelixDashboardTile>
            <helix:HelixDashboardTile TileId="team" Title="Team" />
        </helix:HelixDashboard>

        // Layout (IReadOnlyList<HelixTileState>) is updated on every change: save it.
        """;

    private const string StorageKey = "helix-demo-dashboard";
    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-GB");
    private static readonly JsonSerializerOptions Json = new() { WriteIndented = true };

    private readonly IReadOnlyList<HelixPoint> _imbalance = EnergyData.Imbalance(DateTime.Now);
    private readonly IReadOnlyList<HelixPoint> _forecast = EnergyData.Forecast(DateTime.Now);
    private readonly IReadOnlyList<HelixHeatCell> _weekly = DemoData.WeeklyImbalance();
    private List<Priority> _priorities = DemoData.Priorities();
    private IReadOnlyList<HelixTileState>? _layout;
    private bool _editing;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var json = await JS.InvokeAsync<string?>("localStorage.getItem", StorageKey);
        if (!string.IsNullOrEmpty(json))
        {
            try
            {
                _layout = JsonSerializer.Deserialize<List<HelixTileState>>(json);
                StateHasChanged();
            }
            catch (JsonException)
            {
                // Corrupted value: ignore it and keep the default layout.
            }
        }
    }

    private async Task SaveLayout(IReadOnlyList<HelixTileState> layout)
    {
        _layout = layout;
        await JS.InvokeVoidAsync("localStorage.setItem", StorageKey, JsonSerializer.Serialize(layout));
    }

    private string LayoutJson => _layout is null ? "// Default layout: click “Customize”." : JsonSerializer.Serialize(_layout, Json);

    private const string Code = """
        <HelixDashboard Title="Today's operations" Columns="4" Layout="layout" LayoutChanged="Save">
            <HelixDashboardTile Id="imbalance" Plain>
                <HelixStat Label="Current imbalance" Value="182" Unit="MW" Delta="-24" HigherIsBetter="false" Trend="trend" />
            </HelixDashboardTile>
            <HelixDashboardTile Id="chart" Title="Balancing" DefaultSpan="3" MinSpan="2">
                <HelixChart …>…</HelixChart>
            </HelixDashboardTile>
        </HelixDashboard>

        @code {
            private IReadOnlyList<HelixTileState>? layout;   // loaded from your database, localStorage…

            private Task Save(IReadOnlyList<HelixTileState> l) => store.SaveAsync(userId, l);
        }
        """;

    private static readonly ApiRow[] Api =
    [
        new("Columns", "int", "--helix-dashboard-cols", "Grid columns (4). Drops to 2, then 1 on small screens."),
        new("Layout / LayoutChanged", "IReadOnlyList<HelixTileState>", null, "Layout to restore / to save (Id, Span, Hidden)."),
        new("Editing", "bool", null, "Customization mode (@bind-Editing), otherwise through the “Customize” button."),
        new("Title / Toolbar / ShowToolbar", "string / RenderFragment / bool", null, "Bar above the grid."),
        new("Gap", "string", "--helix-dashboard-gap", "Space between tiles (16px)."),
        new("Tile Id / Title / Actions", "string / string / RenderFragment", null, "Stable identifier (for saving), title, actions."),
        new("Tile DefaultSpan / MinSpan / MaxSpan", "int", null, "Default width and allowed bounds."),
        new("Tile CanHide / Plain / MinHeight", "bool / bool / string", null, "Can be hidden; no frame (for a HelixStat); minimum height."),
    ];
}
