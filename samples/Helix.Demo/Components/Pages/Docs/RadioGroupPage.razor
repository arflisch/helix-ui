@page "/components/radiogroup"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="RadioGroup" Description="One choice among a few options, all visible. Three appearances: classic, cards (with description) or segmented. Real native radio buttons: the keyboard arrows work.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <div style="width:100%;max-width:560px">
                <HelixRadioGroup TValue="Plan" Items="Plans" @bind-Value="_plan" ItemText="p => p.Name" ItemDescription="@(_descriptions ? p => p.Description : null)"
                                Label="Plan" Appearance="_appearance" Horizontal="_horizontal" Color="@_color" />
            </div>
        </Preview>
        <Controls>
            <Choice TEnum="HelixRadioAppearance" Label="Appearance" @bind-Value="_appearance" />
            <ColorPicker Label="Color" @bind-Value="_color" />
            <HelixSwitch Label="Horizontal" @bind-Checked="_horizontal" Size="HelixSize.Sm" />
            <HelixSwitch Label="ItemDescription" @bind-Checked="_descriptions" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <ApiTable Title="HelixRadioGroup" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <!-- Appearance: Default (list), Cards or Segmented -->
        <helix:HelixRadioGroup Label="Plan" Appearance="Cards" Columns="3"
                             ItemsSource="{Binding Plans}" SelectedItem="{Binding Plan}"
                             Hint="Can be changed at any time." Accent="#8B5CF6" CornerRadius="14" />

        // ViewModel: title, description and icon per option
        Plans = [new HelixRadioOption("Starter", "Up to 3 sites", "star"),
                 new HelixRadioOption("Pro", "Unlimited sites", "zap"),
                 new HelixRadioOption("Enterprise", "SSO and dedicated support", "lock")];

        <!-- Or options written in XAML -->
        <helix:HelixRadioGroup Label="Delivery" SelectedIndex="0">
            <helix:HelixRadioItem Content="Standard" Description="3 to 5 days" />
            <helix:HelixRadioItem Content="Express" Description="Tomorrow" />
        </helix:HelixRadioGroup>
        """;

    public sealed record Plan(string Name, string Description);

    private static readonly Plan[] Plans =
    [
        new("Essential", "Up to 3 sites, 30 days of data"),
        new("Pro", "Unlimited sites, alerts, export"),
        new("Enterprise", "SSO, 99.9% SLA, dedicated support"),
    ];

    private Plan? _plan = Plans[1];
    private HelixRadioAppearance _appearance = HelixRadioAppearance.Cards;
    private string? _color;
    private bool _horizontal, _descriptions = true;

    private string Code =>
        $"<HelixRadioGroup Items=\"plans\" @bind-Value=\"plan\" ItemText=\"p => p.Name\"{(_descriptions ? " ItemDescription=\"p => p.Description\"" : "")} Label=\"Plan\"{A("Appearance", _appearance, HelixRadioAppearance.Default)}{B("Horizontal", _horizontal)}{A("Color", _color)} />";

    private static readonly ApiRow[] Api =
    [
        new("Items / Value", "IEnumerable<T> / T?", null, "The options and the choice (@bind-Value)."),
        new("ItemText / ItemDescription / ItemDisabled", "Func<T, …>", null, "Label, description, disabled option."),
        new("ItemTemplate", "RenderFragment<T>", null, "Free content of an option."),
        new("Appearance", "HelixRadioAppearance", null, "Default, Cards or Segmented."),
        new("Horizontal / Label / Hint", "bool / string / string", null, "Layout, title (legend), hint."),
        new("Color", "string", "--helix-radio-color", "Color of the choice."),
    ];
}
