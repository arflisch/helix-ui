@page "/components/radiogroup"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="RadioGroup" Description="Un choix parmi quelques options, toutes visibles. Trois apparences : classique, cartes (avec description) ou segmentée. Vraies cases radio natives : les flèches du clavier fonctionnent.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <div style="width:100%;max-width:560px">
                <HelixRadioGroup TValue="Plan" Items="Plans" @bind-Value="_plan" ItemText="p => p.Name" ItemDescription="@(_descriptions ? p => p.Description : null)"
                                Label="Formule" Appearance="_appearance" Horizontal="_horizontal" Color="@_color" />
            </div>
        </Preview>
        <Controls>
            <Choice TEnum="HelixRadioAppearance" Label="Appearance" @bind-Value="_appearance" />
            <ColorPicker Label="Color" @bind-Value="_color" />
            <HelixSwitch Label="Horizontal" @bind-Checked="_horizontal" Size="HelixSize.Sm" />
            <HelixSwitch Label="ItemDescription" @bind-Checked="_descriptions" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <ApiTable Title="HelixRadioGroup" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <!-- Appearance : Default (liste), Cards (cartes) ou Segmented -->
        <helix:HelixRadioGroup Label="Formule" Appearance="Cards" Columns="3"
                             ItemsSource="{Binding Plans}" SelectedItem="{Binding Plan}"
                             Hint="Changeable à tout moment." Accent="#8B5CF6" CornerRadius="14" />

        // ViewModel : titre, description et icône par option
        Plans = [new HelixRadioOption("Découverte", "Jusqu'à 3 sites", "star"),
                 new HelixRadioOption("Pro", "Sites illimités", "zap"),
                 new HelixRadioOption("Entreprise", "SSO et support dédié", "lock")];

        <!-- Ou des options écrites en XAML -->
        <helix:HelixRadioGroup Label="Livraison" SelectedIndex="0">
            <helix:HelixRadioItem Content="Standard" Description="3 à 5 jours" />
            <helix:HelixRadioItem Content="Express" Description="Demain" />
        </helix:HelixRadioGroup>
        """;

    public sealed record Plan(string Name, string Description);

    private static readonly Plan[] Plans =
    [
        new("Essentiel", "Jusqu'à 3 sites, données sur 30 jours"),
        new("Pro", "Sites illimités, alertes, export"),
        new("Entreprise", "SSO, SLA 99,9 %, support dédié"),
    ];

    private Plan? _plan = Plans[1];
    private HelixRadioAppearance _appearance = HelixRadioAppearance.Cards;
    private string? _color;
    private bool _horizontal, _descriptions = true;

    private string Code =>
        $"<HelixRadioGroup Items=\"plans\" @bind-Value=\"plan\" ItemText=\"p => p.Name\"{(_descriptions ? " ItemDescription=\"p => p.Description\"" : "")} Label=\"Formule\"{A("Appearance", _appearance, HelixRadioAppearance.Default)}{B("Horizontal", _horizontal)}{A("Color", _color)} />";

    private static readonly ApiRow[] Api =
    [
        new("Items / Value", "IEnumerable<T> / T?", null, "Les options et le choix (@bind-Value)."),
        new("ItemText / ItemDescription / ItemDisabled", "Func<T, …>", null, "Libellé, description, option désactivée."),
        new("ItemTemplate", "RenderFragment<T>", null, "Contenu libre d'une option."),
        new("Appearance", "HelixRadioAppearance", null, "Default, Cards ou Segmented."),
        new("Horizontal / Label / Hint", "bool / string / string", null, "Disposition, titre (legend), aide."),
        new("Color", "string", "--helix-radio-color", "Couleur du choix."),
    ];
}
