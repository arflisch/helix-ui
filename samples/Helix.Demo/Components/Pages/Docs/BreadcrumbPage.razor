@page "/components/breadcrumb"

<DemoPage Title="Breadcrumb" Description="Breadcrumb: where am I, and how to go back up. Long paths collapse into “…” (click to see everything).">
    <Example WpfCode="@Wpf1" Title="Examples" Code="@Code">
        <div class="stack">
            <HelixBreadcrumb Items="Short" />
            <HelixBreadcrumb Items="Long" MaxItems="3" />
        </div>
    </Example>

    <ApiTable Title="HelixBreadcrumb" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixBreadcrumb x:Name="Path" MaxItems="4" ItemClick="OnCrumbClick" />

        // Code-behind
        Path.ItemsSource = new[]
        {
            new HelixBreadcrumbItem("Home", "home") { Tag = "/" },
            new HelixBreadcrumbItem("Projects") { Tag = "/projects" },
            new HelixBreadcrumbItem("Energy"),
            new HelixBreadcrumbItem("March report"),   // the last one = current page
        };

        private void OnCrumbClick(object sender, RoutedEventArgs e) =>
            Navigate(((HelixEventArgs<HelixBreadcrumbItem>)e).Value.Tag);
        """;

    private static readonly HelixBreadcrumbItem[] Short =
    [
        new("Home", "", "layout"), new("Components", "components/button"), new("Breadcrumb"),
    ];

    private static readonly HelixBreadcrumbItem[] Long =
    [
        new("Home", "", "layout"), new("Operations", "components/dashboard"), new("Sites", "components/barlist"),
        new("Lyon", "components/barlist"), new("Meters", "components/datagrid"), new("Meter 42"),
    ];

    private const string Code = """
        <HelixBreadcrumb MaxItems="3" Items="@([
            new("Home", "/", "layout"),
            new("Sites", "/sites"),
            new("Lyon", "/sites/lyon"),
            new("Meter 42"),
        ])" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Items", "IEnumerable<HelixBreadcrumbItem>", null, "(Text, Href?, Icon?); the last one is the current page."),
        new("MaxItems", "int?", null, "Beyond it, the middle items collapse into “…”."),
        new("AriaLabel", "string", null, "Name of the navigation (“Breadcrumb”)."),
    ];
}
