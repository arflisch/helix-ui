@page "/components/gauge"
@using System.Globalization

<DemoPage Title="Gauge" Description="Semicircular gauge for a value in a known range (load rate, reserve, fill level). Thresholds change the color and show a status label: the information never relies on color alone.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <HelixGauge Value="_value" Min="0" Max="100" Unit="%" Label="Grid load" Thresholds="_thresholds ? Bands : []" Size="@($"{_size}px")" Culture="English" />
        </Preview>
        <Controls>
            <HelixSlider Label="Value" @bind-Value="_value" />
            <HelixSlider Label="Size" @bind-Value="_size" Min="160" Max="320" Step="20" Format="@(v => $"{v} px")" />
            <HelixSwitch Label="Thresholds" @bind-Checked="_thresholds" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Several gauges">
        <div class="row" style="justify-content:space-around;gap:24px">
            <HelixGauge Value="38" Unit="%" Label="Battery" Thresholds="Bands" Size="180px" Culture="English" />
            <HelixGauge Value="72" Unit="%" Label="Committed reserve" Thresholds="Bands" Size="180px" Culture="English" />
            <HelixGauge Value="91" Unit="%" Label="North line" Thresholds="Bands" Size="180px" Culture="English" />
        </div>
    </Example>

    <ApiTable Title="HelixGauge" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixGauge Value="{Binding Load}" Minimum="0" Maximum="100" Unit="%" Label="Load"
                        Format="0" Size="200" Thresholds="{Binding LoadZones}" />

        // ViewModel
        LoadZones = [new HelixGaugeThreshold(70, "warning", "High"), new HelixGaugeThreshold(90, "danger", "Critical")];
        """;

    private const string Wpf2 = """
        <StackPanel Orientation="Horizontal">
            <helix:HelixGauge Value="72" Unit="%" Label="CPU" Size="150" />
            <helix:HelixGauge Value="38" Maximum="60" Unit="°C" Label="Temperature" Size="150" Accent="#0EA5E9" />
            <helix:HelixGauge Value="5.2" Maximum="8" Unit="GB" Label="Memory" Size="150" Format="0.0" />
        </StackPanel>
        """;

    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-GB");

    private static readonly HelixGaugeThreshold[] Bands =
    [
        new(0, "success", "Normal"),
        new(60, "warning", "Strained"),
        new(85, "danger", "Critical"),
    ];

    private double _value = 68, _size = 240;
    private bool _thresholds = true;

    private string Code => $$"""
        <HelixGauge Value="{{_value}}" Max="100" Unit="%" Label="Grid load" Thresholds="bands" />

        @code {
            private HelixGaugeThreshold[] bands =
            [
                new(0, "success", "Normal"),
                new(60, "warning", "Strained"),
                new(85, "danger", "Critical"),
            ];
        }
        """;

    private static readonly ApiRow[] Api =
    [
        new("Value / Min / Max", "double", null, "Value and range (0–100)."),
        new("Thresholds", "IReadOnlyList<HelixGaugeThreshold>", null, "(Value, Color, Label): from Value on, color + status label."),
        new("Label / Unit / Format", "string", null, "Caption, unit, format."),
        new("Color", "string", null, "Color without thresholds."),
        new("Size", "string", "--helix-gauge-size", "Width (220px)."),
        new("—", "", "--helix-gauge-track", "Color of the arc background."),
    ];
}
