@page "/components/textfield"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="TextField" Description="Input field with label, hint, error message, icon, prefix/suffix and clear button.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <div style="width:100%;max-width:340px">
                <HelixTextField @bind-Value="_value" Label="@_label" Placeholder="@_placeholder" Hint="@_hint"
                               Error="@(_error ? "This field is required" : null)" Icon="@(_icon ? "mail" : null)"
                               Clearable="_clearable" Disabled="_disabled" Required="_required" Color="@_color" Radius="@Radius" />
            </div>
        </Preview>
        <Controls>
            <HelixTextField Label="Label" @bind-Value="_label" />
            <HelixTextField Label="Placeholder" @bind-Value="_placeholder" />
            <HelixTextField Label="Hint" @bind-Value="_hint" />
            <ColorPicker Label="Color (focus)" @bind-Value="_color" />
            <HelixSlider Label="Radius" @bind-Value="_radius" Min="0" Max="20" Format="@(v => $"{v} px")" />
            <HelixSwitch Label="Icon" @bind-Checked="_icon" Size="HelixSize.Sm" />
            <HelixSwitch Label="Clearable" @bind-Checked="_clearable" Size="HelixSize.Sm" />
            <HelixSwitch Label="Required" @bind-Checked="_required" Size="HelixSize.Sm" />
            <HelixSwitch Label="Error" @bind-Checked="_error" Size="HelixSize.Sm" />
            <HelixSwitch Label="Disabled" @bind-Checked="_disabled" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Prefix, suffix and types" Code="@AffixCode">
        <div class="grid-3">
            <HelixTextField Label="Search" Icon="search" Placeholder="Search…" Clearable="true" @bind-Value="_search" />
            <HelixTextField Label="Password" Icon="lock" Type="password" Value="secret123" />
            <HelixTextField Label="Price" Type="number" Value="49">
                <Suffix><span class="muted">EUR</span></Suffix>
            </HelixTextField>
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixTextField Label="E-mail" Icon="mail" Placeholder="first@example.com"
                            Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                            Hint="We never send advertising." Error="{Binding EmailError}"
                            IsRequired="True" IsClearable="True" Accent="#0EA5E9" CornerRadius="10" />
        """;

    private const string Wpf2 = """
        <helix:HelixTextField Label="Amount">
            <helix:HelixTextField.Suffix>
                <TextBlock Text="EUR" FontWeight="SemiBold" />
            </helix:HelixTextField.Suffix>
        </helix:HelixTextField>
        <helix:HelixTextField Label="Website">
            <helix:HelixTextField.Prefix>
                <TextBlock Text="https://" Foreground="{DynamicResource Helix.TextSubtle}" />
            </helix:HelixTextField.Prefix>
        </helix:HelixTextField>
        <!-- Password: a PasswordBox inside a HelixField keeps the same label and hint -->
        """;

    private string? _value;
    private string? _search;
    private string? _label = "Email";
    private string? _placeholder = "you@example.com";
    private string? _hint = "We will never share your email.";
    private string? _color;
    private double _radius = 10;
    private bool _icon = true, _clearable = true, _required, _error, _disabled;

    private string? Radius => _radius == 10 ? null : $"{N(_radius)}px";

    private string Code =>
        $"<HelixTextField @bind-Value=\"email\"{A("Label", _label)}{A("Placeholder", _placeholder)}{A("Hint", _hint)}{A("Icon", _icon ? "mail" : null)}{A("Error", _error ? "This field is required" : null)}{A("Color", _color)}{A("Radius", Radius)}{B("Clearable", _clearable)}{B("Required", _required)}{B("Disabled", _disabled)} />";

    private const string AffixCode = """
        <HelixTextField Label="Search" Icon="search" Placeholder="Search…" Clearable @bind-Value="search" />
        <HelixTextField Label="Password" Icon="lock" Type="password" @bind-Value="password" />
        <HelixTextField Label="Price" Type="number" @bind-Value="price">
            <Suffix><span>EUR</span></Suffix>
        </HelixTextField>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Value", "string?", null, "Value, to use with @bind-Value (updated on every keystroke)."),
        new("Label / Placeholder / Hint", "string", null, "Field texts."),
        new("Icon", "string", null, "Icon at the start of the field."),
        new("Prefix / Suffix", "RenderFragment", null, "Free content before / after the input."),
        new("Clearable", "bool", null, "Button that clears the field."),
        new("Prefix / Suffix", "RenderFragment", null, "Content at the start / end of the field (icon, sign, unit…). Same slots on every field."),
        new("Hint / Error", "string", null, "Hint under the field, or an error that replaces it; linked to the field for screen readers (aria-describedby)."),
        new("Required", "bool", null, "Asterisk after the label and required attribute."),
        new("Color / Radius / Background / BorderColor", "string", "--helix-input-*", "Same look on every field; defaults through Defaults.Field."),
    ];
}
