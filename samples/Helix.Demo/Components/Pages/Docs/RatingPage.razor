@page "/components/rating"
@using System.Globalization

<DemoPage Title="Rating" Description="Rating with stars or hearts: input (real radio buttons, keyboard arrows) or display of an average with fractions. Labels on hover, reset by clicking again.">
    <Example WpfCode="@Wpf1" Title="Input" Code="@InputCode">
        <div class="stack">
            <HelixRating @bind-Value="_value" Labels="Labels" ShowValue="true" Label="Your rating" Culture="English" />
            <HelixRating @bind-Value="_love" Shape="heart" Color="danger" Size="HelixSize.Lg" Label="Favorites" />
            <HelixRating Value="2" Max="10" Size="HelixSize.Sm" Color="primary" Label="Out of 10" />
            <p class="muted" style="margin:0;font-size:13px">Values: @_value · @_love</p>
        </div>
    </Example>

    <Example WpfCode="@Wpf2" Title="Showing an average" Code="@ReadOnlyCode">
        <div class="stack">
            <HelixRating Value="4.3" ReadOnly="true" ShowValue="true" Count="128" Culture="English" Label="Satisfaction" />
            <HelixRating Value="3.6" ReadOnly="true" ShowValue="true" Count="42" Size="HelixSize.Sm" Culture="English" Label="Reliability" />
        </div>
    </Example>

    <ApiTable Title="HelixRating" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixRating Value="{Binding Score}" Max="5" Labels="{Binding ScoreLabels}" AllowClear="True" />
        <helix:HelixRating Value="2" Shape="heart" Accent="#E11D48" Size="Lg" />
        """;

    private const string Wpf2 = """
        <helix:HelixRating Value="3.6" IsReadOnly="True" ShowValue="True" Count="128" Size="Sm" />
        """;

    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-GB");
    private static readonly string[] Labels = ["Very bad", "Bad", "Okay", "Good", "Excellent"];
    private double _value = 4, _love = 3;

    private const string InputCode = """
        <HelixRating @bind-Value="note" Labels="@(["Very bad", "Bad", "Okay", "Good", "Excellent"])" ShowValue />
        <HelixRating @bind-Value="love" Shape="heart" Color="danger" Size="HelixSize.Lg" />
        """;

    private const string ReadOnlyCode = """<HelixRating Value="4.3" ReadOnly ShowValue Count="128" />""";

    private static readonly ApiRow[] Api =
    [
        new("Value / Max", "double / int", null, "Rating (@bind-Value); 0 = none. When read-only, fractions are accepted (4.3)."),
        new("ReadOnly / Disabled / AllowClear", "bool", null, "Display only; disabled; clicking again resets to 0 (true)."),
        new("Shape / Size / Color", "string / HelixSize / string", "--helix-rating-color, --helix-rating-empty", "“star” or “heart”; size; color."),
        new("Labels", "IReadOnlyList<string>", null, "One label per value: hover and screen readers."),
        new("ShowValue / Count", "bool / int?", null, "Numeric value; number of reviews."),
    ];
}
