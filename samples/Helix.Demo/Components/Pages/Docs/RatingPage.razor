@page "/components/rating"
@using System.Globalization

<DemoPage Title="Rating" Description="Note en étoiles ou en cœurs : saisie (vraies cases radio, flèches du clavier) ou affichage d'une moyenne avec fractions. Libellés au survol, remise à zéro en recliquant.">
    <Example WpfCode="@Wpf1" Title="Saisie" Code="@InputCode">
        <div class="stack">
            <HelixRating @bind-Value="_value" Labels="Labels" ShowValue="true" Label="Votre note" Culture="French" />
            <HelixRating @bind-Value="_love" Shape="heart" Color="danger" Size="HelixSize.Lg" Label="Coups de cœur" />
            <HelixRating Value="2" Max="10" Size="HelixSize.Sm" Color="primary" Label="Sur 10" />
            <p class="muted" style="margin:0;font-size:13px">Valeurs : @_value · @_love</p>
        </div>
    </Example>

    <Example WpfCode="@Wpf2" Title="Affichage d'une moyenne" Code="@ReadOnlyCode">
        <div class="stack">
            <HelixRating Value="4.3" ReadOnly="true" ShowValue="true" Count="128" Culture="French" Label="Satisfaction" />
            <HelixRating Value="3.6" ReadOnly="true" ShowValue="true" Count="42" Size="HelixSize.Sm" Culture="French" Label="Fiabilité" />
        </div>
    </Example>

    <ApiTable Title="HelixRating" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixRating Value="{Binding Score}" Max="5" Labels="{Binding ScoreLabels}" AllowClear="True" />
        <helix:HelixRating Value="2" Shape="heart" Accent="#E11D48" Size="Lg" />
        """;

    private const string Wpf2 = """
        <helix:HelixRating Value="3.6" IsReadOnly="True" ShowValue="True" Count="128" Size="Sm" />
        """;

    private static readonly CultureInfo French = CultureInfo.GetCultureInfo("fr-FR");
    private static readonly string[] Labels = ["Très mauvais", "Mauvais", "Correct", "Bien", "Excellent"];
    private double _value = 4, _love = 3;

    private const string InputCode = """
        <HelixRating @bind-Value="note" Labels="@(["Très mauvais", "Mauvais", "Correct", "Bien", "Excellent"])" ShowValue />
        <HelixRating @bind-Value="love" Shape="heart" Color="danger" Size="HelixSize.Lg" />
        """;

    private const string ReadOnlyCode = """<HelixRating Value="4.3" ReadOnly ShowValue Count="128" />""";

    private static readonly ApiRow[] Api =
    [
        new("Value / Max", "double / int", null, "Note (@bind-Value) ; 0 = aucune. En lecture seule, fractions acceptées (4,3)."),
        new("ReadOnly / Disabled / AllowClear", "bool", null, "Affichage seul ; désactivé ; recliquer remet à 0 (true)."),
        new("Shape / Size / Color", "string / HelixSize / string", "--helix-rating-color, --helix-rating-empty", "« star » ou « heart » ; taille ; couleur."),
        new("Labels", "IReadOnlyList<string>", null, "Un libellé par valeur : survol et lecteurs d'écran."),
        new("ShowValue / Count", "bool / int?", null, "Valeur chiffrée ; nombre d'avis."),
    ];
}
