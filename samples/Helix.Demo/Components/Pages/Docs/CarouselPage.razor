@page "/components/carousel"

<DemoPage Title="Carousel" Description="Slides that move by swipe (native scrolling), arrows, dots or keyboard. Several slides at once, autoplay that stops on hover and focus, with a pause button.">
    <Example WpfCode="@Wpf1" Title="Banners (autoplay)" Code="@BannerCode">
        <HelixCarousel Autoplay="true" Height="220px" @bind-Index="_index" AriaLabel="News">
            @foreach (var slide in Banners)
            {
                <HelixCarouselSlide Label="@slide.Title">
                    <div class="banner" style="--_b:@slide.Color">
                        <HelixBadge Variant="HelixBadgeVariant.Solid" Color="neutral">@slide.Tag</HelixBadge>
                        <h3>@slide.Title</h3>
                        <p>@slide.Text</p>
                    </div>
                </HelixCarouselSlide>
            }
        </HelixCarousel>
        <p class="muted" style="margin:10px 0 0;font-size:13px">Current slide: @(_index + 1)</p>
    </Example>

    <Example WpfCode="@Wpf2" Title="Several at once" Code="@CardsCode">
        <HelixCarousel SlidesPerView="3" Gap="14px" AriaLabel="Sites">
            @foreach (var site in Sites)
            {
                <HelixCarouselSlide Label="@site.Name">
                    <HelixCard Title="@site.Name" Subtitle="@site.City" Style="height:100%">
                        <HelixStat Bare="true" Label="Consumption" Value="site.Mwh" Unit="MWh" Trend="DemoData.Trend(site.Seed)" />
                    </HelixCard>
                </HelixCarouselSlide>
            }
        </HelixCarousel>
    </Example>

    <ApiTable Title="HelixCarousel and HelixCarouselSlide" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixCarousel Autoplay="True" Interval="0:0:5" Loop="True">
            <Border Height="180" CornerRadius="14" Background="{DynamicResource Helix.Series1}">…</Border>
            <Border Height="180" CornerRadius="14" Background="{DynamicResource Helix.Series2}">…</Border>
            <Border Height="180" CornerRadius="14" Background="{DynamicResource Helix.Series3}">…</Border>
        </helix:HelixCarousel>
        <!-- Pauses on hover and focus; keyboard arrows; drag to change. -->
        """;

    private const string Wpf2 = """
        <helix:HelixCarousel SlidesPerView="3" Gap="16" ShowDots="False" SelectedIndex="{Binding Slide}">
            <helix:HelixCard Title="Lyon" />
            <helix:HelixCard Title="Grenoble" />
            <helix:HelixCard Title="Marseille" />
            <helix:HelixCard Title="Lille" />
        </helix:HelixCarousel>
        """;

    private static readonly (string Tag, string Title, string Text, string Color)[] Banners =
    [
        ("New", "Light and dark themes", "Build your palette for each mode, or let the computer choose.", "#4f46e5"),
        ("Data", "Server-side loading", "The DataGrid asks your database for one page at a time.", "#0369a1"),
        ("Scheduling", "Editable timeline", "Drag, resize, change lanes: by touch or keyboard.", "#15803d"),
        ("Dashboards", "Personal layout", "Each user arranges their tiles; the layout is saved.", "#c2410c"),
    ];

    private static readonly (string Name, string City, double Mwh, int Seed)[] Sites =
    [
        ("Plant", "Lyon", 1840, 1), ("Warehouse", "Lille", 920, 2), ("Head office", "Paris", 610, 3),
        ("Data center", "Marseille", 2410, 4), ("Workshop", "Nantes", 455, 5), ("Office", "Bordeaux", 180, 6),
    ];

    private int _index;

    private const string BannerCode = """
        <HelixCarousel Autoplay Height="220px" @bind-Index="index">
            <HelixCarouselSlide Label="Light and dark themes">…</HelixCarouselSlide>
            <HelixCarouselSlide Label="Server-side loading">…</HelixCarouselSlide>
        </HelixCarousel>
        """;

    private const string CardsCode = """
        <HelixCarousel SlidesPerView="3" Gap="14px">
            @foreach (var site in sites)
            {
                <HelixCarouselSlide Label="@site.Name"><HelixCard …/></HelixCarouselSlide>
            }
        </HelixCarousel>
        """;

    private static readonly ApiRow[] Api =
    [
        new("ChildContent", "HelixCarouselSlide…", null, "The slides (free content; Label for screen readers)."),
        new("SlidesPerView / Gap / Height", "int / string / string", "--helix-carousel-height", "Slides visible at once, spacing, height."),
        new("Autoplay / Interval", "bool / TimeSpan", null, "Autoplay (5 s), paused on hover, on focus and with the button."),
        new("Loop / ShowArrows / ShowDots", "bool", null, "Loop; arrows; dots."),
        new("Index", "int", null, "Current slide (@bind-Index)."),
    ];
}
