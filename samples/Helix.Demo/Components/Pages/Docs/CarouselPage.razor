@page "/components/carousel"

<DemoPage Title="Carousel" Description="Diapositives qui défilent au doigt (défilement natif), aux flèches, aux points ou au clavier. Plusieurs diapositives à la fois, défilement automatique qui s'arrête au survol et au focus, avec un bouton pause.">
    <Example WpfCode="@Wpf1" Title="Bannières (défilement automatique)" Code="@BannerCode">
        <HelixCarousel Autoplay="true" Height="220px" @bind-Index="_index" AriaLabel="Actualités">
            @foreach (var slide in Banners)
            {
                <HelixCarouselSlide Label="@slide.Title">
                    <div class="banner" style="--_b:@slide.Color">
                        <HelixBadge Variant="HelixBadgeVariant.Solid" Color="neutral">@slide.Tag</HelixBadge>
                        <h3>@slide.Title</h3>
                        <p>@slide.Text</p>
                    </div>
                </HelixCarouselSlide>
            }
        </HelixCarousel>
        <p class="muted" style="margin:10px 0 0;font-size:13px">Diapositive courante : @(_index + 1)</p>
    </Example>

    <Example WpfCode="@Wpf2" Title="Plusieurs à la fois" Code="@CardsCode">
        <HelixCarousel SlidesPerView="3" Gap="14px" AriaLabel="Sites">
            @foreach (var site in Sites)
            {
                <HelixCarouselSlide Label="@site.Name">
                    <HelixCard Title="@site.Name" Subtitle="@site.City" Style="height:100%">
                        <HelixStat Bare="true" Label="Consommation" Value="site.Mwh" Unit="MWh" Trend="DemoData.Trend(site.Seed)" />
                    </HelixCard>
                </HelixCarouselSlide>
            }
        </HelixCarousel>
    </Example>

    <ApiTable Title="HelixCarousel et HelixCarouselSlide" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixCarousel Autoplay="True" Interval="0:0:5" Loop="True">
            <Border Height="180" CornerRadius="14" Background="{DynamicResource Helix.Series1}">…</Border>
            <Border Height="180" CornerRadius="14" Background="{DynamicResource Helix.Series2}">…</Border>
            <Border Height="180" CornerRadius="14" Background="{DynamicResource Helix.Series3}">…</Border>
        </helix:HelixCarousel>
        <!-- Pause au survol et au focus ; flèches du clavier ; glisser pour changer. -->
        """;

    private const string Wpf2 = """
        <helix:HelixCarousel SlidesPerView="3" Gap="16" ShowDots="False" SelectedIndex="{Binding Slide}">
            <helix:HelixCard Title="Lyon" />
            <helix:HelixCard Title="Grenoble" />
            <helix:HelixCard Title="Marseille" />
            <helix:HelixCard Title="Lille" />
        </helix:HelixCarousel>
        """;

    private static readonly (string Tag, string Title, string Text, string Color)[] Banners =
    [
        ("Nouveau", "Thèmes clair et sombre", "Composez votre palette pour chaque mode, ou laissez l'ordinateur choisir.", "#4f46e5"),
        ("Données", "Chargement côté serveur", "Le DataGrid ne demande qu'une page à la fois à votre base.", "#0369a1"),
        ("Planning", "Timeline éditable", "Glissez, redimensionnez, changez de ligne : au doigt comme au clavier.", "#15803d"),
        ("Tableaux de bord", "Disposition personnelle", "Chaque utilisateur arrange ses tuiles ; la disposition se sauvegarde.", "#c2410c"),
    ];

    private static readonly (string Name, string City, double Mwh, int Seed)[] Sites =
    [
        ("Usine", "Lyon", 1840, 1), ("Entrepôt", "Lille", 920, 2), ("Siège", "Paris", 610, 3),
        ("Data center", "Marseille", 2410, 4), ("Atelier", "Nantes", 455, 5), ("Agence", "Bordeaux", 180, 6),
    ];

    private int _index;

    private const string BannerCode = """
        <HelixCarousel Autoplay Height="220px" @bind-Index="index">
            <HelixCarouselSlide Label="Thèmes clair et sombre">…</HelixCarouselSlide>
            <HelixCarouselSlide Label="Chargement côté serveur">…</HelixCarouselSlide>
        </HelixCarousel>
        """;

    private const string CardsCode = """
        <HelixCarousel SlidesPerView="3" Gap="14px">
            @foreach (var site in sites)
            {
                <HelixCarouselSlide Label="@site.Name"><HelixCard …/></HelixCarouselSlide>
            }
        </HelixCarousel>
        """;

    private static readonly ApiRow[] Api =
    [
        new("ChildContent", "HelixCarouselSlide…", null, "Les diapositives (contenu libre ; Label pour les lecteurs d'écran)."),
        new("SlidesPerView / Gap / Height", "int / string / string", "--helix-carousel-height", "Diapositives visibles à la fois, espacement, hauteur."),
        new("Autoplay / Interval", "bool / TimeSpan", null, "Défilement automatique (5 s), en pause au survol, au focus et via le bouton."),
        new("Loop / ShowArrows / ShowDots", "bool", null, "Boucler ; flèches ; points."),
        new("Index", "int", null, "Diapositive courante (@bind-Index)."),
    ];
}
