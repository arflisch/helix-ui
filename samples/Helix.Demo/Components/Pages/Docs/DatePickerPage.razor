@page "/components/datepicker"
@using System.Globalization

<DemoPage Title="DatePicker" Description="Date picker with a calendar: the week starts according to the culture (Monday in British English or French), disabled dates, bounds. From the keyboard: arrows for days, Page ↑/↓ for months (Shift: years), Home/End for the week, Enter to choose.">
    <Example WpfCode="@Wpf1" Title="Examples" Code="@Code">
        <div class="grid-3">
            <HelixDatePicker Label="Delivery date" @bind-Value="_delivery" Culture="English" Hint="@($"Chosen: {_delivery?.ToString("dddd d MMMM", English) ?? "none"}")" />
            <HelixDatePicker Label="Working day (14 days)" @bind-Value="_workday" Culture="English"
                            Min="Today" Max="Today.AddDays(14)" IsDateDisabled="d => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday" />
            <HelixDatePicker Label="Short format" @bind-Value="_short" Format="dd/MM/yyyy" Culture="English" Clearable="false" />
        </div>
    </Example>

    <ApiTable Title="HelixDatePicker" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixDatePicker Label="Start date" SelectedDate="{Binding Start}" Hint="Format dd/mm/yyyy"
                             DisplayDateStart="{Binding Today}" IsRequired="True" />
        <helix:HelixDatePicker Label="Due date" Error="{Binding DueDateError}" Accent="#FF8A00" />
        """;

    private static readonly CultureInfo English = CultureInfo.GetCultureInfo("en-GB");
    private static DateOnly Today => DateOnly.FromDateTime(DateTime.Today);

    private DateOnly? _delivery = DateOnly.FromDateTime(DateTime.Today.AddDays(3));
    private DateOnly? _workday;
    private DateOnly? _short = DateOnly.FromDateTime(DateTime.Today);

    private const string Code = """
        <HelixDatePicker Label="Working day" @bind-Value="date" Min="today" Max="today.AddDays(14)"
                        IsDateDisabled="d => d.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday" />
        """;

    private static readonly ApiRow[] Api =
    [
        new("Value", "DateOnly?", null, "Chosen date (@bind-Value)."),
        new("Min / Max / IsDateDisabled", "DateOnly? / DateOnly? / Func<DateOnly, bool>", null, "Allowed dates (the others are struck through)."),
        new("Format", "string", null, "Display, “d MMMM yyyy” by default."),
        new("Culture", "CultureInfo", null, "Month and day names, first day of the week."),
        new("Clearable / Label / Hint / Error", "bool / string", null, "Clear button, texts."),
        new("TimeProvider", "TimeProvider", null, "Clock for “Today” (tests)."),
        new("Prefix / Suffix", "RenderFragment", null, "Content at the start / end of the field (icon, sign, unit…). Same slots on every field."),
        new("Hint / Error", "string", null, "Hint under the field, or an error that replaces it; linked to the field for screen readers (aria-describedby)."),
        new("Required", "bool", null, "Asterisk after the label and required attribute."),
        new("Color / Radius / Background / BorderColor", "string", "--helix-input-*", "Same look on every field; defaults through Defaults.Field."),
    ];
}
