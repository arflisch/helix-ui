@page "/components/splitter"

<DemoPage Title="Splitter" Description="Two resizable panes: drag the divider, or use the arrows (Home / End for the bounds) once the divider has keyboard focus. Double-click to go back to the initial size.">
    <Example WpfCode="@Wpf1" Title="List + detail" Code="@Code">
        <HelixSplitter @bind-Size="_size" Min="20" Max="70" Height="300px">
            <First>
                <ul class="split-list">
                    @foreach (var name in Names)
                    {
                        <li class="@(name == _selected ? "is-active" : null)" @onclick="() => _selected = name">
                            <HelixAvatar Name="@name" Size="HelixSize.Sm" /> @name
                        </li>
                    }
                </ul>
            </First>
            <Second>
                <div style="padding:20px">
                    <div class="row"><HelixAvatar Name="@_selected" Size="HelixSize.Lg" /><strong style="font-size:16px">@_selected</strong></div>
                    <p class="muted" style="margin:14px 0 0;line-height:1.6">Detail pane. The divider is at <strong>@_size.ToString("0")%</strong>; the value is bound with <code>@@bind-Size</code>, so you can save it as a preference.</p>
                </div>
            </Second>
        </HelixSplitter>
    </Example>

    <Example WpfCode="@Wpf2" Title="Vertical" Code="@VerticalCode">
        <HelixSplitter Vertical="true" Size="60" Height="260px">
            <First><div style="padding:16px" class="muted">Editor (top)</div></First>
            <Second><div style="padding:16px" class="muted">Console (bottom)</div></Second>
        </HelixSplitter>
    </Example>

    <ApiTable Title="HelixSplitter" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="160" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="200" />
            </Grid.ColumnDefinitions>
            <ListBox ItemsSource="{Binding Mails}" />
            <helix:HelixSplitter Grid.Column="1" />
            <ContentControl Grid.Column="2" Content="{Binding SelectedMail}" />
        </Grid>
        """;

    private const string Wpf2 = """
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="160" />
            </Grid.RowDefinitions>
            <TextBox Text="{Binding Query}" />
            <helix:HelixSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
            <helix:HelixDataGrid Grid.Row="2" Source="{Binding Results}" />
        </Grid>
        """;

    private static readonly string[] Names = ["Ada Lovelace", "Alan Turing", "Grace Hopper", "Linus Torvalds", "Margaret Hamilton"];
    private double _size = 35;
    private string _selected = Names[0];

    private const string Code = """
        <HelixSplitter @bind-Size="size" Min="20" Max="70" Height="300px">
            <First>…list…</First>
            <Second>…detail…</Second>
        </HelixSplitter>
        """;

    private const string VerticalCode = """<HelixSplitter Vertical Size="60" Height="260px">…</HelixSplitter>""";

    private static readonly ApiRow[] Api =
    [
        new("First / Second", "RenderFragment", null, "The two panes."),
        new("Size", "double", "--_size", "Size of the first pane in % (@bind-Size)."),
        new("Min / Max / KeyboardStep", "double", null, "Bounds (15–85) and arrow step (5)."),
        new("Vertical / Height", "bool / string", null, "Stacked panes; container height."),
    ];
}
