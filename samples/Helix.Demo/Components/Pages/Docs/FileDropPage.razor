@page "/components/filedrop"
@using Microsoft.AspNetCore.Components.Forms

<DemoPage Title="FileDrop" Description="File drop zone: drag and drop or browse, type filter, maximum size, file list with rejections explained.">
    <Example WpfCode="@Wpf1" Title="Statement import" Code="@Code">
        <div class="grid-2">
            <HelixFileDrop Accept=".csv,.xlsx,.json" MaxFileSize="2_000_000" OnFilesChanged="f => _files = f" />
            <HelixCard Title="Files ready">
                @if (_files.Count == 0)
                {
                    <HelixEmptyState Compact="true" Icon="upload" Title="No files" Description="Valid files show up here." />
                }
                else
                {
                    <ul class="muted" style="margin:0;padding-left:18px;line-height:1.8">
                        @foreach (var f in _files)
                        {
                            <li>@f.Name (@f.ContentType)</li>
                        }
                    </ul>
                }
            </HelixCard>
        </div>
    </Example>

    <Example WpfCode="@Wpf2" Title="Compact">
        <HelixFileDrop Compact="true" Multiple="false" Accept="image/*" Title="Drop an image" />
    </Example>

    <ApiTable Title="HelixFileDrop" Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixFileDrop x:Name="Statements" Accept=".csv,.xlsx" MaxFileSize="10485760" MaxFiles="5"
                           Title="Drop your statements" FilesChanged="OnFilesChanged" />

        // Code-behind
        private void OnFilesChanged(object sender, RoutedEventArgs e)
        {
            foreach (var file in Statements.Files)   // Name, Path, Size, SizeText
                Import(file.Path);
        }
        """;

    private const string Wpf2 = """
        <helix:HelixFileDrop IsCompact="True" Multiple="False" Accept="image/*" Title="Add a logo" ShowList="True" />
        """;

    private IReadOnlyList<IBrowserFile> _files = [];

    private const string Code = """
        <HelixFileDrop Accept=".csv,.xlsx" MaxFileSize="2_000_000" OnFilesChanged="Upload" />

        @code {
            private async Task Upload(IReadOnlyList<IBrowserFile> files)
            {
                foreach (var file in files)
                {
                    await using var stream = file.OpenReadStream(2_000_000);
                    await storage.SaveAsync(file.Name, stream);
                }
            }
        }
        """;

    private static readonly ApiRow[] Api =
    [
        new("Accept / Multiple", "string / bool", null, "Accepted types (“.csv,.xlsx”, “image/*”); several files (true)."),
        new("MaxFileSize / MaxFiles", "long / int", null, "Max size per file (10 MB) and max count; rejections are listed with the reason."),
        new("OnFilesChanged", "EventCallback<IReadOnlyList<IBrowserFile>>", null, "The valid files; read them with OpenReadStream(MaxFileSize)."),
        new("Title / Hint / Compact / ShowList", "string / string / bool / bool", null, "Texts, compact version, file list."),
        new("Color", "string", "--helix-filedrop-color", "Hover and accent color."),
    ];
}
