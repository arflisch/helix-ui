@page "/components/alert"
@using static Helix.Demo.Components.Shared.Snippet

<DemoPage Title="Alert" Description="Contextual message in the page. The severity picks the icon and the color; both can still be changed.">
    <Playground WpfCode="@Wpf1" Code="@Code">
        <Preview>
            <div style="width:100%;max-width:520px">
                <HelixAlert @key="_key" Severity="_severity" Title="@_title" Closable="_closable" Color="@_color" OnClose="Reopen">@_text</HelixAlert>
            </div>
        </Preview>
        <Controls>
            <Choice TEnum="HelixSeverity" Label="Severity" @bind-Value="_severity" />
            <HelixTextField Label="Title" @bind-Value="_title" />
            <HelixTextField Label="Text" @bind-Value="_text" />
            <ColorPicker Label="Color" @bind-Value="_color" />
            <HelixSwitch Label="Closable" @bind-Checked="_closable" Size="HelixSize.Sm" />
        </Controls>
    </Playground>

    <Example WpfCode="@Wpf2" Title="Severities" Code="@AllCode">
        <div class="stack">
            <HelixAlert Title="New version">Helix 0.2 is available with the DataGrid.</HelixAlert>
            <HelixAlert Severity="HelixSeverity.Success" Title="Payment received">Thank you, your invoice is available.</HelixAlert>
            <HelixAlert Severity="HelixSeverity.Warning" Title="Storage almost full">You have 5% of space left.</HelixAlert>
            <HelixAlert Severity="HelixSeverity.Danger" Title="Sync failed" Closable="true">Check your connection, then try again.</HelixAlert>
        </div>
    </Example>

    <ApiTable Rows="Api" />
</DemoPage>

@code {
    private const string Wpf1 = """
        <helix:HelixAlert Severity="Warning" Title="Quota almost reached"
                        Content="8% of the space is left."
                        IsClosable="True" Closed="OnAlertClosed" />

        <!-- Any color and icon -->
        <helix:HelixAlert Title="What's new" Content="PDF exports are coming." Accent="#8B5CF6" Icon="sparkles" CornerRadius="16" />
        """;

    private const string Wpf2 = """
        <helix:HelixAlert Severity="Info" Title="Information" Content="A new version is available." />
        <helix:HelixAlert Severity="Success" Title="Saved" Content="Your settings were applied." />
        <helix:HelixAlert Severity="Warning" Title="Warning" Content="The certificate expires in 7 days." />
        <helix:HelixAlert Severity="Danger" Title="Error" Content="The connection to the server was lost." />
        """;

    private HelixSeverity _severity = HelixSeverity.Info;
    private string? _title = "Update available";
    private string? _text = "A new version is ready. It will be installed at the next restart.";
    private string? _color;
    private bool _closable = true;
    private int _key;

    private async Task Reopen()
    {
        await Task.Delay(800);
        _key++;
    }

    private string Code =>
        $"<HelixAlert{A("Severity", _severity, HelixSeverity.Info)}{A("Title", _title)}{A("Color", _color)}{B("Closable", _closable)}>\n    {_text}\n</HelixAlert>";

    private const string AllCode = """
        <HelixAlert Title="New version">Helix 0.2 is available.</HelixAlert>
        <HelixAlert Severity="HelixSeverity.Success" Title="Payment received">…</HelixAlert>
        <HelixAlert Severity="HelixSeverity.Warning" Title="Storage almost full">…</HelixAlert>
        <HelixAlert Severity="HelixSeverity.Danger" Title="Failed" Closable>…</HelixAlert>
        """;

    private static readonly ApiRow[] Api =
    [
        new("Severity", "HelixSeverity", null, "Info, Success, Warning or Danger."),
        new("Title / ChildContent", "string / RenderFragment", null, "Title and message."),
        new("Closable / OnClose", "bool / EventCallback", null, "Close button."),
        new("Icon / IconContent", "string / RenderFragment", null, "Replaces the severity icon."),
        new("ShowIcon", "bool", null, "Shows the icon (true)."),
        new("Color", "string", "--helix-alert-color", "Replaces the severity color."),
        new("—", "", "--helix-alert-radius", "Corner radius."),
    ];
}
