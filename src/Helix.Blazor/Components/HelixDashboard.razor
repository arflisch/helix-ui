@namespace Helix.Blazor
@inherits HelixComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @attributes="Attributes" class="@(new CssBuilder("helix-dashboard").Add("is-editing", _editing).Add("is-dragging", _dragId is not null).Add(Class).Build())" style="@StyleValue">
    @if (ShowToolbar)
    {
        <div class="helix-dashboard__bar">
            @if (!string.IsNullOrEmpty(Title))
            {
                <h2 class="helix-dashboard__title">@Title</h2>
            }
            @Toolbar
            <div class="helix-dashboard__bar-end">
                @if (_editing)
                {
                    @foreach (var hidden in _layout.Where(s => s.Hidden))
                    {
                        <HelixButton Variant="HelixVariant.Outline" Color="neutral" Size="HelixSize.Sm" Icon="plus" OnClick="() => SetHidden(hidden.Id, false)">
                            @TitleOf(hidden.Id)
                        </HelixButton>
                    }
                    <HelixButton Variant="HelixVariant.Ghost" Color="neutral" Size="HelixSize.Sm" OnClick="Reset">@Texts.Reset</HelixButton>
                    <HelixButton Size="HelixSize.Sm" Icon="check" OnClick="() => SetEditing(false)">@Texts.Done</HelixButton>
                }
                else
                {
                    <HelixButton Variant="HelixVariant.Outline" Color="neutral" Size="HelixSize.Sm" Icon="layout" OnClick="() => SetEditing(true)">@Texts.Customize</HelixButton>
                }
            </div>
        </div>
    }
    @if (_editing)
    {
        <p class="helix-dashboard__hint">@Texts.DashboardEditHint</p>
    }
    <div class="helix-dashboard__grid">
        <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Title { get; set; }

    /// <summary>Content of the toolbar, before the Personnaliser button.</summary>
    [Parameter] public RenderFragment? Toolbar { get; set; }
    [Parameter] public bool ShowToolbar { get; set; } = true;

    [Parameter] public int Columns { get; set; } = 4;

    /// <summary>Saved layout (order, width, hidden) to restore; save it from LayoutChanged.</summary>
    [Parameter] public IReadOnlyList<HelixTileState>? Layout { get; set; }
    [Parameter] public EventCallback<IReadOnlyList<HelixTileState>> LayoutChanged { get; set; }

    /// <summary>Remembers the user's layout under this key (browser or your store, see HelixOptions.SettingsStore).</summary>
    [Parameter] public string? RememberAs { get; set; }

    [Parameter] public bool Editing { get; set; }
    [Parameter] public EventCallback<bool> EditingChanged { get; set; }

    /// <summary>Space between tiles, e.g. "20px".</summary>
    [Parameter] public string? Gap { get; set; }

    private readonly List<HelixDashboardTile> _tiles = [];
    private List<HelixTileState> _layout = [];
    private IReadOnlyList<HelixTileState>? _lastLayoutParam;
    private IReadOnlyList<HelixTileState>? _remembered;
    private bool _editing;
    private bool? _lastEditingParam;
    private string? _dragId;
    private string? _dropId;
    private IJSObjectReference? _module;

    internal bool IsEditing => _editing;
    internal string? DropTargetId => _dragId is null || _dropId == _dragId ? null : _dropId;
    internal string? DraggedId => _dragId;
    internal int ColumnCount => Math.Max(1, Columns);

    private string? StyleValue => new StyleBuilder()
        .Var("--helix-dashboard-cols", ColumnCount.ToString(System.Globalization.CultureInfo.InvariantCulture))
        .Var("--helix-dashboard-gap", Gap)
        .Raw(Style)
        .Build();

    protected override void OnParametersSet()
    {
        if (Editing != _lastEditingParam)
        {
            _lastEditingParam = Editing;
            _editing = Editing;
        }

        if (!ReferenceEquals(Layout, _lastLayoutParam))
        {
            _lastLayoutParam = Layout;
            Merge();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await HelixJs.EnableDndAsync(JS);
            if (RememberAs is { Length: > 0 } key && Layout is null && Settings is { } settings
                && await settings.LoadAsync<List<HelixTileState>>("dashboard:" + key) is { Count: > 0 } saved)
            {
                _remembered = saved;
                Merge();
                StateHasChanged();
            }
        }
    }

    internal void AddTile(HelixDashboardTile tile)
    {
        _tiles.Add(tile);
        Merge();
        StateHasChanged();
    }

    internal void RemoveTile(HelixDashboardTile tile)
    {
        if (_tiles.Remove(tile))
        {
            StateHasChanged();
        }
    }

    /// <summary>Saved layout first (known tiles only), then tiles it doesn't mention, in markup order.</summary>
    private void Merge()
    {
        var known = _tiles.Select(t => t.Id).ToHashSet();
        var merged = (Layout ?? _remembered ?? []).Where(s => known.Contains(s.Id)).DistinctBy(s => s.Id).ToList();
        foreach (var tile in _tiles.Where(t => merged.All(s => s.Id != t.Id)))
        {
            merged.Add(new HelixTileState(tile.Id, tile.DefaultSpan));
        }

        _layout = merged;
    }

    internal (int Order, int Span, bool Hidden) StateOf(string id)
    {
        var index = _layout.FindIndex(s => s.Id == id);
        if (index < 0)
        {
            var tile = _tiles.FirstOrDefault(t => t.Id == id);
            return (int.MaxValue, tile?.DefaultSpan ?? 1, false);
        }

        return (index, Math.Clamp(_layout[index].Span, 1, ColumnCount), _layout[index].Hidden);
    }

    private string TitleOf(string id) => _tiles.FirstOrDefault(t => t.Id == id)?.Title ?? id;

    private async Task Commit(List<HelixTileState> layout)
    {
        _layout = layout;
        _lastLayoutParam = layout;
        StateHasChanged();
        if (RememberAs is { Length: > 0 } key && Settings is { } settings)
        {
            _remembered = layout;
            await settings.SaveAsync("dashboard:" + key, layout);
        }

        await LayoutChanged.InvokeAsync(layout);
    }

    internal Task Resize(string id, int delta)
    {
        var tile = _tiles.FirstOrDefault(t => t.Id == id);
        var max = Math.Min(tile?.MaxSpan ?? ColumnCount, ColumnCount);
        var min = Math.Max(tile?.MinSpan ?? 1, 1);
        return Commit(_layout.Select(s => s.Id == id ? s with { Span = Math.Clamp(s.Span + delta, min, max) } : s).ToList());
    }

    internal Task SetHidden(string id, bool hidden) =>
        Commit(_layout.Select(s => s.Id == id ? s with { Hidden = hidden } : s).ToList());

    /// <summary>Moves a tile one step among the visible ones (keyboard alternative to dragging).</summary>
    internal Task Shift(string id, int direction)
    {
        var visible = _layout.Where(s => !s.Hidden).ToList();
        var index = visible.FindIndex(s => s.Id == id);
        var target = index + direction;
        return target < 0 || target >= visible.Count ? Task.CompletedTask : MoveBefore(id, visible[target].Id, after: direction > 0);
    }

    private Task MoveBefore(string id, string targetId, bool after)
    {
        var list = _layout.ToList();
        var moving = list.First(s => s.Id == id);
        list.Remove(moving);
        var targetIndex = list.FindIndex(s => s.Id == targetId);
        list.Insert(after ? targetIndex + 1 : targetIndex, moving);
        return Commit(list);
    }

    internal void DragStart(string id) => (_dragId, _dropId) = (id, id);

    internal void DragEnter(string id)
    {
        if (_dragId is not null && _dropId != id)
        {
            _dropId = id;
            StateHasChanged();
        }
    }

    internal async Task Drop()
    {
        if (_dragId is { } from && _dropId is { } to && from != to)
        {
            var fromIndex = _layout.FindIndex(s => s.Id == from);
            var toIndex = _layout.FindIndex(s => s.Id == to);
            await MoveBefore(from, to, after: fromIndex < toIndex);
        }

        DragEnd();
    }

    internal void DragEnd()
    {
        _dragId = null;
        _dropId = null;
        StateHasChanged();
    }

    private async Task SetEditing(bool editing)
    {
        _editing = editing;
        await EditingChanged.InvokeAsync(editing);
    }

    private Task Reset() => Commit(_tiles.Select(t => new HelixTileState(t.Id, t.DefaultSpan)).ToList());

    public ValueTask DisposeAsync() => HelixJs.DisposeQuietlyAsync(_module);
}
