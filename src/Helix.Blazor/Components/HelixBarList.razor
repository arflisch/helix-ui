@namespace Helix.Blazor
@inherits HelixComponentBase
@using System.Globalization

@{
    var rows = Sorted();
    var max = MaxValue ?? (rows.Count == 0 ? 1 : Math.Max(rows.Max(r => r.Value), 1e-9));
    var shown = _expanded || Limit is null ? rows : rows.Take(Limit.Value).ToList();
}

<div @attributes="Attributes" class="@(new CssBuilder("helix-barlist").Add(Class).Build())" style="@StyleValue">
    @if (!string.IsNullOrEmpty(LabelHeader) || !string.IsNullOrEmpty(ValueHeader))
    {
        <div class="helix-barlist__head" aria-hidden="true">
            <span>@LabelHeader</span>
            <span>@ValueHeader</span>
        </div>
    }
    <ol class="helix-barlist__list" aria-label="@AriaLabel">
        @foreach (var item in shown)
        {
            var pct = Math.Clamp(item.Value / max * 100, 0, 100);
            var clickable = OnItemClick.HasDelegate || !string.IsNullOrEmpty(item.Href);
            <li class="@(new CssBuilder("helix-barlist__row").Add("is-clickable", clickable).Build())">
                <span class="helix-barlist__bar" style="width:@HelixScale.Pct(pct)"></span>
                @if (!string.IsNullOrEmpty(item.Href))
                {
                    <a class="helix-barlist__label" href="@item.Href">@Label(item)</a>
                }
                else if (OnItemClick.HasDelegate)
                {
                    <button type="button" class="helix-barlist__label" @onclick="() => OnItemClick.InvokeAsync(item)">@Label(item)</button>
                }
                else
                {
                    <span class="helix-barlist__label">@Label(item)</span>
                }
                <span class="helix-barlist__value">@Format(item.Value)</span>
            </li>
        }
    </ol>
    @if (Limit is { } limit && rows.Count > limit)
    {
        <button type="button" class="helix-barlist__more" aria-expanded="@(_expanded ? "true" : "false")" @onclick="() => _expanded = !_expanded">
            @(_expanded ? Texts.ShowLess : HelixTexts.Format(Texts.ShowAll, rows.Count))
            <HelixIcon Name="chevron-down" Size="14" Class="@(_expanded ? "is-flipped" : null)" />
        </button>
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<HelixBarItem> Items { get; set; } = [];

    /// <summary>Largest first (true by default).</summary>
    [Parameter] public bool Sort { get; set; } = true;

    /// <summary>Rows shown before "Voir tout".</summary>
    [Parameter] public int? Limit { get; set; } = 5;

    /// <summary>Value of a full bar (otherwise the largest value).</summary>
    [Parameter] public double? MaxValue { get; set; }

    [Parameter] public string ValueFormat { get; set; } = "#,0.##";
    [Parameter] public string? Unit { get; set; }
    [Parameter] public string? LabelHeader { get; set; }
    [Parameter] public string? ValueHeader { get; set; }

    /// <summary>Bar color (a single hue: the bars compare one measure).</summary>
    [Parameter] public string? Color { get; set; }
    [Parameter] public EventCallback<HelixBarItem> OnItemClick { get; set; }
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public CultureInfo? Culture { get; set; }

    private bool _expanded;

    private string? StyleValue => new StyleBuilder().Color("barlist", Color).Raw(Style).Build();

    private List<HelixBarItem> Sorted() => Sort ? Items.OrderByDescending(i => i.Value).ToList() : Items.ToList();

    private string Format(double value) =>
        value.ToString(ValueFormat, Culture ?? CultureInfo.CurrentCulture) + (string.IsNullOrEmpty(Unit) ? "" : $" {Unit}");

    private static RenderFragment Label(HelixBarItem item) => __builder =>
    {
        @if (!string.IsNullOrEmpty(item.Icon))
        {
            <HelixIcon Name="@item.Icon" Size="14" />
        }
        <span class="helix-barlist__text">@item.Label</span>
    };
}
