@namespace Helix.Blazor
@inherits HelixComponentBase

@if (!string.IsNullOrEmpty(Href) && !Disabled)
{
    <a @attributes="Attributes" role="menuitem" href="@Href" class="@ClassValue" style="@Style" @onclick="() => Menu?.Close(returnFocus: false)">
        @Content
    </a>
}
else
{
    <button @attributes="Attributes" type="button" role="menuitem" class="@ClassValue" style="@Style" disabled="@Disabled" @onclick="Click">
        @Content
    </button>
}

@code {
    [CascadingParameter] private HelixMenu? Menu { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Icon { get; set; }

    /// <summary>Text shown on the right, e.g. "⌘D". Display only.</summary>
    [Parameter] public string? Shortcut { get; set; }

    /// <summary>Smaller second line.</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Red item for destructive actions.</summary>
    [Parameter] public bool Danger { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Check mark on the left (toggle items).</summary>
    [Parameter] public bool Checked { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private string ClassValue => new CssBuilder("helix-menu__item").Add("is-danger", Danger).Add("is-checked", Checked).Add(Class).Build();

    private RenderFragment Content => __builder =>
    {
        <span class="helix-menu__icon" aria-hidden="true">
            @if (Checked)
            {
                <HelixIcon Name="check" Size="15" />
            }
            else if (!string.IsNullOrEmpty(Icon))
            {
                <HelixIcon Name="@Icon" Size="15" />
            }
        </span>
        <span class="helix-menu__text">
            <span>@ChildContent</span>
            @if (!string.IsNullOrEmpty(Description))
            {
                <span class="helix-menu__description">@Description</span>
            }
        </span>
        @if (!string.IsNullOrEmpty(Shortcut))
        {
            <kbd class="helix-menu__shortcut">@Shortcut</kbd>
        }
    };

    private async Task Click()
    {
        Menu?.Close();
        await OnClick.InvokeAsync();
    }
}
