@namespace Helix.Blazor
@typeparam TValue
@inherits HelixListPicker<TValue>

<HelixFieldFrame Id="@Id" Label="@Label" Hint="@Hint" Error="@Error" Required="Required" Disabled="Disabled" Class="@Class" Style="@FieldStyle">
    <div class="@(new CssBuilder("helix-select").Add("is-open", IsOpen).Build())">
        <button @attributes="Attributes"
                id="@Id"
                type="button"
                class="helix-input helix-select__trigger"
                disabled="@Disabled"
                aria-haspopup="listbox"
                aria-expanded="@(IsOpen ? "true" : "false")"
                aria-invalid="@(string.IsNullOrEmpty(Error) ? null : "true")"
                aria-describedby="@HelixFieldFrame.DescribedBy(Id, Hint, Error)"
                @onclick="Toggle"
                @onkeydown="OnListKey"
                @onkeydown:preventDefault="IsOpen">
            @Prefix
            <span class="@(new CssBuilder("helix-select__value").Add("is-placeholder", !HasValue).Build())">
                @(HasValue ? TextOf(Value!) : Placeholder ?? Texts.SelectPlaceholder)
            </span>
            @Suffix
            <HelixIcon Name="chevron-down" Class="helix-select__chevron" />
        </button>

        @if (IsOpen)
        {
            <div class="helix-select__backdrop" @onclick="Close"></div>
            <div class="helix-select__menu" role="presentation">
                @if (HasSearch)
                {
                    <div class="helix-select__search">
                        <HelixIcon Name="search" Size="14" />
                        <input @ref="SearchBox" type="text" value="@SearchText" placeholder="@(SearchPlaceholder ?? Texts.Search)" aria-label="@(SearchPlaceholder ?? Texts.Search)"
                               aria-controls="@($"{Id}-list")" autocomplete="off" @oninput="OnSearchInput" @onkeydown="OnListKey" />
                        @if (Searching)
                        {
                            <HelixSpinner Size="14px" />
                        }
                    </div>
                }
                <ul class="helix-select__list" id="@($"{Id}-list")" role="listbox">
                    @for (var i = 0; i < Visible.Count; i++)
                    {
                        var index = i;
                        var item = Visible[i];
                        var selected = IsSelected(item);
                        <li role="option"
                            aria-selected="@(selected ? "true" : "false")"
                            class="@(new CssBuilder("helix-select__option").Add("is-selected", selected).Add("is-active", index == Active).Build())"
                            @onclick="() => Choose(item)"
                            @onmouseenter="() => Active = index">
                            <span class="helix-select__option-text">@if (ItemTemplate is not null) { @ItemTemplate(item) } else { @TextOf(item) }</span>
                            @if (selected)
                            {
                                <HelixIcon Name="check" Size="15" />
                            }
                        </li>
                    }
                    @if (Visible.Count == 0 && !Searching)
                    {
                        <li class="helix-select__empty" role="presentation">
                            @(EmptyText ?? (string.IsNullOrWhiteSpace(SearchText) ? Texts.NoData : HelixTexts.Format(Texts.NoResultsFor, SearchText.Trim())))
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</HelixFieldFrame>

@code {
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    private bool HasValue => Value is not null && (AllItems.Any(IsSelected) || SearchProvider is not null);

    protected override bool IsSelected(TValue item) => EqualityComparer<TValue>.Default.Equals(item, Value);

    protected override async Task Choose(TValue item)
    {
        Value = item;
        Close();
        await ValueChanged.InvokeAsync(item);
    }
}
