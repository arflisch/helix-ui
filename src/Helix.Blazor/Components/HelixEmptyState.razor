@namespace Helix.Blazor
@inherits HelixComponentBase

<div @attributes="Attributes" class="@(new CssBuilder("helix-empty").Add("helix-empty--compact", Compact).Add("helix-empty--framed", Framed).Add(Class).Build())" style="@(new StyleBuilder().Color("empty", Color).Raw(Style).Build())">
    <span class="helix-empty__art" aria-hidden="true">
        <span class="helix-empty__ring"></span>
        <HelixIcon Name="@Icon" Size="@(Compact ? 18 : 24)" />
    </span>
    @if (!string.IsNullOrEmpty(Title))
    {
        <p class="helix-empty__title">@Title</p>
    }
    @if (!string.IsNullOrEmpty(Description))
    {
        <p class="helix-empty__description">@Description</p>
    }
    @if (Actions is not null)
    {
        <div class="helix-empty__actions">@Actions</div>
    }
</div>

@code {
    [Parameter] public string Icon { get; set; } = "search";
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public bool Compact { get; set; }

    /// <summary>Dashed frame, e.g. for an empty zone in a page.</summary>
    [Parameter] public bool Framed { get; set; }
    [Parameter] public string? Color { get; set; }
}
