@namespace Helix.Blazor
@implements IDisposable

@* A reference line: horizontal (Y = threshold) or vertical (At = event time). *@

@code {
    [CascadingParameter] private HelixChart? Chart { get; set; }

    /// <summary>Horizontal line at this value.</summary>
    [Parameter] public double? Y { get; set; }

    /// <summary>Vertical line at this X (numeric axis).</summary>
    [Parameter] public double? X { get; set; }

    /// <summary>Vertical line at this time (time axis).</summary>
    [Parameter] public DateTime? At { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public bool Dashed { get; set; } = true;

    internal double? XValue => At is { } at ? HelixTime.ToX(at) : X;

    private object? _signature;

    protected override void OnInitialized()
    {
        if (Chart is null)
        {
            throw new InvalidOperationException($"{nameof(HelixChartLine)} must be placed inside a {nameof(HelixChart)}.");
        }

        _signature = (Y, X, At, Label, Color, Dashed);
        Chart.AddLine(this);
    }

    protected override void OnParametersSet()
    {
        var signature = (Y, X, At, Label, Color, Dashed);
        if (!Equals(signature, _signature))
        {
            _signature = signature;
            Chart?.Invalidate();
        }
    }

    public void Dispose() => Chart?.RemoveLine(this);
}
