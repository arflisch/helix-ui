@namespace Helix.Blazor
@inherits HelixComponentBase

@if (!_closed)
{
    <div @attributes="Attributes" role="alert" class="@(new CssBuilder("helix-alert").Add(Class).Build())" style="@StyleValue">
        @if (ShowIcon)
        {
            <span class="helix-alert__icon">
                @if (IconContent is not null)
                {
                    @IconContent
                }
                else
                {
                    <HelixIcon Name="@(Icon ?? HelixColor.FromSeverity(Severity))" Size="18" />
                }
            </span>
        }
        <div class="helix-alert__content">
            @if (!string.IsNullOrEmpty(Title))
            {
                <p class="helix-alert__title">@Title</p>
            }
            @ChildContent
        </div>
        @if (Closable)
        {
            <button type="button" class="helix-close" aria-label="@Texts.Close" @onclick="Close">
                <HelixIcon Name="x" Size="14" />
            </button>
        }
    </div>
}

@code {
    [Parameter] public HelixSeverity Severity { get; set; } = HelixSeverity.Info;
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Closable { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool ShowIcon { get; set; } = true;

    /// <summary>Built-in icon name (defaults to the severity icon).</summary>
    [Parameter] public string? Icon { get; set; }

    /// <summary>Any markup as icon.</summary>
    [Parameter] public RenderFragment? IconContent { get; set; }

    /// <summary>Overrides the severity color.</summary>
    [Parameter] public string? Color { get; set; }

    private bool _closed;

    private string? StyleValue => new StyleBuilder()
        .Color("alert", Color ?? HelixColor.FromSeverity(Severity))
        .Raw(Style)
        .Build();

    private async Task Close()
    {
        _closed = true;
        await OnClose.InvokeAsync();
    }
}
