@namespace Helix.Blazor
@inherits HelixComponentBase
@implements IAsyncDisposable
@typeparam TItem
@inject IJSRuntime JS

@if (Layout == HelixTreeLayout.Diagram)
{
    <div @attributes="Attributes" class="@(new CssBuilder("helix-tree helix-tree--diagram").Add(Class).Build())" style="@Style">
        <ul @ref="_root" class="helix-org" role="tree" tabindex="0" aria-label="@AriaLabel"
            aria-activedescendant="@(_active is null ? null : NodeId(_active))" @onkeydown="OnKey" @onfocus="EnsureActive">
            @foreach (var root in Items)
            {
                @DiagramNode(root, 1)
            }
        </ul>
    </div>
}
else
{
    <ul @attributes="Attributes" @ref="_root" class="@(new CssBuilder("helix-tree helix-tree--list").Add("has-lines", ShowLines).Add(Class).Build())" style="@Style"
        role="tree" tabindex="0" aria-label="@AriaLabel"
        aria-activedescendant="@(_active is null ? null : NodeId(_active))" @onkeydown="OnKey" @onfocus="EnsureActive">
        @foreach (var root in Items)
        {
            @ListNode(root, 1)
        }
    </ul>
}

@code {
    /// <summary>The root items.</summary>
    [Parameter, EditorRequired] public IEnumerable<TItem> Items { get; set; } = [];

    /// <summary>Children of an item (null or empty = leaf).</summary>
    [Parameter, EditorRequired] public Func<TItem, IEnumerable<TItem>?> ChildrenOf { get; set; } = _ => null;

    [Parameter] public Func<TItem, string>? ItemText { get; set; }
    [Parameter] public Func<TItem, string?>? ItemIcon { get; set; }

    /// <summary>Second line in diagram nodes (role, count…).</summary>
    [Parameter] public Func<TItem, string?>? ItemDescription { get; set; }

    /// <summary>Free content of a node.</summary>
    [Parameter] public RenderFragment<TItem>? ItemTemplate { get; set; }

    /// <summary>List (explorer) or Diagram (org chart, top-down).</summary>
    [Parameter] public HelixTreeLayout Layout { get; set; } = HelixTreeLayout.List;

    /// <summary>Levels expanded at first render (1 = roots open).</summary>
    [Parameter] public int ExpandDepth { get; set; } = 1;

    [Parameter] public TItem? SelectedItem { get; set; }
    [Parameter] public EventCallback<TItem?> SelectedItemChanged { get; set; }

    /// <summary>Identity of an item (expansion and selection survive new instances).</summary>
    [Parameter] public Func<TItem, object>? ItemKey { get; set; }

    /// <summary>Vertical guide lines in list mode.</summary>
    [Parameter] public bool ShowLines { get; set; } = true;
    [Parameter] public string AriaLabel { get; set; } = "Arborescence";

    private readonly string _prefix = HelixId.Next("tree");
    private readonly HashSet<object> _expanded = [];
    private object? _active;
    private bool _initialized;
    private ElementReference _root;
    private IJSObjectReference? _module;

    private object KeyOf(TItem item) => ItemKey?.Invoke(item) ?? item!;
    private string NodeId(object key) => $"{_prefix}-{Math.Abs(key.GetHashCode())}";
    private string TextOf(TItem item) => ItemText?.Invoke(item) ?? item?.ToString() ?? "";
    private List<TItem> Children(TItem item) => ChildrenOf(item)?.ToList() ?? [];
    private bool IsSelected(TItem item) => SelectedItem is not null && Equals(KeyOf(SelectedItem), KeyOf(item));

    protected override void OnParametersSet()
    {
        if (_initialized)
        {
            return;
        }

        _initialized = true;
        void Expand(IEnumerable<TItem> items, int depth)
        {
            if (depth > ExpandDepth)
            {
                return;
            }

            foreach (var item in items)
            {
                var children = Children(item);
                if (children.Count > 0)
                {
                    _expanded.Add(KeyOf(item));
                    Expand(children, depth + 1);
                }
            }
        }

        Expand(Items, 1);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", HelixJs.Path);
                await _module.InvokeVoidAsync("preventKeys", _root, new[] { "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight", "Home", "End", " " });
            }
            catch (JSDisconnectedException)
            {
                // Circuit closed.
            }
        }
    }

    public void Expand(TItem item) => _expanded.Add(KeyOf(item));
    public void Collapse(TItem item) => _expanded.Remove(KeyOf(item));

    private void Toggle(TItem item)
    {
        if (!_expanded.Remove(KeyOf(item)))
        {
            _expanded.Add(KeyOf(item));
        }
    }

    private async Task Select(TItem item)
    {
        _active = KeyOf(item);
        SelectedItem = item;
        await SelectedItemChanged.InvokeAsync(item);
    }

    // ----- Keyboard (WAI-ARIA tree pattern) ---------------------------------------------------

    private List<(TItem Item, TItem? Parent)> Visible()
    {
        var list = new List<(TItem, TItem?)>();
        void Walk(IEnumerable<TItem> items, TItem? parent)
        {
            foreach (var item in items)
            {
                list.Add((item, parent));
                if (_expanded.Contains(KeyOf(item)))
                {
                    Walk(Children(item), item);
                }
            }
        }

        Walk(Items, default);
        return list;
    }

    private void EnsureActive()
    {
        if (_active is null)
        {
            var first = SelectedItem is not null ? (object?)KeyOf(SelectedItem) : Visible().Select(v => (object?)KeyOf(v.Item)).FirstOrDefault();
            _active = first;
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        var visible = Visible();
        if (visible.Count == 0)
        {
            return;
        }

        var index = Math.Max(0, visible.FindIndex(v => Equals(KeyOf(v.Item), _active)));
        var (item, parent) = visible[index];
        var expanded = _expanded.Contains(KeyOf(item));
        var hasChildren = Children(item).Count > 0;
        var horizontal = Layout == HelixTreeLayout.Diagram;

        switch (e.Key)
        {
            case "ArrowDown":
                _active = KeyOf(visible[Math.Min(index + 1, visible.Count - 1)].Item);
                break;
            case "ArrowUp":
                _active = KeyOf(visible[Math.Max(index - 1, 0)].Item);
                break;
            case "ArrowRight":
                if (hasChildren && !expanded) _expanded.Add(KeyOf(item));
                else if (hasChildren) _active = KeyOf(Children(item)[0]);
                break;
            case "ArrowLeft":
                if (hasChildren && expanded) _expanded.Remove(KeyOf(item));
                else if (parent is not null) _active = KeyOf(parent);
                break;
            case "Home":
                _active = KeyOf(visible[0].Item);
                break;
            case "End":
                _active = KeyOf(visible[^1].Item);
                break;
            case "Enter" or " ":
                await Select(item);
                if (hasChildren && e.Key == "Enter" && !horizontal) Toggle(item);
                break;
        }
    }

    // ----- Rendering -------------------------------------------------------------------------

    private RenderFragment Label(TItem item) => __builder =>
    {
        @if (ItemTemplate is not null)
        {
            @ItemTemplate(item)
        }
        else
        {
            if (ItemIcon?.Invoke(item) is { } icon)
            {
                <HelixIcon Name="@icon" Size="15" Class="helix-tree__icon" />
            }
            <span class="helix-tree__text">@TextOf(item)</span>
        }
    };

    private RenderFragment ListNode(TItem item, int level) => __builder =>
    {
        var key = KeyOf(item);
        var children = Children(item);
        var expanded = _expanded.Contains(key);
        <li role="treeitem" id="@NodeId(key)" aria-level="@level" aria-selected="@(IsSelected(item) ? "true" : "false")"
            aria-expanded="@(children.Count > 0 ? (expanded ? "true" : "false") : null)" class="helix-tree__node">
            <div class="@(new CssBuilder("helix-tree__row").Add("is-selected", IsSelected(item)).Add("is-active", Equals(_active, key)).Build())"
                 style="--_level:@(level - 1)" @onclick="() => Select(item)">
                @if (children.Count > 0)
                {
                    <span class="@(new CssBuilder("helix-tree__toggle").Add("is-open", expanded).Build())" @onclick="() => Toggle(item)" @onclick:stopPropagation="true">
                        <HelixIcon Name="chevron-right" Size="14" />
                    </span>
                }
                else
                {
                    <span class="helix-tree__toggle is-leaf"></span>
                }
                @Label(item)
                @if (children.Count > 0 && !expanded)
                {
                    <span class="helix-tree__count">@children.Count</span>
                }
            </div>
            @if (children.Count > 0 && expanded)
            {
                <ul role="group" class="helix-tree__group" style="--_level:@(level - 1)">
                    @foreach (var child in children)
                    {
                        @ListNode(child, level + 1)
                    }
                </ul>
            }
        </li>
    };

    private RenderFragment DiagramNode(TItem item, int level) => __builder =>
    {
        var key = KeyOf(item);
        var children = Children(item);
        var expanded = _expanded.Contains(key);
        var description = ItemDescription?.Invoke(item);
        <li role="treeitem" id="@NodeId(key)" aria-level="@level" aria-selected="@(IsSelected(item) ? "true" : "false")"
            aria-expanded="@(children.Count > 0 ? (expanded ? "true" : "false") : null)">
            <div class="@(new CssBuilder("helix-org__node").Add("is-selected", IsSelected(item)).Add("is-active", Equals(_active, key)).Build())"
                 @onclick="() => Select(item)">
                <div class="helix-org__label">@Label(item)</div>
                @if (!string.IsNullOrEmpty(description))
                {
                    <div class="helix-org__description">@description</div>
                }
                @if (children.Count > 0)
                {
                    <span class="helix-org__toggle" title="@(expanded ? Texts.Collapse : HelixTexts.Format(Texts.ExpandCount, children.Count))"
                          @onclick="() => Toggle(item)" @onclick:stopPropagation="true">
                        @(expanded ? "−" : children.Count.ToString())
                    </span>
                }
            </div>
            @if (children.Count > 0 && expanded)
            {
                <ul role="group">
                    @foreach (var child in children)
                    {
                        @DiagramNode(child, level + 1)
                    }
                </ul>
            }
        </li>
    };

    public ValueTask DisposeAsync() => HelixJs.DisposeQuietlyAsync(_module);
}
