@namespace Helix.Blazor
@inherits HelixComponentBase

<HelixFieldFrame Id="@_id" Label="@Label" Hint="@Hint" Error="@Error" Required="Required" Disabled="Disabled" Class="@Class" Style="@FieldStyle">
    <div class="helix-input">
        @if (!string.IsNullOrEmpty(Icon))
        {
            <span class="helix-input__affix"><HelixIcon Name="@Icon" /></span>
        }
        @Prefix
        <input @attributes="Attributes"
               id="@_id"
               class="helix-input__control"
               type="@Type"
               value="@Value"
               placeholder="@Placeholder"
               disabled="@Disabled"
               readonly="@ReadOnly"
               required="@Required"
               aria-invalid="@(string.IsNullOrEmpty(Error) ? null : "true")"
               aria-describedby="@HelixFieldFrame.DescribedBy(_id, Hint, Error)"
               @oninput="OnInput" />
        @if ((Clearable ?? Defaults.Field.Clearable ?? false) && !string.IsNullOrEmpty(Value) && !Disabled && !ReadOnly)
        {
            <button type="button" class="helix-close helix-input__clear" aria-label="@Texts.Clear" @onclick="Clear">
                <HelixIcon Name="x" Size="14" />
            </button>
        }
        @Suffix
    </div>
</HelixFieldFrame>

@code {
    /// <summary>Content at the start of the input (icon, sign, currency…).</summary>
    [Parameter] public RenderFragment? Prefix { get; set; }

    /// <summary>Content at the end of the input (unit, button…).</summary>
    [Parameter] public RenderFragment? Suffix { get; set; }

    /// <summary>Help text under the field, announced with it.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Shows the field in error state with this message (replaces the hint).</summary>
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Required { get; set; }

    /// <summary>Focus color. Null: HelixOptions.Defaults.Field.Color, else primary.</summary>
    [Parameter] public string? Color { get; set; }
    [Parameter] public string? Radius { get; set; }
    [Parameter] public string? Background { get; set; }
    [Parameter] public string? BorderColor { get; set; }

    private string? FieldStyle => new StyleBuilder()
        .Color("input", Color)
        .Var("--helix-input-radius", Radius)
        .Var("--helix-input-bg", Background)
        .Var("--helix-input-border", BorderColor)
        .Raw(Style)
        .Build();

    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }


    /// <summary>Built-in icon name displayed at the start.</summary>
    [Parameter] public string? Icon { get; set; }

    [Parameter] public string Type { get; set; } = "text";
    /// <summary>The × button. Null: HelixOptions.Defaults.Field.Clearable, else false.</summary>
    [Parameter] public bool? Clearable { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool ReadOnly { get; set; }


    private readonly string _id = HelixId.Next("input");

    private Task OnInput(ChangeEventArgs e)
    {
        Value = e.Value?.ToString();
        return ValueChanged.InvokeAsync(Value);
    }

    private Task Clear()
    {
        Value = string.Empty;
        return ValueChanged.InvokeAsync(Value);
    }
}
