@namespace Helix.Blazor
@inherits HelixComponentBase
@implements IAsyncDisposable
@typeparam TItem
@inject IJSRuntime JS

<div @attributes="Attributes" @ref="_root" class="@(new CssBuilder("helix-kanban").Add("is-dragging", _drag is not null).Add(Class).Build())" style="@StyleValue">
    @foreach (var column in Columns)
    {
        var cards = CardsOf(column.Key);
        var count = cards.Count;
        var over = column.Limit is { } limit && count > limit;
        var refused = _drag is not null && _dropColumn == column.Key && !Allowed(_drag.Value.Item, column.Key);
        <section class="@(new CssBuilder("helix-kanban__column").Add("is-over-limit", over).Add("is-drop-target", _drag is not null && _dropColumn == column.Key && !refused).Add("is-refused", refused).Build())"
                 style="--_c:@ColorOf(column)"
                 aria-label="@column.Title"
                 @ondragenter="() => EnterColumn(column.Key, count)"
                 @ondragover:preventDefault="true"
                 @ondrop="Drop">
            <header class="helix-kanban__header">
                <span class="helix-kanban__dot"></span>
                <h4 class="helix-kanban__title">@column.Title</h4>
                <span class="helix-kanban__count" title="@(column.Limit is null ? null : $"Limite : {column.Limit}")">
                    @count@(column.Limit is null ? "" : $" / {column.Limit}")
                </span>
                @if (OnAdd.HasDelegate)
                {
                    <button type="button" class="helix-close helix-kanban__add" aria-label="Ajouter dans @column.Title" @onclick="() => OnAdd.InvokeAsync(column.Key)">
                        <HelixIcon Name="plus" Size="15" />
                    </button>
                }
            </header>
            <div class="helix-kanban__cards">
                @for (var j = 0; j < cards.Count; j++)
                {
                    var index = j;
                    var card = cards[j];
                    var isDragged = _drag is { } d && Equals(d.Item, card);
                    if (ShowDropLine(column.Key, index))
                    {
                        <div class="helix-kanban__drop-line" aria-hidden="true"></div>
                    }
                    <article @key="KeyOf(card)"
                             data-helix-key="@KeyOf(card)"
                             class="@(new CssBuilder("helix-kanban__card").Add("is-dragged", isDragged).Add("is-grabbed", _grabbed is { } g && Equals(g, card)).Add("is-clickable", OnCardClick.HasDelegate).Build())"
                             draggable="true"
                             data-helix-drag
                             tabindex="0"
                             aria-roledescription="@Texts.DraggableCard"
                             @ondragstart="() => DragStart(card, column.Key)"
                             @ondragenter="() => EnterCard(column.Key, index)"
                             @ondragenter:stopPropagation="true"
                             @ondragend="DragEnd"
                             @onclick="() => OnCardClick.InvokeAsync(card)"
                             @onkeydown="e => OnKey(e, card, column.Key, index)"
                             @onkeydown:preventDefault="_grabbed is not null">
                        @if (CardTemplate is not null)
                        {
                            @CardTemplate(card)
                        }
                        else
                        {
                            @card
                        }
                    </article>
                }
                @if (ShowDropLine(column.Key, count))
                {
                    <div class="helix-kanban__drop-line" aria-hidden="true"></div>
                }
                @if (count == 0)
                {
                    <p class="helix-kanban__empty">@(EmptyText ?? Texts.DropCardHere)</p>
                }
            </div>
        </section>
    }
</div>
<div class="helix-sr-only" aria-live="assertive">@_announcement</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<TItem> Items { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<HelixKanbanColumn> Columns { get; set; } = [];

    /// <summary>Which column a card belongs to, e.g. t => t.Status.</summary>
    [Parameter, EditorRequired] public Func<TItem, string> ColumnOf { get; set; } = _ => "";

    [Parameter] public RenderFragment<TItem>? CardTemplate { get; set; }

    /// <summary>Apply it with move.ApplyTo(list, …) or your own logic (API call…).</summary>
    [Parameter] public EventCallback<HelixKanbanMove<TItem>> OnCardMoved { get; set; }

    [Parameter] public EventCallback<TItem> OnCardClick { get; set; }

    /// <summary>Shows a + button in each column header.</summary>
    [Parameter] public EventCallback<string> OnAdd { get; set; }

    /// <summary>Rules, e.g. (card, column) => column != "done" || card.Reviewed. Refused columns are flagged while dragging.</summary>
    [Parameter] public Func<TItem, string, bool>? CanMove { get; set; }

    [Parameter] public Func<TItem, object>? ItemKey { get; set; }
    [Parameter] public string? EmptyText { get; set; }

    /// <summary>Column width, e.g. "300px".</summary>
    [Parameter] public string? ColumnWidth { get; set; }

    private (TItem Item, string From)? _drag;
    private string? _dropColumn;
    private int _dropIndex;
    private TItem? _grabbed;
    private (string Column, int Index)? _grabOrigin;
    private string? _announcement;
    private IJSObjectReference? _module;
    private ElementReference _root;
    private string? _focusKey;

    private string? StyleValue => new StyleBuilder().Var("--helix-kanban-column-w", ColumnWidth).Raw(Style).Build();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await HelixJs.EnableDndAsync(JS);
        }

        if (_focusKey is { } key && _module is not null)
        {
            _focusKey = null;
            await _module.InvokeVoidAsync("focusKey", _root, key);
        }
    }

    private object KeyOf(TItem item) => ItemKey?.Invoke(item) ?? item!;

    private List<TItem> CardsOf(string column) => Items.Where(i => ColumnOf(i) == column).ToList();

    private static string ColorOf(HelixKanbanColumn column) =>
        column.Color is null ? "var(--helix-text-subtle)" : HelixColor.Resolve(column.Color).Value;

    private bool Allowed(TItem item, string column) => CanMove?.Invoke(item, column) ?? true;

    /// <summary>The drop line shows where the card lands, except right around its own position.</summary>
    private bool ShowDropLine(string column, int index)
    {
        if (_drag is not { } drag || _dropColumn != column || _dropIndex != index || !Allowed(drag.Item, column))
        {
            return false;
        }

        if (drag.From != column)
        {
            return true;
        }

        var current = CardsOf(column).IndexOf(drag.Item);
        return index != current && index != current + 1;
    }

    private void DragStart(TItem item, string column)
    {
        _drag = (item, column);
        _dropColumn = column;
        _dropIndex = CardsOf(column).IndexOf(item);
    }

    private void EnterCard(string column, int index)
    {
        if (_drag is not null)
        {
            _dropColumn = column;
            _dropIndex = index;
        }
    }

    private void EnterColumn(string column, int count)
    {
        if (_drag is not null && _dropColumn != column)
        {
            _dropColumn = column;
            _dropIndex = count;
        }
    }

    private async Task Drop()
    {
        if (_drag is { } drag && _dropColumn is { } column && Allowed(drag.Item, column))
        {
            // Index counted without the moved card.
            var index = _dropIndex;
            if (drag.From == column && CardsOf(column).IndexOf(drag.Item) < index)
            {
                index--;
            }

            var unchanged = drag.From == column && CardsOf(column).IndexOf(drag.Item) == index;
            if (!unchanged)
            {
                await OnCardMoved.InvokeAsync(new HelixKanbanMove<TItem>(drag.Item, drag.From, column, index));
            }
        }

        DragEnd();
    }

    private void DragEnd()
    {
        _drag = null;
        _dropColumn = null;
    }

    private async Task OnKey(KeyboardEventArgs e, TItem card, string column, int index)
    {
        switch (e.Key)
        {
            case "Enter" when _grabbed is null:
                _grabbed = card;
                _grabOrigin = (column, index);
                _announcement = Texts.CardGrabbed;
                break;
            case "Enter" or " " when _grabbed is not null:
                _announcement = HelixTexts.Format(Texts.CardDroppedIn, Columns.FirstOrDefault(c => c.Key == column)?.Title, index + 1);
                _grabbed = default;
                _grabOrigin = null;
                break;
            case "Escape" when _grabbed is not null && _grabOrigin is { } origin:
                await MoveTo(card, column, origin.Column, origin.Index);
                _announcement = Texts.MoveCancelled;
                _grabbed = default;
                _grabOrigin = null;
                break;
            case "ArrowLeft" or "ArrowRight" when _grabbed is not null:
                var columnIndex = Columns.ToList().FindIndex(c => c.Key == column);
                var next = Columns.ElementAtOrDefault(columnIndex + (e.Key == "ArrowLeft" ? -1 : 1));
                if (next is not null && Allowed(card, next.Key))
                {
                    var target = Math.Min(index, CardsOf(next.Key).Count);
                    await MoveTo(card, column, next.Key, target);
                    _announcement = $"{next.Title}, position {target + 1}.";
                }

                break;
            case "ArrowUp" or "ArrowDown" when _grabbed is not null:
                var count = CardsOf(column).Count;
                var to = Math.Clamp(index + (e.Key == "ArrowUp" ? -1 : 1), 0, count - 1);
                if (to != index)
                {
                    await MoveTo(card, column, column, to);
                    _announcement = HelixTexts.Format(Texts.PositionAnnouncement, to + 1, count);
                }

                break;
        }
    }

    private Task MoveTo(TItem card, string from, string to, int index)
    {
        _focusKey = KeyOf(card).ToString();
        return OnCardMoved.InvokeAsync(new HelixKanbanMove<TItem>(card, from, to, index));
    }

    public ValueTask DisposeAsync() => HelixJs.DisposeQuietlyAsync(_module);
}
