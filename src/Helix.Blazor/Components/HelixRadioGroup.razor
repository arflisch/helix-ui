@namespace Helix.Blazor
@inherits HelixComponentBase
@typeparam TValue

<fieldset @attributes="Attributes" class="@ClassValue" style="@StyleValue" disabled="@Disabled">
    @if (!string.IsNullOrEmpty(Label))
    {
        <legend class="helix-field__label">@Label</legend>
    }
    <div class="helix-radio-group__options">
        @foreach (var item in Items)
        {
            var selected = EqualityComparer<TValue>.Default.Equals(item, Value);
            var disabled = ItemDisabled?.Invoke(item) ?? false;
            var description = ItemDescription?.Invoke(item);
            <label class="@(new CssBuilder("helix-radio").Add("is-checked", selected).Add("is-disabled", disabled).Build())">
                <input type="radio" class="helix-sr-input helix-radio__input" name="@_name" checked="@selected" disabled="@disabled"
                       @onchange="() => Select(item)" />
                @if (Appearance != HelixRadioAppearance.Segmented)
                {
                    <span class="helix-radio__dot" aria-hidden="true"></span>
                }
                <span class="helix-radio__text">
                    @if (ItemTemplate is not null)
                    {
                        @ItemTemplate(item)
                    }
                    else
                    {
                        <span class="helix-radio__title">@TextOf(item)</span>
                    }
                    @if (!string.IsNullOrEmpty(description))
                    {
                        <span class="helix-radio__description">@description</span>
                    }
                </span>
            </label>
        }
    </div>
    @if (!string.IsNullOrEmpty(Hint))
    {
        <p class="helix-field__hint">@Hint</p>
    }
</fieldset>

@code {
    [Parameter, EditorRequired] public IEnumerable<TValue> Items { get; set; } = [];
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    [Parameter] public Func<TValue, string>? ItemText { get; set; }
    [Parameter] public Func<TValue, string?>? ItemDescription { get; set; }
    [Parameter] public Func<TValue, bool>? ItemDisabled { get; set; }

    /// <summary>Free content per option (replaces the title).</summary>
    [Parameter] public RenderFragment<TValue>? ItemTemplate { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Hint { get; set; }

    /// <summary>Default (dots), Cards (bordered choices) or Segmented (one pill bar).</summary>
    [Parameter] public HelixRadioAppearance Appearance { get; set; }

    /// <summary>Options side by side instead of stacked.</summary>
    [Parameter] public bool Horizontal { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public string? Color { get; set; }

    private readonly string _name = HelixId.Next("radio");

    private string ClassValue => new CssBuilder("helix-radio-group")
        .Add($"helix-radio-group--{Appearance.Css()}")
        .Add("is-horizontal", Horizontal || Appearance == HelixRadioAppearance.Segmented)
        .Add(Class)
        .Build();

    private string? StyleValue => new StyleBuilder().Color("radio", Color).Raw(Style).Build();

    private string TextOf(TValue item) => ItemText?.Invoke(item) ?? item?.ToString() ?? "";

    private Task Select(TValue item)
    {
        Value = item;
        return ValueChanged.InvokeAsync(item);
    }
}
