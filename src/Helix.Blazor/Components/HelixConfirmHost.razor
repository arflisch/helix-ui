@namespace Helix.Blazor
@inherits HelixComponentBase
@implements IDisposable
@inject HelixConfirmService Confirm

@{
    var current = Confirm.Current;
}

<HelixDialog Open="current is not null" OpenChanged="OnOpenChanged" Title="@current?.Title" Width="420px" Class="helix-confirm">
    <ChildContent>
        @if (!string.IsNullOrEmpty(current?.Message))
        {
            @current.Message
        }
    </ChildContent>
    <Footer>
        <HelixButton Variant="HelixVariant.Ghost" Color="neutral" OnClick="() => Confirm.Resolve(false)">@(current?.CancelText ?? Texts.Cancel)</HelixButton>
        <HelixButton Color="@(current?.Danger == true ? "danger" : null)" OnClick="() => Confirm.Resolve(true)">@(current?.ConfirmText ?? Texts.Confirm)</HelixButton>
    </Footer>
</HelixDialog>

@{
    var prompt = Confirm.CurrentPrompt;
}

<HelixDialog Open="prompt is not null" OpenChanged="open => { if (!open) Confirm.ResolvePrompt(null); }" Title="@prompt?.Title" Width="420px" Class="helix-confirm helix-prompt">
    <ChildContent>
        @if (prompt is not null)
        {
            <form class="stack" @onsubmit="SubmitPrompt" @onsubmit:preventDefault="true">
                @if (!string.IsNullOrEmpty(prompt.Message))
                {
                    <p class="helix-prompt__message">@prompt.Message</p>
                }
                <HelixTextField @key="prompt" Value="@PromptText(prompt)" ValueChanged="v => { _promptText = v; _promptError = null; }" Placeholder="@prompt.Placeholder"
                                Error="@_promptError" aria-label="@prompt.Title" autofocus />
            </form>
        }
    </ChildContent>
    <Footer>
        <HelixButton Variant="HelixVariant.Ghost" Color="neutral" OnClick="() => Confirm.ResolvePrompt(null)">@Texts.Cancel</HelixButton>
        <HelixButton OnClick="SubmitPrompt">@(prompt?.ConfirmText ?? Texts.Confirm)</HelixButton>
    </Footer>
</HelixDialog>

@code {
    private string? _promptText;
    private string? _promptError;
    private object? _promptFor;

    private string PromptText(HelixPromptOptions prompt)
    {
        if (!ReferenceEquals(_promptFor, prompt))
        {
            _promptFor = prompt;
            _promptText = prompt.Value;
            _promptError = null;
        }

        return _promptText ?? "";
    }

    private void SubmitPrompt()
    {
        if (Confirm.CurrentPrompt is not { } prompt) return;
        var text = _promptText ?? "";
        _promptError = prompt.Validate?.Invoke(text);
        if (_promptError is null) Confirm.ResolvePrompt(text);
    }

    protected override void OnInitialized() => Confirm.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnOpenChanged(bool open)
    {
        if (!open)
        {
            Confirm.Resolve(false);
        }
    }

    public void Dispose() => Confirm.Changed -= OnChanged;
}
