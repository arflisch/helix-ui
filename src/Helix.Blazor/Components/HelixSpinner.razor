@namespace Helix.Blazor
@inherits HelixComponentBase

<span @attributes="Attributes"
      class="@(new CssBuilder("helix-spinner").Add(Class).Build())"
      style="@(new StyleBuilder().Color("spinner", Color).Var("--helix-spinner-size", Size).Var("--helix-spinner-thickness", Thickness).Raw(Style).Build())"
      role="status"
      aria-label="@(Label ?? Texts.Loading)"></span>

@code {
    [Parameter] public string? Color { get; set; }

    /// <summary>e.g. "32px".</summary>
    [Parameter] public string? Size { get; set; }
    [Parameter] public string? Thickness { get; set; }
    [Parameter] public string? Label { get; set; }
}
