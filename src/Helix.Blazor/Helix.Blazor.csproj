<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Helix.Blazor</PackageId>
    <Title>Helix UI for Blazor</Title>
    <Description>Clean, modern Blazor components where every visual part is a parameter: buttons, fields, data grid, charts, timeline, kanban, dashboard and more. Light and dark themes, no template to copy.</Description>
    <PackageTags>blazor;components;ui;datagrid;charts;timeline;theme;dark-mode</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>


  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.11" />
  </ItemGroup>

</Project>
