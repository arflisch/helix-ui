        <Style Selector="^:error /template/ TextBlock#Hint"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.55" /></Style>
        <Style Selector="^[IsDropDownOpen=True] /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^[IsDropDownOpen=True] /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:clearable /template/ Button#PART_Clear"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:clearable /template/ Border#ClearSpace"><Setter Property="IsVisible" Value="True" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixMultiSelect}" TargetType="h:HelixMultiSelect">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="*" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Danger}" IsVisible="{TemplateBinding IsRequired}" />
                    </StackPanel>
                    <Panel>
                        <Border Name="Halo" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="{DynamicResource Helix.Primary}" Opacity="0" />
                        <Border Name="Frame" MinHeight="{DynamicResource Helix.ControlHeight}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                            <Panel>
                                <ToggleButton Name="Toggle" Theme="{StaticResource HelixBareToggle}" IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,0">
                                    <DockPanel>
                                        <h:HelixIcon DockPanel.Dock="Left" Icon="{TemplateBinding Icon}" Size="16" Foreground="{DynamicResource Helix.TextSubtle}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <h:HelixIcon DockPanel.Dock="Right" Icon="chevron-down" Size="15" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Border DockPanel.Dock="Right" Width="26" Name="ClearSpace" IsVisible="False" />
                                        <Panel>
                                        <TextBlock Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center"
                                                   IsVisible="{TemplateBinding HasSelection, Converter={x:Static BoolConverters.Not}}" />
                                        <WrapPanel VerticalAlignment="Center" Margin="0,4" ItemSpacing="4" LineSpacing="4">
                                            <ItemsControl ItemsSource="{TemplateBinding Chips}">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="4" LineSpacing="4" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="h:HelixChip">
                                                        <Border Background="{DynamicResource Helix.PrimarySoft}" CornerRadius="6" Padding="8,2,4,2">
                                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                                <TextBlock Text="{Binding Text}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Helix.Primary}" VerticalAlignment="Center" />
                                                                <Button Theme="{StaticResource HelixIconButton}" Width="16" Height="16" Command="{Binding RemoveCommand}">
                                                                    <h:HelixIcon Icon="x" Size="11" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Background="{DynamicResource Helix.Surface2}" CornerRadius="6" Padding="7,2" VerticalAlignment="Center"
                                                    IsVisible="{TemplateBinding MoreText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                                                <TextBlock Text="{TemplateBinding MoreText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Helix.TextMuted}" />
                                            </Border>
                                        </WrapPanel>
                                    </Panel>
                                    </DockPanel>
                                </ToggleButton>
                                <Button Name="PART_Clear" Theme="{StaticResource HelixIconButton}" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,32,0" IsVisible="False">
                                    <h:HelixIcon Icon="x" Size="13" />
                                </Button>
                            </Panel>
                        </Border>
                        <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" PlacementTarget="{Binding #Frame}" Placement="BottomEdgeAlignedLeft"
                               VerticalOffset="6" IsLightDismissEnabled="True">
                            <Border Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="12" BoxShadow="0 12 32 0 #26000000" Margin="0,0,12,12" Padding="12">
                                <StackPanel Spacing="8" Width="{Binding #Frame.Bounds.Width}" MinWidth="220">
                                    <Border BorderBrush="{DynamicResource Helix.BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="34"
                                            IsVisible="{TemplateBinding IsSearchable}">
                                        <DockPanel>
                                            <h:HelixIcon DockPanel.Dock="Left" Icon="search" Size="14" Foreground="{DynamicResource Helix.TextSubtle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBox Name="PART_Search" Theme="{StaticResource HelixInput}" Text="{TemplateBinding SearchText, Mode=TwoWay}"
                                                     PlaceholderText="{x:Static h:HelixMultiSelect.SearchPlaceholderText}" />
                                        </DockPanel>
                                    </Border>
                                    <ScrollViewer MaxHeight="260">
                                        <StackPanel Name="PART_List" />
                                    </ScrollViewer>
                                    <DockPanel IsVisible="{TemplateBinding ShowActions}">
                                        <h:HelixButton Name="PART_ClearAll" DockPanel.Dock="Right" Content="{x:Static h:HelixMultiSelect.ClearText}" Variant="Ghost" Tone="Neutral" Size="Sm" />
                                        <h:HelixButton Name="PART_SelectAll" Content="{x:Static h:HelixMultiSelect.SelectAllText}" Variant="Ghost" Size="Sm" HorizontalAlignment="Left" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Panel>
                    <TextBlock Name="Hint" Text="{TemplateBinding Hint}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="Error" Text="{TemplateBinding Error}" FontSize="12.5" Foreground="{DynamicResource Helix.Danger}" TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" /></Style>
        <Style Selector="^:focus-within /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^:focus-within /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:error /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ Border#Halo"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ TextBlock#Error"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:error /template/ TextBlock#Hint"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.55" /></Style>
        <Style Selector="^[IsDropDownOpen=True] /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^[IsDropDownOpen=True] /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:clearable /template/ Button#PART_Clear"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:clearable /template/ Border#ClearSpace"><Setter Property="IsVisible" Value="True" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixNumberField}" TargetType="h:HelixNumberField">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="*" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Danger}" IsVisible="{TemplateBinding IsRequired}" />
                    </StackPanel>
                    <Panel>
                        <Border Name="Halo" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="{DynamicResource Helix.Primary}" Opacity="0" />
                        <Border Name="Frame" MinHeight="{DynamicResource Helix.ControlHeight}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                            <DockPanel>
                                <Button Name="PART_Down" DockPanel.Dock="Left" Theme="{StaticResource HelixStepper}" IsVisible="{TemplateBinding ShowSteppers}"><h:HelixIcon Icon="minus" Size="14" /></Button>
                                <Button Name="PART_Up" DockPanel.Dock="Right" Theme="{StaticResource HelixStepper}" IsVisible="{TemplateBinding ShowSteppers}"><h:HelixIcon Icon="plus" Size="14" /></Button>
                                <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding Unit}" Foreground="{DynamicResource Helix.TextMuted}" VerticalAlignment="Center" Margin="6,0,10,0"
                                           IsVisible="{TemplateBinding Unit, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <TextBox Name="PART_Input" Theme="{StaticResource HelixInput}" Text="{TemplateBinding Text, Mode=TwoWay}" IsReadOnly="{TemplateBinding IsReadOnly}"
                                         PlaceholderText="{TemplateBinding Placeholder}" TextAlignment="Center" Margin="8,0" FontSize="{TemplateBinding FontSize}"
                                         FontFamily="{TemplateBinding FontFamily}" />
                            </DockPanel>
                        </Border>
                    </Panel>
                    <TextBlock Name="Hint" Text="{TemplateBinding Hint}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="Error" Text="{TemplateBinding Error}" FontSize="12.5" Foreground="{DynamicResource Helix.Danger}" TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" /></Style>
        <Style Selector="^:focus-within /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^:focus-within /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:error /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ Border#Halo"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ TextBlock#Error"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:error /template/ TextBlock#Hint"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.55" /></Style>
        <Style Selector="^:good /template/ TextBox#PART_Input"><Setter Property="Foreground" Value="{DynamicResource Helix.Success}" /></Style>
        <Style Selector="^:bad /template/ TextBox#PART_Input"><Setter Property="Foreground" Value="{DynamicResource Helix.Danger}" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="HelixSelectItem" TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource Helix.Surface2}" /></Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource Helix.PrimarySoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Helix.Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixSelect}" TargetType="h:HelixSelect">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="PlaceholderText" Value="{x:Static h:HelixSelect.SelectPlaceholderText}" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource HelixSelectItem}" />
        <Setter Property="MaxDropDownHeight" Value="300" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="*" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Danger}" IsVisible="{TemplateBinding IsRequired}" />
                    </StackPanel>
                    <Panel>
                        <Border Name="Halo" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="{DynamicResource Helix.Primary}" Opacity="0" />
                        <Border Name="Frame" MinHeight="{DynamicResource Helix.ControlHeight}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="12,0">
                            <DockPanel>
                                <h:HelixIcon DockPanel.Dock="Left" Icon="{TemplateBinding Icon}" Size="16" Foreground="{DynamicResource Helix.TextSubtle}"
                                             VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <h:HelixIcon DockPanel.Dock="Right" Icon="chevron-down" Size="15" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                <Panel VerticalAlignment="Center">
                                    <TextBlock Text="{TemplateBinding PlaceholderText}" Foreground="{DynamicResource Helix.TextSubtle}"
                                               IsVisible="{TemplateBinding SelectionBoxItem, Converter={x:Static ObjectConverters.IsNull}}" />
                                    <ContentControl Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" />
                                </Panel>
                            </DockPanel>
                        </Border>
                        <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" PlacementTarget="{Binding #Frame}" Placement="BottomEdgeAlignedLeft"
                               VerticalOffset="6" IsLightDismissEnabled="True" MinWidth="{Binding #Frame.Bounds.Width}">
                            <Border Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="12" BoxShadow="0 12 32 0 #26000000" Margin="0,0,12,12" Padding="6">
                                <DockPanel MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource Helix.BorderStrong}" BorderThickness="1" CornerRadius="8" Padding="10,0" Height="34"
                                            Margin="0,0,0,6" IsVisible="{TemplateBinding IsSearchable}">
                                        <DockPanel>
                                            <h:HelixIcon DockPanel.Dock="Left" Icon="search" Size="14" Foreground="{DynamicResource Helix.TextSubtle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                            <TextBox Name="PART_Search" Theme="{StaticResource HelixInput}" Text="{TemplateBinding SearchText, Mode=TwoWay}"
                                                     PlaceholderText="{x:Static h:HelixSelect.SearchPlaceholderText}" />
                                        </DockPanel>
                                    </Border>
                                    <ScrollViewer>
                                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Panel>
                    <TextBlock Name="Hint" Text="{TemplateBinding Hint}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="Error" Text="{TemplateBinding Error}" FontSize="12.5" Foreground="{DynamicResource Helix.Danger}" TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" /></Style>
        <Style Selector="^:focus /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^:focus /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:error /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ Border#Halo"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ TextBlock#Error"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:error /template/ TextBlock#Hint"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.55" /></Style>
        <Style Selector="^[IsDropDownOpen=True] /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^[IsDropDownOpen=True] /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="HelixRadioItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Background="{TemplateBinding Background}">
                    <Panel DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,10,0">
                        <Ellipse Name="Ring" Stroke="{DynamicResource Helix.BorderStrong}" StrokeThickness="1.5" Fill="{DynamicResource Helix.Surface}" />
                        <Ellipse Name="Dot" Width="8" Height="8" Fill="{DynamicResource Helix.OnPrimary}" Opacity="0" />
                    </Panel>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Ellipse#Ring"><Setter Property="Stroke" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^:selected /template/ Ellipse#Ring">
            <Setter Property="Stroke" Value="{DynamicResource Helix.Primary}" />
            <Setter Property="Fill" Value="{DynamicResource Helix.Primary}" />
        </Style>
        <Style Selector="^:selected /template/ Ellipse#Dot"><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="HelixRadioCard" TargetType="ListBoxItem">
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="14,12">
                    <DockPanel>
                        <Panel DockPanel.Dock="Right" Width="18" Height="18" VerticalAlignment="Top" Margin="12,0,0,0">
                            <Ellipse Name="Ring" Stroke="{DynamicResource Helix.BorderStrong}" StrokeThickness="1.5" />
                            <h:HelixIcon Name="Check" Icon="check" Size="12" StrokeWidth="3" Foreground="{DynamicResource Helix.OnPrimary}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                        </Panel>
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" /></Style>
        <Style Selector="^:selected">
            <Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Helix.PrimarySoft}" />
        </Style>
        <Style Selector="^:selected /template/ Ellipse#Ring">
            <Setter Property="Fill" Value="{DynamicResource Helix.Primary}" />
            <Setter Property="Stroke" Value="{DynamicResource Helix.Primary}" />
        </Style>
        <Style Selector="^:selected /template/ h|HelixIcon#Check"><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="HelixRadioSegment" TargetType="ListBoxItem">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7" Padding="14,6">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" HorizontalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /></Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        </Style>
        <Style Selector="^:selected /template/ Border#Bg"><Setter Property="BoxShadow" Value="0 1 3 0 #24000000" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixRadioGroup}" TargetType="h:HelixRadioGroup">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
        <Setter Property="ItemsPanel">
            <ItemsPanelTemplate><StackPanel Spacing="10" /></ItemsPanelTemplate>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="8">
                    <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold"
                               IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Border Name="Track" HorizontalAlignment="Left">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                    <TextBlock Text="{TemplateBinding Hint}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Orientation=Horizontal]">
            <Setter Property="ItemsPanel"><ItemsPanelTemplate><WrapPanel ItemSpacing="18" LineSpacing="10" /></ItemsPanelTemplate></Setter>
        </Style>
        <Style Selector="^[Appearance=Cards]">
            <Setter Property="ItemsPanel"><ItemsPanelTemplate><UniformGrid Columns="3" ColumnSpacing="10" RowSpacing="10" /></ItemsPanelTemplate></Setter>
        </Style>
        <Style Selector="^[Appearance=Cards] /template/ Border#Track"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
        <Style Selector="^[Appearance=Segmented]">
            <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></Setter>
        </Style>
        <Style Selector="^[Appearance=Segmented] /template/ Border#Track">
            <Setter Property="Background" Value="{DynamicResource Helix.Surface2}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="3" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="HelixSliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Height="6" CornerRadius="3" VerticalAlignment="Center" Background="{ReflectionBinding Accent, RelativeSource={RelativeSource AncestorType=h:HelixSlider}}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="HelixSliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate><Border Background="Transparent" /></ControlTemplate>
        </Setter>
    </ControlTheme>
    <ControlTheme x:Key="HelixSliderThumb" TargetType="Thumb">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border CornerRadius="9" Background="White" BorderThickness="2" BoxShadow="0 1 3 0 #33000000"
                        BorderBrush="{ReflectionBinding Accent, RelativeSource={RelativeSource AncestorType=h:HelixSlider}}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixSlider}" TargetType="h:HelixSlider">
        <Setter Property="Accent" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="TrackBrush" Value="{DynamicResource Helix.Surface3}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <DockPanel IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding ValueText}" FontSize="13" FontWeight="SemiBold" IsVisible="{TemplateBinding ShowValue}" />
                        <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold" />
                    </DockPanel>
                    <Panel Height="22">
                        <Border Height="6" CornerRadius="3" Background="{TemplateBinding TrackBrush}" VerticalAlignment="Center" Margin="0" />
                        <Track Name="PART_Track" Orientation="Horizontal" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                               Value="{TemplateBinding Value, Mode=TwoWay}">
                            <Track.DecreaseButton><RepeatButton Name="PART_DecreaseButton" Theme="{StaticResource HelixSliderFill}" /></Track.DecreaseButton>
                            <Track.IncreaseButton><RepeatButton Name="PART_IncreaseButton" Theme="{StaticResource HelixSliderRest}" /></Track.IncreaseButton>
                            <Thumb Theme="{StaticResource HelixSliderThumb}" />
                        </Track>
                    </Panel>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Tone=Neutral]"><Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" /></Style>
        <Style Selector="^[Tone=Success]"><Setter Property="Accent" Value="{DynamicResource Helix.Success}" /></Style>
        <Style Selector="^[Tone=Warning]"><Setter Property="Accent" Value="{DynamicResource Helix.Warning}" /></Style>
        <Style Selector="^[Tone=Danger]"><Setter Property="Accent" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^[Tone=Info]"><Setter Property="Accent" Value="{DynamicResource Helix.Info}" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixRating}" TargetType="h:HelixRating">
        <Setter Property="Accent" Value="{DynamicResource Helix.Warning}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <StackPanel Name="PART_Icons" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center" />
                    <TextBlock Text="{TemplateBinding Caption}" FontSize="13" VerticalAlignment="Center"
                               IsVisible="{TemplateBinding Caption, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Tone=Neutral]"><Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" /></Style>
        <Style Selector="^[Tone=Success]"><Setter Property="Accent" Value="{DynamicResource Helix.Success}" /></Style>
        <Style Selector="^[Tone=Danger]"><Setter Property="Accent" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^[Tone=Info]"><Setter Property="Accent" Value="{DynamicResource Helix.Info}" /></Style>
    </ControlTheme>

    <!-- ===================================================================== Timeline -->

    <ControlTheme x:Key="{x:Type h:HelixTimeline}" TargetType="h:HelixTimeline">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="16,12,12,8">
                            <Button Name="PART_Toggle" DockPanel.Dock="Right" Theme="{StaticResource HelixIconButton}" VerticalAlignment="Top"
                                    IsVisible="{TemplateBinding IsCollapsible}" ToolTip.Tip="{x:Static h:HelixTimeline.ToggleText}">
                                <h:HelixIcon Name="Chevron" Icon="chevron-down" Size="16" />
                            </Button>
                            <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding HeaderContent}" VerticalAlignment="Center" Margin="8,0" />
                            <StackPanel Spacing="8">
                                <TextBlock Text="{TemplateBinding Title}" FontSize="15" FontWeight="SemiBold"
                                           IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                <WrapPanel Name="PART_Legend" />
                            </StackPanel>
                        </DockPanel>
                        <ScrollViewer Name="PART_Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,0,8">
                            <Canvas Name="PART_Canvas" ClipToBounds="True" />
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsCollapsed=True] /template/ ScrollViewer#PART_Scroll"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^[IsCollapsed=True] /template/ h|HelixIcon#Chevron"><Setter Property="RenderTransform" Value="rotate(-90deg)" /></Style>
    </ControlTheme>

    <!-- ===================================================================== Kanban -->

    <ControlTheme x:Key="{x:Type h:HelixKanban}" TargetType="h:HelixKanban">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Name="PART_Columns" Orientation="Horizontal" />
                    </ScrollViewer>
                    <Canvas Name="PART_Overlay" IsHitTestVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ===================================================================== Sortable list -->

    <ControlTheme x:Key="HelixSortableItem" TargetType="ListBoxItem">
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <h:HelixIcon Name="Grip" DockPanel.Dock="Left" Icon="grip" Size="16" Foreground="{DynamicResource Helix.TextSubtle}" Margin="0,0,10,0" VerticalAlignment="Center"
                                     Cursor="SizeAll" IsVisible="{ReflectionBinding ShowHandle, RelativeSource={RelativeSource AncestorType=h:HelixSortableList}}" />
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" /></Style>
        <Style Selector="^:selected">
            <Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" />
            <Setter Property="Background" Value="{DynamicResource Helix.PrimarySoft}" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixSortableList}" TargetType="h:HelixSortableList">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource HelixSortableItem}" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ===================================================================== Dashboard -->

    <ControlTheme x:Key="{x:Type h:HelixDashboard}" TargetType="h:HelixDashboard">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><h:HelixDashboardPanel /></ItemsPanelTemplate></Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="14">
                    <DockPanel IsVisible="{TemplateBinding ShowToolbar}">
                        <ToggleButton Name="Edit" DockPanel.Dock="Right" Theme="{StaticResource HelixBareToggle}" IsChecked="{TemplateBinding IsEditing, Mode=TwoWay}" VerticalAlignment="Center">
                            <Border Name="EditChrome" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Helix.BorderStrong}" Background="{DynamicResource Helix.Surface}" Padding="12,6">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <h:HelixIcon Name="EditIcon" Icon="layout" Size="15" VerticalAlignment="Center" />
                                    <Panel>
                                        <TextBlock Name="EditText" Text="{x:Static h:HelixDashboard.EditText}" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Name="DoneText" Text="{x:Static h:HelixDashboard.DoneText}" FontSize="13" FontWeight="SemiBold" IsVisible="False" />
                                    </Panel>
                                </StackPanel>
                            </Border>
                        </ToggleButton>
                        <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Toolbar}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="{TemplateBinding Title}" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel Name="Hidden" Orientation="Horizontal" Spacing="8" IsVisible="False">
                        <TextBlock Text="{x:Static h:HelixDashboard.HiddenText}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" VerticalAlignment="Center" />
                        <ItemsControl ItemsSource="{TemplateBinding HiddenChips}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="h:HelixHiddenTile">
                                    <h:HelixButton Content="{Binding Title}" Icon="plus" Variant="Soft" Size="Sm"
                                                   Command="{ReflectionBinding RestoreCommand, RelativeSource={RelativeSource AncestorType=h:HelixDashboard}}" CommandParameter="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Panel>
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                        <Canvas Name="PART_MarkerLayer" IsHitTestVisible="False" />
                    </Panel>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:editing /template/ Border#EditChrome">
            <Setter Property="Background" Value="{DynamicResource Helix.Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource Helix.OnPrimary}" />
        </Style>
        <Style Selector="^:editing /template/ TextBlock#EditText"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^:editing /template/ TextBlock#DoneText"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:editing:has-hidden /template/ StackPanel#Hidden"><Setter Property="IsVisible" Value="True" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixDashboardTile}" TargetType="h:HelixDashboardTile">
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18,4,18,18" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                    <DockPanel>
                        <DockPanel Name="PART_Handle" DockPanel.Dock="Top" Background="Transparent" Margin="18,14,12,8">
                            <StackPanel Name="Tools" DockPanel.Dock="Right" Orientation="Horizontal" Spacing="2" IsVisible="False">
                                <Button Theme="{StaticResource HelixIconButton}" Command="{ReflectionBinding MoveBeforeCommand, RelativeSource={RelativeSource TemplatedParent}}" ToolTip.Tip="{x:Static h:HelixDashboardTile.MoveBeforeText}">
                                        <h:HelixIcon Icon="chevron-left" Size="14" />
                                    </Button>
                                <Button Theme="{StaticResource HelixIconButton}" Command="{ReflectionBinding MoveAfterCommand, RelativeSource={RelativeSource TemplatedParent}}" ToolTip.Tip="{x:Static h:HelixDashboardTile.MoveAfterText}">
                                        <h:HelixIcon Icon="chevron-right" Size="14" />
                                    </Button>
                                <Button Theme="{StaticResource HelixIconButton}" Command="{ReflectionBinding NarrowerCommand, RelativeSource={RelativeSource TemplatedParent}}" ToolTip.Tip="{x:Static h:HelixDashboardTile.NarrowerText}">
                                        <h:HelixIcon Icon="minus" Size="14" />
                                    </Button>
                                <TextBlock Text="{TemplateBinding SpanText}" FontSize="12" Foreground="{DynamicResource Helix.TextMuted}" VerticalAlignment="Center" Margin="2,0" />
                                <Button Theme="{StaticResource HelixIconButton}" Command="{ReflectionBinding WiderCommand, RelativeSource={RelativeSource TemplatedParent}}" ToolTip.Tip="{x:Static h:HelixDashboardTile.WiderText}">
                                        <h:HelixIcon Icon="plus" Size="14" />
                                    </Button>
                                <Button Theme="{StaticResource HelixIconButton}" Command="{ReflectionBinding HideCommand, RelativeSource={RelativeSource TemplatedParent}}" ToolTip.Tip="{x:Static h:HelixDashboardTile.HideText}" IsVisible="{TemplateBinding CanHide}">
                                        <h:HelixIcon Icon="eye-off" Size="14" />
                                    </Button>
                            </StackPanel>
                            <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Actions}" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <h:HelixIcon Name="Grip" Icon="grip" Size="14" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center" IsVisible="False" />
                                <TextBlock Text="{TemplateBinding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </DockPanel>
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Padding="{TemplateBinding Padding}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsPlain=True] /template/ Border#Frame">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="^[IsPlain=True]"><Setter Property="Padding" Value="0" /></Style>
        <Style Selector="^[IsPlain=True]:not(:editing) /template/ DockPanel#PART_Handle"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^:editing /template/ StackPanel#Tools"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:editing /template/ h|HelixIcon#Grip"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:editing /template/ DockPanel#PART_Handle"><Setter Property="Cursor" Value="SizeAll" /></Style>
        <Style Selector="^:editing /template/ Border#Frame">
            <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="^:dragging"><Setter Property="Opacity" Value="0.55" /></Style>
        <Style Selector="^:dragging /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
    </ControlTheme>

    <!-- ===================================================================== Host: dialogs, drawers, confirmations, prompts -->

    <ControlTheme x:Key="HelixBackdrop" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource Helix.Overlay}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <ControlTemplate><Border Background="{TemplateBinding Background}" /></ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixDialog}" TargetType="h:HelixDialog">
        <!-- The dialog shows nothing where it is declared: the HelixHost draws it (content and footer) above the window. -->
        <Setter Property="Template"><ControlTemplate><Panel /></ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type h:HelixDrawer}" TargetType="h:HelixDrawer" BasedOn="{StaticResource {x:Type h:HelixDialog}}" />

    <ControlTheme x:Key="{x:Type h:HelixHost}" TargetType="h:HelixHost">
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
                    <ItemsControl ItemsSource="{Binding Overlays, RelativeSource={RelativeSource TemplatedParent}}" IsVisible="{TemplateBinding HasOverlay}"
                                  TextElement.FontFamily="{DynamicResource Helix.FontFamily}" TextElement.FontSize="{DynamicResource Helix.FontSize}"
                                  TextElement.Foreground="{DynamicResource Helix.Text}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><Panel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.DataTemplates>
                            <DataTemplate DataType="h:HelixDrawerSlot">
                                <Panel>
                                    <Button Theme="{StaticResource HelixBackdrop}" Command="{Binding Dialog.BackdropCommand}" />
                                    <Border Classes="drawer" Classes.left="{Binding IsLeft}" Classes.bottom="{Binding IsBottom}" Background="{DynamicResource Helix.Surface}"
                                            BorderBrush="{DynamicResource Helix.Border}" BoxShadow="0 0 48 0 #40000000">
                                        <Border.Styles>
                                            <Style Selector="Border.drawer">
                                                <Setter Property="HorizontalAlignment" Value="Right" />
                                                <Setter Property="Width" Value="{Binding Drawer.DrawerSize}" />
                                                <Setter Property="BorderThickness" Value="1,0,0,0" />
                                                <Setter Property="MaxWidth" Value="{Binding $parent[Panel].Bounds.Width}" />
                                            </Style>
                                            <Style Selector="Border.drawer.left">
                                                <Setter Property="HorizontalAlignment" Value="Left" />
                                                <Setter Property="BorderThickness" Value="0,0,1,0" />
                                            </Style>
                                            <Style Selector="Border.drawer.bottom">
                                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                <Setter Property="VerticalAlignment" Value="Bottom" />
                                                <Setter Property="Width" Value="NaN" />
                                                <Setter Property="Height" Value="{Binding Drawer.DrawerSize}" />
                                                <Setter Property="BorderThickness" Value="0,1,0,0" />
                                                <Setter Property="CornerRadius" Value="16,16,0,0" />
                                            </Style>
                                            <Style Selector="Border.drawer">
                                                <Style.Animations>
                                                    <Animation Duration="0:0:0.18" Easing="CubicEaseOut" FillMode="Forward">
                                                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0.4" /><Setter Property="TranslateTransform.X" Value="40" /></KeyFrame>
                                                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.X" Value="0" /></KeyFrame>
                                                    </Animation>
                                                </Style.Animations>
                                            </Style>
                                        </Border.Styles>
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="24,20,16,0">
                                            <Button DockPanel.Dock="Right" Theme="{StaticResource HelixIconButton}" VerticalAlignment="Top" Command="{Binding Dialog.CloseCommand}"
                                                    IsVisible="{Binding Dialog.ShowClose}" ToolTip.Tip="{x:Static h:HelixHost.CloseText}">
                                                <h:HelixIcon Icon="x" Size="16" />
                                            </Button>
                                            <StackPanel Spacing="4" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Dialog.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Dialog.Description}" FontSize="13.5" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                                                           IsVisible="{Binding Dialog.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                        </DockPanel>
                                            <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,1,0,0" Padding="24,14"
                                                    IsVisible="{Binding Dialog.Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <ContentPresenter Content="{Binding Dialog.Footer}" HorizontalAlignment="Right" />
                                            </Border>
                                            <ScrollViewer><ContentPresenter Content="{Binding Dialog.Content}" Margin="24,16,24,20" /></ScrollViewer>
                                        </DockPanel>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                            <DataTemplate DataType="h:HelixDialogSlot">
                                <Panel>
                                    <Button Theme="{StaticResource HelixBackdrop}" Command="{Binding Dialog.BackdropCommand}" />
                                    <Border Classes="box" Width="{Binding Dialog.DialogWidth}" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="16" BoxShadow="0 24 64 0 #40000000" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" RenderTransformOrigin="50%,50%">
                                        <Border.Styles><Style Selector="Border.box"><Style.Animations>
                                    <Animation Duration="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
                                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="0.97" /><Setter Property="ScaleTransform.ScaleY" Value="0.97" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                    </Animation>
                                </Style.Animations></Style></Border.Styles>
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="24,20,16,0">
                                            <Button DockPanel.Dock="Right" Theme="{StaticResource HelixIconButton}" VerticalAlignment="Top" Command="{Binding Dialog.CloseCommand}"
                                                    IsVisible="{Binding Dialog.ShowClose}" ToolTip.Tip="{x:Static h:HelixHost.CloseText}">
                                                <h:HelixIcon Icon="x" Size="16" />
                                            </Button>
                                            <StackPanel Spacing="4" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Dialog.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Dialog.Description}" FontSize="13.5" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                                                           IsVisible="{Binding Dialog.Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                        </DockPanel>
                                            <Border DockPanel.Dock="Bottom" Padding="24,0,24,20" IsVisible="{Binding Dialog.Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
                                                <ContentPresenter Content="{Binding Dialog.Footer}" HorizontalAlignment="Right" />
                                            </Border>
                                            <ContentPresenter Content="{Binding Dialog.Content}" Margin="24,14,24,20" />
                                        </DockPanel>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                            <DataTemplate DataType="h:HelixConfirmRequest">
                                <Panel>
                                    <Button Theme="{StaticResource HelixBackdrop}" Command="{Binding CancelCommand}" />
                                    <Border Classes="box" Width="420" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="16" BoxShadow="0 24 64 0 #40000000" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" RenderTransformOrigin="50%,50%" Padding="24,22,24,20">
                                        <Border.Styles><Style Selector="Border.box"><Style.Animations>
                                    <Animation Duration="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
                                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="0.97" /><Setter Property="ScaleTransform.ScaleY" Value="0.97" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                    </Animation>
                                </Style.Animations></Style></Border.Styles>
                                        <StackPanel Spacing="18">
                                            <DockPanel>
                                                <Panel DockPanel.Dock="Left" Width="40" Height="40" VerticalAlignment="Top" Margin="0,0,14,0">
                                                    <Ellipse Classes.danger="{Binding IsDanger}" Opacity="0.14">
                                                        <Ellipse.Styles>
                                                            <Style Selector="Ellipse"><Setter Property="Fill" Value="{DynamicResource Helix.Primary}" /></Style>
                                                            <Style Selector="Ellipse.danger"><Setter Property="Fill" Value="{DynamicResource Helix.Danger}" /></Style>
                                                        </Ellipse.Styles>
                                                    </Ellipse>
                                                    <h:HelixIcon Icon="{Binding Icon}" Size="20" HorizontalAlignment="Center" VerticalAlignment="Center" Classes.danger="{Binding IsDanger}">
                                                        <h:HelixIcon.Styles>
                                                            <Style Selector="h|HelixIcon"><Setter Property="Foreground" Value="{DynamicResource Helix.Primary}" /></Style>
                                                            <Style Selector="h|HelixIcon.danger"><Setter Property="Foreground" Value="{DynamicResource Helix.Danger}" /></Style>
                                                        </h:HelixIcon.Styles>
                                                    </h:HelixIcon>
                                                </Panel>
                                                <StackPanel Spacing="6">
                                                    <TextBlock Text="{Binding Title}" FontSize="16.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                                <h:HelixButton Content="{Binding CancelText}" Variant="Outline" Tone="Neutral" Command="{Binding CancelCommand}" />
                                                <h:HelixButton Content="{Binding ConfirmText}" Tone="{Binding ConfirmTone}" Command="{Binding ConfirmCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                            <DataTemplate DataType="h:HelixPromptRequest">
                                <Panel>
                                    <Button Theme="{StaticResource HelixBackdrop}" Command="{Binding CancelCommand}" />
                                    <Border Classes="box" Width="440" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="16" BoxShadow="0 24 64 0 #40000000" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" RenderTransformOrigin="50%,50%" Padding="24,22,24,20">
                                        <Border.Styles><Style Selector="Border.box"><Style.Animations>
                                    <Animation Duration="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
                                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="0.97" /><Setter Property="ScaleTransform.ScaleY" Value="0.97" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                    </Animation>
                                </Style.Animations></Style></Border.Styles>
                                        <StackPanel Spacing="14">
                                            <StackPanel Spacing="6">
                                                <TextBlock Text="{Binding Title}" FontSize="16.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap" IsVisible="{Binding HasMessage}" />
                                            </StackPanel>
                                            <h:HelixTextField Name="PromptField" Text="{Binding Text, Mode=TwoWay}" Placeholder="{Binding Placeholder}" Error="{Binding Error}">
                                                <h:HelixTextField.KeyBindings>
                                                    <KeyBinding Gesture="Enter" Command="{Binding ConfirmCommand}" />
                                                </h:HelixTextField.KeyBindings>
                                            </h:HelixTextField>
                                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
                                                <h:HelixButton Content="{Binding CancelText}" Variant="Outline" Tone="Neutral" Command="{Binding CancelCommand}" />
                                                <h:HelixButton Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                            <DataTemplate DataType="h:HelixViewRequest">
                                <Panel>
                                    <Border Background="{DynamicResource Helix.Overlay}" />
                                    <Border Classes="box" Width="{Binding DialogWidth}" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="16" BoxShadow="0 24 64 0 #40000000" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" RenderTransformOrigin="50%,50%">
                                        <Border.Styles><Style Selector="Border.box"><Style.Animations>
                                    <Animation Duration="0:0:0.16" Easing="CubicEaseOut" FillMode="Forward">
                                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="ScaleTransform.ScaleX" Value="0.97" /><Setter Property="ScaleTransform.ScaleY" Value="0.97" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /></KeyFrame>
                                    </Animation>
                                </Style.Animations></Style></Border.Styles>
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="24,20,16,0">
                                            <Button DockPanel.Dock="Right" Theme="{StaticResource HelixIconButton}" VerticalAlignment="Top" Command="{Binding CloseCommand}"
                                                    IsVisible="True" ToolTip.Tip="{x:Static h:HelixHost.CloseText}">
                                                <h:HelixIcon Icon="x" Size="16" />
                                            </Button>
                                            <StackPanel Spacing="4" Margin="0,0,8,0">
                                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Description}" FontSize="13.5" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                                                           IsVisible="{Binding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                            </StackPanel>
                                        </DockPanel>
                                            <ContentPresenter Content="{Binding View}" Margin="24,14,24,20" />
                                        </DockPanel>
                                    </Border>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.DataTemplates>
                    </ItemsControl>
                    <h:HelixToastHost ToastHorizontalAlignment="{TemplateBinding ToastHorizontalAlignment}" ToastVerticalAlignment="{TemplateBinding ToastVerticalAlignment}" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ===================================================================== Tabs -->

    <ControlTheme x:Key="{x:Type h:HelixTab}" TargetType="h:HelixTab">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="12,8">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <h:HelixIcon Icon="{TemplateBinding Icon}" Size="15" VerticalAlignment="Center" IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border Name="Line" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Margin="8,0,8,-1" Background="{DynamicResource Helix.Primary}" Opacity="0" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /></Style>
        <Style Selector="^:selected"><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="^:selected /template/ Border#Line"><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
        <Style Selector="^[Variant=Pills] /template/ Border#Line"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^[Variant=Pills]:selected">
            <Setter Property="Background" Value="{DynamicResource Helix.PrimarySoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Helix.Primary}" />
        </Style>
        <Style Selector="^[Variant=Segmented] /template/ Border#Line"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^[Variant=Segmented] /template/ Border#Bg"><Setter Property="Padding" Value="14,6" /></Style>
        <Style Selector="^[Variant=Segmented]:selected"><Setter Property="Background" Value="{DynamicResource Helix.Surface}" /></Style>
        <Style Selector="^[Variant=Segmented]:selected /template/ Border#Bg"><Setter Property="BoxShadow" Value="0 1 3 0 #24000000" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixTabs}" TargetType="h:HelixTabs">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="2" /></ItemsPanelTemplate></Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <Border Name="Strip" DockPanel.Dock="Top" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,0,1" HorizontalAlignment="Stretch">
                        <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    </Border>
                    <ContentPresenter Name="PART_SelectedContentHost" Content="{TemplateBinding SelectedContent}" ContentTemplate="{TemplateBinding SelectedContentTemplate}" Margin="0,16,0,0" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Variant=Pills] /template/ Border#Strip"><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="^[Variant=Segmented] /template/ Border#Strip">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="{DynamicResource Helix.Surface2}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </ControlTheme>

    <!-- ===================================================================== Accordion -->

    <ControlTheme x:Key="{x:Type h:HelixAccordionItem}" TargetType="h:HelixAccordionItem">
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Line" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,0,1">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Top" Theme="{StaticResource HelixBareToggle}" IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="16,14">
                            <DockPanel>
                                <h:HelixIcon Name="Chevron" DockPanel.Dock="Right" Icon="chevron-down" Size="16" Foreground="{DynamicResource Helix.TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <h:HelixIcon.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.15" /></Transitions></h:HelixIcon.Transitions>
                                </h:HelixIcon>
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Extra}" VerticalAlignment="Center" />
                                <h:HelixIcon DockPanel.Dock="Left" Icon="{TemplateBinding Icon}" Size="18" Foreground="{DynamicResource Helix.TextMuted}" VerticalAlignment="Center"
                                             Margin="0,0,12,0" IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <ContentPresenter Content="{TemplateBinding Header}" FontWeight="SemiBold" />
                                    <TextBlock Text="{TemplateBinding Subtitle}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}"
                                               IsVisible="{TemplateBinding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                </StackPanel>
                            </DockPanel>
                        </ToggleButton>
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="16,0,16,16" Foreground="{DynamicResource Helix.TextMuted}" IsVisible="{TemplateBinding IsExpanded}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:expanded /template/ h|HelixIcon#Chevron"><Setter Property="RenderTransform" Value="rotate(180deg)" /></Style>
        <Style Selector="^:nth-last-child(1) /template/ Border#Line"><Setter Property="BorderThickness" Value="0" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixAccordion}" TargetType="h:HelixAccordion">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsFlush=True] /template/ Border#Frame">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </ControlTheme>

    <!-- ===================================================================== Breadcrumb, button group, pagination, stepper -->

    <ControlTheme x:Key="{x:Type h:HelixBreadcrumb}" TargetType="h:HelixBreadcrumb">
        <Setter Property="Template"><ControlTemplate><WrapPanel Name="PART_Panel" /></ControlTemplate></Setter>
    </ControlTheme>

    <ControlTheme x:Key="HelixButtonGroupItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Helix.BorderStrong}" BorderThickness="1,0,0,0" Padding="14,0" MinHeight="36">
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:nth-child(1) /template/ Border#Bg"><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource Helix.Surface2}" /><Setter Property="Foreground" Value="{DynamicResource Helix.Text}" /></Style>
        <Style Selector="^:selected">
            <Setter Property="Background" Value="{DynamicResource Helix.PrimarySoft}" />
            <Setter Property="Foreground" Value="{DynamicResource Helix.Primary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixButtonGroup}" TargetType="h:HelixButtonGroup">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="ItemContainerTheme" Value="{StaticResource HelixButtonGroupItem}" />
        <Setter Property="SelectionMode" Value="Single,AlwaysSelected" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.BorderStrong}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixPagination}" TargetType="h:HelixPagination">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Template"><ControlTemplate><StackPanel Name="PART_Pages" Orientation="Horizontal" /></ControlTemplate></Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixStepper}" TargetType="h:HelixStepper">
        <Setter Property="Accent" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Template"><ControlTemplate><Grid Name="PART_Steps" /></ControlTemplate></Setter>
        <Style Selector="^[Tone=Neutral]"><Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" /><Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnNeutral}" /></Style>
        <Style Selector="^[Tone=Success]"><Setter Property="Accent" Value="{DynamicResource Helix.Success}" /><Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnSuccess}" /></Style>
        <Style Selector="^[Tone=Warning]"><Setter Property="Accent" Value="{DynamicResource Helix.Warning}" /><Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnWarning}" /></Style>
        <Style Selector="^[Tone=Danger]"><Setter Property="Accent" Value="{DynamicResource Helix.Danger}" /><Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnDanger}" /></Style>
        <Style Selector="^[Tone=Info]"><Setter Property="Accent" Value="{DynamicResource Helix.Info}" /><Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnInfo}" /></Style>
    </ControlTheme>

    <!-- ===================================================================== Avatar, skeleton, splitter -->

    <ControlTheme x:Key="{x:Type h:HelixAvatar}" TargetType="h:HelixAvatar">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border CornerRadius="999" BorderThickness="2" BorderBrush="{DynamicResource Helix.Surface}" Background="{TemplateBinding Fill}" ClipToBounds="True">
                        <Panel>
                            <TextBlock Text="{TemplateBinding Initials}" Foreground="White" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Image Source="{TemplateBinding Source}" Stretch="UniformToFill" IsVisible="{TemplateBinding Source, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </Panel>
                    </Border>
                    <Ellipse Name="Status" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{DynamicResource Helix.Surface}" StrokeThickness="2" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Size=Sm]"><Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="FontSize" Value="11" /></Style>
        <Style Selector="^[Size=Lg]"><Setter Property="Width" Value="48" /><Setter Property="Height" Value="48" /><Setter Property="FontSize" Value="16" /></Style>
        <Style Selector="^:online /template/ Ellipse#Status"><Setter Property="IsVisible" Value="True" /><Setter Property="Fill" Value="{DynamicResource Helix.Success}" /></Style>
        <Style Selector="^:away /template/ Ellipse#Status"><Setter Property="IsVisible" Value="True" /><Setter Property="Fill" Value="{DynamicResource Helix.Warning}" /></Style>
        <Style Selector="^:busy /template/ Ellipse#Status"><Setter Property="IsVisible" Value="True" /><Setter Property="Fill" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:offline /template/ Ellipse#Status"><Setter Property="IsVisible" Value="True" /><Setter Property="Fill" Value="{DynamicResource Helix.TextSubtle}" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixAvatarGroup}" TargetType="h:HelixAvatarGroup">
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Orientation="Horizontal">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                    <Border Height="36" MinWidth="36" CornerRadius="999" BorderThickness="2" BorderBrush="{DynamicResource Helix.Surface}" Background="{DynamicResource Helix.Surface3}"
                            Margin="-10,0,0,0" Padding="6,0" IsVisible="{TemplateBinding OverflowText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{TemplateBinding OverflowText}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Helix.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixSkeleton}" TargetType="h:HelixSkeleton">
        <Setter Property="Background" Value="{DynamicResource Helix.Surface3}" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ItemsControl Name="Lines" ItemsSource="{TemplateBinding LineWidths}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="9" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="x:Double">
                                <Border Height="12" CornerRadius="6" Background="{DynamicResource Helix.Surface3}" HorizontalAlignment="Left">
                                    <Border.Width>
                                        <MultiBinding Converter="{x:Static h:HelixConverters.Share}">
                                            <Binding Path="$parent[ItemsControl].Bounds.Width" />
                                            <Binding />
                                        </MultiBinding>
                                    </Border.Width>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Name="Block" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsCircle=True] /template/ Border#Block"><Setter Property="IsVisible" Value="True" /><Setter Property="CornerRadius" Value="999" /></Style>
        <Style Selector="^[IsCircle=True] /template/ ItemsControl#Lines"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^">
            <Style.Animations>
                <Animation Duration="0:0:1.4" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.45" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixSplitter}" TargetType="h:HelixSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="MinWidth" Value="8" />
        <Setter Property="MinHeight" Value="8" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="{TemplateBinding Background}">
                    <Border Name="Line" Background="{DynamicResource Helix.Border}" Width="1" />
                    <Border Name="Grip" Width="4" Height="28" CornerRadius="2" Background="{DynamicResource Helix.BorderStrong}" />
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Line"><Setter Property="Background" Value="{DynamicResource Helix.Primary}" /><Setter Property="Width" Value="2" /></Style>
        <Style Selector="^:pointerover /template/ Border#Grip"><Setter Property="Background" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^[ResizeDirection=Rows] /template/ Border#Line"><Setter Property="Width" Value="NaN" /><Setter Property="Height" Value="1" /></Style>
        <Style Selector="^[ResizeDirection=Rows] /template/ Border#Grip"><Setter Property="Width" Value="28" /><Setter Property="Height" Value="4" /></Style>
    </ControlTheme>

    <!-- ===================================================================== Menus -->

    <ControlTheme x:Key="{x:Type h:HelixContextMenu}" TargetType="h:HelixContextMenu">
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><StackPanel /></ItemsPanelTemplate></Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="12" Padding="{TemplateBinding Padding}" BoxShadow="0 12 32 0 #26000000" Margin="0,0,12,12">
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" KeyboardNavigation.TabNavigation="Continue" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixMenuItem}" TargetType="h:HelixMenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7" Padding="10,7">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding Shortcut}" FontSize="11.5" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center" Margin="16,0,0,0" />
                        <h:HelixIcon Name="Icon" DockPanel.Dock="Left" Icon="{TemplateBinding IconName}" Size="15" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Top"
                                     Margin="0,2,10,0" IsVisible="{TemplateBinding IconName, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <StackPanel Spacing="1">
                            <ContentPresenter Name="PART_HeaderPresenter" Content="{TemplateBinding Header}" />
                            <TextBlock Text="{TemplateBinding Description}" FontSize="12" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                                       IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource Helix.Surface2}" /></Style>
        <Style Selector="^:selected"><Setter Property="Background" Value="{DynamicResource Helix.Surface2}" /></Style>
        <Style Selector="^[IsDanger=True]"><Setter Property="Foreground" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^[IsDanger=True] /template/ h|HelixIcon#Icon"><Setter Property="Foreground" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.45" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixMenuSeparator}" TargetType="h:HelixMenuSeparator">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template"><ControlTemplate><Border Height="1" Margin="6,5" Background="{DynamicResource Helix.Border}" /></ControlTemplate></Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixMenuLabel}" TargetType="h:HelixMenuLabel">
        <Setter Property="Template">
            <ControlTemplate>
                <TextBlock Text="{TemplateBinding Text}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Helix.TextSubtle}" Margin="10,6,10,4" />
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ===================================================================== Time bar -->

    <ControlTheme x:Key="{x:Type h:HelixTimeBar}" TargetType="h:HelixTimeBar">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <TextBlock Name="Count" DockPanel.Dock="Right" Text="{TemplateBinding RemainingText}" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Helix.Primary}" VerticalAlignment="Bottom" FontFeatures="tnum" />
                        <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Helix.TextMuted}"
                                   VerticalAlignment="Bottom" Margin="0,0,12,4" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <Border Name="PART_Track" Height="{TemplateBinding TrackHeight}" CornerRadius="4" ClipToBounds="True" Background="{DynamicResource Helix.Surface2}">
                        <Border Name="PART_Fill" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource Helix.Primary}">
                            <Border.Transitions><Transitions><DoubleTransition Property="Width" Duration="0:0:0.3" /></Transitions></Border.Transitions>
                        </Border>
                    </Border>
                    <DockPanel Name="Foot" Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding Hint}" FontSize="12.5" Foreground="{DynamicResource Helix.TextSubtle}" Margin="12,0,0,0" />
                        <TextBlock Text="{TemplateBinding UntilText}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" />
                    </DockPanel>
                    <ItemsControl Name="SlotList" ItemsSource="{TemplateBinding Slots}" IsVisible="{TemplateBinding HasSlots}" Margin="0,8,-6,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="h:HelixTimeBarSlotView">
                                <Border Classes="chip" Classes.current="{Binding IsCurrent}" Classes.past="{Binding IsPast}" Margin="0,0,6,0" Padding="10,7" CornerRadius="6" BorderThickness="1">
                                    <Border.Styles>
                                        <Style Selector="Border.chip"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" /><Setter Property="Background" Value="{DynamicResource Helix.Surface}" /></Style>
                                        <Style Selector="Border.chip.past"><Setter Property="Opacity" Value="0.6" /></Style>
                                        <Style Selector="Border.chip.current"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /><Setter Property="Background" Value="{DynamicResource Helix.PrimarySoft}" /></Style>
                                    </Border.Styles>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Brush}" IsVisible="{Binding HasBrush}" />
                                            <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Text}" FontSize="11.5" MinHeight="15" Foreground="{DynamicResource Helix.TextMuted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Compact=True] /template/ DockPanel#Foot"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^[Compact=True] /template/ ItemsControl#SlotList"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^[Compact=True] /template/ TextBlock#Count"><Setter Property="FontSize" Value="15" /></Style>
        <Style Selector="^:warn /template/ TextBlock#Count"><Setter Property="Foreground" Value="{DynamicResource Helix.Warning}" /></Style>
        <Style Selector="^:warn /template/ Border#PART_Fill"><Setter Property="Background" Value="{DynamicResource Helix.Warning}" /></Style>
        <Style Selector="^:critical /template/ TextBlock#Count"><Setter Property="Foreground" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:critical /template/ Border#PART_Fill"><Setter Property="Background" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:passed /template/ TextBlock#Count"><Setter Property="Foreground" Value="{DynamicResource Helix.TextSubtle}" /><Setter Property="FontSize" Value="15" /></Style>
        <Style Selector="^:passed /template/ Border#PART_Fill"><Setter Property="Background" Value="{DynamicResource Helix.TextSubtle}" /></Style>
    </ControlTheme>

    <!-- ===================================================================== Notification center -->

    <ControlTheme x:Key="HelixTextButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <ContentPresenter Content="{TemplateBinding Content}" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Opacity" Value="0.8" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="HelixNotificationRow" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="8,9">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalContentAlignment="Stretch" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^.unread"><Setter Property="Background" Value="{DynamicResource Helix.PrimarySoft}" /></Style>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource Helix.Surface2}" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixNotificationCenter}" TargetType="h:HelixNotificationCenter">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <ToggleButton Name="Bell" Theme="{StaticResource HelixBareToggle}" Width="36" Height="36" CornerRadius="8"
                                  IsChecked="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  AutomationProperties.Name="{x:Static h:HelixNotificationCenter.NotificationsText}">
                        <Panel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <h:HelixIcon Icon="bell" Size="20" Foreground="{DynamicResource Helix.TextMuted}" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-9,0" MinWidth="17" Height="17" Padding="4,0"
                                    CornerRadius="9" Background="{DynamicResource Helix.Danger}" BorderBrush="{DynamicResource Helix.Surface}" BorderThickness="2"
                                    IsVisible="{TemplateBinding HasUnread}">
                                <TextBlock Text="{TemplateBinding UnreadText}" FontSize="10" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                    </ToggleButton>
                    <Popup Name="PART_Popup" PlacementTarget="{Binding #Bell}" IsLightDismissEnabled="True" OverlayDismissEventPassThrough="False"
                           IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <Border Margin="12,0,12,24" Width="{TemplateBinding PanelWidth}" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                                BorderThickness="1" CornerRadius="10" BoxShadow="0 12 32 0 #26000000"
                                TextElement.FontFamily="{DynamicResource Helix.FontFamily}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="14,12">
                                    <Button DockPanel.Dock="Right" Theme="{StaticResource HelixTextButton}" Content="{x:Static h:HelixNotificationCenter.MarkAllReadText}"
                                            Command="{Binding MarkAllReadCommand, RelativeSource={RelativeSource TemplatedParent}}" IsVisible="{TemplateBinding HasUnread}"
                                            FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Primary}" />
                                    <TextBlock Text="{TemplateBinding PanelTitle}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" />
                                </DockPanel>
                                <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Helix.Border}" />
                                <DockPanel DockPanel.Dock="Bottom" IsVisible="{TemplateBinding HasItems}">
                                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Helix.Border}" />
                                    <Button Theme="{StaticResource HelixTextButton}" Content="{x:Static h:HelixNotificationCenter.ClearAllText}"
                                            Command="{Binding ClearCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                            HorizontalAlignment="Left" Margin="14,8" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" />
                                </DockPanel>
                                <Panel>
                                    <StackPanel Margin="16,36" HorizontalAlignment="Center" IsVisible="{Binding !HasItems, RelativeSource={RelativeSource TemplatedParent}}">
                                        <h:HelixIcon Icon="bell" Size="22" Foreground="{DynamicResource Helix.TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                        <TextBlock Text="{x:Static h:HelixNotificationCenter.EmptyText}" FontSize="13" Foreground="{DynamicResource Helix.TextMuted}" />
                                    </StackPanel>
                                    <ScrollViewer MaxHeight="420" IsVisible="{TemplateBinding HasItems}" HorizontalScrollBarVisibility="Disabled">
                                        <ItemsControl ItemsSource="{TemplateBinding Rows}" Margin="6,2,6,6">
                                            <ItemsControl.Styles>
                                                <Style Selector="Button.row Button#Dismiss"><Setter Property="Opacity" Value="0" /></Style>
                                                <Style Selector="Button.row:pointerover Button#Dismiss"><Setter Property="Opacity" Value="1" /></Style>
                                            </ItemsControl.Styles>
                                            <ItemsControl.DataTemplates>
                                                <DataTemplate DataType="h:HelixNotificationGroup">
                                                    <TextBlock Text="{Binding Name}" Margin="8,10,8,4" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Helix.TextSubtle}" />
                                                </DataTemplate>
                                                <DataTemplate DataType="h:HelixNotification">
                                                    <Button Theme="{StaticResource HelixNotificationRow}" Classes="row" Command="{Binding OpenCommand}" Classes.unread="{Binding !IsRead}">
                                                        <DockPanel>
                                                            <Ellipse Classes="dot" Classes.read="{Binding IsRead}" Classes.success="{Binding Severity, Converter={x:Static h:HelixConverters.IsSuccess}}"
                                                                     Classes.warning="{Binding Severity, Converter={x:Static h:HelixConverters.IsWarning}}"
                                                                     Classes.danger="{Binding Severity, Converter={x:Static h:HelixConverters.IsDanger}}"
                                                                     DockPanel.Dock="Left" Width="8" Height="8" Margin="0,6,10,0" VerticalAlignment="Top">
                                                                <Ellipse.Styles>
                                                                    <Style Selector="Ellipse.dot"><Setter Property="Fill" Value="{DynamicResource Helix.Info}" /></Style>
                                                                    <Style Selector="Ellipse.dot.success"><Setter Property="Fill" Value="{DynamicResource Helix.Success}" /></Style>
                                                                    <Style Selector="Ellipse.dot.warning"><Setter Property="Fill" Value="{DynamicResource Helix.Warning}" /></Style>
                                                                    <Style Selector="Ellipse.dot.danger"><Setter Property="Fill" Value="{DynamicResource Helix.Danger}" /></Style>
                                                                    <Style Selector="Ellipse.dot.read"><Setter Property="Opacity" Value="0.45" /></Style>
                                                                </Ellipse.Styles>
                                                            </Ellipse>
                                                            <Button Name="Dismiss" DockPanel.Dock="Right" Theme="{StaticResource HelixIconButton}" VerticalAlignment="Top" Margin="6,-2,0,0"
                                                                    Command="{Binding DismissCommand}" ToolTip.Tip="{x:Static h:HelixNotificationCenter.DismissText}">
                                                                <h:HelixIcon Icon="x" Size="14" />
                                                            </Button>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource Helix.Text}"
                                                                           Classes.bold="{Binding !IsRead}">
                                                                    <TextBlock.Styles><Style Selector="TextBlock.bold"><Setter Property="FontWeight" Value="SemiBold" /></Style></TextBlock.Styles>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource Helix.TextMuted}" IsVisible="{Binding HasText}" />
                                                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                    <TextBlock Text="{Binding TimeText}" FontSize="11.5" Foreground="{DynamicResource Helix.TextSubtle}" />
                                                                    <TextBlock Text="{Binding ActionLine}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Primary}" IsVisible="{Binding HasAction}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.DataTemplates>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Panel>
                            </DockPanel>
                        </Border>
                    </Popup>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ===================================================================== Filter bar -->

    <ControlTheme x:Key="{x:Type h:HelixFilterBar}" TargetType="h:HelixFilterBar">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="ItemsPanel"><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,2,0,0" Spacing="6">
                        <h:HelixButton Name="PART_Clear" Content="{x:Static h:HelixFilterBar.ClearText}" Icon="x" Variant="Ghost" Tone="Neutral" Size="Sm"
                                       IsVisible="{TemplateBinding ActiveCount, Converter={x:Static h:HelixConverters.IsPositive}}" />
                        <h:HelixButton Name="PART_Saved" Content="{TemplateBinding SavedText}" Icon="star" IconEnd="chevron-down" Variant="Outline" Tone="Neutral" Size="Sm" />
                        <Popup Name="PART_SavePopup" PlacementTarget="{Binding #PART_Saved}" Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True" VerticalOffset="4">
                            <Border Margin="0,0,12,12" Padding="14" Width="280" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                                    BorderThickness="1" CornerRadius="14" BoxShadow="0 12 32 0 #26000000">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{x:Static h:HelixFilterBar.NameText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" />
                                    <TextBox Name="PART_SaveName" MinHeight="34" Padding="10,6" VerticalContentAlignment="Center" CornerRadius="8" />
                                    <h:HelixButton Name="PART_SaveConfirm" Content="{x:Static h:HelixFilterBar.SaveText}" Icon="check" Size="Sm" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                    <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixTextFilter}" TargetType="h:HelixTextFilter">
        <Setter Property="Width" Value="240" />
        <Setter Property="Margin" Value="0,0,10,8" />
        <Setter Property="Template"><ControlTemplate><h:HelixTextField Icon="search" IsClearable="True" Placeholder="{TemplateBinding Placeholder}"
                                Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" /></ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type h:HelixChoiceFilter}" TargetType="h:HelixChoiceFilter">
        <Setter Property="Width" Value="220" />
        <Setter Property="Margin" Value="0,0,10,8" />
        <Setter Property="Template"><ControlTemplate><h:HelixMultiSelect ItemsSource="{TemplateBinding Choices}" SelectedItems="{Binding Chosen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                  Placeholder="{TemplateBinding Label}" IsSearchable="{TemplateBinding IsSearchable}" MaxChips="2" /></ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type h:HelixDateFilter}" TargetType="h:HelixDateFilter">
        <Setter Property="Width" Value="250" />
        <Setter Property="Margin" Value="0,0,10,8" />
        <Setter Property="Template"><ControlTemplate><h:HelixDateRangePicker SelectedRange="{Binding Range, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Placeholder="{TemplateBinding Label}" MaxDays="{TemplateBinding MaxDays}" /></ControlTemplate></Setter>
    </ControlTheme>
    <ControlTheme x:Key="{x:Type h:HelixToggleFilter}" TargetType="h:HelixToggleFilter">
        <Setter Property="Margin" Value="4,0,14,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template"><ControlTemplate><h:HelixSwitch Content="{TemplateBinding Label}" VerticalAlignment="Center"
                             IsChecked="{Binding IsOn, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" /></ControlTemplate></Setter>
    </ControlTheme>

    <!-- ===================================================================== Color picker -->

    <ControlTheme x:Key="{x:Type h:HelixColorPicker}" TargetType="h:HelixColorPicker">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="*" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Danger}" IsVisible="{TemplateBinding IsRequired}" />
                    </StackPanel>
                    <Panel>
                        <Border Name="Halo" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="{DynamicResource Helix.Primary}" Opacity="0" />
                        <Border Name="Frame" MinHeight="{DynamicResource Helix.ControlHeight}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                            <Panel>
                                <ToggleButton Name="Toggle" Theme="{StaticResource HelixBareToggle}" IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,0">
                                    <DockPanel>
                                        <h:HelixIcon DockPanel.Dock="Left" Icon="{TemplateBinding Icon}" Size="16" Foreground="{DynamicResource Helix.TextSubtle}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <h:HelixIcon DockPanel.Dock="Right" Icon="chevron-down" Size="15" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Border DockPanel.Dock="Right" Width="26" Name="ClearSpace" IsVisible="False" />
                                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                            <Border Width="22" Height="22" CornerRadius="6" BorderThickness="1" BorderBrush="#28000000" Background="{TemplateBinding SwatchBrush}"
                                                    IsVisible="{TemplateBinding HasValue}" />
                                            <TextBlock Text="{TemplateBinding Hex}" FontFamily="Cascadia Mono, Menlo, Consolas, monospace" VerticalAlignment="Center" />
                                            <TextBlock Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center"
                                                       IsVisible="{TemplateBinding HasValue, Converter={x:Static BoolConverters.Not}}" />
                                        </StackPanel>
                                    </DockPanel>
                                </ToggleButton>
                                <Button Name="PART_Clear" Theme="{StaticResource HelixIconButton}" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,32,0" IsVisible="False">
                                    <h:HelixIcon Icon="x" Size="13" />
                                </Button>
                            </Panel>
                        </Border>
                        <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" PlacementTarget="{Binding #Frame}" Placement="BottomEdgeAlignedLeft"
                               VerticalOffset="6" IsLightDismissEnabled="True">
                            <Border Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="12" BoxShadow="0 12 32 0 #26000000" Margin="0,0,12,12" Padding="12">
                                <Border Name="PART_Panel" />
                            </Border>
                        </Popup>
                    </Panel>
                    <TextBlock Name="Hint" Text="{TemplateBinding Hint}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="Error" Text="{TemplateBinding Error}" FontSize="12.5" Foreground="{DynamicResource Helix.Danger}" TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" /></Style>
        <Style Selector="^:focus-within /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^:focus-within /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:error /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ Border#Halo"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ TextBlock#Error"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:error /template/ TextBlock#Hint"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.55" /></Style>
        <Style Selector="^[IsDropDownOpen=True] /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^[IsDropDownOpen=True] /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:clearable /template/ Button#PART_Clear"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:clearable /template/ Border#ClearSpace"><Setter Property="IsVisible" Value="True" /></Style>
    </ControlTheme>

    <!-- ===================================================================== File drop -->

    <ControlTheme x:Key="{x:Type h:HelixFileDrop}" TargetType="h:HelixFileDrop">
        <Setter Property="Accent" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel>
                    <Panel Name="Zone">
                        <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" />
                        <Border Name="Tint" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0" />
                        <Rectangle Name="Dash" RadiusX="14" RadiusY="14" StrokeDashArray="5,4" StrokeThickness="1.5" Stroke="{DynamicResource Helix.BorderStrong}" />
                        <StackPanel Name="Big" Margin="24,28" HorizontalAlignment="Center">
                            <Panel Width="44" Height="44" HorizontalAlignment="Center">
                                <Ellipse Fill="{TemplateBinding Accent}" Opacity="0.1" />
                                <h:HelixIcon Icon="upload" Size="20" Foreground="{TemplateBinding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Panel>
                            <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding AutoHint}" FontSize="12.5" Margin="0,3,0,0" HorizontalAlignment="Center" Foreground="{DynamicResource Helix.TextMuted}"
                                       IsVisible="{TemplateBinding AutoHint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <h:HelixButton Name="PART_Browse" Content="{TemplateBinding BrowseText}" Variant="Outline" Tone="Neutral" Size="Sm" Margin="0,14,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Panel>
                    <TextBlock Text="{TemplateBinding Error}" Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Helix.Danger}"
                               IsVisible="{TemplateBinding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ItemsControl Name="List" ItemsSource="{Binding Files, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,10,0,0" IsVisible="{TemplateBinding HasFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="h:HelixFile">
                                <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="10" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Helix.Surface2}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Extension}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Helix.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Button DockPanel.Dock="Right" Theme="{StaticResource HelixIconButton}" Command="{Binding RemoveCommand}" VerticalAlignment="Center">
                                            <h:HelixIcon Icon="x" Size="14" />
                                        </Button>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Helix.Text}" />
                                            <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource Helix.TextMuted}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Tone=Neutral]"><Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" /></Style>
        <Style Selector="^[Tone=Success]"><Setter Property="Accent" Value="{DynamicResource Helix.Success}" /></Style>
        <Style Selector="^[Tone=Warning]"><Setter Property="Accent" Value="{DynamicResource Helix.Warning}" /></Style>
        <Style Selector="^[Tone=Danger]"><Setter Property="Accent" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^[Tone=Info]"><Setter Property="Accent" Value="{DynamicResource Helix.Info}" /></Style>
        <Style Selector="^[IsCompact=True] /template/ StackPanel#Big"><Setter Property="Margin" Value="16,10" /></Style>
        <Style Selector="^[ShowList=False] /template/ ItemsControl#List"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^:pointerover /template/ Rectangle#Dash"><Setter Property="Stroke" Value="{DynamicResource Helix.TextSubtle}" /></Style>
        <Style Selector="^:dragover /template/ Rectangle#Dash"><Setter Property="Stroke" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" /></Style>
        <Style Selector="^:dragover /template/ Border#Tint"><Setter Property="Opacity" Value="0.07" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
    </ControlTheme>

</ResourceDictionary>
