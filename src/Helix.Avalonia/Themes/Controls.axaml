                        <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="*" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Danger}" IsVisible="{TemplateBinding IsRequired}" />
                    </StackPanel>
