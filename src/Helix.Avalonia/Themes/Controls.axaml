<!-- Generated by build/gen_avalonia_theme.py: edit the script, not this file. -->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="using:Helix.Avalonia">

    <!-- Small borderless icon button used inside templates (close buttons). -->
    <ControlTheme x:Key="HelixIconButton" TargetType="Button">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bg" Background="{TemplateBinding Background}" CornerRadius="6">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource Helix.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        </Style>
    </ControlTheme>

    <!-- ===================================================================== Button -->

    <ControlTheme x:Key="{x:Type h:HelixButton}" TargetType="h:HelixButton">
        <Setter Property="Accent" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="{DynamicResource Helix.ControlHeight}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ReflectionBinding Accent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Name="Root" RenderTransformOrigin="50%,50%">
                    <Border Name="Chrome" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                    <Border Name="Tint" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0" IsHitTestVisible="False" />
                    <Border Name="Shade" CornerRadius="{TemplateBinding CornerRadius}" Background="Black" Opacity="0" IsHitTestVisible="False" />
                    <Panel Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                        <StackPanel Name="Body" Orientation="Horizontal" Spacing="8">
                            <h:HelixIcon Icon="{TemplateBinding Icon}" Size="16" VerticalAlignment="Center"
                                         IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              VerticalAlignment="Center" IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <h:HelixIcon Icon="{TemplateBinding IconEnd}" Size="16" VerticalAlignment="Center"
                                         IsVisible="{TemplateBinding IconEnd, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        </StackPanel>
                        <h:HelixSpinner Name="Spinner" Classes="spin" Size="16" Thickness="2.5" Accent="{TemplateBinding Foreground}" IsVisible="False"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Tone=Neutral]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnNeutral}" />
        </Style>
        <Style Selector="^[Tone=Success]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Success}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnSuccess}" />
        </Style>
        <Style Selector="^[Tone=Warning]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Warning}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnWarning}" />
        </Style>
        <Style Selector="^[Tone=Danger]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Danger}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnDanger}" />
        </Style>
        <Style Selector="^[Tone=Info]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Info}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnInfo}" />
        </Style>
        <Style Selector="^[Variant=Solid]">
            <Setter Property="Background" Value="{ReflectionBinding Accent, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground" Value="{ReflectionBinding ResolvedOnAccent, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style Selector="^[Variant=Outline]">
            <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
        </Style>
        <Style Selector="^[Variant=Soft] /template/ Border#Tint"><Setter Property="Opacity" Value="0.11" /></Style>
        <Style Selector="^[Variant=Solid]:pointerover /template/ Border#Shade"><Setter Property="Opacity" Value="0.1" /></Style>
        <Style Selector="^[Variant=Soft]:pointerover /template/ Border#Tint"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^[Variant=Outline]:pointerover /template/ Border#Tint"><Setter Property="Opacity" Value="0.06" /></Style>
        <Style Selector="^[Variant=Ghost]:pointerover /template/ Border#Tint"><Setter Property="Opacity" Value="0.09" /></Style>
        <Style Selector="^:pressed /template/ Panel#Root"><Setter Property="RenderTransform" Value="scale(0.985)" /></Style>
        <Style Selector="^[IsLoading=True] /template/ StackPanel#Body"><Setter Property="Opacity" Value="0" /></Style>
        <Style Selector="^[IsLoading=True] /template/ h|HelixSpinner#Spinner"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:disabled /template/ Panel#Root"><Setter Property="Opacity" Value="0.5" /></Style>
        <Style Selector="^[Size=Sm]">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="^[Size=Lg]">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="FontSize" Value="15" />
        </Style>
    </ControlTheme>

    <!-- ===================================================================== Spinner -->

    <ControlTheme x:Key="{x:Type h:HelixSpinner}" TargetType="h:HelixSpinner">
        <Setter Property="Accent" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Style Selector="^[Tone=Neutral]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" />
        </Style>
        <Style Selector="^[Tone=Success]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Success}" />
        </Style>
        <Style Selector="^[Tone=Warning]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Warning}" />
        </Style>
        <Style Selector="^[Tone=Danger]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Danger}" />
        </Style>
        <Style Selector="^[Tone=Info]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Info}" />
        </Style>
        <Style Selector="^">
            <Style.Animations>
                <Animation Duration="0:0:0.8" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
    </ControlTheme>

    <!-- ===================================================================== Badge -->

    <ControlTheme x:Key="{x:Type h:HelixBadge}" TargetType="h:HelixBadge">
        <Setter Property="Accent" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="{ReflectionBinding Accent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border Name="Tint" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0.13" />
                    <Border Name="Frame" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{TemplateBinding Foreground}" VerticalAlignment="Center" IsVisible="{TemplateBinding ShowDot}" />
                            <h:HelixIcon Icon="{TemplateBinding Icon}" Size="12" VerticalAlignment="Center"
                                         IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Tone=Neutral]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnNeutral}" />
        </Style>
        <Style Selector="^[Tone=Success]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Success}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnSuccess}" />
        </Style>
        <Style Selector="^[Tone=Warning]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Warning}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnWarning}" />
        </Style>
        <Style Selector="^[Tone=Danger]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Danger}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnDanger}" />
        </Style>
        <Style Selector="^[Tone=Info]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Info}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnInfo}" />
        </Style>
        <Style Selector="^[Variant=Solid]">
            <Setter Property="Background" Value="{ReflectionBinding Accent, RelativeSource={RelativeSource Self}}" />
            <Setter Property="Foreground" Value="{ReflectionBinding ResolvedOnAccent, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style Selector="^[Variant=Solid] /template/ Border#Tint"><Setter Property="Opacity" Value="0" /></Style>
        <Style Selector="^[Variant=Outline]">
            <Setter Property="BorderBrush" Value="{ReflectionBinding Accent, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style Selector="^[Variant=Outline] /template/ Border#Tint"><Setter Property="Opacity" Value="0" /></Style>
    </ControlTheme>

    <!-- ===================================================================== Alert -->

    <ControlTheme x:Key="{x:Type h:HelixAlert}" TargetType="h:HelixAlert">
        <Setter Property="Accent" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0.09" />
                    <Border CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding Accent}" BorderThickness="1" Opacity="0.35" />
                    <DockPanel Margin="{TemplateBinding Padding}">
                        <h:HelixIcon DockPanel.Dock="Left" Icon="{TemplateBinding ResolvedIcon}" Size="18" Foreground="{TemplateBinding Accent}"
                                     VerticalAlignment="Top" Margin="0,1,10,0" />
                        <Button Name="PART_Close" DockPanel.Dock="Right" Theme="{StaticResource HelixIconButton}" VerticalAlignment="Top" Margin="8,-4,-6,0"
                                IsVisible="{TemplateBinding IsClosable}">
                            <h:HelixIcon Icon="x" Size="14" />
                        </Button>
                        <StackPanel Spacing="2">
                            <TextBlock Text="{TemplateBinding Title}" FontWeight="SemiBold" TextWrapping="Wrap"
                                       IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Foreground="{DynamicResource Helix.TextMuted}">
                                <ContentPresenter.Styles>
                                    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                                </ContentPresenter.Styles>
                            </ContentPresenter>
                        </StackPanel>
                    </DockPanel>
                </Panel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Tone=Neutral]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" />
        </Style>
        <Style Selector="^[Tone=Success]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Success}" />
        </Style>
        <Style Selector="^[Tone=Warning]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Warning}" />
        </Style>
        <Style Selector="^[Tone=Danger]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Danger}" />
        </Style>
        <Style Selector="^[Tone=Info]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Info}" />
        </Style>
    </ControlTheme>

    <!-- ===================================================================== Card -->

    <ControlTheme x:Key="{x:Type h:HelixCard}" TargetType="h:HelixCard">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                    <DockPanel>
                        <Border Name="Head" DockPanel.Dock="Top" Padding="20,16,20,0" IsVisible="{TemplateBinding HasHeader}">
                            <DockPanel>
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Actions}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                <Panel>
                                    <StackPanel Spacing="2" IsVisible="{TemplateBinding Header, Converter={x:Static ObjectConverters.IsNull}}">
                                        <TextBlock Text="{TemplateBinding Title}" FontSize="16" FontWeight="SemiBold"
                                                   IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                        <TextBlock Text="{TemplateBinding Subtitle}" FontSize="13" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                                                   IsVisible="{TemplateBinding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                                    </StackPanel>
                                    <ContentPresenter Content="{TemplateBinding Header}" />
                                </Panel>
                            </DockPanel>
                        </Border>
                        <Border Name="Foot" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,1,0,0" Padding="20,12"
                                Background="{DynamicResource Helix.Surface2}" IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}">
                            <ContentPresenter Content="{TemplateBinding Footer}" />
                        </Border>
                        <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[IsElevated=True] /template/ Border#Frame">
            <Setter Property="BoxShadow" Value="0 8 24 0 #1A000000, 0 1 3 0 #12000000" />
            <Setter Property="ClipToBounds" Value="False" />
        </Style>
    </ControlTheme>

    <!-- ===================================================================== Progress -->

    <ControlTheme x:Key="{x:Type h:HelixProgress}" TargetType="h:HelixProgress">
        <Setter Property="Accent" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="TrackBrush" Value="{DynamicResource Helix.Surface3}" />
        <Setter Property="Minimum" Value="0" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <DockPanel IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding PercentText}" FontSize="13" FontWeight="SemiBold" IsVisible="{TemplateBinding ShowValue}" />
                        <TextBlock Text="{TemplateBinding Label}" FontSize="13" Foreground="{DynamicResource Helix.TextMuted}" />
                    </DockPanel>
                    <Border Name="PART_Indicator" IsVisible="False" />
                    <Border Name="Track" Height="{TemplateBinding BarHeight}" CornerRadius="999" Background="{TemplateBinding TrackBrush}" ClipToBounds="True">
                        <Border Name="Fill" CornerRadius="999" Background="{TemplateBinding Accent}" HorizontalAlignment="Left" Width="0">
                            <Border.Transitions>
                                <Transitions><DoubleTransition Property="Width" Duration="0:0:0.3" Easing="CubicEaseOut" /></Transitions>
                            </Border.Transitions>
                        </Border>
                    </Border>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Tone=Neutral]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" />
        </Style>
        <Style Selector="^[Tone=Success]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Success}" />
        </Style>
        <Style Selector="^[Tone=Warning]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Warning}" />
        </Style>
        <Style Selector="^[Tone=Danger]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Danger}" />
        </Style>
        <Style Selector="^[Tone=Info]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Info}" />
        </Style>
    </ControlTheme>

    <!-- ===================================================================== Empty state -->

    <ControlTheme x:Key="{x:Type h:HelixEmptyState}" TargetType="h:HelixEmptyState">
        <Setter Property="Accent" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Padding" Value="24,36" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" Spacing="6" MaxWidth="420">
                    <Panel Width="48" Height="48" HorizontalAlignment="Center" Margin="0,0,0,8">
                        <Border CornerRadius="14" Background="{TemplateBinding Accent}" Opacity="0.12" />
                        <h:HelixIcon Icon="{TemplateBinding Icon}" Size="22" Foreground="{TemplateBinding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Panel>
                    <TextBlock Text="{TemplateBinding Title}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                    <TextBlock Text="{TemplateBinding Description}" FontSize="13.5" Foreground="{DynamicResource Helix.TextMuted}" HorizontalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" IsVisible="{TemplateBinding Description, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ContentPresenter Content="{TemplateBinding Actions}" HorizontalAlignment="Center" Margin="0,10,0,0" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Tone=Neutral]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" />
        </Style>
        <Style Selector="^[Tone=Success]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Success}" />
        </Style>
        <Style Selector="^[Tone=Warning]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Warning}" />
        </Style>
        <Style Selector="^[Tone=Danger]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Danger}" />
        </Style>
        <Style Selector="^[Tone=Info]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Info}" />
        </Style>
    </ControlTheme>

    <!-- ===================================================================== Stat -->

    <ControlTheme x:Key="{x:Type h:HelixStat}" TargetType="h:HelixStat">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <h:HelixIcon Icon="{TemplateBinding Icon}" Size="14" Foreground="{DynamicResource Helix.TextMuted}" VerticalAlignment="Center"
                                     IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Helix.TextMuted}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Text="{TemplateBinding Value}" FontSize="26" FontWeight="SemiBold" />
                        <TextBlock Text="{TemplateBinding Unit}" FontSize="14" Foreground="{DynamicResource Helix.TextMuted}" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </StackPanel>
                    <StackPanel Name="Delta" Orientation="Horizontal" Spacing="3" IsVisible="{TemplateBinding DeltaText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                TextElement.Foreground="{DynamicResource Helix.TextMuted}">
                        <h:HelixIcon Icon="{TemplateBinding DeltaIcon}" Size="12" VerticalAlignment="Center" />
                        <TextBlock Text="{TemplateBinding DeltaText}" FontSize="12.5" FontWeight="SemiBold" />
                    </StackPanel>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:good /template/ StackPanel#Delta"><Setter Property="TextElement.Foreground" Value="{DynamicResource Helix.Success}" /></Style>
        <Style Selector="^:bad /template/ StackPanel#Delta"><Setter Property="TextElement.Foreground" Value="{DynamicResource Helix.Danger}" /></Style>
    </ControlTheme>

    <!-- ===================================================================== Text field -->

    <!-- The editable part of HelixTextField: a TextBox without its own frame. -->
    <ControlTheme x:Key="HelixInput" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Helix.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Helix.PrimarySoft}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Helix.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="IBeam" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel Background="Transparent">
                    <TextBlock Name="PART_Watermark" Text="{TemplateBinding PlaceholderText}" Foreground="{DynamicResource Helix.TextSubtle}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}" IsHitTestVisible="False"
                               IsVisible="{TemplateBinding Text, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                    <ScrollViewer Name="PART_ScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"
                                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}">
                        <TextPresenter Name="PART_TextPresenter"
                                       Text="{TemplateBinding Text, Mode=TwoWay}"
                                       CaretIndex="{TemplateBinding CaretIndex}"
                                       SelectionStart="{TemplateBinding SelectionStart}"
                                       SelectionEnd="{TemplateBinding SelectionEnd}"
                                       TextAlignment="{TemplateBinding TextAlignment}"
                                       TextWrapping="{TemplateBinding TextWrapping}"
                                       PasswordChar="{TemplateBinding PasswordChar}"
                                       RevealPassword="{TemplateBinding RevealPassword}"
                                       SelectionBrush="{TemplateBinding SelectionBrush}"
                                       SelectionForegroundBrush="{TemplateBinding SelectionForegroundBrush}"
                                       CaretBrush="{TemplateBinding CaretBrush}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ScrollViewer>
                </Panel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixTextField}" TargetType="h:HelixTextField">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="*" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Danger}" IsVisible="{TemplateBinding IsRequired}" />
                    </StackPanel>
                    <Panel>
                        <Border Name="Halo" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="{DynamicResource Helix.Primary}" Opacity="0" />
                        <Border Name="Frame" MinHeight="{DynamicResource Helix.ControlHeight}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <h:HelixIcon DockPanel.Dock="Left" Icon="{TemplateBinding Icon}" Size="16" Foreground="{DynamicResource Helix.TextSubtle}"
                                             VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Suffix}" VerticalAlignment="Center" Margin="8,0,0,0"
                                                  Foreground="{DynamicResource Helix.TextMuted}" IsVisible="{TemplateBinding Suffix, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                <Button Name="PART_Clear" DockPanel.Dock="Right" Theme="{StaticResource HelixIconButton}" Width="22" Height="22" Margin="6,0,-4,0"
                                        VerticalAlignment="Center" IsVisible="False">
                                    <h:HelixIcon Icon="x" Size="13" />
                                </Button>
                                <TextBox Name="PART_Input" Theme="{StaticResource HelixInput}" Text="{TemplateBinding Text, Mode=TwoWay}"
                                         PlaceholderText="{TemplateBinding Placeholder}" IsReadOnly="{TemplateBinding IsReadOnly}" PasswordChar="{TemplateBinding PasswordChar}"
                                         AcceptsReturn="{TemplateBinding AcceptsReturn}" FontSize="{TemplateBinding FontSize}" FontFamily="{TemplateBinding FontFamily}" />
                            </DockPanel>
                        </Border>
                    </Panel>
                    <TextBlock Name="Hint" Text="{TemplateBinding Hint}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="Error" Text="{TemplateBinding Error}" FontSize="12.5" Foreground="{DynamicResource Helix.Danger}" TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" /></Style>
        <Style Selector="^:focus-within /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^:focus-within /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:error /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ Border#Halo"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ TextBlock#Error"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:error /template/ TextBlock#Hint"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^:clearable /template/ Button#PART_Clear"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.55" /></Style>
    </ControlTheme>

    <!-- ===================================================================== Switch -->

    <ControlTheme x:Key="{x:Type h:HelixSwitch}" TargetType="h:HelixSwitch">
        <Setter Property="Accent" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="TrackBrush" Value="{DynamicResource Helix.Surface3}" />
        <Setter Property="ThumbBrush" Value="White" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Background="{TemplateBinding Background}">
                    <Panel Name="Track" DockPanel.Dock="Left" Width="36" Height="20" VerticalAlignment="Center">
                        <Border Name="Halo" Margin="-3" CornerRadius="999" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                        <Border CornerRadius="999" Background="{TemplateBinding TrackBrush}" />
                        <Border Name="On" CornerRadius="999" Background="{TemplateBinding Accent}" Opacity="0">
                            <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.15" /></Transitions></Border.Transitions>
                        </Border>
                        <Border Name="Thumb" Width="16" Height="16" Margin="2" CornerRadius="999" Background="{TemplateBinding ThumbBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center" BoxShadow="0 1 2 0 #33000000">
                            <Border.Transitions><Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="CubicEaseOut" /></Transitions></Border.Transitions>
                        </Border>
                    </Panel>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" Margin="10,0,0,0" IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Tone=Neutral]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" />
        </Style>
        <Style Selector="^[Tone=Success]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Success}" />
        </Style>
        <Style Selector="^[Tone=Warning]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Warning}" />
        </Style>
        <Style Selector="^[Tone=Danger]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Danger}" />
        </Style>
        <Style Selector="^[Tone=Info]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Info}" />
        </Style>
        <Style Selector="^:checked /template/ Border#On"><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="^:checked /template/ Border#Thumb"><Setter Property="RenderTransform" Value="translateX(16px)" /></Style>
        <Style Selector="^:focus-visible /template/ Border#Halo"><Setter Property="Opacity" Value="0.25" /></Style>
        <Style Selector="^[LabelPosition=Start] /template/ Panel#Track"><Setter Property="DockPanel.Dock" Value="Right" /></Style>
        <Style Selector="^[LabelPosition=Start] /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Margin" Value="0,0,10,0" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
    </ControlTheme>

    <!-- ===================================================================== Check box -->

    <ControlTheme x:Key="{x:Type h:HelixCheckBox}" TargetType="h:HelixCheckBox">
        <Setter Property="Accent" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnPrimary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <ControlTemplate>
                <DockPanel Background="{TemplateBinding Background}">
                    <Panel DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Center">
                        <Border Name="Halo" Margin="-3" CornerRadius="7" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                        <Border Name="Box" CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource Helix.BorderStrong}" Background="{DynamicResource Helix.Surface}" />
                        <Border Name="Fill" CornerRadius="5" Background="{TemplateBinding Accent}" Opacity="0">
                            <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.12" /></Transitions></Border.Transitions>
                        </Border>
                        <h:HelixIcon Name="Check" Icon="check" Size="13" StrokeWidth="3" Foreground="{TemplateBinding ResolvedOnAccent}" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Opacity="0" />
                        <h:HelixIcon Name="Dash" Icon="minus" Size="13" StrokeWidth="3" Foreground="{TemplateBinding ResolvedOnAccent}" HorizontalAlignment="Center"
                                     VerticalAlignment="Center" Opacity="0" />
                    </Panel>
                    <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" Margin="10,0,0,0" IsVisible="{TemplateBinding Content, Converter={x:Static ObjectConverters.IsNotNull}}" />
                </DockPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Tone=Neutral]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnNeutral}" />
        </Style>
        <Style Selector="^[Tone=Success]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Success}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnSuccess}" />
        </Style>
        <Style Selector="^[Tone=Warning]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Warning}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnWarning}" />
        </Style>
        <Style Selector="^[Tone=Danger]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Danger}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnDanger}" />
        </Style>
        <Style Selector="^[Tone=Info]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Info}" />
            <Setter Property="ToneOnBrush" Value="{DynamicResource Helix.OnInfo}" />
        </Style>
        <Style Selector="^:pointerover /template/ Border#Box"><Setter Property="BorderBrush" Value="{ReflectionBinding Accent, RelativeSource={RelativeSource TemplatedParent}}" /></Style>
        <Style Selector="^:checked /template/ Border#Fill"><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="^:checked /template/ h|HelixIcon#Check"><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="^:indeterminate /template/ Border#Fill"><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="^:indeterminate /template/ h|HelixIcon#Dash"><Setter Property="Opacity" Value="1" /></Style>
        <Style Selector="^:focus-visible /template/ Border#Halo"><Setter Property="Opacity" Value="0.25" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
    </ControlTheme>


    <!-- ===================================================================== Chart -->

    <ControlTheme x:Key="{x:Type h:HelixChart}" TargetType="h:HelixChart">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="10">
                    <DockPanel>
                        <WrapPanel Name="PART_Legend" DockPanel.Dock="Right" VerticalAlignment="Top" />
                        <StackPanel Spacing="2" VerticalAlignment="Top">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="15" FontWeight="SemiBold"
                                       IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Text="{TemplateBinding Subtitle}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}"
                                       IsVisible="{TemplateBinding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                        </StackPanel>
                    </DockPanel>
                    <h:HelixPlot Name="PART_Plot" Height="{TemplateBinding PlotHeight}" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixDonut}" TargetType="h:HelixDonut">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="14">
                    <StackPanel Spacing="2" IsVisible="{TemplateBinding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{TemplateBinding Title}" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="{TemplateBinding Subtitle}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}"
                                   IsVisible="{TemplateBinding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                    <WrapPanel>
                        <h:HelixPlot Name="PART_Plot" VerticalAlignment="Center" Margin="0,0,24,12" />
                        <StackPanel Name="PART_Legend" VerticalAlignment="Center" MinWidth="200" />
                    </WrapPanel>
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Shape=SegmentedBar] /template/ WrapPanel"><Setter Property="Orientation" Value="Vertical" /></Style>
        <Style Selector="^[Shape=SegmentedBar] /template/ h|HelixPlot#PART_Plot"><Setter Property="Margin" Value="0,0,0,14" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixBarList}" TargetType="h:HelixBarList">
        <Setter Property="Accent" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Name="PART_Rows" />
            </ControlTemplate>
        </Setter>
        <Style Selector="^[Tone=Neutral]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Neutral}" />
        </Style>
        <Style Selector="^[Tone=Success]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Success}" />
        </Style>
        <Style Selector="^[Tone=Warning]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Warning}" />
        </Style>
        <Style Selector="^[Tone=Danger]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Danger}" />
        </Style>
        <Style Selector="^[Tone=Info]">
            <Setter Property="Accent" Value="{DynamicResource Helix.Info}" />
        </Style>
    </ControlTheme>

    <!-- ===================================================================== Data grid -->

    <ControlTheme x:Key="{x:Type h:HelixDataGrid}" TargetType="h:HelixDataGrid">
        <Setter Property="SearchPlaceholder" Value="{x:Static h:HelixDataGrid.SearchPlaceholderText}" />
        <Setter Property="EmptyText" Value="{x:Static h:HelixDataGrid.EmptyTextDefault}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="12" IsVisible="{TemplateBinding HasToolbar}">
                            <h:HelixButton Name="PART_Export" DockPanel.Dock="Right" Icon="download" Content="{x:Static h:HelixDataGrid.ExportText}" Variant="Outline"
                                           Tone="Neutral" Size="Sm" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{TemplateBinding IsExportable}" />
                            <h:HelixButton Name="PART_Columns" DockPanel.Dock="Right" Icon="columns" Content="{x:Static h:HelixDataGrid.ColumnsText}" Variant="Outline"
                                           Tone="Neutral" Size="Sm" Margin="8,0,0,0" VerticalAlignment="Center" IsVisible="{TemplateBinding ShowColumnChooser}" />
                            <h:HelixTextField DockPanel.Dock="Right" Width="240" Icon="search" IsClearable="True" VerticalAlignment="Center"
                                              Text="{TemplateBinding SearchText, Mode=TwoWay}" Placeholder="{TemplateBinding SearchPlaceholder}" IsVisible="{TemplateBinding IsSearchable}" />
                            <ContentPresenter Content="{TemplateBinding Toolbar}" VerticalAlignment="Center" />
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Bottom" Margin="16,8" IsVisible="{TemplateBinding HasPager}">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                <h:HelixButton Name="PART_Previous" Icon="chevron-left" Variant="Outline" Tone="Neutral" Size="Sm" Width="32" Padding="0" />
                                <TextBlock Text="{TemplateBinding PageText}" FontSize="13" VerticalAlignment="Center" Margin="6,0" Foreground="{DynamicResource Helix.TextMuted}" />
                                <h:HelixButton Name="PART_Next" Icon="chevron-right" Variant="Outline" Tone="Neutral" Size="Sm" Width="32" Padding="0" />
                            </StackPanel>
                            <TextBlock Text="{TemplateBinding InfoText}" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Helix.TextMuted}" />
                        </DockPanel>
                        <Border DockPanel.Dock="Bottom" Height="42" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,1,0,1"
                                Background="{DynamicResource Helix.Surface2}" IsVisible="{TemplateBinding HasTotals}" ClipToBounds="True">
                            <StackPanel Name="PART_Totals" Orientation="Horizontal" />
                        </Border>
                        <Panel>
                            <DataGrid Name="PART_Grid" Classes="helix-grid" IsReadOnly="True" CanUserSortColumns="True" CanUserResizeColumns="True"
                                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" Background="Transparent" BorderThickness="0"
                                      HorizontalGridLinesBrush="{DynamicResource Helix.Border}" RowDetailsTemplate="{TemplateBinding RowDetailsTemplate}"
                                      SelectedItem="{TemplateBinding SelectedItem, Mode=TwoWay}" />
                            <h:HelixEmptyState Title="{TemplateBinding EmptyMessage}" VerticalAlignment="Center" Margin="0,40,0,0" IsHitTestVisible="False">
                                <h:HelixEmptyState.IsVisible>
                                    <MultiBinding Converter="{x:Static BoolConverters.And}">
                                        <TemplateBinding Property="IsEmpty" />
                                        <TemplateBinding Property="Error" Converter="{x:Static ObjectConverters.IsNull}" />
                                    </MultiBinding>
                                </h:HelixEmptyState.IsVisible>
                            </h:HelixEmptyState>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" Margin="0,40,0,0"
                                        IsVisible="{TemplateBinding Error, Converter={x:Static ObjectConverters.IsNotNull}}">
                                <h:HelixIcon Icon="danger" Size="22" Foreground="{DynamicResource Helix.Danger}" HorizontalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Error}" Foreground="{DynamicResource Helix.TextMuted}" HorizontalAlignment="Center" />
                                <h:HelixButton Name="PART_Retry" Content="{x:Static h:HelixDataGrid.RetryText}" Icon="refresh" Variant="Soft" HorizontalAlignment="Center" />
                            </StackPanel>
                            <Border Background="{DynamicResource Helix.Surface}" Opacity="0.7" IsVisible="{TemplateBinding IsLoading}">
                                <h:HelixSpinner Size="28" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <!-- ===================================================================== Toasts -->

    <ControlTheme x:Key="{x:Type h:HelixToastHost}" TargetType="h:HelixToastHost">
        <Setter Property="IsHitTestVisible" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <ItemsControl ItemsSource="{x:Static h:HelixToasts.Items}" Width="360" Margin="20"
                              HorizontalAlignment="{TemplateBinding ToastHorizontalAlignment}" VerticalAlignment="{TemplateBinding ToastVerticalAlignment}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="h:HelixToast">
                            <Border Margin="0,8,0,0" Padding="14,12,8,12" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                                    BorderThickness="1" CornerRadius="12" BoxShadow="0 10 30 0 #24000000" Classes.success="{Binding Severity, Converter={x:Static h:HelixConverters.IsSuccess}}"
                                    Classes.warning="{Binding Severity, Converter={x:Static h:HelixConverters.IsWarning}}"
                                    Classes.danger="{Binding Severity, Converter={x:Static h:HelixConverters.IsDanger}}"
                                    TextElement.FontFamily="{DynamicResource Helix.FontFamily}" TextElement.FontSize="{DynamicResource Helix.FontSize}">
                                <DockPanel>
                                    <h:HelixIcon Name="Icon" DockPanel.Dock="Left" Icon="{Binding Icon}" Size="18" Margin="0,1,10,0" VerticalAlignment="Top"
                                                 Foreground="{DynamicResource Helix.Info}" />
                                    <Button DockPanel.Dock="Right" Theme="{StaticResource HelixIconButton}" VerticalAlignment="Top" Margin="8,-3,0,0"
                                            Command="{Binding CloseCommand}" ToolTip.Tip="{Binding CloseText}">
                                        <h:HelixIcon Icon="x" Size="14" />
                                    </Button>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{DynamicResource Helix.Text}" IsVisible="{Binding HasTitle}" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}" />
                                    </StackPanel>
                                </DockPanel>
                                <Border.Styles>
                                    <Style Selector="Border.success h|HelixIcon#Icon"><Setter Property="Foreground" Value="{DynamicResource Helix.Success}" /></Style>
                                    <Style Selector="Border.warning h|HelixIcon#Icon"><Setter Property="Foreground" Value="{DynamicResource Helix.Warning}" /></Style>
                                    <Style Selector="Border.danger h|HelixIcon#Icon"><Setter Property="Foreground" Value="{DynamicResource Helix.Danger}" /></Style>
                                </Border.Styles>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ControlTemplate>
        </Setter>
    </ControlTheme>


    <!-- ===================================================================== Fields and pickers -->

    <!-- The − / + buttons of the number field. -->
    <ControlTheme x:Key="HelixStepper" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover">
            <Setter Property="Background" Value="{DynamicResource Helix.Surface2}" />
            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        </Style>
    </ControlTheme>

    <!-- A toggle without its own look: the clickable part of a picker field. -->
    <ControlTheme x:Key="HelixBareToggle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Stretch" />
                </Border>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="HelixCalendarDay" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                    <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover"><Setter Property="Background" Value="{DynamicResource Helix.Surface2}" /></Style>
        <Style Selector="^.outside"><Setter Property="Foreground" Value="{DynamicResource Helix.TextSubtle}" /></Style>
        <Style Selector="^.today">
            <Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="^.in-range"><Setter Property="Background" Value="{DynamicResource Helix.PrimarySoft}" /></Style>
        <Style Selector="^.selected">
            <Setter Property="Background" Value="{DynamicResource Helix.Primary}" />
            <Setter Property="Foreground" Value="{DynamicResource Helix.OnPrimary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="^:disabled">
            <Setter Property="Foreground" Value="{DynamicResource Helix.TextSubtle}" />
            <Setter Property="Opacity" Value="0.45" />
        </Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixCalendar}" TargetType="h:HelixCalendar">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <DockPanel>
                        <Button Name="PART_Previous" DockPanel.Dock="Left" Theme="{StaticResource HelixIconButton}" Width="30" Height="30"><h:HelixIcon Icon="chevron-left" Size="16" /></Button>
                        <Button Name="PART_Next" DockPanel.Dock="Right" Theme="{StaticResource HelixIconButton}" Width="30" Height="30"><h:HelixIcon Icon="chevron-right" Size="16" /></Button>
                        <TextBlock Text="{TemplateBinding MonthText}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </DockPanel>
                    <UniformGrid Name="PART_Days" Columns="7" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixDatePicker}" TargetType="h:HelixDatePicker">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="*" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Danger}" IsVisible="{TemplateBinding IsRequired}" />
                    </StackPanel>
                    <Panel>
                        <Border Name="Halo" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="{DynamicResource Helix.Primary}" Opacity="0" />
                        <Border Name="Frame" MinHeight="{DynamicResource Helix.ControlHeight}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                            <Panel>
                                <ToggleButton Name="Toggle" Theme="{StaticResource HelixBareToggle}" IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,0">
                                    <DockPanel>
                                        <h:HelixIcon DockPanel.Dock="Left" Icon="{TemplateBinding Icon}" Size="16" Foreground="{DynamicResource Helix.TextSubtle}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <h:HelixIcon DockPanel.Dock="Right" Icon="chevron-down" Size="15" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Border DockPanel.Dock="Right" Width="26" Name="ClearSpace" IsVisible="False" />
                                        <Panel>
                                        <TextBlock Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center"
                                                   IsVisible="{TemplateBinding HasValue, Converter={x:Static BoolConverters.Not}}" />
                                        <TextBlock Text="{TemplateBinding DisplayText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Panel>
                                    </DockPanel>
                                </ToggleButton>
                                <Button Name="PART_Clear" Theme="{StaticResource HelixIconButton}" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,32,0" IsVisible="False">
                                    <h:HelixIcon Icon="x" Size="13" />
                                </Button>
                            </Panel>
                        </Border>
                        <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" PlacementTarget="{Binding #Frame}" Placement="BottomEdgeAlignedLeft"
                               VerticalOffset="6" IsLightDismissEnabled="True">
                            <Border Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="12" BoxShadow="0 12 32 0 #26000000" Margin="0,0,12,12" Padding="12">
                                <StackPanel Spacing="8">
                                    <h:HelixCalendar Name="PART_Calendar" />
                                    <h:HelixButton Name="PART_Today" Content="{x:Static h:HelixPickerBase.TodayText}" Variant="Ghost" Size="Sm" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Panel>
                    <TextBlock Name="Hint" Text="{TemplateBinding Hint}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="Error" Text="{TemplateBinding Error}" FontSize="12.5" Foreground="{DynamicResource Helix.Danger}" TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" /></Style>
        <Style Selector="^:focus-within /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^:focus-within /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:error /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ Border#Halo"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ TextBlock#Error"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:error /template/ TextBlock#Hint"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.55" /></Style>
        <Style Selector="^[IsDropDownOpen=True] /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^[IsDropDownOpen=True] /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:clearable /template/ Button#PART_Clear"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:clearable /template/ Border#ClearSpace"><Setter Property="IsVisible" Value="True" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixDateTimePicker}" TargetType="h:HelixDateTimePicker">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Template">
            <ControlTemplate>
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="3" IsVisible="{TemplateBinding Label, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold" />
                        <TextBlock Text="*" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Danger}" IsVisible="{TemplateBinding IsRequired}" />
                    </StackPanel>
                    <Panel>
                        <Border Name="Halo" Margin="-3" CornerRadius="13" BorderThickness="3" BorderBrush="{DynamicResource Helix.Primary}" Opacity="0" />
                        <Border Name="Frame" MinHeight="{DynamicResource Helix.ControlHeight}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                            <Panel>
                                <ToggleButton Name="Toggle" Theme="{StaticResource HelixBareToggle}" IsChecked="{TemplateBinding IsDropDownOpen, Mode=TwoWay}"
                                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,0">
                                    <DockPanel>
                                        <h:HelixIcon DockPanel.Dock="Left" Icon="{TemplateBinding Icon}" Size="16" Foreground="{DynamicResource Helix.TextSubtle}"
                                                     VerticalAlignment="Center" Margin="0,0,8,0" IsVisible="{TemplateBinding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                        <h:HelixIcon DockPanel.Dock="Right" Icon="chevron-down" Size="15" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                        <Border DockPanel.Dock="Right" Width="26" Name="ClearSpace" IsVisible="False" />
                                        <Panel>
                                        <TextBlock Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center"
                                                   IsVisible="{TemplateBinding HasValue, Converter={x:Static BoolConverters.Not}}" />
                                        <TextBlock Text="{TemplateBinding DisplayText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </Panel>
                                    </DockPanel>
                                </ToggleButton>
                                <Button Name="PART_Clear" Theme="{StaticResource HelixIconButton}" Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,32,0" IsVisible="False">
                                    <h:HelixIcon Icon="x" Size="13" />
                                </Button>
                            </Panel>
                        </Border>
                        <Popup Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen, Mode=TwoWay}" PlacementTarget="{Binding #Frame}" Placement="BottomEdgeAlignedLeft"
                               VerticalOffset="6" IsLightDismissEnabled="True">
                            <Border Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="12" BoxShadow="0 12 32 0 #26000000" Margin="0,0,12,12" Padding="12">
                                <StackPanel Spacing="8">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <h:HelixCalendar Name="PART_Calendar" />
                                        <Border Width="1" Background="{DynamicResource Helix.Border}" />
                                        <ListBox Name="PART_Times" Width="96" Height="272" Background="Transparent">
                                            <ListBox.Styles>
                                                <Style Selector="ListBoxItem">
                                                    <Setter Property="Padding" Value="10,6" />
                                                    <Setter Property="CornerRadius" Value="7" />
                                                    <Setter Property="IsEnabled" Value="{ReflectionBinding IsEnabled}" />
                                                </Style>
                                                <Style Selector="ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
                                                    <Setter Property="Background" Value="{DynamicResource Helix.Primary}" />
                                                    <Setter Property="Foreground" Value="{DynamicResource Helix.OnPrimary}" />
                                                </Style>
                                            </ListBox.Styles>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate x:DataType="h:HelixTimeSlot">
                                                    <TextBlock Text="{Binding Text}" FontSize="13" />
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                    <h:HelixButton Name="PART_Now" Content="{x:Static h:HelixPickerBase.NowText}" Variant="Ghost" Size="Sm" HorizontalAlignment="Left" />
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Panel>
                    <TextBlock Name="Hint" Text="{TemplateBinding Hint}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap"
                               IsVisible="{TemplateBinding Hint, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <TextBlock Name="Error" Text="{TemplateBinding Error}" FontSize="12.5" Foreground="{DynamicResource Helix.Danger}" TextWrapping="Wrap" IsVisible="False" />
                </StackPanel>
            </ControlTemplate>
        </Setter>
        <Style Selector="^:pointerover /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" /></Style>
        <Style Selector="^:focus-within /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^:focus-within /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:error /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ Border#Halo"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Danger}" /></Style>
        <Style Selector="^:error /template/ TextBlock#Error"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:error /template/ TextBlock#Hint"><Setter Property="IsVisible" Value="False" /></Style>
        <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.55" /></Style>
        <Style Selector="^[IsDropDownOpen=True] /template/ Border#Frame"><Setter Property="BorderBrush" Value="{DynamicResource Helix.Primary}" /></Style>
        <Style Selector="^[IsDropDownOpen=True] /template/ Border#Halo"><Setter Property="Opacity" Value="0.18" /></Style>
        <Style Selector="^:clearable /template/ Button#PART_Clear"><Setter Property="IsVisible" Value="True" /></Style>
        <Style Selector="^:clearable /template/ Border#ClearSpace"><Setter Property="IsVisible" Value="True" /></Style>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type h:HelixDateRangePicker}" TargetType="h:HelixDateRangePicker">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
