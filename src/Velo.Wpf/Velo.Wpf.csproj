<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Lets the library build on macOS and Linux too (it only runs on Windows). -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>Velo.Wpf</RootNamespace>
    <Description>Velo UI for WPF: clean, modern controls where every visual part is a property.</Description>
  </PropertyGroup>

</Project>
