<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Velo.Wpf">

    <!--
        Velo UI for WPF: default look of every control.
        Colors come from DynamicResource Velo.* (see VeloResources), so the theme switches live.
        Every visual part is a property on the control: you never need to copy these templates.
    -->

    <BooleanToVisibilityConverter x:Key="Velo.BoolToVisibility" />

    <DropShadowEffect x:Key="Velo.ShadowSm" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#000000" />
    <DropShadowEffect x:Key="Velo.ShadowLg" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.16" Color="#000000" />

    <!-- Keyboard focus: a soft ring in the primary color. -->
    <Style x:Key="Velo.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Velo.Primary}" Opacity="0.45" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small square icon button (clear, close, steppers, calendar). -->
    <Style x:Key="Velo.IconButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Velo.Surface3}" />
                            <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless text box used inside Velo fields. -->
    <Style x:Key="Velo.BareTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Velo.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Velo.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Spinner -->

    <Style TargetType="{x:Type local:VeloSpinner}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloSpinner}">
                    <Viewbox Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
                        <Grid x:Name="Ring" Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform />
                            </Grid.RenderTransform>
                            <Ellipse Margin="3" Stroke="{TemplateBinding Accent}" StrokeThickness="{TemplateBinding Thickness}" Opacity="0.2" />
                            <Path Data="M12,3 A9,9 0 0 1 21,12" Stroke="{TemplateBinding Accent}" StrokeThickness="{TemplateBinding Thickness}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Viewbox>
                    <ControlTemplate.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                     From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Button -->

    <Style TargetType="{x:Type local:VeloButton}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Velo.FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="{DynamicResource Velo.ControlHeight}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Velo.Radius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{Binding Accent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Velo.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloButton}">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="Chrome" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Tint" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="Shade" CornerRadius="{TemplateBinding CornerRadius}" Background="Black" Opacity="0" IsHitTestVisible="False" />
                        <Grid Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <StackPanel x:Name="Body" Orientation="Horizontal">
                                <local:VeloIcon x:Name="IconStart" Icon="{TemplateBinding Icon}" Size="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                <local:VeloIcon x:Name="IconEnd" Icon="{TemplateBinding IconEnd}" Size="16" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <local:VeloSpinner x:Name="Spinner" Size="16" Thickness="2.5" Accent="{TemplateBinding Foreground}" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconStart" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IconEnd" Value="{x:Null}">
                            <Setter TargetName="IconEnd" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="IconStart" Property="Margin" Value="0" />
                            <Setter TargetName="IconEnd" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Soft">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.11" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Variant" Value="Solid" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Shade" Property="Opacity" Value="0.1" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Variant" Value="Soft" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tint" Property="Opacity" Value="0.18" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Variant" Value="Outline" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tint" Property="Opacity" Value="0.06" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Variant" Value="Ghost" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tint" Property="Opacity" Value="0.09" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
<Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsLoading" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="0" />
                            <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                            <Setter Property="Cursor" Value="Wait" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Variant" Value="Solid">
                <Setter Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground" Value="{Binding OnAccent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
            <Trigger Property="Variant" Value="Outline">
                <Setter Property="Background" Value="{DynamicResource Velo.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Velo.BorderStrong}" />
            </Trigger>
            <Trigger Property="Size" Value="Sm">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="13" />
            </Trigger>
            <Trigger Property="Size" Value="Lg">
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="FontSize" Value="15" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== Switch -->

    <Style TargetType="{x:Type local:VeloSwitch}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="TrackBrush" Value="{DynamicResource Velo.Surface3}" />
        <Setter Property="ThumbBrush" Value="#FFFFFFFF" />
        <Setter Property="ThumbOnBrush" Value="{Binding ThumbBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Velo.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloSwitch}">
                    <DockPanel x:Name="Root" Background="{TemplateBinding Background}" LastChildFill="True">
                        <Grid x:Name="PART_Track" DockPanel.Dock="Left" Height="20" MinWidth="36" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Border x:Name="Halo" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3"
                                    BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="TrackOff" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding TrackBrush}" />
                            <Border x:Name="TrackOn" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0" />
                            <Grid x:Name="Texts" MinWidth="{TemplateBinding TrackMinWidth}" VerticalAlignment="Center">
                                <TextBlock x:Name="OnText" Text="{TemplateBinding OnText}" Margin="8,0,22,0" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{TemplateBinding OnAccent}" VerticalAlignment="Center" Opacity="0" />
                                <TextBlock x:Name="OffText" Text="{TemplateBinding OffText}" Margin="22,0,8,0" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Velo.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border x:Name="PART_Thumb" Width="16" Height="16" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding ThumbBrush}" Effect="{StaticResource Velo.ShadowSm}">
                                <Grid>
                                    <local:VeloIcon x:Name="IconOn" Icon="{TemplateBinding OnIcon}" Size="11" StrokeWidth="2.6" Foreground="{TemplateBinding Accent}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                                    <local:VeloIcon x:Name="IconOff" Icon="{TemplateBinding OffIcon}" Size="11" StrokeWidth="2.6" Foreground="{DynamicResource Velo.TextMuted}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <StackPanel x:Name="Text" Margin="10,0,0,0" VerticalAlignment="Center">
                            <ContentPresenter x:Name="Label" RecognizesAccessKey="True" />
                            <TextBlock x:Name="Description" Text="{TemplateBinding Description}" FontSize="12.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Velo.TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Size" Value="Sm">
                            <Setter TargetName="PART_Track" Property="Height" Value="16" />
                            <Setter TargetName="PART_Track" Property="MinWidth" Value="28" />
                            <Setter TargetName="PART_Thumb" Property="Width" Value="12" />
                            <Setter TargetName="PART_Thumb" Property="Height" Value="12" />
                            <Setter TargetName="IconOn" Property="Size" Value="8" />
                            <Setter TargetName="IconOff" Property="Size" Value="8" />
                            <Setter TargetName="OnText" Property="Margin" Value="6,0,17,0" />
                            <Setter TargetName="OffText" Property="Margin" Value="17,0,6,0" />
                            <Setter TargetName="OnText" Property="FontSize" Value="8" />
                            <Setter TargetName="OffText" Property="FontSize" Value="8" />
                        </Trigger>
                        <Trigger Property="Size" Value="Lg">
                            <Setter TargetName="PART_Track" Property="Height" Value="26" />
                            <Setter TargetName="PART_Track" Property="MinWidth" Value="46" />
                            <Setter TargetName="PART_Thumb" Property="Width" Value="20" />
                            <Setter TargetName="PART_Thumb" Property="Height" Value="20" />
                            <Setter TargetName="PART_Thumb" Property="Margin" Value="3" />
                            <Setter TargetName="IconOn" Property="Size" Value="13" />
                            <Setter TargetName="IconOff" Property="Size" Value="13" />
                            <Setter TargetName="OnText" Property="Margin" Value="10,0,28,0" />
                            <Setter TargetName="OffText" Property="Margin" Value="28,0,10,0" />
                            <Setter TargetName="OnText" Property="FontSize" Value="11" />
                            <Setter TargetName="OffText" Property="FontSize" Value="11" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TrackOn" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_Thumb" Property="Background" Value="{Binding ThumbOnBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="IconOn" Property="Opacity" Value="1" />
                            <Setter TargetName="IconOff" Property="Opacity" Value="0" />
                            <Setter TargetName="OnText" Property="Opacity" Value="1" />
                            <Setter TargetName="OffText" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="LabelPosition" Value="Start">
                            <Setter TargetName="PART_Track" Property="DockPanel.Dock" Value="Right" />
                            <Setter TargetName="Text" Property="Margin" Value="0,0,12,0" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="{x:Null}" />
                                <Condition Property="Description" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Text" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== CheckBox -->

    <Style TargetType="{x:Type local:VeloCheckBox}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CheckBrush" Value="{Binding OnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Velo.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Background" Value="{DynamicResource Velo.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Velo.BorderStrong}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloCheckBox}">
                    <DockPanel x:Name="Root" Background="Transparent">
                        <Grid DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Border x:Name="Halo" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="Box" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" />
                            <Path x:Name="Check" Data="M4,9 L7.5,12.5 L14,5.5" Stroke="{TemplateBinding CheckBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            <Path x:Name="Dash" Data="M5,9 L13,9" Stroke="{TemplateBinding CheckBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel x:Name="Text" Margin="10,0,0,0" VerticalAlignment="Center">
                            <ContentPresenter x:Name="Label" RecognizesAccessKey="True" />
                            <TextBlock x:Name="Description" Text="{TemplateBinding Description}" FontSize="12.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Velo.TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== RadioButton -->

    <Style TargetType="{x:Type local:VeloRadioButton}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Velo.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Background" Value="{DynamicResource Velo.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Velo.BorderStrong}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloRadioButton}">
                    <DockPanel x:Name="Root" Background="Transparent">
                        <Grid DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Ellipse x:Name="Halo" Margin="-3" Stroke="{TemplateBinding Accent}" StrokeThickness="3" Opacity="0" />
                            <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" />
                        </Grid>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <ContentPresenter x:Name="Label" RecognizesAccessKey="True" />
                            <TextBlock x:Name="Description" Text="{TemplateBinding Description}" FontSize="12.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Velo.TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Stroke" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Circle" Property="Stroke" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Circle" Property="StrokeThickness" Value="5.5" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Slider -->

    <Style x:Key="Velo.SliderFill" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Velo.SliderRest" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Velo.SliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid x:Name="Knob" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Fill="#FFFFFFFF" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" Effect="{StaticResource Velo.ShadowSm}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
<Setter TargetName="Knob" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
<Setter TargetName="Knob" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.18" ScaleY="1.18" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:VeloSlider}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="TrackBrush" Value="{DynamicResource Velo.Surface3}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloSlider}">
                    <Grid MinHeight="24" Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{TemplateBinding TrackBrush}" VerticalAlignment="Center" Margin="2,0" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Velo.SliderFill}" Background="{TemplateBinding Accent}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Velo.SliderRest}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Velo.SliderThumb}" BorderBrush="{TemplateBinding Accent}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Field shell -->

    <Style TargetType="{x:Type local:VeloField}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Velo.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloField}">
                    <StackPanel>
                        <StackPanel x:Name="LabelRow" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Velo.Text}" />
                            <TextBlock x:Name="Star" Text=" *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Velo.Danger}" Visibility="Collapsed" />
                        </StackPanel>
                        <ContentPresenter />
                        <TextBlock x:Name="Message" Text="{TemplateBinding Message}" Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Velo.TextMuted}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="LabelRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsRequired" Value="True">
                            <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Message" Value="{x:Null}">
                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource Velo.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared look of the input box of every field. -->
    <Style x:Key="Velo.FieldBase" TargetType="{x:Type Control}">
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Velo.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Background" Value="{DynamicResource Velo.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Velo.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================================================================== TextField -->

    <Style TargetType="{x:Type local:VeloTextField}" BasedOn="{StaticResource Velo.FieldBase}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Velo.Radius}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Velo.Text}" />
        <Setter Property="SelectionBrush" Value="{Binding Accent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloTextField}">
                    <local:VeloField x:Name="Field" Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}" Error="{TemplateBinding Error}" IsRequired="{TemplateBinding IsRequired}">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="Chrome" MinHeight="{DynamicResource Velo.ControlHeight}" CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Margin="12,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <local:VeloIcon x:Name="Icon" Icon="{TemplateBinding Icon}" Foreground="{DynamicResource Velo.TextSubtle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <ContentPresenter x:Name="Prefix" Grid.Column="1" Content="{TemplateBinding Prefix}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Placeholder" Grid.Column="2" Text="{TemplateBinding Placeholder}" Margin="2,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Velo.TextSubtle}" IsHitTestVisible="False" Visibility="Collapsed" />
                                    <ScrollViewer x:Name="PART_ContentHost" Grid.Column="2" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="0,0,6,0" />
                                    <Button x:Name="PART_Clear" Grid.Column="3" Style="{StaticResource Velo.IconButton}" Visibility="Collapsed">
                                        <local:VeloIcon Icon="x" Size="14" />
                                    </Button>
                                    <ContentPresenter x:Name="Suffix" Grid.Column="4" Content="{TemplateBinding Suffix}" Margin="4,0,6,0" VerticalAlignment="Center"
                                                      TextElement.Foreground="{DynamicResource Velo.TextMuted}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </local:VeloField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Prefix" Value="{x:Null}">
                            <Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Suffix" Value="{x:Null}">
                            <Setter TargetName="Suffix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClearable" Value="True">
                            <Setter TargetName="PART_Clear" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Clear" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="PART_Clear" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Velo.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Velo.Danger}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Velo.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== NumberField -->

    <Style TargetType="{x:Type local:VeloNumberField}" BasedOn="{StaticResource Velo.FieldBase}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Velo.Radius}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloNumberField}">
                    <local:VeloField x:Name="Field" Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}" Error="{TemplateBinding Error}" IsRequired="{TemplateBinding IsRequired}">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="Chrome" MinHeight="{DynamicResource Velo.ControlHeight}" CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RepeatButton x:Name="PART_Down" Style="{StaticResource Velo.IconButton}" Delay="400" Interval="80">
                                        <local:VeloIcon Icon="minus" Size="14" />
                                    </RepeatButton>
                                    <ContentPresenter x:Name="Prefix" Grid.Column="1" Content="{TemplateBinding Prefix}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Placeholder" Grid.Column="2" Text="{TemplateBinding Placeholder}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Velo.TextSubtle}" IsHitTestVisible="False" Visibility="Collapsed" />
                                    <TextBox x:Name="PART_Input" Grid.Column="2" Margin="6,0" Style="{StaticResource Velo.BareTextBox}"
                                             Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" SelectionBrush="{TemplateBinding Accent}" FontWeight="Medium" />
                                    <TextBlock x:Name="Unit" Grid.Column="3" Text="{TemplateBinding Unit}" Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Velo.TextSubtle}" />
                                    <ContentPresenter x:Name="Suffix" Grid.Column="4" Content="{TemplateBinding Suffix}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <RepeatButton x:Name="PART_Up" Grid.Column="5" Style="{StaticResource Velo.IconButton}" Delay="400" Interval="80">
                                        <local:VeloIcon Icon="plus" Size="14" />
                                    </RepeatButton>
                                </Grid>
                            </Border>
                        </Grid>
                    </local:VeloField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowSteppers" Value="False">
                            <Setter TargetName="PART_Down" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Up" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="PART_Down" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Up" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Prefix" Value="{x:Null}">
                            <Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Suffix" Value="{x:Null}">
                            <Setter TargetName="Suffix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Unit" Value="{x:Null}">
                            <Setter TargetName="Unit" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Velo.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Velo.Danger}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Velo.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Select -->

    <Style x:Key="Velo.SelectItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <local:VeloIcon x:Name="Check" DockPanel.Dock="Right" Icon="check" Size="15" Margin="12,0,0,0"
                                            Foreground="{DynamicResource Velo.Primary}" Visibility="Hidden" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Velo.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:VeloSelect}" BasedOn="{StaticResource Velo.FieldBase}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Velo.Radius}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Velo.SelectItem}" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloSelect}">
                    <local:VeloField x:Name="Field" Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}" Error="{TemplateBinding Error}" IsRequired="{TemplateBinding IsRequired}">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="Chrome" MinHeight="{DynamicResource Velo.ControlHeight}" CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid Margin="12,0,10,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Prefix" Content="{TemplateBinding Prefix}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ContentPresenter x:Name="Selection" Grid.Column="1" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Placeholder}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Velo.TextSubtle}" Visibility="Collapsed" />
                                <ContentPresenter x:Name="Suffix" Grid.Column="2" Content="{TemplateBinding Suffix}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <local:VeloIcon x:Name="Chevron" Grid.Column="3" Icon="chevron-down" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Foreground="{DynamicResource Velo.TextSubtle}" RenderTransformOrigin="0.5,0.5">
                                    <local:VeloIcon.RenderTransform>
                                        <RotateTransform />
                                    </local:VeloIcon.RenderTransform>
                                </local:VeloIcon>
                            </Grid>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=Chrome}"
                                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False" VerticalOffset="-4" HorizontalOffset="-8">
                                <Border Margin="8" MinWidth="{Binding ActualWidth, ElementName=Chrome}" Background="{DynamicResource Velo.Surface}"
                                        BorderBrush="{DynamicResource Velo.Border}" BorderThickness="1" CornerRadius="12" Effect="{StaticResource Velo.ShadowLg}">
                                    <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </local:VeloField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Prefix" Value="{x:Null}">
                            <Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Suffix" Value="{x:Null}">
                            <Setter TargetName="Suffix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Velo.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Velo.Danger}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Velo.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== DatePicker and calendar -->

    <Style x:Key="Velo.CalendarDay" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Grid Width="34" Height="32" Margin="1">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent" />
                        <Border x:Name="Today" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Velo.Primary}" Visibility="Collapsed" />
                        <ContentPresenter x:Name="Day" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Velo.Text}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Velo.Surface3}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Today" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter TargetName="Day" Property="TextElement.Foreground" Value="{DynamicResource Velo.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Velo.Primary}" />
                            <Setter TargetName="Day" Property="TextElement.Foreground" Value="{DynamicResource Velo.OnPrimary}" />
                            <Setter TargetName="Today" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="Day" Property="Opacity" Value="0.3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Day" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Velo.CalendarMonth" TargetType="{x:Type CalendarButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Grid Width="56" Height="44" Margin="2">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent" />
                        <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Velo.Text}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Velo.Surface3}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Velo.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Velo.Primary}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Velo.OnPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Velo.CalendarHeader" TargetType="{x:Type Button}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Padding="10,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Velo.Surface3}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Velo.CalendarItem" TargetType="{x:Type CalendarItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarItem}">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Velo.TextSubtle}"
                                       HorizontalAlignment="Center" Margin="0,4,0,6" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <Button x:Name="PART_PreviousButton" DockPanel.Dock="Left" Style="{StaticResource Velo.IconButton}">
                                <local:VeloIcon Icon="chevron-left" />
                            </Button>
                            <Button x:Name="PART_NextButton" DockPanel.Dock="Right" Style="{StaticResource Velo.IconButton}">
                                <local:VeloIcon Icon="chevron-right" />
                            </Button>
                            <Button x:Name="PART_HeaderButton" Style="{StaticResource Velo.CalendarHeader}" />
                        </DockPanel>
                        <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>
                        <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>
                        <Rectangle x:Name="PART_DisabledVisual" Grid.RowSpan="2" Fill="{DynamicResource Velo.Surface}" Opacity="0" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_DisabledVisual" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Velo.Calendar" TargetType="{x:Type Calendar}">
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource Velo.CalendarDay}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource Velo.CalendarMonth}" />
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <Border Margin="8" Padding="10" Background="{DynamicResource Velo.Surface}" BorderBrush="{DynamicResource Velo.Border}"
                            BorderThickness="1" CornerRadius="14" Effect="{StaticResource Velo.ShadowLg}">
                        <CalendarItem x:Name="PART_CalendarItem" Style="{StaticResource Velo.CalendarItem}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Velo.DateTextBox" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Velo.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="WatermarkStates">
                                <VisualState x:Name="Unwatermarked" />
                                <VisualState x:Name="Watermarked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Watermark" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentControl x:Name="PART_Watermark" Opacity="0" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center"
                                        Foreground="{DynamicResource Velo.TextSubtle}" Margin="2,0,0,0" />
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:VeloDatePicker}" BasedOn="{StaticResource Velo.FieldBase}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Velo.Radius}" />
        <Setter Property="CalendarStyle" Value="{StaticResource Velo.Calendar}" />
        <Setter Property="IsTodayHighlighted" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloDatePicker}">
                    <local:VeloField x:Name="Field" Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}" Error="{TemplateBinding Error}" IsRequired="{TemplateBinding IsRequired}">
                        <Grid x:Name="PART_Root">
                            <Border x:Name="Ring" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="Chrome" MinHeight="{DynamicResource Velo.ControlHeight}" CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Margin="12,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="Prefix" Content="{TemplateBinding Prefix}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="1" Style="{StaticResource Velo.DateTextBox}"
                                                       SelectionBrush="{TemplateBinding Accent}" Margin="0,0,6,0" />
                                    <ContentPresenter x:Name="Suffix" Grid.Column="2" Content="{TemplateBinding Suffix}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Button x:Name="PART_Button" Grid.Column="3" Style="{StaticResource Velo.IconButton}">
                                        <local:VeloIcon Icon="calendar" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Chrome}" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-4" HorizontalOffset="-8" />
                        </Grid>
                    </local:VeloField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Prefix" Value="{x:Null}">
                            <Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Suffix" Value="{x:Null}">
                            <Setter TargetName="Suffix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Velo.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Velo.Danger}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Velo.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Badge -->

    <Style TargetType="{x:Type local:VeloBadge}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Foreground" Value="{Binding Accent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloBadge}">
                    <Grid>
                        <Border x:Name="Tint" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0.12" />
                        <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{TemplateBinding Foreground}" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <local:VeloIcon x:Name="Icon" Icon="{TemplateBinding Icon}" Size="12" StrokeWidth="2.4" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowDot" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Solid">
                            <Setter TargetName="Tint" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Outline">
                            <Setter TargetName="Tint" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Variant" Value="Solid">
                <Setter Property="Foreground" Value="{Binding OnAccent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
            <Trigger Property="Variant" Value="Outline">
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== Alert -->

    <Style TargetType="{x:Type local:VeloAlert}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Velo.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Background" Value="{DynamicResource Velo.Surface}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Velo.Radius}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloAlert}">
                    <Grid>
                        <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" />
                        <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0.08" />
                        <Border CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding Accent}" BorderThickness="1" Opacity="0.35" />
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <local:VeloIcon DockPanel.Dock="Left" Icon="{TemplateBinding EffectiveIcon}" Size="18" Foreground="{TemplateBinding Accent}"
                                            Margin="0,1,10,0" VerticalAlignment="Top" />
                            <Button x:Name="PART_Close" DockPanel.Dock="Right" Style="{StaticResource Velo.IconButton}" Margin="8,-3,-4,0"
                                    VerticalAlignment="Top" Visibility="Collapsed">
                                <local:VeloIcon Icon="x" Size="14" />
                            </Button>
                            <StackPanel>
                                <TextBlock x:Name="Title" Text="{TemplateBinding Title}" FontWeight="SemiBold" Margin="0,0,0,2" TextWrapping="Wrap" />
                                <ContentPresenter x:Name="Body" TextElement.Foreground="{DynamicResource Velo.TextMuted}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Body" Property="TextElement.Foreground" Value="{DynamicResource Velo.Text}" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Title" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="True">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Card -->

    <Style TargetType="{x:Type local:VeloCard}">
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Velo.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Background" Value="{DynamicResource Velo.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Velo.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,16,20,20" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloCard}">
                    <Border x:Name="Root" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel x:Name="HeaderRow" Margin="20,18,20,0">
                                <ContentPresenter x:Name="Actions" DockPanel.Dock="Right" Content="{TemplateBinding Actions}" VerticalAlignment="Top" Margin="12,0,0,0" />
                                <ContentPresenter x:Name="CustomHeader" Content="{TemplateBinding Header}" />
                                <StackPanel x:Name="TitleStack" Visibility="Collapsed">
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="Subtitle" Text="{TemplateBinding Subtitle}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Velo.TextMuted}" />
                                </StackPanel>
                            </DockPanel>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                            <Border x:Name="FooterRow" Grid.Row="2" BorderBrush="{DynamicResource Velo.Border}" BorderThickness="0,1,0,0" Padding="16,12">
                                <ContentPresenter Content="{TemplateBinding Footer}" HorizontalAlignment="Right" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="CustomHeader" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitleStack" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Header" Value="{x:Null}" />
                                <Condition Property="Title" Value="{x:Null}" />
                                <Condition Property="Actions" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsElevated" Value="True">
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Velo.ShadowSm}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Progress -->

    <Style TargetType="{x:Type local:VeloProgress}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="TrackBrush" Value="{DynamicResource Velo.Surface3}" />
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloProgress}">
                    <StackPanel>
                        <DockPanel x:Name="Header" Margin="0,0,0,6">
                            <TextBlock x:Name="Percent" DockPanel.Dock="Right" Text="{TemplateBinding PercentText}" Foreground="{DynamicResource Velo.TextMuted}" Visibility="Collapsed" />
                            <TextBlock Text="{TemplateBinding Label}" FontWeight="SemiBold" />
                        </DockPanel>
                        <Grid Height="{TemplateBinding BarHeight}" ClipToBounds="True">
                            <Border x:Name="PART_Track" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding TrackBrush}" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" />
                            <Border x:Name="Runner" Width="90" HorizontalAlignment="Left" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-90" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowValue" Value="True">
                            <Setter TargetName="Percent" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Label" Value="{x:Null}" />
                                <Condition Property="ShowValue" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Percent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Run">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Runner" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-90" To="600" Duration="0:0:1.4" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Run" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== EmptyState -->

    <Style TargetType="{x:Type local:VeloEmptyState}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Velo.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloEmptyState}">
                    <StackPanel Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="48" Height="48" HorizontalAlignment="Center">
                            <Ellipse Fill="{TemplateBinding Accent}" Opacity="0.1" />
                            <local:VeloIcon Icon="{TemplateBinding Icon}" Size="22" Foreground="{TemplateBinding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock x:Name="Title" Text="{TemplateBinding Title}" FontSize="15" FontWeight="SemiBold" Margin="0,14,0,0"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                        <TextBlock x:Name="Description" Text="{TemplateBinding Description}" Margin="0,4,0,0" MaxWidth="360"
                                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource Velo.TextMuted}" />
                        <ContentPresenter x:Name="Actions" Content="{TemplateBinding Actions}" Margin="0,16,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Actions" Value="{x:Null}">
                            <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Stat -->

    <Style TargetType="{x:Type local:VeloStat}">
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloStat}">
                    <StackPanel>
                        <DockPanel>
                            <local:VeloIcon x:Name="Icon" DockPanel.Dock="Right" Icon="{TemplateBinding Icon}" Foreground="{DynamicResource Velo.TextSubtle}" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Label}" FontSize="13" Foreground="{DynamicResource Velo.TextMuted}" />
                        </DockPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="{TemplateBinding Value}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                            <TextBlock x:Name="Unit" Text="{TemplateBinding Unit}" FontSize="15" Margin="5,0,10,4" VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource Velo.TextMuted}" />
                            <Border x:Name="Delta" CornerRadius="999" Padding="7,2" Margin="0,0,0,6" VerticalAlignment="Bottom" Background="{DynamicResource Velo.Surface2}">
                                <TextBlock x:Name="DeltaText" Text="{TemplateBinding DeltaText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Velo.TextMuted}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Unit" Value="{x:Null}">
                            <Setter TargetName="Unit" Property="Margin" Value="0,0,10,4" />
                        </Trigger>
                        <Trigger Property="DeltaState" Value="none">
                            <Setter TargetName="Delta" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="DeltaState" Value="good">
                            <Setter TargetName="DeltaText" Property="Foreground" Value="{DynamicResource Velo.Success}" />
                        </Trigger>
                        <Trigger Property="DeltaState" Value="bad">
                            <Setter TargetName="DeltaText" Property="Foreground" Value="{DynamicResource Velo.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Dialog (shown by VeloHost) -->

    <Style TargetType="{x:Type local:VeloDialog}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloDialog}">
                    <Border />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Host: dialogs, confirmations, toasts -->

    <Style TargetType="{x:Type local:VeloHost}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Velo.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Velo.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Velo.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:VeloHost}">
                    <Grid>
                        <ContentPresenter />

                        <ItemsControl ItemsSource="{Binding Overlays, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type local:VeloDialogSlot}">
                                    <Grid KeyboardNavigation.TabNavigation="Cycle">
                                        <Border Background="{DynamicResource Velo.Overlay}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding Dialog.BackdropCommand}" />
                                            </Border.InputBindings>
                                        </Border>
                                        <Border Width="{Binding Dialog.DialogWidth}" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{DynamicResource Velo.Surface}" BorderBrush="{DynamicResource Velo.Border}" BorderThickness="1"
                                                CornerRadius="{Binding Dialog.CornerRadius}" Effect="{StaticResource Velo.ShadowLg}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <DockPanel Margin="24,22,18,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Velo.IconButton}" VerticalAlignment="Top"
                                                            Command="{Binding Dialog.CloseCommand}" Focusable="True"
                                                            Visibility="{Binding Dialog.ShowClose, Converter={StaticResource Velo.BoolToVisibility}}">
                                                        <local:VeloIcon Icon="x" />
                                                    </Button>
                                                    <StackPanel>
                                                        <TextBlock x:Name="Title" Text="{Binding Dialog.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="Description" Text="{Binding Dialog.Description}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource Velo.TextMuted}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <ContentPresenter Grid.Row="1" Margin="24,16,24,20" Content="{Binding Dialog.Content}" />
                                                <ContentPresenter x:Name="Footer" Grid.Row="2" Margin="24,0,24,20" HorizontalAlignment="Right" Content="{Binding Dialog.Footer}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Dialog.Title}" Value="{x:Null}">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dialog.Description}" Value="{x:Null}">
                                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dialog.Footer}" Value="{x:Null}">
                                            <Setter TargetName="Footer" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type local:VeloConfirmRequest}">
                                    <Grid KeyboardNavigation.TabNavigation="Cycle">
                                        <Border Background="{DynamicResource Velo.Overlay}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding CancelCommand}" />
                                            </Border.InputBindings>
                                        </Border>
                                        <Border Width="420" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,22,24,20"
                                                Background="{DynamicResource Velo.Surface}" BorderBrush="{DynamicResource Velo.Border}" BorderThickness="1"
                                                CornerRadius="16" Effect="{StaticResource Velo.ShadowLg}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="Message" Text="{Binding Message}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Velo.TextMuted}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                                                    <local:VeloButton Variant="Ghost" Tone="Neutral" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" />
                                                    <local:VeloButton x:Name="ConfirmButton" Margin="8,0,0,0" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                            <Setter TargetName="ConfirmButton" Property="Tone" Value="Danger" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Toasts, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Width="360" Margin="20"
                                      HorizontalAlignment="{TemplateBinding ToastHorizontalAlignment}" VerticalAlignment="{TemplateBinding ToastVerticalAlignment}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:VeloToast}">
                                    <Border Margin="0,8,0,0" Padding="14,12,8,12" Background="{DynamicResource Velo.Surface}" BorderBrush="{DynamicResource Velo.Border}"
                                            BorderThickness="1" CornerRadius="12" Effect="{StaticResource Velo.ShadowLg}">
                                        <DockPanel>
                                            <local:VeloIcon x:Name="Icon" DockPanel.Dock="Left" Icon="{Binding Icon}" Size="18" Margin="0,1,10,0"
                                                            VerticalAlignment="Top" Foreground="{DynamicResource Velo.Info}" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Velo.IconButton}" VerticalAlignment="Top" Margin="8,-3,0,0"
                                                    Command="{Binding CloseCommand}" ToolTip="{Binding CloseText}">
                                                <local:VeloIcon Icon="x" Size="14" />
                                            </Button>
                                            <StackPanel>
                                                <TextBlock x:Name="Title" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,2" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Velo.Text}" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource Velo.TextMuted}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Success">
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Velo.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Velo.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Danger">
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Velo.Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
