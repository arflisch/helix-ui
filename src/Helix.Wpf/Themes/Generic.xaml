<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Helix.Wpf">

    <!--
        Helix UI for WPF: default look of every control.
        Colors come from DynamicResource Helix.* (see HelixResources), so the theme switches live.
        Every visual part is a property on the control: you never need to copy these templates.
    -->

    <BooleanToVisibilityConverter x:Key="Helix.BoolToVisibility" />

    <DropShadowEffect x:Key="Helix.ShadowSm" BlurRadius="10" ShadowDepth="1" Direction="270" Opacity="0.10" Color="#000000" />
    <DropShadowEffect x:Key="Helix.ShadowLg" BlurRadius="32" ShadowDepth="8" Direction="270" Opacity="0.16" Color="#000000" />

    <!-- Keyboard focus: a soft ring in the primary color. -->
    <Style x:Key="Helix.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Helix.Primary}" Opacity="0.45" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Small square icon button (clear, close, steppers, calendar). -->
    <Style x:Key="Helix.IconButton" TargetType="{x:Type ButtonBase}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ButtonBase}">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface3}" />
                            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Borderless text box used inside Helix fields. -->
    <Style x:Key="Helix.BareTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Helix.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Helix.Primary}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Spinner -->

    <Style TargetType="{x:Type local:HelixSpinner}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixSpinner}">
                    <Viewbox Width="{TemplateBinding Size}" Height="{TemplateBinding Size}">
                        <Viewbox.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.8" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Viewbox.Triggers>
                        <Grid x:Name="Ring" Width="24" Height="24" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform />
                            </Grid.RenderTransform>
                            <Ellipse Margin="3" Stroke="{TemplateBinding Accent}" StrokeThickness="{TemplateBinding Thickness}" Opacity="0.2" />
                            <Path Data="M12,3 A9,9 0 0 1 21,12" Stroke="{TemplateBinding Accent}" StrokeThickness="{TemplateBinding Thickness}"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                        </Grid>
                    </Viewbox>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Button -->

    <Style TargetType="{x:Type local:HelixButton}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="{DynamicResource Helix.ControlHeight}" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{Binding Accent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Helix.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixButton}">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Border x:Name="Chrome" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Tint" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="Shade" CornerRadius="{TemplateBinding CornerRadius}" Background="Black" Opacity="0" IsHitTestVisible="False" />
                        <Grid Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                            <StackPanel x:Name="Body" Orientation="Horizontal">
                                <local:HelixIcon x:Name="IconStart" Icon="{TemplateBinding Icon}" Size="16" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center" RecognizesAccessKey="True" />
                                <local:HelixIcon x:Name="IconEnd" Icon="{TemplateBinding IconEnd}" Size="16" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                            <local:HelixSpinner x:Name="Spinner" Size="16" Thickness="2.5" Accent="{TemplateBinding Foreground}" Visibility="Collapsed"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="IconStart" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IconEnd" Value="{x:Null}">
                            <Setter TargetName="IconEnd" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="IconStart" Property="Margin" Value="0" />
                            <Setter TargetName="IconEnd" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Soft">
                            <Setter TargetName="Tint" Property="Opacity" Value="0.11" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Variant" Value="Solid" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Shade" Property="Opacity" Value="0.1" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Variant" Value="Soft" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tint" Property="Opacity" Value="0.18" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Variant" Value="Outline" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tint" Property="Opacity" Value="0.06" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="Variant" Value="Ghost" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Tint" Property="Opacity" Value="0.09" />
                        </MultiTrigger>
                        <Trigger Property="IsPressed" Value="True">
<Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.985" ScaleY="0.985" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsLoading" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="0" />
                            <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                            <Setter Property="Cursor" Value="Wait" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Variant" Value="Solid">
                <Setter Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource Self}}" />
                <Setter Property="Foreground" Value="{Binding OnAccent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
            <Trigger Property="Variant" Value="Outline">
                <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
            </Trigger>
            <Trigger Property="Size" Value="Sm">
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="FontSize" Value="13" />
            </Trigger>
            <Trigger Property="Size" Value="Lg">
                <Setter Property="Height" Value="44" />
                <Setter Property="Padding" Value="20,0" />
                <Setter Property="FontSize" Value="15" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== Switch -->

    <Style TargetType="{x:Type local:HelixSwitch}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="TrackBrush" Value="{DynamicResource Helix.Surface3}" />
        <Setter Property="ThumbBrush" Value="#FFFFFFFF" />
        <Setter Property="ThumbOnBrush" Value="{Binding ThumbBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixSwitch}">
                    <DockPanel x:Name="Root" Background="{TemplateBinding Background}" LastChildFill="True">
                        <Grid x:Name="PART_Track" DockPanel.Dock="Left" Height="20" MinWidth="36" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Border x:Name="Halo" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3"
                                    BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="TrackOff" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding TrackBrush}" />
                            <Border x:Name="TrackOn" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0" />
                            <Grid x:Name="Texts" MinWidth="{TemplateBinding TrackMinWidth}" VerticalAlignment="Center">
                                <TextBlock x:Name="OnText" Text="{TemplateBinding OnText}" Margin="8,0,22,0" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{TemplateBinding OnAccent}" VerticalAlignment="Center" Opacity="0" />
                                <TextBlock x:Name="OffText" Text="{TemplateBinding OffText}" Margin="22,0,8,0" FontSize="9.5" FontWeight="Bold"
                                           Foreground="{DynamicResource Helix.TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <Border x:Name="PART_Thumb" Width="16" Height="16" Margin="2" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding ThumbBrush}" Effect="{StaticResource Helix.ShadowSm}">
                                <Grid>
                                    <local:HelixIcon x:Name="IconOn" Icon="{TemplateBinding OnIcon}" Size="11" StrokeWidth="2.6" Foreground="{TemplateBinding Accent}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                                    <local:HelixIcon x:Name="IconOff" Icon="{TemplateBinding OffIcon}" Size="11" StrokeWidth="2.6" Foreground="{DynamicResource Helix.TextMuted}"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        <StackPanel x:Name="Text" Margin="10,0,0,0" VerticalAlignment="Center">
                            <ContentPresenter x:Name="Label" RecognizesAccessKey="True" />
                            <TextBlock x:Name="Description" Text="{TemplateBinding Description}" FontSize="12.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Size" Value="Sm">
                            <Setter TargetName="PART_Track" Property="Height" Value="16" />
                            <Setter TargetName="PART_Track" Property="MinWidth" Value="28" />
                            <Setter TargetName="PART_Thumb" Property="Width" Value="12" />
                            <Setter TargetName="PART_Thumb" Property="Height" Value="12" />
                            <Setter TargetName="IconOn" Property="Size" Value="8" />
                            <Setter TargetName="IconOff" Property="Size" Value="8" />
                            <Setter TargetName="OnText" Property="Margin" Value="6,0,17,0" />
                            <Setter TargetName="OffText" Property="Margin" Value="17,0,6,0" />
                            <Setter TargetName="OnText" Property="FontSize" Value="8" />
                            <Setter TargetName="OffText" Property="FontSize" Value="8" />
                        </Trigger>
                        <Trigger Property="Size" Value="Lg">
                            <Setter TargetName="PART_Track" Property="Height" Value="26" />
                            <Setter TargetName="PART_Track" Property="MinWidth" Value="46" />
                            <Setter TargetName="PART_Thumb" Property="Width" Value="20" />
                            <Setter TargetName="PART_Thumb" Property="Height" Value="20" />
                            <Setter TargetName="PART_Thumb" Property="Margin" Value="3" />
                            <Setter TargetName="IconOn" Property="Size" Value="13" />
                            <Setter TargetName="IconOff" Property="Size" Value="13" />
                            <Setter TargetName="OnText" Property="Margin" Value="10,0,28,0" />
                            <Setter TargetName="OffText" Property="Margin" Value="28,0,10,0" />
                            <Setter TargetName="OnText" Property="FontSize" Value="11" />
                            <Setter TargetName="OffText" Property="FontSize" Value="11" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TrackOn" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_Thumb" Property="Background" Value="{Binding ThumbOnBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="IconOn" Property="Opacity" Value="1" />
                            <Setter TargetName="IconOff" Property="Opacity" Value="0" />
                            <Setter TargetName="OnText" Property="Opacity" Value="1" />
                            <Setter TargetName="OffText" Property="Opacity" Value="0" />
                        </Trigger>
                        <Trigger Property="LabelPosition" Value="Start">
                            <Setter TargetName="PART_Track" Property="DockPanel.Dock" Value="Right" />
                            <Setter TargetName="Text" Property="Margin" Value="0,0,12,0" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Content" Value="{x:Null}" />
                                <Condition Property="Description" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Text" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== CheckBox -->

    <Style TargetType="{x:Type local:HelixCheckBox}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CheckBrush" Value="{Binding OnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixCheckBox}">
                    <DockPanel x:Name="Root" Background="Transparent">
                        <Grid DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Border x:Name="Halo" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="Box" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1.5" />
                            <Path x:Name="Check" Data="M4,9 L7.5,12.5 L14,5.5" Stroke="{TemplateBinding CheckBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            <Path x:Name="Dash" Data="M5,9 L13,9" Stroke="{TemplateBinding CheckBrush}" StrokeThickness="2.2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed" />
                        </Grid>
                        <StackPanel x:Name="Text" Margin="10,0,0,0" VerticalAlignment="Center">
                            <ContentPresenter x:Name="Label" RecognizesAccessKey="True" />
                            <TextBlock x:Name="Description" Text="{TemplateBinding Description}" FontSize="12.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== RadioButton -->

    <Style TargetType="{x:Type local:HelixRadioButton}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixRadioButton}">
                    <DockPanel x:Name="Root" Background="Transparent">
                        <Grid DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Ellipse x:Name="Halo" Margin="-3" Stroke="{TemplateBinding Accent}" StrokeThickness="3" Opacity="0" />
                            <Ellipse x:Name="Circle" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="1.5" />
                        </Grid>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <ContentPresenter x:Name="Label" RecognizesAccessKey="True" />
                            <TextBlock x:Name="Description" Text="{TemplateBinding Description}" FontSize="12.5" Margin="0,2,0,0"
                                       Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Circle" Property="Stroke" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Circle" Property="Stroke" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Circle" Property="StrokeThickness" Value="5.5" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Slider -->

    <Style x:Key="Helix.SliderFill" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Height="6" CornerRadius="3" Background="{TemplateBinding Background}" VerticalAlignment="Center" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Helix.SliderRest" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Helix.SliderThumb" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Grid x:Name="Knob" RenderTransformOrigin="0.5,0.5">
                        <Ellipse Fill="#FFFFFFFF" Stroke="{TemplateBinding BorderBrush}" StrokeThickness="2" Effect="{StaticResource Helix.ShadowSm}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
<Setter TargetName="Knob" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.12" ScaleY="1.12" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
<Setter TargetName="Knob" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="1.18" ScaleY="1.18" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixSlider}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="TrackBrush" Value="{DynamicResource Helix.Surface3}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixSlider}">
                    <Grid MinHeight="24" Background="Transparent">
                        <Border Height="6" CornerRadius="3" Background="{TemplateBinding TrackBrush}" VerticalAlignment="Center" Margin="2,0" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Helix.SliderFill}" Background="{TemplateBinding Accent}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Helix.SliderRest}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Helix.SliderThumb}" BorderBrush="{TemplateBinding Accent}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Field shell -->

    <Style TargetType="{x:Type local:HelixField}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixField}">
                    <StackPanel>
                        <StackPanel x:Name="LabelRow" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" />
                            <TextBlock x:Name="Star" Text=" *" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Danger}" Visibility="Collapsed" />
                        </StackPanel>
                        <ContentPresenter />
                        <TextBlock x:Name="Message" Text="{TemplateBinding Message}" Margin="0,6,0,0" FontSize="12.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Helix.TextMuted}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Label" Value="{x:Null}">
                            <Setter TargetName="LabelRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsRequired" Value="True">
                            <Setter TargetName="Star" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Message" Value="{x:Null}">
                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Message" Property="Foreground" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared look of the input box of every field. -->
    <Style x:Key="Helix.FieldBase" TargetType="{x:Type Control}">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!-- ===================================================================== TextField -->

    <Style TargetType="{x:Type local:HelixTextField}" BasedOn="{StaticResource Helix.FieldBase}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Helix.Text}" />
        <Setter Property="SelectionBrush" Value="{Binding Accent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixTextField}">
                    <local:HelixField x:Name="Field" Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}" Error="{TemplateBinding Error}" IsRequired="{TemplateBinding IsRequired}">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="Chrome" MinHeight="{DynamicResource Helix.ControlHeight}" CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Margin="12,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <local:HelixIcon x:Name="Icon" Icon="{TemplateBinding Icon}" Foreground="{DynamicResource Helix.TextSubtle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <ContentPresenter x:Name="Prefix" Grid.Column="1" Content="{TemplateBinding Prefix}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Placeholder" Grid.Column="2" Text="{TemplateBinding Placeholder}" Margin="2,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Helix.TextSubtle}" IsHitTestVisible="False" Visibility="Collapsed" />
                                    <ScrollViewer x:Name="PART_ContentHost" Grid.Column="2" Focusable="False" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" Margin="0,0,6,0" />
                                    <Button x:Name="PART_Clear" Grid.Column="3" Style="{StaticResource Helix.IconButton}" Visibility="Collapsed">
                                        <local:HelixIcon Icon="x" Size="14" />
                                    </Button>
                                    <ContentPresenter x:Name="Suffix" Grid.Column="4" Content="{TemplateBinding Suffix}" Margin="4,0,6,0" VerticalAlignment="Center"
                                                      TextElement.Foreground="{DynamicResource Helix.TextMuted}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </local:HelixField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Prefix" Value="{x:Null}">
                            <Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Suffix" Value="{x:Null}">
                            <Setter TargetName="Suffix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsClearable" Value="True">
                            <Setter TargetName="PART_Clear" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Clear" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="PART_Clear" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== NumberField -->

    <Style TargetType="{x:Type local:HelixNumberField}" BasedOn="{StaticResource Helix.FieldBase}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixNumberField}">
                    <local:HelixField x:Name="Field" Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}" Error="{TemplateBinding Error}" IsRequired="{TemplateBinding IsRequired}">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="Chrome" MinHeight="{DynamicResource Helix.ControlHeight}" CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <RepeatButton x:Name="PART_Down" Style="{StaticResource Helix.IconButton}" Delay="400" Interval="80">
                                        <local:HelixIcon Icon="minus" Size="14" />
                                    </RepeatButton>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <local:HelixIcon x:Name="SignArrow" Icon="arrow-up" Size="14" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                        <ContentPresenter x:Name="Prefix" Content="{TemplateBinding Prefix}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock x:Name="Placeholder" Grid.Column="2" Text="{TemplateBinding Placeholder}" Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Helix.TextSubtle}" IsHitTestVisible="False" Visibility="Collapsed" />
                                    <TextBox x:Name="PART_Input" Grid.Column="2" Margin="6,0" Style="{StaticResource Helix.BareTextBox}"
                                             Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsReadOnly="{TemplateBinding IsReadOnly}" SelectionBrush="{TemplateBinding Accent}" FontWeight="Medium" />
                                    <TextBlock x:Name="Unit" Grid.Column="3" Text="{TemplateBinding Unit}" Margin="0,0,6,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Helix.TextSubtle}" />
                                    <ContentPresenter x:Name="Suffix" Grid.Column="4" Content="{TemplateBinding Suffix}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <RepeatButton x:Name="PART_Up" Grid.Column="5" Style="{StaticResource Helix.IconButton}" Delay="400" Interval="80">
                                        <local:HelixIcon Icon="plus" Size="14" />
                                    </RepeatButton>
                                </Grid>
                            </Border>
                        </Grid>
                    </local:HelixField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SignDirection" Value="1">
                            <Setter TargetName="SignArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SignDirection" Value="-1">
                            <Setter TargetName="SignArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SignArrow" Property="Icon" Value="arrow-down" />
                        </Trigger>
                        <Trigger Property="SignState" Value="good">
                            <Setter TargetName="SignArrow" Property="Foreground" Value="{DynamicResource Helix.Success}" />
                            <Setter TargetName="PART_Input" Property="Foreground" Value="{DynamicResource Helix.Success}" />
                        </Trigger>
                        <Trigger Property="SignState" Value="bad">
                            <Setter TargetName="SignArrow" Property="Foreground" Value="{DynamicResource Helix.Danger}" />
                            <Setter TargetName="PART_Input" Property="Foreground" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                        <Trigger Property="ShowSteppers" Value="False">
                            <Setter TargetName="PART_Down" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Up" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="PART_Down" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Up" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Prefix" Value="{x:Null}">
                            <Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Suffix" Value="{x:Null}">
                            <Setter TargetName="Suffix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Unit" Value="{x:Null}">
                            <Setter TargetName="Unit" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Select -->

    <Style x:Key="Helix.SelectItem" TargetType="{x:Type ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                            <local:HelixIcon x:Name="Check" DockPanel.Dock="Right" Icon="check" Size="15" Margin="12,0,0,0"
                                            Foreground="{DynamicResource Helix.Primary}" Visibility="Hidden" VerticalAlignment="Center" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixSelect}" BasedOn="{StaticResource Helix.FieldBase}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Helix.SelectItem}" />
        <Setter Property="MaxDropDownHeight" Value="320" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixSelect}">
                    <local:HelixField x:Name="Field" Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}" Error="{TemplateBinding Error}" IsRequired="{TemplateBinding IsRequired}">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="Chrome" MinHeight="{DynamicResource Helix.ControlHeight}" CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="Transparent" />
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Grid Margin="12,0,10,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter x:Name="Prefix" Content="{TemplateBinding Prefix}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <ContentPresenter x:Name="Selection" Grid.Column="1" VerticalAlignment="Center"
                                                  Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}" />
                                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="{TemplateBinding Placeholder}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Helix.TextSubtle}" Visibility="Collapsed" />
                                <ContentPresenter x:Name="Suffix" Grid.Column="2" Content="{TemplateBinding Suffix}" Margin="8,0,0,0" VerticalAlignment="Center" />
                                <local:HelixIcon x:Name="Chevron" Grid.Column="3" Icon="chevron-down" Margin="8,0,0,0" VerticalAlignment="Center"
                                                Foreground="{DynamicResource Helix.TextSubtle}" RenderTransformOrigin="0.5,0.5">
                                    <local:HelixIcon.RenderTransform>
                                        <RotateTransform />
                                    </local:HelixIcon.RenderTransform>
                                </local:HelixIcon>
                            </Grid>
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" PlacementTarget="{Binding ElementName=Chrome}"
                                   AllowsTransparency="True" PopupAnimation="Fade" Focusable="False" VerticalOffset="-4" HorizontalOffset="-8">
                                <Border Margin="8" MinWidth="{Binding ActualWidth, ElementName=Chrome}" Background="{DynamicResource Helix.Surface}"
                                        BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="12" Effect="{StaticResource Helix.ShadowLg}">
                                    <DockPanel>
                                        <Border x:Name="SearchRow" DockPanel.Dock="Top" Padding="12,8" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                                            <DockPanel>
                                                <local:HelixIcon Icon="search" Size="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Helix.TextSubtle}" />
                                                <Grid>
                                                    <TextBlock x:Name="SearchHint" Text="{x:Static local:HelixSelect.SearchPlaceholderText}" Foreground="{DynamicResource Helix.TextSubtle}"
                                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    <TextBox x:Name="PART_Search" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Helix.Text}" CaretBrush="{DynamicResource Helix.Text}" FocusVisualStyle="{x:Null}"
                                                             Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                        <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}" Margin="0,4" VerticalScrollBarVisibility="Auto">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </local:HelixField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSearchable" Value="True">
                            <Setter TargetName="SearchRow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Text.Length, ElementName=PART_Search}" Value="0">
                            <Setter TargetName="SearchHint" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=PART_Search}" Value="True">
                            <Setter TargetName="SearchHint" Property="Opacity" Value="0" />
                        </DataTrigger>
                        <Trigger Property="SelectedItem" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Prefix" Value="{x:Null}">
                            <Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Suffix" Value="{x:Null}">
                            <Setter TargetName="Suffix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== DatePicker and calendar -->

    <Style x:Key="Helix.CalendarDay" TargetType="{x:Type CalendarDayButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Grid Width="34" Height="32" Margin="1">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent" />
                        <Border x:Name="Today" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource Helix.Primary}" Visibility="Collapsed" />
                        <ContentPresenter x:Name="Day" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Helix.Text}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface3}" />
                        </Trigger>
                        <Trigger Property="IsToday" Value="True">
                            <Setter TargetName="Today" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter TargetName="Day" Property="TextElement.Foreground" Value="{DynamicResource Helix.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Primary}" />
                            <Setter TargetName="Day" Property="TextElement.Foreground" Value="{DynamicResource Helix.OnPrimary}" />
                            <Setter TargetName="Today" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsBlackedOut" Value="True">
                            <Setter TargetName="Day" Property="Opacity" Value="0.3" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Day" Property="Opacity" Value="0.3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Helix.CalendarMonth" TargetType="{x:Type CalendarButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Grid Width="56" Height="44" Margin="2">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent" />
                        <ContentPresenter x:Name="Label" HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{DynamicResource Helix.Text}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface3}" />
                        </Trigger>
                        <Trigger Property="IsInactive" Value="True">
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Helix.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="HasSelectedDays" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Primary}" />
                            <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource Helix.OnPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Helix.CalendarHeader" TargetType="{x:Type Button}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="7" Padding="10,4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface3}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Helix.CalendarItem" TargetType="{x:Type CalendarItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarItem}">
                    <ControlTemplate.Resources>
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Text="{Binding}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Helix.TextSubtle}"
                                       HorizontalAlignment="Center" Margin="0,4,0,6" />
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,6">
                            <Button x:Name="PART_PreviousButton" DockPanel.Dock="Left" Style="{StaticResource Helix.IconButton}">
                                <local:HelixIcon Icon="chevron-left" />
                            </Button>
                            <Button x:Name="PART_NextButton" DockPanel.Dock="Right" Style="{StaticResource Helix.IconButton}">
                                <local:HelixIcon Icon="chevron-right" />
                            </Button>
                            <Button x:Name="PART_HeaderButton" Style="{StaticResource Helix.CalendarHeader}" />
                        </DockPanel>
                        <Grid x:Name="PART_MonthView" Grid.Row="1" Visibility="Visible">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>
                        <Grid x:Name="PART_YearView" Grid.Row="1" Visibility="Hidden">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                        </Grid>
                        <Rectangle x:Name="PART_DisabledVisual" Grid.RowSpan="2" Fill="{DynamicResource Helix.Surface}" Opacity="0" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter TargetName="PART_MonthView" Property="Visibility" Value="Hidden" />
                            <Setter TargetName="PART_YearView" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_DisabledVisual" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_DisabledVisual" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Helix.Calendar" TargetType="{x:Type Calendar}">
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource Helix.CalendarDay}" />
        <Setter Property="CalendarButtonStyle" Value="{StaticResource Helix.CalendarMonth}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <Border Margin="8" Padding="10" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                            BorderThickness="1" CornerRadius="14" Effect="{StaticResource Helix.ShadowLg}">
                        <CalendarItem x:Name="PART_CalendarItem" Style="{StaticResource Helix.CalendarItem}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Helix.DateTextBox" TargetType="{x:Type DatePickerTextBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Helix.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DatePickerTextBox}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="WatermarkStates">
                                <VisualState x:Name="Unwatermarked" />
                                <VisualState x:Name="Watermarked">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="PART_Watermark" Storyboard.TargetProperty="Opacity" To="1" Duration="0" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentControl x:Name="PART_Watermark" Opacity="0" Focusable="False" IsHitTestVisible="False" VerticalAlignment="Center"
                                        Foreground="{DynamicResource Helix.TextSubtle}" Margin="2,0,0,0" />
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixDatePicker}" BasedOn="{StaticResource Helix.FieldBase}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="CalendarStyle" Value="{StaticResource Helix.Calendar}" />
        <Setter Property="IsTodayHighlighted" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixDatePicker}">
                    <local:HelixField x:Name="Field" Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}" Error="{TemplateBinding Error}" IsRequired="{TemplateBinding IsRequired}">
                        <Grid x:Name="PART_Root">
                            <Border x:Name="Ring" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="Chrome" MinHeight="{DynamicResource Helix.ControlHeight}" CornerRadius="{TemplateBinding CornerRadius}"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <Grid Margin="12,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter x:Name="Prefix" Content="{TemplateBinding Prefix}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <DatePickerTextBox x:Name="PART_TextBox" Grid.Column="1" Style="{StaticResource Helix.DateTextBox}"
                                                       SelectionBrush="{TemplateBinding Accent}" Margin="0,0,6,0" />
                                    <ContentPresenter x:Name="Suffix" Grid.Column="2" Content="{TemplateBinding Suffix}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <Button x:Name="PART_Button" Grid.Column="3" Style="{StaticResource Helix.IconButton}">
                                        <local:HelixIcon Icon="calendar" />
                                    </Button>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=Chrome}" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Fade" VerticalOffset="-4" HorizontalOffset="-8" />
                        </Grid>
                    </local:HelixField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Prefix" Value="{x:Null}">
                            <Setter TargetName="Prefix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Suffix" Value="{x:Null}">
                            <Setter TargetName="Suffix" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== MultiSelect -->

    <Style TargetType="{x:Type local:HelixMultiSelect}" BasedOn="{StaticResource Helix.FieldBase}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixMultiSelect}">
                    <local:HelixField x:Name="Field" Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}" Error="{TemplateBinding Error}" IsRequired="{TemplateBinding IsRequired}">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="PART_Chrome" MinHeight="{DynamicResource Helix.ControlHeight}" CornerRadius="{TemplateBinding CornerRadius}" Cursor="Hand"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <DockPanel Margin="8,4,10,4">
                                    <local:HelixIcon x:Name="Chevron" DockPanel.Dock="Right" Icon="chevron-down" Size="15" VerticalAlignment="Center" Foreground="{DynamicResource Helix.TextSubtle}" />
                                    <WrapPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Placeholder}" Margin="4,0" VerticalAlignment="Center" Foreground="{DynamicResource Helix.TextSubtle}" />
                                        <ItemsControl ItemsSource="{TemplateBinding Chips}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Margin="2" Padding="8,2,3,2" CornerRadius="7" Background="{DynamicResource Helix.PrimarySoft}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Text}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" MaxWidth="160" TextTrimming="CharacterEllipsis"
                                                                       Foreground="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixMultiSelect}}}" />
                                                            <Button Style="{StaticResource Helix.IconButton}" Width="18" Height="18" Margin="2,0,0,0"
                                                                    Command="{Binding RemoveCommand, RelativeSource={RelativeSource AncestorType={x:Type local:HelixMultiSelect}}}"
                                                                    CommandParameter="{Binding Item}">
                                                                <local:HelixIcon Icon="x" Size="11" />
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="{TemplateBinding MoreText}" Margin="6,0" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Helix.TextMuted}" />
                                    </WrapPanel>
                                </DockPanel>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Chrome}" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" VerticalOffset="-4" HorizontalOffset="-8"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Border Margin="8" MinWidth="{Binding ActualWidth, ElementName=PART_Chrome}" Background="{DynamicResource Helix.Surface}"
                                        BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="12" Effect="{StaticResource Helix.ShadowLg}">
                                    <DockPanel>
                                        <Border x:Name="SearchRow" DockPanel.Dock="Top" Padding="12,8" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,0,1" Visibility="Collapsed">
                                            <DockPanel>
                                                <local:HelixIcon Icon="search" Size="14" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Helix.TextSubtle}" />
                                                <Grid>
                                                    <TextBlock x:Name="SearchHint" Text="{x:Static local:HelixMultiSelect.SearchPlaceholderText}" Foreground="{DynamicResource Helix.TextSubtle}"
                                                               VerticalAlignment="Center" IsHitTestVisible="False" />
                                                    <TextBox x:Name="PART_Search" Background="Transparent" BorderThickness="0" Padding="0" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Helix.Text}" CaretBrush="{DynamicResource Helix.Text}" FocusVisualStyle="{x:Null}"
                                                             Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </Grid>
                                            </DockPanel>
                                        </Border>
                                        <Border x:Name="Actions" DockPanel.Dock="Bottom" Padding="6" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,1,0,0">
                                            <DockPanel>
                                                <local:HelixButton x:Name="PART_ClearAll" DockPanel.Dock="Right" Content="{x:Static local:HelixMultiSelect.ClearText}" Variant="Ghost" Size="Sm" />
                                                <local:HelixButton x:Name="PART_SelectAll" Content="{x:Static local:HelixMultiSelect.SelectAllText}" Variant="Ghost" Size="Sm" HorizontalAlignment="Left" />
                                            </DockPanel>
                                        </Border>
                                        <ListBox x:Name="PART_List" SelectionMode="Multiple" MaxHeight="280" Margin="0,4" BorderThickness="0" Background="Transparent"
                                                 DisplayMemberPath="{TemplateBinding DisplayMemberPath}" ItemTemplate="{TemplateBinding ItemTemplate}"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="{x:Type ListBoxItem}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                                                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                    <Setter Property="Cursor" Value="Hand" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                <Border x:Name="Bg" Margin="4,1" Padding="10,7" CornerRadius="7" Background="Transparent">
                                                                    <DockPanel>
                                                                        <Border x:Name="Box" DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,10,0" CornerRadius="5" BorderThickness="1.5"
                                                                                BorderBrush="{DynamicResource Helix.BorderStrong}" Background="Transparent" VerticalAlignment="Center">
                                                                            <local:HelixIcon x:Name="Tick" Icon="check" Size="11" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                                            Foreground="{Binding OnAccent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixMultiSelect}}}" />
                                                                        </Border>
                                                                        <ContentPresenter VerticalAlignment="Center" />
                                                                    </DockPanel>
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                                        <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                                                    </Trigger>
                                                                    <Trigger Property="IsSelected" Value="True">
                                                                        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                                                        <Setter TargetName="Box" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixMultiSelect}}}" />
                                                                        <Setter TargetName="Box" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixMultiSelect}}}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                        </ListBox>
                                    </DockPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </local:HelixField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasSelection" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsSearchable" Value="True">
                            <Setter TargetName="SearchRow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsKeyboardFocused, ElementName=PART_Search}" Value="True">
                            <Setter TargetName="SearchHint" Property="Opacity" Value="0" />
                        </DataTrigger>
                        <Trigger Property="SearchText" Value="">
                            <Setter TargetName="SearchHint" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowActions" Value="False">
                            <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Chrome" Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="PART_Chrome" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Filter bar -->

    <Style TargetType="{x:Type local:HelixFilterBar}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixFilterBar}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,2,0,0">
                            <local:HelixButton x:Name="PART_Clear" Content="{x:Static local:HelixFilterBar.ClearText}" Icon="x" Variant="Ghost" Tone="Neutral" Size="Sm"
                                              Margin="0,0,6,0" Visibility="Collapsed" />
                            <local:HelixButton x:Name="PART_Saved" Content="{TemplateBinding SavedText}" Icon="star" IconEnd="chevron-down" Variant="Outline" Tone="Neutral" Size="Sm" />
                            <Popup x:Name="PART_SavePopup" PlacementTarget="{Binding ElementName=PART_Saved}" Placement="Bottom" StaysOpen="False"
                                   AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-180" VerticalOffset="4">
                                <Border Margin="8" Padding="14" Width="280" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                                        BorderThickness="1" CornerRadius="14" Effect="{StaticResource Helix.ShadowLg}">
                                    <StackPanel>
                                        <TextBlock Text="{x:Static local:HelixFilterBar.NameText}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" Foreground="{DynamicResource Helix.Text}" />
                                        <TextBox x:Name="PART_SaveName" MinHeight="34" Padding="10,6" VerticalContentAlignment="Center" />
                                        <local:HelixButton x:Name="PART_SaveConfirm" Content="{x:Static local:HelixFilterBar.SaveText}" Icon="check" Size="Sm"
                                                          HorizontalAlignment="Right" Margin="0,10,0,0" />
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </StackPanel>
                        <ItemsPresenter />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ActiveCount" Value="0">
                            <Setter TargetName="PART_Clear" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixTextFilter}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="240" />
        <Setter Property="Margin" Value="0,0,10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixTextFilter}">
                    <local:HelixTextField Icon="search" IsClearable="True" Placeholder="{TemplateBinding Placeholder}"
                                         Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixChoiceFilter}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="220" />
        <Setter Property="Margin" Value="0,0,10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixChoiceFilter}">
                    <local:HelixMultiSelect ItemsSource="{TemplateBinding Choices}" SelectedItems="{Binding Chosen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                           Placeholder="{TemplateBinding Label}" IsSearchable="{TemplateBinding IsSearchable}" MaxChips="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixDateFilter}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="250" />
        <Setter Property="Margin" Value="0,0,10,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixDateFilter}">
                    <local:HelixDateRangePicker SelectedRange="{Binding Range, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                               Placeholder="{TemplateBinding Label}" MaxDays="{TemplateBinding MaxDays}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixToggleFilter}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="4,0,14,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixToggleFilter}">
                    <local:HelixSwitch Content="{TemplateBinding Label}" Size="Sm" VerticalAlignment="Center"
                                      IsChecked="{Binding IsOn, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Busy -->

    <Style TargetType="{x:Type local:HelixBusy}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixBusy}">
                    <Grid>
                        <ContentPresenter x:Name="Content" />
                        <Border x:Name="Veil" Visibility="Collapsed" Background="{DynamicResource Helix.Surface}" Opacity="0.82" CornerRadius="12" />
                        <StackPanel x:Name="Spinner" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <local:HelixSpinner Size="26" HorizontalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Text}" Margin="0,10,0,0" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource Helix.TextMuted}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsVeilShown" Value="True">
                            <Setter TargetName="Veil" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Spinner" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Content" Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Target bar -->

    <Style TargetType="{x:Type local:HelixTargetBar}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixTargetBar}">
                    <StackPanel>
                        <DockPanel x:Name="Head" Margin="0,0,0,4">
                            <StackPanel x:Name="Values" DockPanel.Dock="Right" Orientation="Horizontal">
                                <TextBlock Text="{TemplateBinding ValueText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" />
                                <TextBlock Text="{TemplateBinding TargetText}" FontSize="13" Margin="6,0,0,0" Foreground="{DynamicResource Helix.TextSubtle}" />
                                <TextBlock x:Name="Delta" Text="{TemplateBinding DeltaText}" FontSize="12" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Bottom"
                                           Foreground="{DynamicResource Helix.TextMuted}" />
                            </StackPanel>
                            <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Helix.TextMuted}" />
                        </DockPanel>
                        <local:HelixTargetTrack x:Name="PART_Track" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowValues" Value="False">
                            <Setter TargetName="Values" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="State" Value="ok">
                            <Setter TargetName="Delta" Property="Foreground" Value="{DynamicResource Helix.Success}" />
                        </Trigger>
                        <Trigger Property="State" Value="warn">
                            <Setter TargetName="Delta" Property="Foreground" Value="{DynamicResource Helix.Warning}" />
                        </Trigger>
                        <Trigger Property="State" Value="off">
                            <Setter TargetName="Delta" Property="Foreground" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Time bar -->

    <Style TargetType="{x:Type local:HelixTimeBar}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixTimeBar}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock x:Name="Count" DockPanel.Dock="Right" Text="{TemplateBinding RemainingText}" FontSize="26" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Helix.Primary}" VerticalAlignment="Bottom" />
                            <TextBlock Text="{TemplateBinding Label}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource Helix.TextMuted}"
                                       VerticalAlignment="Bottom" Margin="0,0,12,4" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Border x:Name="PART_Track" Height="{TemplateBinding TrackHeight}" CornerRadius="4" ClipToBounds="True"
                                Background="{DynamicResource Helix.Surface2}">
                            <Border x:Name="PART_Fill" HorizontalAlignment="Left" CornerRadius="4" Background="{DynamicResource Helix.Primary}" />
                        </Border>
                        <DockPanel x:Name="Foot" Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{TemplateBinding Hint}" FontSize="12.5" Foreground="{DynamicResource Helix.TextSubtle}" Margin="12,0,0,0" />
                            <TextBlock Text="{TemplateBinding UntilText}" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}" />
                        </DockPanel>
                        <ItemsControl x:Name="SlotList" ItemsSource="{TemplateBinding Slots}" Margin="0,8,-6,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HelixTimeBarSlotView}">
                                    <Border x:Name="Chip" Margin="0,0,6,0" Padding="10,7" CornerRadius="6" BorderThickness="1"
                                            BorderBrush="{DynamicResource Helix.Border}" Background="{DynamicResource Helix.Surface}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Brush}" />
                                                <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Text}" FontSize="11.5" MinHeight="15" Foreground="{DynamicResource Helix.TextMuted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Brush}" Value="{x:Null}">
                                            <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPast}" Value="True">
                                            <Setter TargetName="Chip" Property="Opacity" Value="0.6" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                            <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Helix.Primary}" />
                                            <Setter TargetName="Chip" Property="Background" Value="{DynamicResource Helix.PrimarySoft}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasSlots" Value="False">
                            <Setter TargetName="SlotList" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Compact" Value="True">
                            <Setter TargetName="Foot" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SlotList" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Count" Property="FontSize" Value="15" />
                        </Trigger>
                        <Trigger Property="State" Value="warn">
                            <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Helix.Warning}" />
                            <Setter TargetName="PART_Fill" Property="Background" Value="{DynamicResource Helix.Warning}" />
                        </Trigger>
                        <Trigger Property="State" Value="critical">
                            <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Helix.Danger}" />
                            <Setter TargetName="PART_Fill" Property="Background" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                        <Trigger Property="State" Value="passed">
                            <Setter TargetName="Count" Property="Foreground" Value="{DynamicResource Helix.TextSubtle}" />
                            <Setter TargetName="Count" Property="FontSize" Value="15" />
                            <Setter TargetName="PART_Fill" Property="Background" Value="{DynamicResource Helix.TextSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Description list -->

    <Style TargetType="{x:Type local:HelixDescriptionList}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:HelixDescriptionPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixDescription}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixDescription}">
                    <Border x:Name="Line" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0">
                        <DockPanel x:Name="Root">
                            <StackPanel x:Name="LabelRow" DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,3">
                                <local:HelixIcon x:Name="Icon" Icon="{TemplateBinding Icon}" Size="14" Margin="0,0,6,0" VerticalAlignment="Center"
                                                Foreground="{DynamicResource Helix.TextMuted}" />
                                <TextBlock Text="{TemplateBinding Label}" FontSize="12.5" FontWeight="Medium" Foreground="{DynamicResource Helix.TextMuted}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ContentPresenter x:Name="Value" VerticalAlignment="Top">
                                <ContentPresenter.Resources>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <DataTrigger Binding="{Binding IsInline, RelativeSource={RelativeSource AncestorType={x:Type local:HelixDescriptionList}}}" Value="True">
                            <Setter TargetName="LabelRow" Property="DockPanel.Dock" Value="Left" />
                            <Setter TargetName="LabelRow" Property="Width" Value="{Binding LabelWidth, RelativeSource={RelativeSource AncestorType={x:Type local:HelixDescriptionList}}}" />
                            <Setter TargetName="LabelRow" Property="Margin" Value="0,2,12,0" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsBordered, RelativeSource={RelativeSource AncestorType={x:Type local:HelixDescriptionList}}}" Value="True">
                            <Setter TargetName="Line" Property="BorderThickness" Value="0,0,0,1" />
                            <Setter TargetName="Line" Property="Padding" Value="0,0,0,10" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Log viewer -->

    <Style x:Key="Helix.LogLevelToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextSubtle}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bg" Height="28" Padding="10,0" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Helix.Border}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
                            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Helix.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixLogViewer}">
        <Setter Property="Height" Value="420" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixLogViewer}">
                    <Border Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="14">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="12,10" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,0,1">
                                <StackPanel>
                                    <DockPanel>
                                        <local:HelixSwitch DockPanel.Dock="Right" Content="{x:Static local:HelixLogViewer.FollowText}" Size="Sm" VerticalAlignment="Center" Margin="10,0,0,0"
                                                          IsChecked="{Binding IsFollowing, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
                                            <ToggleButton Style="{StaticResource Helix.LogLevelToggle}" IsChecked="{Binding ShowDebug, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                <TextBlock><Run Text="{x:Static local:HelixLogViewer.DebugText}" /> <Run Text="{Binding Counts[0], RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Foreground="{DynamicResource Helix.TextMuted}" /></TextBlock>
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource Helix.LogLevelToggle}" IsChecked="{Binding ShowInfo, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                <TextBlock><Run Text="{x:Static local:HelixLogViewer.InfoText}" /> <Run Text="{Binding Counts[1], RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Foreground="{DynamicResource Helix.TextMuted}" /></TextBlock>
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource Helix.LogLevelToggle}" IsChecked="{Binding ShowWarning, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                <TextBlock><Run Text="{x:Static local:HelixLogViewer.WarningText}" /> <Run Text="{Binding Counts[2], RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Foreground="{DynamicResource Helix.TextMuted}" /></TextBlock>
                                            </ToggleButton>
                                            <ToggleButton Style="{StaticResource Helix.LogLevelToggle}" IsChecked="{Binding ShowError, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                                <TextBlock><Run Text="{x:Static local:HelixLogViewer.ErrorText}" /> <Run Text="{Binding Counts[3], RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Foreground="{DynamicResource Helix.TextMuted}" /></TextBlock>
                                            </ToggleButton>
                                        </StackPanel>
                                        <local:HelixTextField Icon="search" IsClearable="True" Placeholder="{x:Static local:HelixLogViewer.SearchPlaceholderText}" MaxWidth="280" HorizontalAlignment="Left"
                                                             Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                    <DockPanel Margin="0,8,0,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"
                                                    Visibility="{Binding IsExportable, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Helix.BoolToVisibility}}">
                                            <local:HelixButton Content="CSV" Icon="download" Variant="Ghost" Tone="Neutral" Size="Sm" Margin="0,0,4,0" Command="{Binding ExportCsvCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                                            <local:HelixButton Content="Excel" Icon="download" Variant="Ghost" Tone="Neutral" Size="Sm" Command="{Binding ExportExcelCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <local:HelixSelect Width="190" Margin="0,0,8,0" ItemsSource="{Binding Sources, RelativeSource={RelativeSource TemplatedParent}}"
                                                               Visibility="{Binding HasSources, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Helix.BoolToVisibility}}"
                                                               SelectedItem="{Binding SourceChoice, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                            <local:HelixSelect Width="190" ItemsSource="{Binding Periods, RelativeSource={RelativeSource TemplatedParent}}" DisplayMemberPath="Label"
                                                               SelectedItem="{Binding Period, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                            <Border DockPanel.Dock="Top" Padding="12,8,12,2" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,0,1"
                                    Visibility="{Binding HasFilters, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Helix.BoolToVisibility}}">
                                <WrapPanel>
                                    <ItemsControl ItemsSource="{Binding Filters, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type local:HelixLogFilter}">
                                                <Border CornerRadius="999" Padding="10,2,4,2" Margin="0,0,6,6" Background="{DynamicResource Helix.PrimarySoft}" BorderBrush="{DynamicResource Helix.Primary}" BorderThickness="1">
                                                    <StackPanel Orientation="Horizontal" TextElement.Foreground="{DynamicResource Helix.Text}">
                                                        <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" />
                                                        <TextBlock Text=" = " FontSize="12" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding ShortValue}" ToolTip="{Binding Value}" FontSize="12" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" />
                                                        <Button Style="{StaticResource Helix.IconButton}" Width="20" Height="20" Margin="4,0,0,0" Command="{Binding RemoveCommand}"><local:HelixIcon Icon="x" Size="11" /></Button>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <local:HelixButton Content="{x:Static local:HelixLogViewer.ClearFiltersText}" Variant="Ghost" Size="Sm" Margin="0,0,0,6" VerticalAlignment="Center"
                                                       Command="{Binding ClearFiltersCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                                </WrapPanel>
                            </Border>
                            <TextBlock DockPanel.Dock="Bottom" Text="{TemplateBinding StatusText}" FontSize="12" Foreground="{DynamicResource Helix.TextSubtle}" Margin="12,6" />
                            <ContentControl x:Name="PART_Details" DockPanel.Dock="Bottom" Visibility="Collapsed" Focusable="False">
                                <ContentControl.Template>
                                    <ControlTemplate TargetType="{x:Type ContentControl}">
                                        <Border Background="{DynamicResource Helix.Surface2}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,1,0,1">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </ContentControl.Template>
                            </ContentControl>
                            <Grid>
                                <ListBox x:Name="PART_Lines" ItemsSource="{TemplateBinding View}" BorderThickness="0" Background="Transparent"
                                         SelectedItem="{Binding SelectedEntry, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" FontFamily="Cascadia Mono, Consolas" FontSize="12.5">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="{x:Type ListBoxItem}">
                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                        <Border x:Name="Bg" Height="30" Padding="12,0" Background="Transparent" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,0,1">
                                                            <ContentPresenter VerticalAlignment="Center" />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.PrimarySoft}" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Width="72" Foreground="{DynamicResource Helix.TextSubtle}">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{x:Static local:HelixLogTimeConverter.Instance}">
                                                            <Binding Path="Time" />
                                                            <Binding Path="TimeFormat" RelativeSource="{RelativeSource AncestorType={x:Type local:HelixLogViewer}}" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                                <TextBlock x:Name="Level" DockPanel.Dock="Left" Width="72" Text="{Binding LevelText}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource Helix.TextSubtle}" />
                                                <local:HelixIcon x:Name="Failure" DockPanel.Dock="Right" Icon="danger" Size="13" Foreground="{DynamicResource Helix.Danger}" VerticalAlignment="Center"
                                                                 Margin="8,0,0,0" Visibility="Collapsed" />
                                                <TextBlock DockPanel.Dock="Left" MaxWidth="150" Margin="0,0,10,0" Text="{Binding Source}" TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource Helix.TextMuted}" />
                                                <TextBlock Text="{Binding Message}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" Foreground="{DynamicResource Helix.Text}" />
                                            </DockPanel>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Level}" Value="Info">
                                                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Helix.Info}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Warning">
                                                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Helix.Warning}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Level}" Value="Error">
                                                    <Setter TargetName="Level" Property="Foreground" Value="{DynamicResource Helix.Danger}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding HasException}" Value="True">
                                                    <Setter TargetName="Failure" Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <local:HelixButton HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Size="Sm" Icon="arrow-down"
                                                   Content="{TemplateBinding UnseenText}" Command="{Binding JumpToNewestCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                   Visibility="{Binding HasUnseen, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource Helix.BoolToVisibility}}" />
                            </Grid>
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Auto form -->

    <Style TargetType="{x:Type local:HelixAutoForm}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixAutoForm}">
                    <StackPanel>
                        <local:HelixAutoFormPanel x:Name="PART_Fields" />
                        <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                            <local:HelixButton x:Name="PART_Cancel" Content="{TemplateBinding CancelText}" Variant="Ghost" Tone="Neutral" Margin="0,0,8,0" Visibility="Collapsed" />
                            <local:HelixButton x:Name="PART_Submit" Content="{TemplateBinding SubmitText}" Icon="check" IsDefault="True" />
                        </StackPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowActions" Value="False">
                            <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowCancel" Value="True">
                            <Setter TargetName="PART_Cancel" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Calendar without its own frame, inside the panels of the pickers. -->
    <Style x:Key="Helix.CalendarPlain" TargetType="{x:Type Calendar}" BasedOn="{StaticResource Helix.Calendar}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Calendar}">
                    <CalendarItem x:Name="PART_CalendarItem" Style="{StaticResource Helix.CalendarItem}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== DateTimePicker -->

    <Style TargetType="{x:Type local:HelixDateTimePicker}" BasedOn="{StaticResource Helix.FieldBase}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixDateTimePicker}">
                    <local:HelixField x:Name="Field" Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}" Error="{TemplateBinding Error}" IsRequired="{TemplateBinding IsRequired}">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="PART_Chrome" MinHeight="{DynamicResource Helix.ControlHeight}" CornerRadius="{TemplateBinding CornerRadius}" Cursor="Hand"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <DockPanel Margin="12,0,6,0">
                                    <local:HelixIcon DockPanel.Dock="Left" Icon="calendar" Size="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Helix.TextSubtle}" />
                                    <Button x:Name="PART_Clear" DockPanel.Dock="Right" Style="{StaticResource Helix.IconButton}" ToolTip="{x:Static local:HelixPanelPicker.ClearText}" Visibility="Collapsed">
                                        <local:HelixIcon Icon="x" Size="14" />
                                    </Button>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Helix.TextSubtle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="Value" Text="{TemplateBinding DisplayText}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Chrome}" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" VerticalOffset="2" HorizontalOffset="-8"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Border Margin="8" Padding="12" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1"
                                        CornerRadius="14" Effect="{StaticResource Helix.ShadowLg}">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <Calendar x:Name="PART_Calendar" Style="{StaticResource Helix.CalendarPlain}" IsTodayHighlighted="True" />
                                            <DockPanel Margin="10,0,0,0" Width="88">
                                                <TextBlock DockPanel.Dock="Top" Text="{x:Static local:HelixDateTimePicker.TimeText}" FontSize="11.5" FontWeight="SemiBold"
                                                           HorizontalAlignment="Center" Margin="0,4,0,6" Foreground="{DynamicResource Helix.TextSubtle}" />
                                                <ListBox x:Name="PART_Times" Height="270" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Helix.Border}" Background="Transparent"
                                                         Padding="8,0,0,0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                                                    <ListBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Text}" HorizontalAlignment="Center" />
                                                        </DataTemplate>
                                                    </ListBox.ItemTemplate>
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="{x:Type ListBoxItem}">
                                                            <Setter Property="IsEnabled" Value="{Binding IsEnabled}" />
                                                            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="{x:Type ListBoxItem}">
                                                                        <Border x:Name="Bg" Height="32" Margin="0,1" CornerRadius="8" Background="Transparent">
                                                                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="Bg" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixDateTimePicker}}}" />
                                                                                <Setter Property="Foreground" Value="{Binding OnAccent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixDateTimePicker}}}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsEnabled" Value="False">
                                                                                <Setter Property="Opacity" Value="0.4" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                </ListBox>
                                            </DockPanel>
                                        </StackPanel>
                                        <Border Margin="0,10,0,0" Padding="0,8,0,0" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,1,0,0">
                                            <local:HelixButton x:Name="PART_Now" Content="{x:Static local:HelixDateTimePicker.NowText}" Variant="Ghost" Size="Sm" HorizontalAlignment="Left" />
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </local:HelixField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasValue" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Value" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasValue" Value="True" />
                                <Condition Property="IsClearable" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Clear" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Chrome" Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PART_Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="PART_Chrome" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== DateRangePicker -->

    <Style TargetType="{x:Type local:HelixDateRangePicker}" BasedOn="{StaticResource Helix.FieldBase}">
        <Style.Resources>
            <Style x:Key="Helix.RangePreset" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bg" Padding="10,7" Margin="0,1" CornerRadius="8" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixDateRangePicker}">
                    <local:HelixField x:Name="Field" Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}" Error="{TemplateBinding Error}" IsRequired="{TemplateBinding IsRequired}">
                        <Grid>
                            <Border x:Name="Ring" Margin="-3" CornerRadius="{TemplateBinding CornerRadius}" BorderThickness="3" BorderBrush="{TemplateBinding Accent}" Opacity="0" />
                            <Border x:Name="PART_Chrome" MinHeight="{DynamicResource Helix.ControlHeight}" CornerRadius="{TemplateBinding CornerRadius}" Cursor="Hand"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                <DockPanel Margin="12,0,6,0">
                                    <local:HelixIcon DockPanel.Dock="Left" Icon="calendar" Size="16" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource Helix.TextSubtle}" />
                                    <Button x:Name="PART_Clear" DockPanel.Dock="Right" Style="{StaticResource Helix.IconButton}" ToolTip="{x:Static local:HelixPanelPicker.ClearText}" Visibility="Collapsed">
                                        <local:HelixIcon Icon="x" Size="14" />
                                    </Button>
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Helix.TextSubtle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="Value" Text="{TemplateBinding DisplayText}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" PlacementTarget="{Binding ElementName=PART_Chrome}" StaysOpen="False" AllowsTransparency="True"
                                   PopupAnimation="Fade" VerticalOffset="2" HorizontalOffset="-8"
                                   IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <Border Margin="8" Padding="12" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1"
                                        CornerRadius="14" Effect="{StaticResource Helix.ShadowLg}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="PresetsHost" Padding="0,0,12,0" Margin="0,0,12,0" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,1,0">
                                            <ItemsControl x:Name="PART_Presets" MinWidth="130" />
                                        </Border>
                                        <StackPanel>
                                            <Calendar x:Name="PART_Calendar" Style="{StaticResource Helix.CalendarPlain}" IsTodayHighlighted="True" SelectionMode="SingleRange" />
                                            <TextBlock x:Name="Status" Text="{x:Static local:HelixDateRangePicker.PeriodText}" Margin="0,8,0,0" FontSize="11.5" Foreground="{DynamicResource Helix.TextSubtle}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Popup>
                        </Grid>
                    </local:HelixField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasValue" Value="True">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Value" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="HasValue" Value="True" />
                                <Condition Property="IsClearable" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Clear" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Chrome" Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="PART_Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="PART_Chrome" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Ring" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="HasError" Value="True">
                            <Setter TargetName="PART_Chrome" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <Trigger Property="ShowPresets" Value="False">
                            <Setter TargetName="PresetsHost" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsPickingEnd" Value="True">
                            <Setter TargetName="Status" Property="Text" Value="{x:Static local:HelixDateRangePicker.PickEndText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Badge -->

    <Style TargetType="{x:Type local:HelixBadge}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Foreground" Value="{Binding Accent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="9,2" />
        <Setter Property="MinHeight" Value="22" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixBadge}">
                    <Grid>
                        <Border x:Name="Tint" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0.12" />
                        <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse x:Name="Dot" Width="6" Height="6" Fill="{TemplateBinding Foreground}" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <local:HelixIcon x:Name="Icon" Icon="{TemplateBinding Icon}" Size="12" StrokeWidth="2.4" Margin="0,0,5,0" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowDot" Value="True">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Solid">
                            <Setter TargetName="Tint" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Outline">
                            <Setter TargetName="Tint" Property="Opacity" Value="0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Variant" Value="Solid">
                <Setter Property="Foreground" Value="{Binding OnAccent, RelativeSource={RelativeSource Self}}" />
            </Trigger>
            <Trigger Property="Variant" Value="Outline">
                <Setter Property="BorderThickness" Value="1" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== Alert -->

    <Style TargetType="{x:Type local:HelixAlert}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixAlert}">
                    <Grid>
                        <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" />
                        <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0.08" />
                        <Border CornerRadius="{TemplateBinding CornerRadius}" BorderBrush="{TemplateBinding Accent}" BorderThickness="1" Opacity="0.35" />
                        <DockPanel Margin="{TemplateBinding Padding}">
                            <local:HelixIcon DockPanel.Dock="Left" Icon="{TemplateBinding EffectiveIcon}" Size="18" Foreground="{TemplateBinding Accent}"
                                            Margin="0,1,10,0" VerticalAlignment="Top" />
                            <Button x:Name="PART_Close" DockPanel.Dock="Right" Style="{StaticResource Helix.IconButton}" Margin="8,-3,-4,0"
                                    VerticalAlignment="Top" Visibility="Collapsed">
                                <local:HelixIcon Icon="x" Size="14" />
                            </Button>
                            <StackPanel>
                                <TextBlock x:Name="Title" Text="{TemplateBinding Title}" FontWeight="SemiBold" Margin="0,0,0,2" TextWrapping="Wrap" />
                                <ContentPresenter x:Name="Body" TextElement.Foreground="{DynamicResource Helix.TextMuted}">
                                    <ContentPresenter.Resources>
                                        <Style TargetType="{x:Type TextBlock}">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </StackPanel>
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Body" Property="TextElement.Foreground" Value="{DynamicResource Helix.Text}" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Title" Property="Margin" Value="0" />
                        </Trigger>
                        <Trigger Property="IsClosable" Value="True">
                            <Setter TargetName="PART_Close" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Card -->

    <Style TargetType="{x:Type local:HelixCard}">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="20,16,20,20" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixCard}">
                    <Border x:Name="Root" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <DockPanel x:Name="HeaderRow" Margin="20,18,20,0">
                                <ContentPresenter x:Name="Actions" DockPanel.Dock="Right" Content="{TemplateBinding Actions}" VerticalAlignment="Top" Margin="12,0,0,0" />
                                <ContentPresenter x:Name="CustomHeader" Content="{TemplateBinding Header}" />
                                <StackPanel x:Name="TitleStack" Visibility="Collapsed">
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="Subtitle" Text="{TemplateBinding Subtitle}" FontSize="13" Margin="0,2,0,0" TextWrapping="Wrap"
                                               Foreground="{DynamicResource Helix.TextMuted}" />
                                </StackPanel>
                            </DockPanel>
                            <ContentPresenter Grid.Row="1" Margin="{TemplateBinding Padding}" />
                            <Border x:Name="FooterRow" Grid.Row="2" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,1,0,0" Padding="16,12">
                                <ContentPresenter Content="{TemplateBinding Footer}" HorizontalAlignment="Right" />
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Header" Value="{x:Null}">
                            <Setter TargetName="CustomHeader" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="TitleStack" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Header" Value="{x:Null}" />
                                <Condition Property="Title" Value="{x:Null}" />
                                <Condition Property="Actions" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderRow" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="Footer" Value="{x:Null}">
                            <Setter TargetName="FooterRow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsElevated" Value="True">
                            <Setter TargetName="Root" Property="Effect" Value="{StaticResource Helix.ShadowSm}" />
                            <Setter TargetName="Root" Property="BorderBrush" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Progress -->

    <Style TargetType="{x:Type local:HelixProgress}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="TrackBrush" Value="{DynamicResource Helix.Surface3}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixProgress}">
                    <StackPanel>
                        <DockPanel x:Name="Header" Margin="0,0,0,6">
                            <TextBlock x:Name="Percent" DockPanel.Dock="Right" Text="{TemplateBinding PercentText}" Foreground="{DynamicResource Helix.TextMuted}" Visibility="Collapsed" />
                            <TextBlock Text="{TemplateBinding Label}" FontWeight="SemiBold" />
                        </DockPanel>
                        <Grid Height="{TemplateBinding BarHeight}" ClipToBounds="True">
                            <Border x:Name="PART_Track" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding TrackBrush}" />
                            <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" />
                            <Border x:Name="Runner" Width="90" HorizontalAlignment="Left" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Visibility="Collapsed">
                                <Border.RenderTransform>
                                    <TranslateTransform X="-90" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowValue" Value="True">
                            <Setter TargetName="Percent" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Label" Value="{x:Null}" />
                                <Condition Property="ShowValue" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Percent" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Runner" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Run">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Runner" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                         From="-90" To="600" Duration="0:0:1.4" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Run" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

