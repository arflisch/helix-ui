    <!-- ===================================================================== Stat -->

    <Style TargetType="{x:Type local:HelixStat}">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixStat}">
                    <StackPanel>
                        <DockPanel>
                            <local:HelixIcon x:Name="Icon" DockPanel.Dock="Right" Icon="{TemplateBinding Icon}" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Label}" FontSize="13" Foreground="{DynamicResource Helix.TextMuted}" />
                        </DockPanel>
                        <WrapPanel Margin="0,6,0,0">
                            <TextBlock Text="{TemplateBinding Value}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                            <TextBlock x:Name="Unit" Text="{TemplateBinding Unit}" FontSize="15" Margin="5,0,10,4" VerticalAlignment="Bottom"
                                       Foreground="{DynamicResource Helix.TextMuted}" />
                            <Border x:Name="Delta" CornerRadius="999" Padding="7,2" Margin="0,0,0,6" VerticalAlignment="Bottom" Background="{DynamicResource Helix.Surface2}">
                                <TextBlock x:Name="DeltaText" Text="{TemplateBinding DeltaText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Helix.TextMuted}" />
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Unit" Value="{x:Null}">
                            <Setter TargetName="Unit" Property="Margin" Value="0,0,10,4" />
                        </Trigger>
                        <Trigger Property="DeltaState" Value="none">
                            <Setter TargetName="Delta" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="DeltaState" Value="good">
                            <Setter TargetName="DeltaText" Property="Foreground" Value="{DynamicResource Helix.Success}" />
                        </Trigger>
                        <Trigger Property="DeltaState" Value="bad">
                            <Setter TargetName="DeltaText" Property="Foreground" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Tabs -->

    <Style TargetType="{x:Type local:HelixTabs}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,18,0,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixTabs}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top">
                            <Border x:Name="Line" VerticalAlignment="Bottom" Height="1" Background="{DynamicResource Helix.Border}" />
                            <Border x:Name="Strip" HorizontalAlignment="Left" CornerRadius="10">
                                <TabPanel IsItemsHost="True" Background="Transparent" />
                            </Border>
                        </Grid>
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Variant" Value="Pills">
                            <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Variant" Value="Segmented">
                            <Setter TargetName="Line" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Strip" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                            <Setter TargetName="Strip" Property="Padding" Value="3" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixTab}">
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Helix.FocusVisual}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixTab}">
                    <Grid x:Name="Root" Margin="0,0,4,0" Background="Transparent">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent" />
                        <Border x:Name="Underline" Height="2" VerticalAlignment="Bottom" CornerRadius="1" Visibility="Hidden"
                                Background="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixTabs}}}" />
                        <StackPanel Orientation="Horizontal" Margin="12,9">
                            <local:HelixIcon x:Name="Icon" Icon="{TemplateBinding Icon}" Margin="0,0,7,0" VerticalAlignment="Center" />
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <DataTrigger Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type local:HelixTabs}}}" Value="Pills">
                            <Setter TargetName="Underline" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type local:HelixTabs}}}" Value="Segmented">
                            <Setter TargetName="Underline" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Root" Property="Margin" Value="0" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type local:HelixTabs}}}" Value="Pills" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixTabs}}}" />
                            <Setter TargetName="Bg" Property="Opacity" Value="0.12" />
                            <Setter Property="Foreground" Value="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixTabs}}}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Variant, RelativeSource={RelativeSource AncestorType={x:Type local:HelixTabs}}}" Value="Segmented" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{StaticResource Helix.ShadowSm}" />
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Accordion -->

    <Style TargetType="{x:Type local:HelixAccordion}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixAccordion}">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12" Padding="0,0,0,0">
                        <ItemsPresenter Margin="0,0,0,-1" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFlush" Value="True">
                            <Setter TargetName="Root" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Root" Property="Background" Value="Transparent" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixAccordionItem}">
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixAccordionItem}">
                    <Border BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,0,1">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Bg" Background="Transparent" Padding="16,13">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <DockPanel>
                                    <local:HelixIcon x:Name="Chevron" DockPanel.Dock="Right" Icon="chevron-down" Foreground="{DynamicResource Helix.TextSubtle}"
                                                    VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                    <ContentPresenter x:Name="Extra" DockPanel.Dock="Right" Content="{TemplateBinding Extra}" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    <local:HelixIcon x:Name="Icon" DockPanel.Dock="Left" Icon="{TemplateBinding Icon}" Margin="0,1,12,0" VerticalAlignment="Top"
                                                    Foreground="{DynamicResource Helix.TextMuted}" />
                                    <StackPanel>
                                        <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Helix.Text}" />
                                        <TextBlock x:Name="Subtitle" Text="{TemplateBinding Subtitle}" FontSize="12.5" Margin="0,2,0,0" Foreground="{DynamicResource Helix.TextMuted}" />
                                    </StackPanel>
                                </DockPanel>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Margin="16,0,16,16" Visibility="Collapsed" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="Icon" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Extra" Value="{x:Null}">
                            <Setter TargetName="Extra" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Breadcrumb, pagination, stepper (built in code) -->

    <Style TargetType="{x:Type local:HelixBreadcrumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixBreadcrumb}">
                    <WrapPanel x:Name="PART_Panel" Margin="-8,0,0,0" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixPagination}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixPagination}">
                    <StackPanel x:Name="PART_Pages" Orientation="Horizontal" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixStepper}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixStepper}">
                    <Grid x:Name="PART_Steps" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== ButtonGroup (segmented) -->

    <Style x:Key="Helix.SegmentItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Helix.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface}" />
                            <Setter TargetName="Bg" Property="Effect" Value="{StaticResource Helix.ShadowSm}" />
                            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixButtonGroup}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Helix.SegmentItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:HelixButtonGroup}}}" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixButtonGroup}">
                    <Border Background="{DynamicResource Helix.Surface2}" CornerRadius="{TemplateBinding CornerRadius}" Padding="3">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Avatar -->

    <Style TargetType="{x:Type local:HelixAvatar}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixAvatar}">
                    <Grid x:Name="Root" Width="36" Height="36">
                        <Border CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}">
                            <TextBlock x:Name="Initials" Text="{TemplateBinding Initials}" Foreground="#FFFFFFFF" FontWeight="SemiBold" FontSize="13"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Photo" CornerRadius="{TemplateBinding CornerRadius}">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Source, RelativeSource={RelativeSource TemplatedParent}}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Ellipse x:Name="Dot" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                 Stroke="{DynamicResource Helix.Surface}" StrokeThickness="2" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Source" Value="{x:Null}">
                            <Setter TargetName="Photo" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Size" Value="Sm">
                            <Setter TargetName="Root" Property="Width" Value="28" />
                            <Setter TargetName="Root" Property="Height" Value="28" />
                            <Setter TargetName="Initials" Property="FontSize" Value="11" />
                            <Setter TargetName="Dot" Property="Width" Value="8" />
                            <Setter TargetName="Dot" Property="Height" Value="8" />
                        </Trigger>
                        <Trigger Property="Size" Value="Lg">
                            <Setter TargetName="Root" Property="Width" Value="48" />
                            <Setter TargetName="Root" Property="Height" Value="48" />
                            <Setter TargetName="Initials" Property="FontSize" Value="17" />
                            <Setter TargetName="Dot" Property="Width" Value="13" />
                            <Setter TargetName="Dot" Property="Height" Value="13" />
                        </Trigger>
                        <Trigger Property="Status" Value="Online">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Helix.Success}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Away">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Helix.Warning}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Busy">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                        <Trigger Property="Status" Value="Offline">
                            <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Helix.TextSubtle}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixAvatarGroup}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixAvatarGroup}">
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0">
                        <StackPanel.Resources>
                            <Style TargetType="{x:Type local:HelixAvatar}" BasedOn="{StaticResource {x:Type local:HelixAvatar}}">
                                <Setter Property="Margin" Value="-8,0,0,0" />
                            </Style>
                        </StackPanel.Resources>
                        <ItemsPresenter />
                        <Border x:Name="Overflow" Margin="-8,0,0,0" MinWidth="36" Height="36" CornerRadius="18" Padding="6,0"
                                Background="{DynamicResource Helix.Surface3}" BorderBrush="{DynamicResource Helix.Surface}" BorderThickness="2">
                            <TextBlock Text="{TemplateBinding OverflowText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Helix.TextMuted}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="OverflowText" Value="{x:Null}">
                            <Setter TargetName="Overflow" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Skeleton -->

    <Style TargetType="{x:Type local:HelixSkeleton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixSkeleton}">
                    <Grid x:Name="Root">
                        <Border x:Name="Block" CornerRadius="{TemplateBinding CornerRadius}" Background="{DynamicResource Helix.Surface3}" />
                        <Ellipse x:Name="Circle" Fill="{DynamicResource Helix.Surface3}" Visibility="Collapsed" />
                        <ItemsControl x:Name="LinesHost" ItemsSource="{TemplateBinding LineItems}" Visibility="Collapsed" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,9">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Filled}" />
                                            <ColumnDefinition Width="{Binding Empty}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Height="12" CornerRadius="6" Background="{DynamicResource Helix.Surface3}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCircle" Value="True">
                            <Setter TargetName="Block" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Circle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMultiline" Value="True">
                            <Setter TargetName="Block" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LinesHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard>
                                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="1" To="0.45"
                                                     Duration="0:0:0.9" AutoReverse="True" RepeatBehavior="Forever" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Splitter -->

    <Style TargetType="{x:Type local:HelixSplitter}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Width" Value="9" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixSplitter}">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Line" Width="1" Background="{DynamicResource Helix.Border}" />
                        <Border x:Name="Grip" Width="5" Height="28" CornerRadius="3" Background="{DynamicResource Helix.BorderStrong}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HorizontalAlignment" Value="Stretch">
                            <Setter TargetName="Line" Property="Width" Value="NaN" />
                            <Setter TargetName="Line" Property="Height" Value="1" />
                            <Setter TargetName="Grip" Property="Width" Value="28" />
                            <Setter TargetName="Grip" Property="Height" Value="5" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Grip" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Grip" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="HorizontalAlignment" Value="Stretch">
                <Setter Property="Width" Value="NaN" />
                <Setter Property="Height" Value="9" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== Menu -->

    <Style TargetType="{x:Type local:HelixContextMenu}">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixContextMenu}">
                    <Border Margin="8" Padding="4" MinWidth="200" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                            BorderThickness="1" CornerRadius="12" Effect="{StaticResource Helix.ShadowLg}">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixMenuSeparator}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixMenuSeparator}">
                    <Border Height="1" Margin="6,4" Background="{DynamicResource Helix.Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixMenuLabel}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixMenuLabel}">
                    <TextBlock Text="{TemplateBinding Text}" Margin="10,8,10,4" FontSize="11" FontWeight="SemiBold"
                               Foreground="{DynamicResource Helix.TextSubtle}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixMenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixMenuItem}">
                    <Grid>
                        <Border x:Name="Bg" CornerRadius="7" Background="Transparent" Padding="10,7">
                            <DockPanel>
                                <local:HelixIcon x:Name="Icon" DockPanel.Dock="Left" Icon="{TemplateBinding IconName}" Margin="0,1,10,0" VerticalAlignment="Top"
                                                Foreground="{DynamicResource Helix.TextMuted}" />
                                <ContentPresenter x:Name="CustomIcon" DockPanel.Dock="Left" ContentSource="Icon" Margin="0,0,10,0" VerticalAlignment="Top" />
                                <local:HelixIcon x:Name="Check" DockPanel.Dock="Right" Icon="check" Margin="12,1,0,0" VerticalAlignment="Top"
                                                Foreground="{DynamicResource Helix.Primary}" Visibility="Collapsed" />
                                <local:HelixIcon x:Name="Arrow" DockPanel.Dock="Right" Icon="chevron-right" Margin="12,1,0,0" VerticalAlignment="Top"
                                                Foreground="{DynamicResource Helix.TextSubtle}" Visibility="Collapsed" />
                                <TextBlock x:Name="Gesture" DockPanel.Dock="Right" Text="{TemplateBinding InputGestureText}" Margin="20,1,0,0" FontSize="12"
                                           VerticalAlignment="Top" Foreground="{DynamicResource Helix.TextSubtle}" />
                                <StackPanel>
                                    <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" />
                                    <TextBlock x:Name="Description" Text="{TemplateBinding Description}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"
                                               MaxWidth="260" HorizontalAlignment="Left" Foreground="{DynamicResource Helix.TextMuted}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Popup x:Name="PART_Popup" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Placement="Right"
                               HorizontalOffset="-4" VerticalOffset="-12" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                            <Border Margin="8" Padding="4" MinWidth="180" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                                    BorderThickness="1" CornerRadius="12" Effect="{StaticResource Helix.ShadowLg}">
                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IconName" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="MenuItem.Icon" Value="{x:Null}">
                            <Setter TargetName="CustomIcon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Description" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsDanger" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Helix.Danger}" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Helix.Danger}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Rating -->

    <Style TargetType="{x:Type local:HelixRating}">
        <Setter Property="Accent" Value="#FFF5A524" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Helix.FocusVisual}" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixRating}">
                    <StackPanel x:Name="PART_Items" Orientation="Horizontal" Background="Transparent" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Focusable" Value="False" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== ColorPicker -->

    <Style TargetType="{x:Type local:HelixColorPicker}" BasedOn="{StaticResource Helix.FieldBase}">
        <Setter Property="CornerRadius" Value="{DynamicResource Helix.Radius}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixColorPicker}">
                    <local:HelixField x:Name="Field" Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                          IsChecked="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border x:Name="Chrome" MinHeight="{DynamicResource Helix.ControlHeight}" Background="{DynamicResource Helix.Surface}"
                                                BorderBrush="{DynamicResource Helix.BorderStrong}" BorderThickness="1"
                                                CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:HelixColorPicker}}}">
                                            <ContentPresenter Margin="8,0,10,0" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Helix.TextSubtle}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Helix.Primary}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <DockPanel>
                                    <local:HelixIcon DockPanel.Dock="Right" Icon="chevron-down" Foreground="{DynamicResource Helix.TextSubtle}" VerticalAlignment="Center" />
                                    <Border Width="22" Height="22" CornerRadius="6" BorderThickness="1" BorderBrush="#28000000"
                                            Background="{TemplateBinding SwatchBrush}" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <Grid VerticalAlignment="Center">
                                        <TextBlock x:Name="HexText" Text="{TemplateBinding Hex}" FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource Helix.Text}" />
                                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Placeholder}" Foreground="{DynamicResource Helix.TextSubtle}" Visibility="Collapsed" />
                                    </Grid>
                                </DockPanel>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" IsOpen="{Binding IsOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" StaysOpen="False"
                                   Placement="Bottom" PlacementTarget="{Binding ElementName=Toggle}" AllowsTransparency="True" PopupAnimation="Fade"
                                   VerticalOffset="-4" HorizontalOffset="-8">
                                <Border x:Name="PART_Panel" Margin="8" Padding="12" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                                        BorderThickness="1" CornerRadius="14" Effect="{StaticResource Helix.ShadowLg}" />
                            </Popup>
                        </Grid>
                    </local:HelixField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Hex" Value="{x:Null}">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Field" Property="Opacity" Value="0.55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== FileDrop -->

    <Style TargetType="{x:Type local:HelixFileDrop}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixFileDrop}">
                    <StackPanel>
                        <Grid x:Name="Zone">
                            <Border x:Name="ZoneBg" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Background}" />
                            <Border x:Name="Tint" CornerRadius="{TemplateBinding CornerRadius}" Background="{TemplateBinding Accent}" Opacity="0" />
                            <Rectangle x:Name="Dash" RadiusX="14" RadiusY="14" StrokeDashArray="5 4" StrokeThickness="1.5" Stroke="{DynamicResource Helix.BorderStrong}" />
                            <StackPanel x:Name="Big" Margin="24,28" HorizontalAlignment="Center">
                                <Grid Width="44" Height="44" HorizontalAlignment="Center">
                                    <Ellipse Fill="{TemplateBinding Accent}" Opacity="0.1" />
                                    <local:HelixIcon Icon="upload" Size="20" Foreground="{TemplateBinding Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="Title" Text="{TemplateBinding Title}" FontWeight="SemiBold" Margin="0,12,0,0" HorizontalAlignment="Center" />
                                <TextBlock x:Name="Hint" Text="{TemplateBinding AutoHint}" FontSize="12.5" Margin="0,3,0,0" HorizontalAlignment="Center"
                                           Foreground="{DynamicResource Helix.TextMuted}" />
                                <local:HelixButton x:Name="PART_Browse" Content="{TemplateBinding BrowseText}" Variant="Outline" Tone="Neutral" Size="Sm"
                                                  Margin="0,14,0,0" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="Error" Text="{TemplateBinding Error}" Margin="0,8,0,0" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Helix.Danger}" />
                        <ItemsControl x:Name="List" ItemsSource="{Binding Files, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,10,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,8" CornerRadius="10" Background="{DynamicResource Helix.Surface}"
                                            BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1">
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource Helix.Surface2}" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Extension}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource Helix.TextMuted}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Helix.IconButton}" Command="{Binding RemoveCommand}">
                                                <local:HelixIcon Icon="x" Size="14" />
                                            </Button>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Medium" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Helix.Text}" />
                                                <TextBlock Text="{Binding SizeText}" FontSize="12" Foreground="{DynamicResource Helix.TextMuted}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCompact" Value="True">
                            <Setter TargetName="Big" Property="Margin" Value="16,10" />
                        </Trigger>
                        <Trigger Property="AutoHint" Value="{x:Null}">
                            <Setter TargetName="Hint" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Error" Value="{x:Null}">
                            <Setter TargetName="Error" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasFiles" Value="False">
                            <Setter TargetName="List" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowList" Value="False">
                            <Setter TargetName="List" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Dash" Property="Stroke" Value="{DynamicResource Helix.TextSubtle}" />
                        </Trigger>
                        <Trigger Property="IsDragOver" Value="True">
                            <Setter TargetName="Dash" Property="Stroke" Value="{Binding Accent, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Tint" Property="Opacity" Value="0.07" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Charts -->

    <Style x:Key="Helix.ChartTitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
    </Style>
    <Style x:Key="Helix.ChartSubtitle" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
    </Style>

    <Style TargetType="{x:Type local:HelixChart}">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixChart}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <WrapPanel x:Name="PART_Legend" DockPanel.Dock="Right" VerticalAlignment="Top" Margin="12,0,-8,0" />
                            <StackPanel VerticalAlignment="Top">
                                <TextBlock x:Name="Title" Text="{TemplateBinding Title}" Style="{StaticResource Helix.ChartTitle}" />
                                <TextBlock x:Name="Subtitle" Text="{TemplateBinding Subtitle}" Style="{StaticResource Helix.ChartSubtitle}" />
                            </StackPanel>
                        </DockPanel>
                        <local:HelixPlot x:Name="PART_Plot" Height="{TemplateBinding PlotHeight}" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixDonut}">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixDonut}">
                    <StackPanel>
                        <StackPanel x:Name="Header" Margin="0,0,0,14">
                            <TextBlock x:Name="Title" Text="{TemplateBinding Title}" Style="{StaticResource Helix.ChartTitle}" />
                            <TextBlock x:Name="Subtitle" Text="{TemplateBinding Subtitle}" Style="{StaticResource Helix.ChartSubtitle}" />
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <local:HelixPlot x:Name="PART_Plot" HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <StackPanel x:Name="PART_Legend" Grid.Column="1" Margin="28,0,0,0" VerticalAlignment="Center" MinWidth="180" />
                        </Grid>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="Subtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Title" Value="{x:Null}" />
                                <Condition Property="Subtitle" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Header" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="Shape" Value="SegmentedBar">
                            <Setter TargetName="PART_Plot" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="PART_Plot" Property="HorizontalAlignment" Value="Stretch" />
                            <Setter TargetName="PART_Legend" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_Legend" Property="Grid.Row" Value="1" />
                            <Setter TargetName="PART_Legend" Property="Grid.ColumnSpan" Value="2" />
                            <Setter TargetName="PART_Legend" Property="Margin" Value="0,14,0,0" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixHeatmap}">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixHeatmap}">
                    <StackPanel>
                        <TextBlock x:Name="Title" Text="{TemplateBinding Title}" Style="{StaticResource Helix.ChartTitle}" Margin="0,0,0,10" />
                        <local:HelixPlot x:Name="PART_Plot" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixBarList}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixBarList}">
                    <StackPanel x:Name="PART_Rows" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== DataGrid -->

    <Style x:Key="Helix.HeaderGripper" TargetType="{x:Type Thumb}">
        <Setter Property="Width" Value="8" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Helix.GridHeader" TargetType="{x:Type DataGridColumnHeader}">
        <Setter Property="Background" Value="{DynamicResource Helix.Surface2}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                    <Grid>
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}">
                            <DockPanel>
                                <local:HelixIcon x:Name="Sort" DockPanel.Dock="Right" Icon="chevrons-up-down" Size="13" Margin="6,0,0,0" Opacity="0.45" VerticalAlignment="Center" />
                                <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </DockPanel>
                        </Border>
                        <Thumb x:Name="PART_LeftHeaderGripper" HorizontalAlignment="Left" Style="{StaticResource Helix.HeaderGripper}" />
                        <Thumb x:Name="PART_RightHeaderGripper" HorizontalAlignment="Right" Style="{StaticResource Helix.HeaderGripper}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="CanUserSort" Value="False">
                            <Setter TargetName="Sort" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="Sort" Property="Icon" Value="arrow-up" />
                            <Setter TargetName="Sort" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="Sort" Property="Icon" Value="arrow-down" />
                            <Setter TargetName="Sort" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Helix.GridCell" TargetType="{x:Type DataGridCell}">
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridCell}">
                    <Border Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                <Setter Property="Background" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Helix.GridRow" TargetType="{x:Type DataGridRow}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type DataGridRow}">
                    <Border x:Name="DGR_Border" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,0,1">
                        <SelectiveScrollingGrid>
                            <SelectiveScrollingGrid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </SelectiveScrollingGrid.ColumnDefinitions>
                            <SelectiveScrollingGrid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </SelectiveScrollingGrid.RowDefinitions>
                            <DataGridCellsPresenter Grid.Column="1" ItemsPanel="{TemplateBinding ItemsPanel}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <DataGridDetailsPresenter Grid.Column="1" Grid.Row="1" Visibility="{TemplateBinding DetailsVisibility}"
                                                      SelectiveScrollingGrid.SelectiveScrollingOrientation="{Binding AreRowDetailsFrozen, ConverterParameter={x:Static SelectiveScrollingOrientation.Vertical}, Converter={x:Static DataGrid.RowDetailsScrollingConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                            <DataGridRowHeader Grid.RowSpan="2" SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                               Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Row}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                        </SelectiveScrollingGrid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource Self}}" Value="1" />
                    <Condition Binding="{Binding IsStriped, RelativeSource={RelativeSource AncestorType={x:Type local:HelixDataGrid}}}" Value="True" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource Helix.Surface2}" />
            </MultiDataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Helix.Surface2}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource Helix.PrimarySoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Chevron of HelixDetailsColumn: opens the row details. -->
    <Style TargetType="{x:Type local:HelixDetailsToggle}">
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextSubtle}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixDetailsToggle}">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="7">
                        <local:HelixIcon x:Name="Chevron" Icon="chevron-right" Size="15" Foreground="{TemplateBinding Foreground}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                            <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="Icon" Value="chevron-down" />
                            <Setter Property="Foreground" Value="{DynamicResource Helix.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Signed change: arrow + sign, green / red / gray. -->
    <Style TargetType="{x:Type local:HelixSignedValue}">
        <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixSignedValue}">
                    <StackPanel Orientation="Horizontal">
                        <local:HelixIcon x:Name="Arrow" Icon="arrow-up" Size="12" Margin="0,0,3,0" Foreground="{TemplateBinding Foreground}"
                                        VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock Text="{TemplateBinding Text}" VerticalAlignment="Center" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Direction" Value="1">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Direction" Value="-1">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Arrow" Property="Icon" Value="arrow-down" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="State" Value="good">
                <Setter Property="Foreground" Value="{DynamicResource Helix.Success}" />
            </Trigger>
            <Trigger Property="State" Value="bad">
                <Setter Property="Foreground" Value="{DynamicResource Helix.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:HelixDataGrid}">
        <Style.Resources>
            <!-- Group header (GroupBy): chevron, name, row count, subtotals; the rows fold under it. -->
            <Style x:Key="Helix.GridGroupItem" TargetType="{x:Type GroupItem}">
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type GroupItem}">
                            <StackPanel>
                                <Border Background="{DynamicResource Helix.Surface2}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,0,0,1" Padding="12,0">
                                    <ToggleButton x:Name="Toggle" IsChecked="True" Cursor="Hand" FocusVisualStyle="{x:Null}" HorizontalAlignment="Left">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent" Padding="0,9">
                                                    <StackPanel Orientation="Horizontal">
                                                        <local:HelixIcon x:Name="Chevron" Icon="chevron-down" Size="14" VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource Helix.TextSubtle}" />
                                                        <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="False">
                                                        <Setter TargetName="Chevron" Property="Icon" Value="chevron-right" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" VerticalAlignment="Center" />
                                            <Border Margin="8,0,0,0" Padding="7,1" CornerRadius="999" Background="{DynamicResource Helix.Surface3}" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ItemCount}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Helix.TextMuted}" />
                                            </Border>
                                            <TextBlock Margin="16,0,0,0" FontWeight="SemiBold" Foreground="{DynamicResource Helix.TextMuted}" VerticalAlignment="Center">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{x:Static local:HelixDataGrid.GroupSummaryConverter}">
                                                        <Binding Path="Items" />
                                                        <Binding RelativeSource="{RelativeSource AncestorType={x:Type local:HelixDataGrid}}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </ToggleButton>
                                </Border>
                                <ItemsPresenter x:Name="Rows" />
                            </StackPanel>
                            <ControlTemplate.Triggers>
                                <Trigger SourceName="Toggle" Property="IsChecked" Value="False">
                                    <Setter TargetName="Rows" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </Style.Resources>
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserDeleteRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="RowHeight" Value="40" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Helix.GridHeader}" />
        <Setter Property="RowStyle" Value="{StaticResource Helix.GridRow}" />
        <Setter Property="CellStyle" Value="{StaticResource Helix.GridCell}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizingWhenGrouping" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixDataGrid}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <DockPanel x:Name="Toolbar" DockPanel.Dock="Top" Margin="12,12,12,12">
                                <local:HelixButton x:Name="PART_Export" DockPanel.Dock="Right" Icon="download" Content="{x:Static local:HelixDataGrid.ExportText}"
                                                  Variant="Outline" Tone="Neutral" Size="Sm" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <local:HelixButton x:Name="PART_Columns" DockPanel.Dock="Right" Icon="columns" Content="{x:Static local:HelixDataGrid.ColumnsText}"
                                                  Variant="Outline" Tone="Neutral" Size="Sm" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <local:HelixTextField x:Name="Search" DockPanel.Dock="Right" Width="240" Icon="search" IsClearable="True" Visibility="Collapsed"
                                                     Placeholder="{TemplateBinding SearchPlaceholder}" VerticalAlignment="Center"
                                                     Text="{Binding SearchText, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ContentPresenter Content="{TemplateBinding Toolbar}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border x:Name="Footer" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,1,0,0" Padding="12,8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <local:HelixSelect x:Name="Sizes" Width="88" Margin="0,0,10,0" ItemsSource="{TemplateBinding PageSizes}"
                                                          SelectedItem="{Binding PageSize, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                          ItemStringFormat="{}{0} / page" />
                                        <local:HelixPagination x:Name="Pager" Page="{Binding Page, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                                              TotalItems="{TemplateBinding TotalCount}" PageSize="{TemplateBinding PageSize}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{TemplateBinding InfoText}" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource Helix.TextMuted}" />
                                </DockPanel>
                            </Border>
                            <!-- Total row: one cell per visible column, as wide as the column, scrolled with the rows. -->
                            <Border x:Name="TotalsHost" DockPanel.Dock="Bottom" MinHeight="40" ClipToBounds="True" Visibility="Collapsed"
                                    Background="{DynamicResource Helix.Surface2}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,1,0,0">
                                <StackPanel x:Name="PART_Totals" Orientation="Horizontal" />
                            </Border>
                            <Grid>
                                <ScrollViewer x:Name="DG_ScrollViewer" Focusable="False">
                                    <ScrollViewer.Template>
                                        <ControlTemplate TargetType="{x:Type ScrollViewer}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Border Width="{Binding CellsPanelHorizontalOffset, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}"
                                                        Background="{DynamicResource Helix.Surface2}" />
                                                <DataGridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.Column="1"
                                                                                Visibility="{Binding HeadersVisibility, ConverterParameter={x:Static DataGridHeadersVisibility.Column}, Converter={x:Static DataGrid.HeadersVisibilityConverter}, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" Grid.Row="1" Grid.ColumnSpan="2" CanContentScroll="{TemplateBinding CanContentScroll}" />
                                                <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="2" Grid.Row="1" Orientation="Vertical"
                                                           Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                                           Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                           Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                                                <Grid Grid.Column="1" Grid.Row="2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="{Binding NonFrozenColumnsViewportHorizontalOffset, RelativeSource={RelativeSource AncestorType={x:Type DataGrid}}}" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <ScrollBar x:Name="PART_HorizontalScrollBar" Grid.Column="1" Orientation="Horizontal"
                                                               Maximum="{TemplateBinding ScrollableWidth}" ViewportSize="{TemplateBinding ViewportWidth}"
                                                               Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                               Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                                                </Grid>
                                            </Grid>
                                        </ControlTemplate>
                                    </ScrollViewer.Template>
                                    <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                </ScrollViewer>
                                <local:HelixProgress x:Name="Loading" IsIndeterminate="True" BarHeight="3" CornerRadius="0" VerticalAlignment="Top" Visibility="Collapsed" Margin="0,38,0,0" />
                                <local:HelixEmptyState x:Name="Empty" Icon="search" Title="{TemplateBinding EmptyMessage}" Margin="0,38,0,0" Visibility="Collapsed" />
                                <StackPanel x:Name="ErrorPanel" Margin="0,38,0,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <local:HelixIcon Icon="danger" Size="22" Foreground="{DynamicResource Helix.Danger}" HorizontalAlignment="Center" />
                                    <TextBlock Text="{TemplateBinding Error}" Margin="0,8,0,10" HorizontalAlignment="Center" Foreground="{DynamicResource Helix.Text}" />
                                    <local:HelixButton x:Name="PART_Retry" Content="{x:Static local:HelixDataGrid.RetryText}" Variant="Soft" Tone="Neutral" Size="Sm" HorizontalAlignment="Center" />
                                </StackPanel>
                                <Popup x:Name="PART_ColumnPopup" PlacementTarget="{Binding ElementName=PART_Columns}" Placement="Bottom" StaysOpen="False"
                                       AllowsTransparency="True" PopupAnimation="Fade" HorizontalOffset="-8" VerticalOffset="-4">
                                    <Border Margin="8" Padding="8" MinWidth="200" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                                            BorderThickness="1" CornerRadius="12" Effect="{StaticResource Helix.ShadowLg}">
                                        <StackPanel>
                                            <TextBlock Text="{x:Static local:HelixDataGrid.VisibleColumnsText}" FontSize="12" FontWeight="SemiBold" Margin="4,2,4,6"
                                                       Foreground="{DynamicResource Helix.TextSubtle}" />
                                            <StackPanel x:Name="PART_ColumnList" />
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSearchable" Value="True">
                            <Setter TargetName="Search" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowColumnChooser" Value="True">
                            <Setter TargetName="PART_Columns" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsExportable" Value="True">
                            <Setter TargetName="PART_Export" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasTotals" Value="True">
                            <Setter TargetName="TotalsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSearchable" Value="False" />
                                <Condition Property="ShowColumnChooser" Value="False" />
                                <Condition Property="IsExportable" Value="False" />
                                <Condition Property="Toolbar" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Toolbar" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <Trigger Property="HasPager" Value="False">
                            <Setter TargetName="Pager" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="PageSize" Value="0">
                            <Setter TargetName="Sizes" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="InfoText" Value="{x:Null}">
                            <Setter TargetName="Footer" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsLoading" Value="True">
                            <Setter TargetName="Loading" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsEmpty" Value="True" />
                                <Condition Property="IsLoading" Value="False" />
                                <Condition Property="Error" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="Error" Value="{x:Null}">
                            <Setter TargetName="ErrorPanel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Density" Value="Sm">
                <Setter Property="RowHeight" Value="32" />
                <Setter Property="FontSize" Value="13" />
            </Trigger>
            <Trigger Property="Density" Value="Lg">
                <Setter Property="RowHeight" Value="48" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== Timeline -->

    <Style TargetType="{x:Type local:HelixTimeline}">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="{DynamicResource Helix.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Helix.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixTimeline}">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="14" SnapsToDevicePixels="True">
                        <DockPanel>
                            <DockPanel x:Name="Header" DockPanel.Dock="Top" Margin="16,14,12,10">
                                <Button x:Name="PART_Toggle" DockPanel.Dock="Right" Style="{StaticResource Helix.IconButton}" Visibility="Collapsed" Focusable="True">
                                    <local:HelixIcon x:Name="Chevron" Icon="chevron-down" RenderTransformOrigin="0.5,0.5" />
                                </Button>
                                <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding HeaderContent}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="{TemplateBinding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid x:Name="Body">
                                <DockPanel>
                                    <WrapPanel x:Name="PART_Legend" DockPanel.Dock="Top" Margin="16,0,16,8" />
                                    <ScrollViewer x:Name="PART_Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                                        <Canvas x:Name="PART_Canvas" ClipToBounds="True" HorizontalAlignment="Left" />
                                    </ScrollViewer>
                                </DockPanel>
                            </Grid>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsCollapsible" Value="True">
                            <Setter TargetName="PART_Toggle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsCollapsed" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="-90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== SortableList -->

    <Style x:Key="Helix.SortableItem" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border x:Name="Card" Margin="0,0,0,8" Padding="10" CornerRadius="10" Background="{DynamicResource Helix.Surface}"
                            BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1">
                        <DockPanel>
                            <local:HelixIcon x:Name="Grip" DockPanel.Dock="Left" Icon="grip" Foreground="{DynamicResource Helix.TextSubtle}" Margin="0,0,10,0"
                                            VerticalAlignment="Center" Cursor="SizeAll"
                                            Visibility="{Binding ShowHandle, RelativeSource={RelativeSource AncestorType={x:Type local:HelixSortableList}}, Converter={StaticResource Helix.BoolToVisibility}}" />
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Helix.Primary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixSortableList}">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Helix.SortableItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixSortableList}">
                    <ItemsPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Kanban -->

    <Style TargetType="{x:Type local:HelixKanban}">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixKanban}">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="PART_Columns" Orientation="Horizontal" VerticalAlignment="Top" />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Dashboard -->

    <Style TargetType="{x:Type local:HelixDashboard}">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:HelixDashboardPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixDashboard}">
                    <StackPanel>
                        <DockPanel x:Name="Toolbar" Margin="0,0,0,16">
                            <local:HelixButton x:Name="EditButton" DockPanel.Dock="Right" Icon="layout" Variant="Outline" Tone="Neutral" Size="Sm"
                                              Content="{x:Static local:HelixDashboard.EditText}"
                                              Command="{Binding ToggleEditCommand, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter DockPanel.Dock="Right" Content="{TemplateBinding Toolbar}" Margin="0,0,8,0" VerticalAlignment="Center" />
                            <TextBlock Text="{TemplateBinding Title}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <WrapPanel x:Name="Hidden" Margin="0,0,0,12" Visibility="Collapsed">
                            <TextBlock Text="{x:Static local:HelixDashboard.HiddenText}" FontSize="12.5" Margin="0,0,10,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource Helix.TextMuted}" />
                            <ItemsControl ItemsSource="{TemplateBinding HiddenTiles}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <local:HelixButton Content="{Binding Title}" Icon="plus" Variant="Soft" Tone="Neutral" Size="Sm" Margin="0,0,6,0"
                                                          Command="{Binding RestoreCommand, RelativeSource={RelativeSource AncestorType={x:Type local:HelixDashboard}}}"
                                                          CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </WrapPanel>
                        <ItemsPresenter />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowToolbar" Value="False">
                            <Setter TargetName="Toolbar" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEditing" Value="True">
                            <Setter TargetName="Hidden" Property="Visibility" Value="Visible" />
                            <Setter TargetName="EditButton" Property="Content" Value="{x:Static local:HelixDashboard.DoneText}" />
                            <Setter TargetName="EditButton" Property="Variant" Value="Solid" />
                            <Setter TargetName="EditButton" Property="Tone" Value="Primary" />
                            <Setter TargetName="EditButton" Property="Icon" Value="check" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsEditing, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding HiddenTiles.Count, RelativeSource={RelativeSource Self}}" Value="0" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Hidden" Property="Visibility" Value="Collapsed" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixDashboardTile}">
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixDashboardTile}">
                    <Grid>
                        <Border x:Name="Card" CornerRadius="14" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                                BorderThickness="1" Padding="18,16,18,18">
                            <DockPanel>
                                <DockPanel x:Name="PART_Handle" DockPanel.Dock="Top" Margin="0,0,0,12" Background="Transparent">
                                    <StackPanel x:Name="Tools" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed">
                                        <Button x:Name="ColumnLeft" Style="{StaticResource Helix.IconButton}" Command="{Binding MoveLeftCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                ToolTip="{x:Static local:HelixDashboardTile.MoveLeftText}" Focusable="True" Visibility="Collapsed">
                                            <local:HelixIcon Icon="chevron-left" Size="14" />
                                        </Button>
                                        <Button x:Name="ColumnRight" Style="{StaticResource Helix.IconButton}" Command="{Binding MoveRightCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                ToolTip="{x:Static local:HelixDashboardTile.MoveRightText}" Focusable="True" Visibility="Collapsed">
                                            <local:HelixIcon Icon="chevron-right" Size="14" />
                                        </Button>
                                        <Button Style="{StaticResource Helix.IconButton}" Command="{Binding MoveBeforeCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                ToolTip="{x:Static local:HelixDashboardTile.MoveBeforeText}" Focusable="True">
                                            <local:HelixIcon x:Name="BeforeIcon" Icon="chevron-left" Size="14" />
                                        </Button>
                                        <Button Style="{StaticResource Helix.IconButton}" Command="{Binding MoveAfterCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                ToolTip="{x:Static local:HelixDashboardTile.MoveAfterText}" Focusable="True">
                                            <local:HelixIcon x:Name="AfterIcon" Icon="chevron-right" Size="14" />
                                        </Button>
                                        <Border Width="1" Margin="6,4" Background="{DynamicResource Helix.Border}" />
                                        <Button Style="{StaticResource Helix.IconButton}" Command="{Binding NarrowerCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                ToolTip="{x:Static local:HelixDashboardTile.NarrowerText}" Focusable="True">
                                            <local:HelixIcon Icon="minus" Size="14" />
                                        </Button>
                                        <TextBlock Text="{TemplateBinding SpanText}" FontSize="12" Margin="4,0" VerticalAlignment="Center" Foreground="{DynamicResource Helix.TextMuted}" />
                                        <Button Style="{StaticResource Helix.IconButton}" Command="{Binding WiderCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                ToolTip="{x:Static local:HelixDashboardTile.WiderText}" Focusable="True">
                                            <local:HelixIcon Icon="plus" Size="14" />
                                        </Button>
                                        <Button x:Name="HideButton" Style="{StaticResource Helix.IconButton}" Command="{Binding HideCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                ToolTip="{x:Static local:HelixDashboardTile.HideText}" Focusable="True" Margin="6,0,0,0">
                                            <local:HelixIcon Icon="eye-off" Size="14" />
                                        </Button>
                                    </StackPanel>
                                    <ContentPresenter x:Name="Actions" DockPanel.Dock="Right" Content="{TemplateBinding Actions}" VerticalAlignment="Center" />
                                    <local:HelixIcon x:Name="Grip" DockPanel.Dock="Left" Icon="grip" Margin="0,0,8,0" VerticalAlignment="Center"
                                                     Foreground="{DynamicResource Helix.TextSubtle}" Visibility="Collapsed"
                                                     ToolTip="{x:Static local:HelixDashboardTile.DragText}" />
                                    <TextBlock x:Name="Title" Text="{TemplateBinding Title}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </DockPanel>
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <Border x:Name="EditRing" CornerRadius="14" BorderThickness="1.5" BorderBrush="{DynamicResource Helix.Primary}" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="CanHide" Value="False">
                            <Setter TargetName="HideButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsPlain" Value="True">
                            <Setter TargetName="Card" Property="Background" Value="Transparent" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Card" Property="Padding" Value="0" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Title" Value="{x:Null}" />
                                <Condition Property="Actions" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_Handle" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <DataTrigger Binding="{Binding IsEditing, RelativeSource={RelativeSource AncestorType={x:Type local:HelixDashboard}}}" Value="True">
                            <Setter TargetName="PART_Handle" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Handle" Property="Cursor" Value="SizeAll" />
                            <Setter TargetName="Grip" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Tools" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="EditRing" Property="Opacity" Value="0.6" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding LayoutMode, RelativeSource={RelativeSource AncestorType={x:Type local:HelixDashboard}}}" Value="Columns">
                            <Setter TargetName="ColumnLeft" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ColumnRight" Property="Visibility" Value="Visible" />
                            <Setter TargetName="BeforeIcon" Property="Icon" Value="arrow-up" />
                            <Setter TargetName="AfterIcon" Property="Icon" Value="arrow-down" />
                        </DataTrigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                            <Setter TargetName="EditRing" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== TreeView -->

    <Style x:Key="Helix.TreeToggle" TargetType="{x:Type ToggleButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6">
                        <local:HelixIcon x:Name="Chevron" Icon="chevron-right" Size="14" Foreground="{DynamicResource Helix.TextSubtle}"
                                        HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface3}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="90" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="Helix.TreeItemList" TargetType="{x:Type local:HelixTreeViewItem}">
        <StackPanel>
            <Border x:Name="Row" CornerRadius="8" Padding="4,5" Margin="0,1" Background="Transparent">
                <DockPanel Margin="{TemplateBinding Indent}">
                    <ToggleButton x:Name="Expander" DockPanel.Dock="Left" Style="{StaticResource Helix.TreeToggle}" Margin="0,0,4,0" VerticalAlignment="Top"
                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                    <ContentPresenter x:Name="PART_Header" ContentSource="Header" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
            <ItemsPresenter x:Name="ItemsHost" Visibility="Collapsed" />
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
            </Trigger>
            <Trigger Property="IsExpanded" Value="True">
                <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Helix.Surface2}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Helix.PrimarySoft}" />
                <Setter TargetName="PART_Header" Property="TextElement.FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Helix.TreeItemDiagram" TargetType="{x:Type local:HelixTreeViewItem}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top">
            <Grid x:Name="TopConnector" Height="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border x:Name="LeftLine" BorderBrush="{DynamicResource Helix.BorderStrong}" BorderThickness="0,1.5,0,0" />
                <Border x:Name="RightLine" Grid.Column="1" BorderBrush="{DynamicResource Helix.BorderStrong}" BorderThickness="0,1.5,0,0" />
                <Border Grid.ColumnSpan="2" Width="1.5" HorizontalAlignment="Center" Background="{DynamicResource Helix.BorderStrong}" />
            </Grid>
            <Border x:Name="Node" HorizontalAlignment="Center" Margin="10,0" MinWidth="150" Padding="14,10" CornerRadius="12"
                    Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1"
                    Effect="{StaticResource Helix.ShadowSm}" Cursor="Hand">
                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="Center" />
            </Border>
            <ToggleButton x:Name="Expander" Width="20" Height="20" Margin="0,-10,0,0" HorizontalAlignment="Center" Focusable="False" Cursor="Hand"
                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                        <Border Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.BorderStrong}" BorderThickness="1" CornerRadius="10">
                            <local:HelixIcon x:Name="Sign" Icon="plus" Size="11" StrokeWidth="2.6" Foreground="{DynamicResource Helix.TextMuted}"
                                            HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Sign" Property="Icon" Value="minus" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
            <StackPanel x:Name="Below" Visibility="Collapsed">
                <Border Width="1.5" Height="12" Background="{DynamicResource Helix.BorderStrong}" HorizontalAlignment="Center" />
                <ItemsPresenter />
            </StackPanel>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="Level" Value="0">
                <Setter TargetName="TopConnector" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="SiblingPosition" Value="first">
                <Setter TargetName="LeftLine" Property="BorderThickness" Value="0" />
            </Trigger>
            <Trigger Property="SiblingPosition" Value="last">
                <Setter TargetName="RightLine" Property="BorderThickness" Value="0" />
            </Trigger>
            <Trigger Property="SiblingPosition" Value="only">
                <Setter TargetName="LeftLine" Property="BorderThickness" Value="0" />
                <Setter TargetName="RightLine" Property="BorderThickness" Value="0" />
            </Trigger>
            <Trigger Property="HasItems" Value="False">
                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsExpanded" Value="True" />
                    <Condition Property="HasItems" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Below" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger SourceName="Node" Property="IsMouseOver" Value="True">
                <Setter TargetName="Node" Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Node" Property="BorderBrush" Value="{DynamicResource Helix.Primary}" />
                <Setter TargetName="Node" Property="BorderThickness" Value="2" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ItemsPanelTemplate x:Key="Helix.TreeRowPanel">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" />
    </ItemsPanelTemplate>

    <Style TargetType="{x:Type local:HelixTreeViewItem}">
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource Helix.TreeItemList}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Layout, RelativeSource={RelativeSource AncestorType={x:Type local:HelixTreeView}}}" Value="Diagram">
                <Setter Property="Template" Value="{StaticResource Helix.TreeItemDiagram}" />
                <Setter Property="ItemsPanel" Value="{StaticResource Helix.TreeRowPanel}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type local:HelixTreeView}">
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixTreeView}">
                    <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ItemsPresenter />
                    </ScrollViewer>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Layout" Value="Diagram">
                            <Setter TargetName="Scroll" Property="HorizontalScrollBarVisibility" Value="Auto" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Layout" Value="Diagram">
                <Setter Property="ItemsPanel" Value="{StaticResource Helix.TreeRowPanel}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== Carousel -->

    <Style x:Key="Helix.CarouselArrow" TargetType="{x:Type Button}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Bg" CornerRadius="18" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                            BorderThickness="1" Effect="{StaticResource Helix.ShadowSm}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type local:HelixCarousel}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <local:HelixCarouselPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixCarousel}">
                    <StackPanel>
                        <Grid>
                            <ItemsPresenter />
                            <Button x:Name="PART_Prev" Style="{StaticResource Helix.CarouselArrow}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0">
                                <local:HelixIcon Icon="chevron-left" />
                            </Button>
                            <Button x:Name="PART_Next" Style="{StaticResource Helix.CarouselArrow}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0">
                                <local:HelixIcon Icon="chevron-right" />
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                            <Button x:Name="PART_Play" Style="{StaticResource Helix.IconButton}" Margin="0,0,8,0" Visibility="Collapsed" />
                            <StackPanel x:Name="PART_Dots" Orientation="Horizontal" VerticalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowArrows" Value="False">
                            <Setter TargetName="PART_Prev" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Next" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== RadioGroup (Default, Cards, Segmented) -->

    <ControlTemplate x:Key="Helix.RadioItemDefault" TargetType="{x:Type local:HelixRadioItem}">
        <DockPanel x:Name="Root" Background="Transparent" Margin="0,0,0,12">
            <Grid DockPanel.Dock="Left" Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                <Ellipse x:Name="Halo" Margin="-3" StrokeThickness="3" Opacity="0"
                         Stroke="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" />
                <Ellipse x:Name="Circle" Fill="{DynamicResource Helix.Surface}" Stroke="{DynamicResource Helix.BorderStrong}" StrokeThickness="1.5" />
            </Grid>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <ContentPresenter RecognizesAccessKey="True" />
                <TextBlock x:Name="Description" Text="{TemplateBinding Description}" FontSize="12.5" Margin="0,2,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource Helix.TextMuted}" />
            </StackPanel>
        </DockPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="Description" Value="{x:Null}">
                <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <DataTrigger Binding="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" Value="Horizontal">
                <Setter TargetName="Root" Property="Margin" Value="0,0,24,0" />
            </DataTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Circle" Property="Stroke" Value="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Circle" Property="Stroke" Value="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" />
                <Setter TargetName="Circle" Property="StrokeThickness" Value="5.5" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Halo" Property="Opacity" Value="0.3" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Helix.RadioItemCard" TargetType="{x:Type local:HelixRadioItem}">
        <Grid x:Name="Root" Margin="0,0,12,12">
            <Border x:Name="Card" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1.5"
                    CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" />
            <Border x:Name="Tint" Opacity="0" IsHitTestVisible="False"
                    Background="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}"
                    CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" />
            <Border x:Name="Halo" Margin="-4" BorderThickness="3" Opacity="0" IsHitTestVisible="False"
                    BorderBrush="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}"
                    CornerRadius="{Binding CornerRadius, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" />
            <DockPanel Margin="16,14">
                <Grid DockPanel.Dock="Right" Width="18" Height="18" VerticalAlignment="Top" Margin="12,0,0,0">
                    <Ellipse x:Name="Circle" Fill="{DynamicResource Helix.Surface}" Stroke="{DynamicResource Helix.BorderStrong}" StrokeThickness="1.5" />
                </Grid>
                <Grid x:Name="IconBox" DockPanel.Dock="Top" Width="34" Height="34" HorizontalAlignment="Left" Margin="0,0,0,10">
                    <Border x:Name="IconBg" CornerRadius="9" Background="{DynamicResource Helix.Surface2}" />
                    <local:HelixIcon x:Name="Icon" Icon="{TemplateBinding Icon}" Size="18" Foreground="{DynamicResource Helix.TextMuted}"
                                    HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <StackPanel>
                    <ContentPresenter TextElement.FontWeight="SemiBold" RecognizesAccessKey="True" />
                    <TextBlock x:Name="Description" Text="{TemplateBinding Description}" FontSize="12.5" Margin="0,3,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource Helix.TextMuted}" />
                </StackPanel>
            </DockPanel>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="IconBox" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="Description" Value="{x:Null}">
                <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Helix.BorderStrong}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" />
                <Setter TargetName="Tint" Property="Opacity" Value="0.06" />
                <Setter TargetName="Circle" Property="Stroke" Value="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" />
                <Setter TargetName="Circle" Property="StrokeThickness" Value="5.5" />
                <Setter TargetName="Icon" Property="Foreground" Value="{Binding Accent, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Halo" Property="Opacity" Value="0.25" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="Helix.RadioItemSegment" TargetType="{x:Type local:HelixRadioItem}">
        <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="14,6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface}" />
                <Setter TargetName="Bg" Property="Effect" Value="{StaticResource Helix.ShadowSm}" />
                <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="{x:Type local:HelixRadioItem}">
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template" Value="{StaticResource Helix.RadioItemDefault}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Appearance, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" Value="Cards">
                <Setter Property="Template" Value="{StaticResource Helix.RadioItemCard}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Appearance, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" Value="Segmented">
                <Setter Property="Template" Value="{StaticResource Helix.RadioItemSegment}" />
                <Setter Property="Foreground" Value="{DynamicResource Helix.TextMuted}" />
                <Setter Property="FontWeight" Value="Medium" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <ItemsPanelTemplate x:Key="Helix.RadioPanelList">
        <StackPanel Orientation="{Binding Orientation, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Helix.RadioPanelCards">
        <UniformGrid Columns="{Binding Columns, RelativeSource={RelativeSource AncestorType={x:Type local:HelixRadioGroup}}}" Margin="0,0,-12,-12" />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="Helix.RadioPanelSegments">
        <StackPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <Style TargetType="{x:Type local:HelixRadioGroup}">
        <Setter Property="Accent" Value="{Binding ToneBrush, RelativeSource={RelativeSource Self}}" />
        <Setter Property="OnAccent" Value="{Binding AutoOnAccent, RelativeSource={RelativeSource Self}}" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ItemsPanel" Value="{StaticResource Helix.RadioPanelList}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixRadioGroup}">
                    <local:HelixField Label="{TemplateBinding Label}" Hint="{TemplateBinding Hint}">
                        <Border x:Name="Frame" HorizontalAlignment="Stretch">
                            <ItemsPresenter />
                        </Border>
                    </local:HelixField>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Appearance" Value="Segmented">
                            <Setter TargetName="Frame" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                            <Setter TargetName="Frame" Property="CornerRadius" Value="10" />
                            <Setter TargetName="Frame" Property="Padding" Value="3" />
                            <Setter TargetName="Frame" Property="HorizontalAlignment" Value="Left" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Appearance" Value="Cards">
                <Setter Property="ItemsPanel" Value="{StaticResource Helix.RadioPanelCards}" />
            </Trigger>
            <Trigger Property="Appearance" Value="Segmented">
                <Setter Property="ItemsPanel" Value="{StaticResource Helix.RadioPanelSegments}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================================================================== Dialog (shown by HelixHost) -->

    <Style TargetType="{x:Type local:HelixDialog}">
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixDialog}">
                    <Border />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Host: dialogs, confirmations, toasts -->

    <Style TargetType="{x:Type local:HelixHost}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="FontSize" Value="{DynamicResource Helix.FontSize}" />
        <Setter Property="Foreground" Value="{DynamicResource Helix.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixHost}">
                    <Grid>
                        <ContentPresenter />

                        <ItemsControl ItemsSource="{Binding Overlays, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.Resources>
                                <DataTemplate DataType="{x:Type local:HelixDialogSlot}">
                                    <Grid KeyboardNavigation.TabNavigation="Cycle">
                                        <Border Background="{DynamicResource Helix.Overlay}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding Dialog.BackdropCommand}" />
                                            </Border.InputBindings>
                                        </Border>
                                        <Border Width="{Binding Dialog.DialogWidth}" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1"
                                                CornerRadius="{Binding Dialog.CornerRadius}" Effect="{StaticResource Helix.ShadowLg}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <DockPanel Margin="24,22,18,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Helix.IconButton}" VerticalAlignment="Top"
                                                            Command="{Binding Dialog.CloseCommand}" Focusable="True"
                                                            Visibility="{Binding Dialog.ShowClose, Converter={StaticResource Helix.BoolToVisibility}}">
                                                        <local:HelixIcon Icon="x" />
                                                    </Button>
                                                    <StackPanel>
                                                        <TextBlock x:Name="Title" Text="{Binding Dialog.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="Description" Text="{Binding Dialog.Description}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource Helix.TextMuted}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <ContentPresenter Grid.Row="1" Margin="24,16,24,20" Content="{Binding Dialog.Content}" />
                                                <ContentPresenter x:Name="Footer" Grid.Row="2" Margin="24,0,24,20" HorizontalAlignment="Right" Content="{Binding Dialog.Footer}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Dialog.Title}" Value="{x:Null}">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dialog.Description}" Value="{x:Null}">
                                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dialog.Footer}" Value="{x:Null}">
                                            <Setter TargetName="Footer" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type local:HelixDrawerSlot}">
                                    <Grid KeyboardNavigation.TabNavigation="Cycle">
                                        <Border Background="{DynamicResource Helix.Overlay}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding Dialog.BackdropCommand}" />
                                            </Border.InputBindings>
                                        </Border>
                                        <Border Width="{Binding Width}" Height="{Binding Height}" HorizontalAlignment="{Binding HorizontalAlignment}"
                                                VerticalAlignment="{Binding VerticalAlignment}" Background="{DynamicResource Helix.Surface}"
                                                BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1" CornerRadius="{Binding CornerRadius}"
                                                Effect="{StaticResource Helix.ShadowLg}">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top" Margin="24,22,18,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Helix.IconButton}" VerticalAlignment="Top"
                                                            Command="{Binding Dialog.CloseCommand}" Focusable="True"
                                                            Visibility="{Binding Dialog.ShowClose, Converter={StaticResource Helix.BoolToVisibility}}">
                                                        <local:HelixIcon Icon="x" />
                                                    </Button>
                                                    <StackPanel>
                                                        <TextBlock x:Name="Title" Text="{Binding Dialog.Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="Description" Text="{Binding Dialog.Description}" Margin="0,4,0,0" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource Helix.TextMuted}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <Border x:Name="Footer" DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="0,1,0,0" Padding="24,14">
                                                    <ContentPresenter Content="{Binding Dialog.Footer}" HorizontalAlignment="Right" />
                                                </Border>
                                                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                                                    <ContentPresenter Margin="24,16,24,20" Content="{Binding Dialog.Content}" />
                                                </ScrollViewer>
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Dialog.Title}" Value="{x:Null}">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dialog.Description}" Value="{x:Null}">
                                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Dialog.Footer}" Value="{x:Null}">
                                            <Setter TargetName="Footer" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type local:HelixPromptRequest}">
                                    <Grid KeyboardNavigation.TabNavigation="Cycle">
                                        <Border Background="{DynamicResource Helix.Overlay}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding CancelCommand}" />
                                            </Border.InputBindings>
                                        </Border>
                                        <Border Width="420" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,22,24,20"
                                                Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1"
                                                CornerRadius="16" Effect="{StaticResource Helix.ShadowLg}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="Message" Text="{Binding Message}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}" />
                                                <local:HelixTextField x:Name="Input" Margin="0,16,0,0" Placeholder="{Binding Placeholder}" Error="{Binding Error}"
                                                                     Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                     FocusManager.FocusedElement="{Binding RelativeSource={RelativeSource Self}}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                                                    <local:HelixButton Variant="Ghost" Tone="Neutral" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" />
                                                    <local:HelixButton Margin="8,0,0,0" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type local:HelixViewRequest}">
                                    <Grid KeyboardNavigation.TabNavigation="Cycle">
                                        <Border Background="{DynamicResource Helix.Overlay}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding CloseCommand}" />
                                            </Border.InputBindings>
                                        </Border>
                                        <Border Width="{Binding DialogWidth}" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1"
                                                CornerRadius="16" Effect="{StaticResource Helix.ShadowLg}">
                                            <DockPanel>
                                                <DockPanel DockPanel.Dock="Top" Margin="24,22,18,0">
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Helix.IconButton}" VerticalAlignment="Top" Command="{Binding CloseCommand}" Focusable="True">
                                                        <local:HelixIcon Icon="x" />
                                                    </Button>
                                                    <StackPanel>
                                                        <TextBlock x:Name="Title" Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock x:Name="Description" Text="{Binding Description}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}" />
                                                    </StackPanel>
                                                </DockPanel>
                                                <ContentPresenter Margin="24,16,24,20" Content="{Binding View}" />
                                            </DockPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Description}" Value="{x:Null}">
                                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>

                                <DataTemplate DataType="{x:Type local:HelixConfirmRequest}">
                                    <Grid KeyboardNavigation.TabNavigation="Cycle">
                                        <Border Background="{DynamicResource Helix.Overlay}">
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick" Command="{Binding CancelCommand}" />
                                            </Border.InputBindings>
                                        </Border>
                                        <Border Width="420" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24,22,24,20"
                                                Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}" BorderThickness="1"
                                                CornerRadius="16" Effect="{StaticResource Helix.ShadowLg}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock x:Name="Message" Text="{Binding Message}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                                                    <local:HelixButton Variant="Ghost" Tone="Neutral" Content="{Binding CancelText}" Command="{Binding CancelCommand}" IsCancel="True" />
                                                    <local:HelixButton x:Name="ConfirmButton" Margin="8,0,0,0" Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}" IsDefault="True" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Message}" Value="{x:Null}">
                                            <Setter TargetName="Message" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                            <Setter TargetName="ConfirmButton" Property="Tone" Value="Danger" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.Resources>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding Toasts, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False" Width="360" Margin="20"
                                      HorizontalAlignment="{TemplateBinding ToastHorizontalAlignment}" VerticalAlignment="{TemplateBinding ToastVerticalAlignment}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:HelixToast}">
                                    <Border Margin="0,8,0,0" Padding="14,12,8,12" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                                            BorderThickness="1" CornerRadius="12" Effect="{StaticResource Helix.ShadowLg}">
                                        <DockPanel>
                                            <local:HelixIcon x:Name="Icon" DockPanel.Dock="Left" Icon="{Binding Icon}" Size="18" Margin="0,1,10,0"
                                                            VerticalAlignment="Top" Foreground="{DynamicResource Helix.Info}" />
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Helix.IconButton}" VerticalAlignment="Top" Margin="8,-3,0,0"
                                                    Command="{Binding CloseCommand}" ToolTip="{Binding CloseText}">
                                                <local:HelixIcon Icon="x" Size="14" />
                                            </Button>
                                            <StackPanel>
                                                <TextBlock x:Name="Title" Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,2" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource Helix.Text}" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{DynamicResource Helix.TextMuted}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Title}" Value="{x:Null}">
                                            <Setter TargetName="Title" Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Success">
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Helix.Success}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Helix.Warning}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Severity}" Value="Danger">
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Helix.Danger}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================================================================== Notification center -->

    <Style TargetType="{x:Type local:HelixNotificationCenter}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontFamily" Value="{DynamicResource Helix.FontFamily}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:HelixNotificationCenter}">
                    <Grid>
                        <ToggleButton x:Name="Bell" IsChecked="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Width="36" Height="36" Cursor="Hand" AutomationProperties.Name="{x:Static local:HelixNotificationCenter.NotificationsText}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="{x:Type ToggleButton}">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="8">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <Grid>
                                <local:HelixIcon Icon="bell" Size="20" Foreground="{DynamicResource Helix.TextMuted}" />
                                <Border x:Name="Count" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,-9,0" MinWidth="17" Height="17" Padding="4,0"
                                        CornerRadius="9" Background="{DynamicResource Helix.Danger}" BorderBrush="{DynamicResource Helix.Surface}" BorderThickness="2">
                                    <TextBlock Text="{TemplateBinding UnreadText}" FontSize="10" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </ToggleButton>
                        <Popup x:Name="PART_Popup" PlacementTarget="{Binding ElementName=Bell}" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
                               IsOpen="{Binding IsOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <Border Margin="12,0,12,24" Width="{TemplateBinding PanelWidth}" Background="{DynamicResource Helix.Surface}" BorderBrush="{DynamicResource Helix.Border}"
                                    BorderThickness="1" CornerRadius="10" Effect="{StaticResource Helix.ShadowLg}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="14,12">
                                        <Button x:Name="MarkAll" DockPanel.Dock="Right" Content="{x:Static local:HelixNotificationCenter.MarkAllReadText}"
                                                Command="{Binding MarkAllReadCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                Cursor="Hand" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Primary}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                        <TextBlock x:Name="TitleText" Text="{TemplateBinding Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource Helix.Text}" />
                                    </DockPanel>
                                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Helix.Border}" />
                                    <DockPanel x:Name="Foot" DockPanel.Dock="Bottom">
                                        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource Helix.Border}" />
                                        <Button Content="{x:Static local:HelixNotificationCenter.ClearAllText}" Command="{Binding ClearCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                                Cursor="Hand" HorizontalAlignment="Left" Margin="14,8" FontSize="12.5" Foreground="{DynamicResource Helix.TextMuted}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="{x:Type Button}">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DockPanel>
                                    <Grid>
                                        <StackPanel x:Name="Empty" Margin="16,36" Visibility="Collapsed" HorizontalAlignment="Center">
                                            <local:HelixIcon Icon="bell" Size="22" Foreground="{DynamicResource Helix.TextMuted}" HorizontalAlignment="Center" Margin="0,0,0,8" />
                                            <TextBlock Text="{x:Static local:HelixNotificationCenter.EmptyText}" FontSize="13" Foreground="{DynamicResource Helix.TextMuted}" />
                                        </StackPanel>
                                        <ScrollViewer x:Name="List" MaxHeight="420" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding View, RelativeSource={RelativeSource TemplatedParent}}" Margin="6,2,6,6" Focusable="False">
                                                <ItemsControl.GroupStyle>
                                                    <GroupStyle>
                                                        <GroupStyle.HeaderTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Text="{Binding Name}" Margin="8,10,8,4" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Helix.TextSubtle}" />
                                                            </DataTemplate>
                                                        </GroupStyle.HeaderTemplate>
                                                    </GroupStyle>
                                                </ItemsControl.GroupStyle>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:HelixNotification}">
                                                        <Border x:Name="Row" Padding="8,9" CornerRadius="7" Background="Transparent" Cursor="Hand">
                                                            <Border.InputBindings>
                                                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenCommand}" />
                                                            </Border.InputBindings>
                                                            <DockPanel>
                                                                <Ellipse x:Name="Dot" DockPanel.Dock="Left" Width="8" Height="8" Margin="0,6,10,0" VerticalAlignment="Top" Fill="{DynamicResource Helix.Info}" />
                                                                <Button x:Name="Dismiss" DockPanel.Dock="Right" Style="{StaticResource Helix.IconButton}" VerticalAlignment="Top" Margin="6,-2,0,0"
                                                                        Command="{Binding DismissCommand}" ToolTip="{x:Static local:HelixNotificationCenter.DismissText}" Visibility="Hidden">
                                                                    <local:HelixIcon Icon="x" Size="14" />
                                                                </Button>
                                                                <StackPanel>
                                                                    <TextBlock x:Name="ItemTitle" Text="{Binding Title}" FontSize="13.5" TextWrapping="Wrap" Foreground="{DynamicResource Helix.Text}" />
                                                                    <TextBlock x:Name="ItemText" Text="{Binding Text}" FontSize="12.5" TextWrapping="Wrap" Margin="0,2,0,0" Foreground="{DynamicResource Helix.TextMuted}" />
                                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                        <TextBlock Text="{Binding TimeText}" FontSize="11.5" Foreground="{DynamicResource Helix.TextSubtle}" />
                                                                        <TextBlock x:Name="Action" Text="{Binding ActionText, StringFormat='  ·  {0}'}" FontSize="11.5" FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource Helix.Primary}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </DockPanel>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="False">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Helix.PrimarySoft}" />
                                                                <Setter TargetName="ItemTitle" Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsRead}" Value="True">
                                                                <Setter TargetName="Dot" Property="Opacity" Value="0.45" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasText}" Value="False">
                                                                <Setter TargetName="ItemText" Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasAction}" Value="False">
                                                                <Setter TargetName="Action" Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Helix.Success}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Helix.Warning}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Severity}" Value="Danger">
                                                                <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Helix.Danger}" />
                                                            </DataTrigger>
                                                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Helix.Surface2}" />
                                                                <Setter TargetName="Dismiss" Property="Visibility" Value="Visible" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Grid>
                                </DockPanel>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Title" Value="{x:Null}">
                            <Setter TargetName="TitleText" Property="Text" Value="{x:Static local:HelixNotificationCenter.NotificationsText}" />
                        </Trigger>
                        <Trigger Property="UnreadCount" Value="0">
                            <Setter TargetName="Count" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="MarkAll" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Empty" Property="Visibility" Value="Visible" />
                            <Setter TargetName="List" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Foot" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsOpen" Value="True">
                            <!-- the popup closes on the outside click; that same click must not reopen it -->
                            <Setter TargetName="Bell" Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
