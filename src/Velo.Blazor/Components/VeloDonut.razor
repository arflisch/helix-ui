@namespace Velo.Blazor
@inherits VeloComponentBase
@using System.Globalization

@{
    var parts = Parts();
    var total = parts.Sum(p => p.Value);
    var active = _active is { } a && a < parts.Count ? parts[a] : null;
}

<div @attributes="Attributes" class="@(new CssBuilder("velo-donut").Add($"velo-donut--{Shape.Css()}").Add(Class).Build())"
     style="@(new StyleBuilder().Var("--velo-donut-size", Size).Raw(Style).Build())">
    @if (!string.IsNullOrEmpty(Title) || ShowTableToggle)
    {
        <div class="velo-chart__header">
            <div class="velo-chart__titles">
                @if (!string.IsNullOrEmpty(Title)) { <h3 class="velo-chart__title">@Title</h3> }
                @if (!string.IsNullOrEmpty(Subtitle)) { <p class="velo-chart__subtitle">@Subtitle</p> }
            </div>
            @if (ShowTableToggle)
            {
                <div class="velo-chart__actions">
                    <VeloButton Variant="VeloVariant.Ghost" Color="neutral" Size="VeloSize.Sm" aria-pressed="@(_table ? "true" : "false")"
                                OnClick="() => _table = !_table">@(_table ? "Graphique" : "Tableau")</VeloButton>
                </div>
            }
        </div>
    }

    @if (total <= 0)
    {
        <p class="velo-chart__empty">@EmptyText</p>
    }
    else if (_table)
    {
        <div class="velo-chart__table-wrap">
            <table class="velo-chart__table">
                <thead><tr><th scope="col">@(LabelHeader ?? "Catégorie")</th><th scope="col" class="is-end">Valeur</th><th scope="col" class="is-end">Part</th></tr></thead>
                <tbody>
                    @foreach (var part in parts)
                    {
                        <tr><th scope="row">@part.Label</th><td class="is-end">@FormatValue(part.Value)</td><td class="is-end">@FormatPct(part.Value / total)</td></tr>
                    }
                </tbody>
                <tfoot><tr><th scope="row">Total</th><td class="is-end">@FormatValue(total)</td><td class="is-end">100 %</td></tr></tfoot>
            </table>
        </div>
    }
    else if (Shape == VeloPartShape.SegmentedBar)
    {
        <div class="velo-donut__bar" role="img" aria-label="@Describe(parts, total)">
            @for (var i = 0; i < parts.Count; i++)
            {
                var index = i;
                var part = parts[i];
                var share = part.Value / total;
                <span class="@(new CssBuilder("velo-donut__block").Add("is-dim", _active is not null && _active != index).Build())"
                      style="flex-grow:@Inv(part.Value);--_s:@part.Color"
                      title="@($"{part.Label} · {FormatValue(part.Value)} · {FormatPct(share)}")"
                      @onmouseenter="() => _active = index" @onmouseleave="() => _active = null">
                    @if (share >= 0.1)
                    {
                        <span class="velo-donut__block-text">@FormatPct(share)</span>
                    }
                </span>
            }
        </div>
        @Legend(parts, total, withFigures: false)
    }
    else
    {
        <div class="velo-donut__body">
            <div class="velo-donut__ring">
                <svg viewBox="0 0 100 100" role="img" aria-label="@Describe(parts, total)">
                    <circle class="velo-donut__track" cx="50" cy="50" r="40" style="stroke-width:@Inv(Thickness)" />
                    @{
                        var offset = 0d;
                        var gap = parts.Count > 1 ? 0.8 : 0; // surface gap between segments, in % of the circle
                    }
                    @for (var i = 0; i < parts.Count; i++)
                    {
                        var index = i;
                        var part = parts[i];
                        var length = part.Value / total * 100;
                        <circle class="@(new CssBuilder("velo-donut__segment").Add("is-active", _active == index).Add("is-dim", _active is not null && _active != index).Build())"
                                cx="50" cy="50" r="40" pathLength="100"
                                style="--_s:@part.Color;stroke-width:@Inv(Thickness);stroke-dasharray:@Inv(Math.Max(length - gap, 0.1)) @Inv(100 - Math.Max(length - gap, 0.1));stroke-dashoffset:@Inv(-offset)"
                                @onmouseenter="() => _active = index" @onmouseleave="() => _active = null" @onclick="() => OnItemClick.InvokeAsync(part.Source)" />
                        offset += length;
                    }
                </svg>
                <div class="velo-donut__center" aria-hidden="true">
                    @if (active is not null)
                    {
                        <span class="velo-donut__center-value">@FormatPct(active.Value / total)</span>
                        <span class="velo-donut__center-label">@active.Label</span>
                        <span class="velo-donut__center-sub">@FormatValue(active.Value)</span>
                    }
                    else
                    {
                        <span class="velo-donut__center-value">@FormatValue(total)</span>
                        <span class="velo-donut__center-label">@CenterLabel</span>
                    }
                </div>
            </div>
            @Legend(parts, total, withFigures: true)
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IEnumerable<VeloPart> Items { get; set; } = [];
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public VeloPartShape Shape { get; set; } = VeloPartShape.Donut;

    /// <summary>Beyond this, the smallest parts are grouped into "Autres" (6 max: more becomes unreadable).</summary>
    [Parameter] public int MaxParts { get; set; } = 6;
    [Parameter] public string OtherLabel { get; set; } = "Autres";

    /// <summary>Largest first (true).</summary>
    [Parameter] public bool Sort { get; set; } = true;
    [Parameter] public string CenterLabel { get; set; } = "Total";
    [Parameter] public string? Unit { get; set; }
    [Parameter] public string ValueFormat { get; set; } = "#,0.##";
    [Parameter] public string? LabelHeader { get; set; }

    /// <summary>Ring width (in % of the diameter, 12 by default).</summary>
    [Parameter] public double Thickness { get; set; } = 12;

    /// <summary>Ring diameter, e.g. "200px".</summary>
    [Parameter] public string? Size { get; set; }
    [Parameter] public bool ShowTableToggle { get; set; } = true;
    [Parameter] public string EmptyText { get; set; } = "Aucune donnée";
    [Parameter] public EventCallback<VeloPart> OnItemClick { get; set; }
    [Parameter] public CultureInfo? Culture { get; set; }

    private int? _active;
    private bool _table;

    private CultureInfo EffectiveCulture => Culture ?? CultureInfo.CurrentCulture;

    private sealed record Part(string Label, double Value, string Color, VeloPart Source);

    private List<Part> Parts()
    {
        var items = Items.Where(i => i.Value > 0).ToList();
        if (Sort)
        {
            items = items.OrderByDescending(i => i.Value).ToList();
        }

        var max = Math.Clamp(MaxParts, 2, 8);
        if (items.Count > max)
        {
            var rest = items.Skip(max - 1).ToList();
            items = items.Take(max - 1).Append(new VeloPart(OtherLabel, rest.Sum(r => r.Value), "var(--velo-text-subtle)")).ToList();
        }

        // Colors follow the fixed series order; an explicit color wins.
        return items.Select((item, i) => new Part(item.Label, item.Value,
            item.Color is { } c ? VeloColor.Resolve(c).Value : $"var(--velo-series-{i + 1})", item)).ToList();
    }

    private RenderFragment Legend(List<Part> parts, double total, bool withFigures) => __builder =>
    {
        <ul class="@(new CssBuilder("velo-donut__legend").Add("is-compact", !withFigures).Build())">
            @for (var i = 0; i < parts.Count; i++)
            {
                var index = i;
                var part = parts[i];
                <li>
                    <button type="button" class="@(new CssBuilder("velo-donut__legend-item").Add("is-active", _active == index).Build())"
                            @onmouseenter="() => _active = index" @onmouseleave="() => _active = null"
                            @onfocus="() => _active = index" @onblur="() => _active = null"
                            @onclick="() => OnItemClick.InvokeAsync(part.Source)">
                        <span class="velo-donut__key" style="--_s:@part.Color"></span>
                        <span class="velo-donut__legend-label">@part.Label</span>
                        @if (withFigures)
                        {
                            <span class="velo-donut__legend-value">@FormatValue(part.Value)</span>
                            <span class="velo-donut__legend-pct">@FormatPct(part.Value / total)</span>
                        }
                    </button>
                </li>
            }
        </ul>
    };

    private string Describe(List<Part> parts, double total) =>
        $"{Title ?? "Répartition"} : " + string.Join(", ", parts.Select(p => $"{p.Label} {FormatPct(p.Value / total)}"));

    private string FormatValue(double value) =>
        value.ToString(ValueFormat, EffectiveCulture) + (string.IsNullOrEmpty(Unit) ? "" : $" {Unit}");

    /// <summary>"42 %", or one decimal under 10 % ("4,5 %") where the difference matters.</summary>
    private string FormatPct(double share) => (share * 100).ToString(share < 0.1 ? "0.#" : "0", EffectiveCulture) + " %";

    private static string Inv(double value) => value.ToString("0.###", CultureInfo.InvariantCulture);
}
