@namespace Velo.Blazor
@inherits VeloComponentBase
@implements IDisposable

@{
    var index = Carousel?.IndexOf(this) ?? 0;
}

<div @attributes="Attributes" class="@(new CssBuilder("velo-carousel__slide").Add(Class).Build())" style="@Style"
     role="group" aria-roledescription="@Texts.SlideRole" aria-label="@AriaLabelText(index)">
    @ChildContent
</div>

@code {
    [CascadingParameter] private VeloCarousel? Carousel { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Name read by screen readers ("2 of 5: Lyon plant").</summary>
    [Parameter] public string? Label { get; set; }

    private string AriaLabelText(int index)
    {
        var position = VeloTexts.Format(Texts.PositionOf, index + 1, Carousel?.Count);
        return string.IsNullOrEmpty(Label) ? position : $"{position}: {Label}";
    }

    protected override void OnInitialized()
    {
        if (Carousel is null)
        {
            throw new InvalidOperationException($"{nameof(VeloCarouselSlide)} must be placed inside a {nameof(VeloCarousel)}.");
        }

        Carousel.Add(this);
    }

    public void Dispose() => Carousel?.Remove(this);
}
