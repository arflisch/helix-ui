@namespace Velo.Blazor
@inherits VeloComponentBase

<label class="@ClassValue" style="@StyleValue">
    <input @attributes="Attributes"
           type="checkbox"
           role="switch"
           class="velo-sr-input velo-switch__input"
           checked="@Checked"
           disabled="@Disabled"
           aria-checked="@(Checked ? "true" : "false")"
           @onchange="OnChange" />
    <span class="velo-switch__track"><span class="velo-switch__thumb"></span></span>
    @if (!string.IsNullOrEmpty(Label) || ChildContent is not null)
    {
        <span class="velo-switch__label">@Label@ChildContent</span>
    }
</label>

@code {
    [Parameter] public bool Checked { get; set; }
    [Parameter] public EventCallback<bool> CheckedChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public VeloSize Size { get; set; } = VeloSize.Md;

    /// <summary>Track color when ON. Semantic name or any CSS color.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>Track color when OFF.</summary>
    [Parameter] public string? TrackColor { get; set; }

    /// <summary>Color of the thumb (the knob).</summary>
    [Parameter] public string? ThumbColor { get; set; }

    /// <summary>Color of the thumb when ON (defaults to <see cref="ThumbColor"/>).</summary>
    [Parameter] public string? ThumbOnColor { get; set; }

    /// <summary>Corner radius of track and thumb, e.g. "6px" for a square switch.</summary>
    [Parameter] public string? Radius { get; set; }

    private string ClassValue => new CssBuilder("velo-switch")
        .Add($"velo-switch--{Size.Css()}")
        .Add("is-checked", Checked)
        .Add("is-disabled", Disabled)
        .Add(Class)
        .Build();

    private string? StyleValue => new StyleBuilder()
        .Color("switch", Color)
        .Var("--velo-switch-track", TrackColor)
        .Var("--velo-switch-thumb", ThumbColor)
        .Var("--velo-switch-thumb-on", ThumbOnColor)
        .Var("--velo-switch-radius", Radius)
        .Raw(Style)
        .Build();

    private Task OnChange(ChangeEventArgs e)
    {
        Checked = e.Value is true;
        return CheckedChanged.InvokeAsync(Checked);
    }
}
