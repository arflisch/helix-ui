@namespace Velo.Blazor
@implements IDisposable
@inject VeloToastService Toasts

<div class="velo-toasts velo-toasts--@Position.Css()" role="region" aria-live="polite" aria-label="Notifications">
    @foreach (var toast in Toasts.Toasts)
    {
        var color = VeloColor.FromSeverity(toast.Severity);
        <div @key="toast.Id" class="velo-toast" style="@ToastStyle(toast, color)">
            <span class="velo-toast__icon"><VeloIcon Name="@color" Size="18" /></span>
            <div class="velo-toast__content">
                @if (!string.IsNullOrEmpty(toast.Title))
                {
                    <p class="velo-toast__title">@toast.Title</p>
                }
                <p class="velo-toast__message">@toast.Message</p>
            </div>
            <button type="button" class="velo-close" aria-label="Fermer" @onclick="() => Toasts.Dismiss(toast.Id)">
                <VeloIcon Name="x" Size="14" />
            </button>
            @if (toast.Duration > TimeSpan.Zero)
            {
                <span class="velo-toast__progress"></span>
            }
        </div>
    }
</div>

@code {
    [Parameter] public VeloToastPosition Position { get; set; } = VeloToastPosition.BottomRight;

    protected override void OnInitialized() => Toasts.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private static string? ToastStyle(VeloToast toast, string color) => new StyleBuilder()
        .Color("toast", color)
        .Var("--velo-toast-duration", $"{toast.Duration.TotalMilliseconds:0}ms")
        .Build();

    public void Dispose() => Toasts.Changed -= OnChanged;
}
