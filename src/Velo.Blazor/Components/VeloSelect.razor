@namespace Velo.Blazor
@inherits VeloComponentBase
@typeparam TValue

<VeloFieldFrame Id="@_id" Label="@Label" Hint="@Hint" Error="@Error" Required="Required" Disabled="Disabled" Class="@Class" Style="@FieldStyle">
    <div class="@(new CssBuilder("velo-select").Add("is-open", _open).Build())">
        <button @attributes="Attributes"
                id="@_id"
                type="button"
                class="velo-input velo-select__trigger"
                disabled="@Disabled"
                aria-haspopup="listbox"
                aria-expanded="@(_open ? "true" : "false")"
                aria-invalid="@(string.IsNullOrEmpty(Error) ? null : "true")"
                aria-describedby="@VeloFieldFrame.DescribedBy(_id, Hint, Error)"
                @onclick="Toggle"
                @onkeydown="OnKeyDown"
                @onkeydown:preventDefault="_open">
            @Prefix
            <span class="@(new CssBuilder("velo-select__value").Add("is-placeholder", !HasValue).Build())">
                @(HasValue ? TextOf(Value!) : Placeholder ?? Texts.SelectPlaceholder)
            </span>
            @Suffix
            <VeloIcon Name="chevron-down" Class="velo-select__chevron" />
        </button>

        @if (_open)
        {
            <div class="velo-select__backdrop" @onclick="Close"></div>
            <ul class="velo-select__menu" role="listbox">
                @for (var i = 0; i < _items.Count; i++)
                {
                    var index = i;
                    var item = _items[i];
                    var selected = IsSelected(item);
                    <li role="option"
                        aria-selected="@(selected ? "true" : "false")"
                        class="@(new CssBuilder("velo-select__option").Add("is-selected", selected).Add("is-active", index == _active).Build())"
                        @onclick="() => Select(item)"
                        @onmouseenter="() => _active = index">
                        <span>@TextOf(item)</span>
                        @if (selected)
                        {
                            <VeloIcon Name="check" Size="15" />
                        }
                    </li>
                }
            </ul>
        }
    </div>
</VeloFieldFrame>

@code {
    /// <summary>Content at the start of the input (icon, sign, currency…).</summary>
    [Parameter] public RenderFragment? Prefix { get; set; }

    /// <summary>Content at the end of the input (unit, button…).</summary>
    [Parameter] public RenderFragment? Suffix { get; set; }

    /// <summary>Help text under the field, announced with it.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Shows the field in error state with this message (replaces the hint).</summary>
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Required { get; set; }

    /// <summary>Focus color. Null: VeloOptions.Defaults.Field.Color, else primary.</summary>
    [Parameter] public string? Color { get; set; }
    [Parameter] public string? Radius { get; set; }
    [Parameter] public string? Background { get; set; }
    [Parameter] public string? BorderColor { get; set; }

    private string? FieldStyle => new StyleBuilder()
        .Color("input", Color)
        .Var("--velo-input-radius", Radius)
        .Var("--velo-input-bg", Background)
        .Var("--velo-input-border", BorderColor)
        .Raw(Style)
        .Build();

    [Parameter, EditorRequired] public IEnumerable<TValue> Items { get; set; } = [];
    [Parameter] public TValue? Value { get; set; }
    [Parameter] public EventCallback<TValue?> ValueChanged { get; set; }

    /// <summary>How an item is displayed. Defaults to ToString().</summary>
    [Parameter] public Func<TValue, string>? ItemText { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Disabled { get; set; }

    private readonly string _id = VeloId.Next("select");
    private List<TValue> _items = [];
    private bool _open;
    private int _active = -1;

    private bool HasValue => Value is not null && _items.Any(IsSelected);

    protected override void OnParametersSet() => _items = Items.ToList();

    private string TextOf(TValue item) => ItemText?.Invoke(item) ?? item?.ToString() ?? "";

    private bool IsSelected(TValue item) => EqualityComparer<TValue>.Default.Equals(item, Value);

    private void Toggle()
    {
        if (_open)
        {
            Close();
        }
        else
        {
            Open();
        }
    }

    private void Open()
    {
        _open = true;
        _active = _items.FindIndex(i => IsSelected(i));
    }

    private void Close() => _open = false;

    private async Task Select(TValue item)
    {
        Value = item;
        _open = false;
        await ValueChanged.InvokeAsync(item);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!_open)
        {
            if (e.Key is "ArrowDown" or "ArrowUp")
            {
                Open();
            }

            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                _active = Math.Min(_active + 1, _items.Count - 1);
                break;
            case "ArrowUp":
                _active = Math.Max(_active - 1, 0);
                break;
            case "Enter" or " " when _active >= 0:
                await Select(_items[_active]);
                break;
            case "Escape" or "Tab":
                Close();
                break;
        }
    }
}
