@namespace Velo.Blazor
@inherits VeloComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

<div @attributes="Attributes" class="@(new CssBuilder("velo-menu").Add("is-open", _open).Add(Class).Build())" style="@Style">
    <div class="velo-menu__trigger" @ref="_trigger" @onclick="Toggle">@Trigger</div>
    @if (_open)
    {
        <div class="velo-select__backdrop" @onclick="() => Close(returnFocus: false)"></div>
        <div @ref="_list" class="velo-menu__list velo-menu__list--@Align.Css()" role="menu" style="@(MinWidth is null ? null : $"min-width:{MinWidth}")"
             @onkeydown="OnKey">
            <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
        </div>
    }
</div>

@code {
    /// <summary>What opens the menu, usually a VeloButton.</summary>
    [Parameter, EditorRequired] public RenderFragment? Trigger { get; set; }

    /// <summary>VeloMenuItem, VeloMenuSeparator, VeloMenuLabel.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Start: aligned on the left edge of the trigger; End: on the right edge.</summary>
    [Parameter] public VeloAlign Align { get; set; } = VeloAlign.Start;
    [Parameter] public string? MinWidth { get; set; }

    private bool _open;
    private bool _justOpened;
    private bool _focusTrigger;
    private ElementReference _trigger;
    private ElementReference _list;
    private IJSObjectReference? _module;

    private void Toggle()
    {
        _open = !_open;
        _justOpened = _open;
    }

    /// <summary>Closes the menu; by default focus goes back to the trigger (keyboard users stay in place).</summary>
    public void Close(bool returnFocus = true)
    {
        if (!_open)
        {
            return;
        }

        _open = false;
        _focusTrigger = returnFocus;
        StateHasChanged();
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key is "Escape" or "Tab")
        {
            Close(returnFocus: e.Key == "Escape");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_justOpened && !_focusTrigger)
        {
            return;
        }

        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", VeloJs.Path);
            if (_justOpened)
            {
                _justOpened = false;
                await _module.InvokeVoidAsync("menuOpen", _list);
            }

            if (_focusTrigger)
            {
                _focusTrigger = false;
                await _module.InvokeVoidAsync("focusFirst", _trigger);
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit closed while the menu was open.
        }
    }

    public ValueTask DisposeAsync() => VeloJs.DisposeQuietlyAsync(_module);
}
