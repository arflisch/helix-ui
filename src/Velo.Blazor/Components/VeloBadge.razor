@namespace Velo.Blazor
@inherits VeloComponentBase

<span @attributes="Attributes" class="@ClassValue" style="@StyleValue">
    @if (Dot)
    {
        <span class="velo-badge__dot"></span>
    }
    else if (!string.IsNullOrEmpty(Icon))
    {
        <VeloIcon Name="@Icon" Size="12" />
    }
    @ChildContent
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    /// <summary>Null: VeloOptions.Defaults.Badge.Variant, else Soft.</summary>
    [Parameter] public VeloBadgeVariant? Variant { get; set; }

    /// <summary>Semantic name or any CSS color. Neutral by default.</summary>
    [Parameter] public string? Color { get; set; }

    [Parameter] public bool Dot { get; set; }
    [Parameter] public string? Icon { get; set; }

    /// <summary>Square corners instead of a pill.</summary>
    [Parameter] public bool Square { get; set; }

    private string ClassValue => new CssBuilder("velo-badge")
        .Add($"velo-badge--{(Variant ?? Defaults.Badge.Variant ?? VeloBadgeVariant.Soft).Css()}")
        .Add("velo-badge--square", Square)
        .Add(Class)
        .Build();

    private string? StyleValue => new StyleBuilder().Color("badge", Color).Raw(Style).Build();
}
