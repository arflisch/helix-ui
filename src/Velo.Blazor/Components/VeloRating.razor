@namespace Velo.Blazor
@inherits VeloComponentBase
@using System.Globalization

@{
    var shown = _hover ?? Value;
}

<div @attributes="Attributes"
     class="@(new CssBuilder("velo-rating").Add($"velo-rating--{Size.Css()}").Add("is-readonly", ReadOnly).Add("is-disabled", Disabled).Add(Class).Build())"
     style="@(new StyleBuilder().Color("rating", Color).Raw(Style).Build())"
     role="@(ReadOnly ? "img" : "radiogroup")"
     aria-label="@(ReadOnly ? $"{Label ?? "Note"} : {Value.ToString("0.#", EffectiveCulture)} sur {Max}" : Label ?? "Note")"
     @onmouseleave="() => _hover = null">
    @for (var i = 1; i <= Max; i++)
    {
        var index = i;
        var fill = Math.Clamp(shown - (index - 1), 0, 1) * 100;
        var title = Labels is { } labels && labels.Count >= index ? labels[index - 1] : null;
        if (ReadOnly)
        {
            <span class="velo-rating__item" aria-hidden="true">@Icon(fill)</span>
        }
        else
        {
            <label class="velo-rating__item" title="@title" @onmouseenter="() => _hover = index">
                <input type="radio" class="velo-sr-input velo-rating__input" name="@_name" checked="@(Value == index)" disabled="@Disabled"
                       aria-label="@(title ?? $"{index} sur {Max}")"
                       @onchange="() => Set(index)" @onclick="() => ClearIfSame(index)" />
                @Icon(fill)
            </label>
        }
    }
    @if (ShowValue)
    {
        <span class="velo-rating__value">@(shown > 0 ? shown.ToString("0.#", EffectiveCulture) : "—")</span>
    }
    @if (!ReadOnly && _hover is { } h && Labels is { } texts && texts.Count >= h)
    {
        <span class="velo-rating__hint">@texts[(int)h - 1]</span>
    }
    else if (Count is { } count)
    {
        <span class="velo-rating__count">(@count.ToString("N0", EffectiveCulture) avis)</span>
    }
</div>

@code {
    /// <summary>Current value (0 = none). Read-only ratings may be fractional, e.g. an average of 4.3.</summary>
    [Parameter] public double Value { get; set; }
    [Parameter] public EventCallback<double> ValueChanged { get; set; }
    [Parameter] public int Max { get; set; } = 5;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }

    /// <summary>Clicking the current value again resets to 0.</summary>
    [Parameter] public bool AllowClear { get; set; } = true;

    /// <summary>"star" or "heart".</summary>
    [Parameter] public string Shape { get; set; } = "star";
    [Parameter] public VeloSize Size { get; set; } = VeloSize.Md;

    /// <summary>Default amber; semantic name or any CSS color.</summary>
    [Parameter] public string? Color { get; set; }

    /// <summary>One label per value, shown on hover and read by screen readers, e.g. "Mauvais" … "Excellent".</summary>
    [Parameter] public IReadOnlyList<string>? Labels { get; set; }
    [Parameter] public bool ShowValue { get; set; }

    /// <summary>Number of reviews shown next to the value.</summary>
    [Parameter] public int? Count { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public CultureInfo? Culture { get; set; }

    private readonly string _name = VeloId.Next("rating");
    private double? _hover;

    private CultureInfo EffectiveCulture => Culture ?? CultureInfo.CurrentCulture;

    private const string StarPath = "M12 2.8l2.8 5.8 6.3.9-4.6 4.4 1.1 6.3L12 17.2l-5.6 3 1.1-6.3L2.9 9.5l6.3-.9z";
    private const string HeartPath = "M12 21s-7.5-4.6-9.6-9.4C1 8.3 3 4.8 6.6 4.8c2.1 0 3.6 1.1 5.4 3 1.8-1.9 3.3-3 5.4-3 3.6 0 5.6 3.5 4.2 6.8C19.5 16.4 12 21 12 21z";

    private RenderFragment Icon(double fillPercent) => __builder =>
    {
        var path = Shape == "heart" ? HeartPath : StarPath;
        <span class="velo-rating__icon">
            <svg viewBox="0 0 24 24" class="velo-rating__empty"><path d="@path" /></svg>
            <span class="velo-rating__fill" style="width:@VeloScale.Pct(fillPercent)">
                <svg viewBox="0 0 24 24"><path d="@path" /></svg>
            </span>
        </span>
    };

    private Task Set(double value)
    {
        Value = value;
        return ValueChanged.InvokeAsync(value);
    }

    private Task ClearIfSame(int index) => AllowClear && Value == index ? Set(0) : Task.CompletedTask;
}
