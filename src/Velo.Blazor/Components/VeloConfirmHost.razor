@namespace Velo.Blazor
@inherits VeloComponentBase
@implements IDisposable
@inject VeloConfirmService Confirm

@{
    var current = Confirm.Current;
}

<VeloDialog Open="current is not null" OpenChanged="OnOpenChanged" Title="@current?.Title" Width="420px" Class="velo-confirm">
    <ChildContent>
        @if (!string.IsNullOrEmpty(current?.Message))
        {
            @current.Message
        }
    </ChildContent>
    <Footer>
        <VeloButton Variant="VeloVariant.Ghost" Color="neutral" OnClick="() => Confirm.Resolve(false)">@(current?.CancelText ?? Texts.Cancel)</VeloButton>
        <VeloButton Color="@(current?.Danger == true ? "danger" : null)" OnClick="() => Confirm.Resolve(true)">@(current?.ConfirmText ?? Texts.Confirm)</VeloButton>
    </Footer>
</VeloDialog>

@code {
    protected override void OnInitialized() => Confirm.Changed += OnChanged;

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnOpenChanged(bool open)
    {
        if (!open)
        {
            Confirm.Resolve(false);
        }
    }

    public void Dispose() => Confirm.Changed -= OnChanged;
}
