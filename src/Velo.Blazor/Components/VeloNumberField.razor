@namespace Velo.Blazor
@inherits VeloComponentBase
@using System.Globalization

<VeloFieldFrame Id="@_id" Label="@Label" Hint="@Hint" Error="@Error" Required="Required" Disabled="Disabled" Class="@Class" Style="@FieldStyle">
    <div class="velo-input velo-number">
        @if (Steppers)
        {
            <button type="button" class="velo-number__step" tabindex="-1" aria-label="@Texts.Decrease" disabled="@(Disabled || AtMin)" @onclick="() => StepBy(-1)">
                <VeloIcon Name="minus" Size="14" />
            </button>
        }
        @Prefix
        <input @attributes="Attributes"
               id="@_id"
               type="number"
               inputmode="decimal"
               class="velo-input__control velo-number__control"
               value="@Raw"
               min="@Inv(Min)"
               max="@Inv(Max)"
               step="@Inv(Step)"
               placeholder="@Placeholder"
               disabled="@Disabled"
               required="@Required"
               aria-invalid="@(string.IsNullOrEmpty(Error) ? null : "true")"
               aria-describedby="@VeloFieldFrame.DescribedBy(_id, Hint, Error)"
               @onchange="OnChange" />
        @if (!string.IsNullOrEmpty(Unit))
        {
            <span class="velo-input__affix velo-number__unit">@Unit</span>
        }
        @Suffix
        @if (Steppers)
        {
            <button type="button" class="velo-number__step" tabindex="-1" aria-label="@Texts.Increase" disabled="@(Disabled || AtMax)" @onclick="() => StepBy(1)">
                <VeloIcon Name="plus" Size="14" />
            </button>
        }
    </div>
</VeloFieldFrame>

@code {
    /// <summary>Content at the start of the input (icon, sign, currency…).</summary>
    [Parameter] public RenderFragment? Prefix { get; set; }

    /// <summary>Content at the end of the input (unit, button…).</summary>
    [Parameter] public RenderFragment? Suffix { get; set; }

    /// <summary>Help text under the field, announced with it.</summary>
    [Parameter] public string? Hint { get; set; }

    /// <summary>Shows the field in error state with this message (replaces the hint).</summary>
    [Parameter] public string? Error { get; set; }
    [Parameter] public bool Required { get; set; }

    /// <summary>Focus color. Null: VeloOptions.Defaults.Field.Color, else primary.</summary>
    [Parameter] public string? Color { get; set; }
    [Parameter] public string? Radius { get; set; }
    [Parameter] public string? Background { get; set; }
    [Parameter] public string? BorderColor { get; set; }

    private string? FieldStyle => new StyleBuilder()
        .Color("input", Color)
        .Var("--velo-input-radius", Radius)
        .Var("--velo-input-bg", Background)
        .Var("--velo-input-border", BorderColor)
        .Raw(Style)
        .Build();

    [Parameter] public double? Value { get; set; }
    [Parameter] public EventCallback<double?> ValueChanged { get; set; }
    [Parameter] public double? Min { get; set; }
    [Parameter] public double? Max { get; set; }

    /// <summary>Increment of the − / + buttons and arrow keys.</summary>
    [Parameter] public double Step { get; set; } = 1;

    /// <summary>Decimals kept (rounding), e.g. 0 for whole numbers.</summary>
    [Parameter] public int? Decimals { get; set; }

    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Unit { get; set; }

    [Parameter] public string? Placeholder { get; set; }
    /// <summary>The − / + buttons. Null: VeloOptions.Defaults.Field.ShowSteppers, else true.</summary>
    [Parameter] public bool? ShowSteppers { get; set; }

    private bool Steppers => ShowSteppers ?? Defaults.Field.ShowSteppers ?? true;
    [Parameter] public bool Disabled { get; set; }

    private readonly string _id = VeloId.Next("number");

    private bool AtMin => Min is { } min && Value is { } v && v <= min;
    private bool AtMax => Max is { } max && Value is { } v && v >= max;

    private string? Raw => Value?.ToString(CultureInfo.InvariantCulture);


    private static string? Inv(double? value) => value?.ToString(CultureInfo.InvariantCulture);

    private double Normalize(double value)
    {
        if (Min is { } min) value = Math.Max(min, value);
        if (Max is { } max) value = Math.Min(max, value);
        return Decimals is { } d ? Math.Round(value, d) : value;
    }

    private Task Set(double? value)
    {
        Value = value is { } v ? Normalize(v) : null;
        return ValueChanged.InvokeAsync(Value);
    }

    private Task StepBy(int direction) => Set((Value ?? Min ?? 0) + direction * Step);

    private Task OnChange(ChangeEventArgs e)
    {
        var text = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(text))
        {
            return Set(null);
        }

        // type=number always reports an invariant number ("12.5"), whatever the culture.
        return double.TryParse(text, NumberStyles.Float, CultureInfo.InvariantCulture, out var value)
            ? Set(value)
            : Task.CompletedTask;
    }
}
