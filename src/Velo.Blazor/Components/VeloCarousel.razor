@namespace Velo.Blazor
@inherits VeloComponentBase
@implements IAsyncDisposable
@inject IJSRuntime JS

@{
    var count = _slides.Count;
    var lastStart = Math.Max(0, count - Math.Max(1, SlidesPerView));
}

<section @attributes="Attributes" class="@(new CssBuilder("velo-carousel").Add(Class).Build())"
         style="@(new StyleBuilder().Var("--_per", Math.Max(1, SlidesPerView).ToString()).Var("--_gap", Gap).Var("--velo-carousel-height", Height).Raw(Style).Build())"
         aria-roledescription="@Texts.CarouselRole" aria-label="@(AriaLabel ?? Texts.Carousel)"
         @onmouseenter="() => _hovered = true" @onmouseleave="() => _hovered = false"
         @onfocusin="() => _focused = true" @onfocusout="() => _focused = false">
    <div class="velo-carousel__viewport">
        <div class="velo-carousel__track" @ref="_track" tabindex="0" aria-live="@(IsPlaying ? "off" : "polite")">
            <CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue>
        </div>
        @if (ShowArrows && count > SlidesPerView)
        {
            <button type="button" class="velo-carousel__arrow is-prev" aria-label="@Texts.PreviousSlide"
                    disabled="@(!Loop && _index == 0)" @onclick="() => GoTo(_index == 0 ? lastStart : _index - 1)">
                <VeloIcon Name="chevron-left" Size="18" />
            </button>
            <button type="button" class="velo-carousel__arrow is-next" aria-label="@Texts.NextSlide"
                    disabled="@(!Loop && _index >= lastStart)" @onclick="() => GoTo(_index >= lastStart ? 0 : _index + 1)">
                <VeloIcon Name="chevron-right" Size="18" />
            </button>
        }
    </div>
    @if ((ShowDots || Autoplay) && count > SlidesPerView)
    {
        <div class="velo-carousel__footer">
            @if (Autoplay)
            {
                <button type="button" class="velo-close velo-carousel__play" aria-label="@(_paused ? Texts.Play : Texts.Pause)"
                        @onclick="() => _paused = !_paused">
                    <VeloIcon Svg="@(_paused ? "<path d='M7 4v16l13-8z'/>" : "<path d='M7 4v16M17 4v16'/>")" Size="14" />
                </button>
            }
            @if (ShowDots)
            {
                <div class="velo-carousel__dots" role="group" aria-label="@Texts.ChooseSlide">
                    @for (var i = 0; i <= lastStart; i++)
                    {
                        var target = i;
                        <button type="button" class="@(new CssBuilder("velo-carousel__dot").Add("is-active", target == _index).Build())"
                                aria-label="@VeloTexts.Format(Texts.SlideOf, target + 1, lastStart + 1)" aria-current="@(target == _index ? "true" : null)"
                                @onclick="() => GoTo(target)"></button>
                    }
                </div>
            }
        </div>
    }
</section>

@code {
    /// <summary>VeloCarouselSlide elements.</summary>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Slides visible at once (they shrink accordingly).</summary>
    [Parameter] public int SlidesPerView { get; set; } = 1;

    /// <summary>Space between slides, e.g. "16px".</summary>
    [Parameter] public string? Gap { get; set; }
    [Parameter] public string? Height { get; set; }

    /// <summary>Advances on its own; pauses on hover and focus, and has a pause button.</summary>
    [Parameter] public bool Autoplay { get; set; }
    [Parameter] public TimeSpan Interval { get; set; } = TimeSpan.FromSeconds(5);

    /// <summary>The arrows wrap around from the last slide to the first.</summary>
    [Parameter] public bool Loop { get; set; } = true;
    [Parameter] public bool ShowArrows { get; set; } = true;
    [Parameter] public bool ShowDots { get; set; } = true;

    /// <summary>Current slide (0-based). @bind-Index.</summary>
    [Parameter] public int Index { get; set; }
    [Parameter] public EventCallback<int> IndexChanged { get; set; }
    [Parameter] public string? AriaLabel { get; set; }

    private readonly List<VeloCarouselSlide> _slides = [];
    private readonly VeloTicker _ticker = new();
    private ElementReference _track;
    private IJSObjectReference? _module, _handle;
    private DotNetObjectReference<VeloCarousel>? _self;
    private int _index;
    private int? _lastIndexParam;
    private bool _hovered, _focused, _paused;

    private bool IsPlaying => Autoplay && !_paused && !_hovered && !_focused;

    internal int Count => _slides.Count;
    internal int IndexOf(VeloCarouselSlide slide) => _slides.IndexOf(slide);

    internal void Add(VeloCarouselSlide slide)
    {
        _slides.Add(slide);
        StateHasChanged();
    }

    internal void Remove(VeloCarouselSlide slide)
    {
        if (_slides.Remove(slide))
        {
            StateHasChanged();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_lastIndexParam != Index)
        {
            _lastIndexParam = Index;
            if (_handle is not null && Index != _index)
            {
                await GoTo(Index);
            }

            _index = Index;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", VeloJs.Path);
            _self = DotNetObjectReference.Create(this);
            _handle = await _module.InvokeAsync<IJSObjectReference>("attachCarousel", _track, _self);
            if (_index > 0)
            {
                await _handle.InvokeVoidAsync("goTo", _index, false);
            }
        }
        catch (JSDisconnectedException)
        {
            return;
        }

        if (Autoplay)
        {
            _ticker.Start(Interval, TimeProvider.System, () => InvokeAsync(async () =>
            {
                if (IsPlaying && _slides.Count > SlidesPerView)
                {
                    var lastStart = Math.Max(0, _slides.Count - SlidesPerView);
                    await GoTo(_index >= lastStart ? 0 : _index + 1);
                }
            }));
        }
    }

    public async Task GoTo(int index)
    {
        if (_handle is null)
        {
            return;
        }

        // Update right away: the scroll event only confirms it later (and is the source of truth for swipes).
        if (index != _index)
        {
            _index = index;
            _lastIndexParam = index;
            await IndexChanged.InvokeAsync(index);
            StateHasChanged();
        }

        try
        {
            await _handle.InvokeVoidAsync("goTo", index, true);
        }
        catch (JSDisconnectedException)
        {
            // Circuit closed.
        }
    }

    /// <summary>Called by velo.js once scrolling (swipe, arrows, dots, keyboard) settles.</summary>
    [JSInvokable]
    public async Task OnSlideChanged(int index)
    {
        _index = index;
        _lastIndexParam = index;
        await IndexChanged.InvokeAsync(index);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _ticker.Dispose();
        try
        {
            if (_handle is not null)
            {
                await _handle.InvokeVoidAsync("dispose");
                await _handle.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Circuit closed.
        }

        await VeloJs.DisposeQuietlyAsync(_module);
        _self?.Dispose();
    }
}
