@namespace Velo.Blazor
@inherits VeloComponentBase

<ol @attributes="Attributes" class="@(new CssBuilder("velo-stepper").Add(Vertical ? "velo-stepper--vertical" : "velo-stepper--horizontal").Add(Class).Build())"
    style="@(new StyleBuilder().Color("stepper", Color).Raw(Style).Build())" aria-label="@AriaLabel">
    @for (var i = 0; i < Steps.Count; i++)
    {
        var index = i;
        var step = Steps[i];
        var state = ErrorSteps?.Contains(index) == true ? "error" : index < ActiveIndex ? "done" : index == ActiveIndex ? "current" : "upcoming";
        var clickable = Clickable && index != ActiveIndex && (index < ActiveIndex || AllowSkip);
        <li class="@(new CssBuilder("velo-stepper__step").Add($"is-{state}").Build())" aria-current="@(state == "current" ? "step" : null)">
            @if (clickable)
            {
                <button type="button" class="velo-stepper__button" @onclick="() => Go(index)">@Body(index, step, state)</button>
            }
            else
            {
                <div class="velo-stepper__button">@Body(index, step, state)</div>
            }
        </li>
    }
</ol>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<VeloStep> Steps { get; set; } = [];

    /// <summary>Current step (0-based). Steps before it are done.</summary>
    [Parameter] public int ActiveIndex { get; set; }
    [Parameter] public EventCallback<int> ActiveIndexChanged { get; set; }

    /// <summary>Steps flagged in error (icon + "Erreur", not only red).</summary>
    [Parameter] public IReadOnlyCollection<int>? ErrorSteps { get; set; }

    /// <summary>Done steps can be clicked to go back.</summary>
    [Parameter] public bool Clickable { get; set; } = true;

    /// <summary>Also allow jumping to future steps.</summary>
    [Parameter] public bool AllowSkip { get; set; }
    [Parameter] public bool Vertical { get; set; }
    [Parameter] public string? Color { get; set; }
    [Parameter] public string AriaLabel { get; set; } = "Étapes";

    private async Task Go(int index)
    {
        ActiveIndex = index;
        await ActiveIndexChanged.InvokeAsync(index);
    }

    private static RenderFragment Body(int index, VeloStep step, string state) => __builder =>
    {
        <span class="velo-stepper__marker" aria-hidden="true">
            @if (state == "done")
            {
                <VeloIcon Name="check" Size="14" StrokeWidth="3" />
            }
            else if (state == "error")
            {
                <VeloIcon Name="x" Size="14" StrokeWidth="3" />
            }
            else
            {
                @(index + 1)
            }
        </span>
        <span class="velo-stepper__text">
            <span class="velo-stepper__title">@step.Title</span>
            @if (state == "error")
            {
                <span class="velo-stepper__description velo-stepper__error">Erreur à corriger</span>
            }
            else if (!string.IsNullOrEmpty(step.Description))
            {
                <span class="velo-stepper__description">@step.Description</span>
            }
            <span class="velo-sr-only">@(state switch { "done" => "(terminée)", "current" => "(en cours)", "error" => "(en erreur)", _ => "" })</span>
        </span>
    };
}
